---
import Layout from '../layouts/Layout.astro';
import { getGuide } from '../data/guides';
import { getLocalizedPath, type Lang } from '../i18n/ui';
import { getLocalizedTools } from '../data/tools';
const {lang,slug}=Astro.props as {lang:Lang;slug:string};const guide=getGuide(slug);if(!guide)throw new Error(`Unknown guide: ${slug}`);const c=guide.copy[lang],es=lang==='es',catalog=getLocalizedTools(lang);const related=(slugs:string[])=>slugs.map((slug)=>catalog.find((tool)=>tool.slug===slug)).filter(Boolean);
---
<Layout title={`${c.title} — Alon Tools`} description={c.description} lang={lang} path={`/guides/${slug}/`} translated={true} pageType="article">
  <article class="guide-page">
    <nav class="guide-breadcrumb"><a href={getLocalizedPath('/guides/',lang)}>{es?'Guías':'Guides'}</a><span>/</span><span>{c.reading}</span></nav>
    <header><span class="eyebrow">{es?'Guía práctica':'Practical guide'} · {c.reading}</span><h1>{c.title}</h1><p class="lead">{c.intro}</p></header>
    <div class="article-layout"><div class="article-content">{c.sections.map((section,index)=><section id={`section-${index+1}`}><span class="section-number">0{index+1}</span><h2>{section.title}</h2>{section.paragraphs.map((paragraph)=><p>{paragraph}</p>)}{section.tools&&<div class="inline-tools"><strong>{es?'Herramientas recomendadas':'Recommended tools'}</strong>{related(section.tools).map((tool)=><a href={tool.path}>{tool.title} <span>→</span></a>)}</div>}</section>)}<aside class="takeaway"><strong>{es?'Idea clave':'Key takeaway'}</strong><p>{c.takeaway}</p></aside></div><aside class="guide-aside"><div><strong>{es?'En esta guía':'In this guide'}</strong><ol>{c.sections.map((section,index)=><li><a href={`#section-${index+1}`}>{section.title}</a></li>)}</ol></div><a class="btn btn-primary" href={getLocalizedPath('/',lang)}>{es?'Buscar herramienta':'Find a tool'}</a></aside></div>
    <section class="more-guides"><h2>{es?'Sigue aprendiendo':'Keep learning'}</h2><a href={getLocalizedPath('/guides/',lang)}>{es?'Ver todas las guías y recursos':'Browse all guides and resources'} →</a></section>
  </article>
</Layout>
<style>
  .guide-page{max-width:72rem;margin:auto}.guide-breadcrumb{display:flex;gap:.5rem;padding-top:1rem;color:var(--color-text-soft);font-size:.8rem;font-weight:800}.guide-breadcrumb a{color:var(--color-text-muted);text-decoration:none}.guide-page>header{display:grid;gap:1rem;padding:clamp(2rem,6vw,4.5rem) 0 2rem}.guide-page>header h1{max-width:58rem}.lead{max-width:48rem;font-size:clamp(1.05rem,2vw,1.25rem)}.article-layout{display:grid;grid-template-columns:minmax(0,1fr) 17rem;gap:clamp(2rem,5vw,5rem);align-items:start}.article-content section{position:relative;padding:0 0 2.5rem}.article-content h2{margin:.35rem 0 1rem}.article-content p{max-width:68ch;font-size:1.04rem;line-height:1.75}.section-number{color:var(--color-primary);font:900 .78rem var(--font-mono)}.inline-tools{display:grid;grid-template-columns:repeat(2,1fr);gap:.55rem;margin-top:1.3rem;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:var(--color-surface)}.inline-tools>strong{grid-column:1/-1}.inline-tools a{display:flex;justify-content:space-between;padding:.7rem;border-radius:var(--radius-md);background:var(--color-surface-soft);color:var(--color-text);font-size:.88rem;font-weight:800;text-decoration:none}.takeaway{padding:1.2rem;border-left:4px solid var(--color-primary);border-radius:0 var(--radius-lg) var(--radius-lg) 0;background:var(--color-primary-soft)}.takeaway strong{color:var(--color-text)}.takeaway p{margin:.4rem 0 0;color:var(--color-text)}.guide-aside{position:sticky;top:6rem;display:grid;gap:1rem}.guide-aside>div{padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:var(--color-surface)}.guide-aside ol{margin:.75rem 0 0;padding-left:1.3rem}.guide-aside li{margin:.55rem 0}.guide-aside a:not(.btn){color:var(--color-text-muted);font-size:.84rem;text-decoration:none}.more-guides{margin-top:4rem;padding:1.2rem;border-top:1px solid var(--color-border)}.more-guides h2{margin:0 0 .6rem}@media(max-width:800px){.article-layout{grid-template-columns:1fr}.guide-aside{position:static;grid-row:1}.inline-tools{grid-template-columns:1fr}.inline-tools>strong{grid-column:auto}}
</style>
