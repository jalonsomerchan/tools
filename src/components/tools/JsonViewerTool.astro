---
import { useTranslations, type Language } from '../../i18n';

const { lang = 'en' } = Astro.props as { lang?: Language };
const t = useTranslations(lang);
---

<section style="padding: 4rem 0;">
  <div class="eyebrow">Alon Tools</div>

  <h1>{t('json.title')}</h1>

  <p class="hero-text">{t('json.description')}</p>

  <section class="tool-card">
    <div class="toolbar">
      <button class="primary" id="formatBtn">{t('json.format')}</button>
      <button id="minifyBtn">{t('json.minify')}</button>
      <button id="validateBtn">{t('json.validate')}</button>
      <button id="clearBtn">{t('json.clear')}</button>
      <button id="copyBtn">{t('json.copy')}</button>
    </div>

    <div class="workspace">
      <textarea id="input" placeholder={t('json.input')}></textarea>
      <textarea id="output" readonly placeholder={t('json.output')}></textarea>
    </div>

    <p class="status" id="status">{t('json.ready')}</p>
  </section>
</section>

<style>
  .toolbar{display:flex;gap:1rem;margin-bottom:1rem;flex-wrap:wrap}
  button{background:#0f172a;color:white;border:1px solid var(--border);border-radius:14px;padding:1rem;cursor:pointer}
  button.primary{background:var(--primary);color:black}
  .workspace{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
  textarea{width:100%;min-height:400px;border-radius:18px;border:1px solid var(--border);background:#020617;color:white;padding:1rem;font-family:ui-monospace,monospace;line-height:1.6}
  .status{margin-top:1rem;color:var(--muted)}
  @media (max-width:860px){.workspace{grid-template-columns:1fr}}
</style>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('input');
    const output = document.getElementById('output');
    const status = document.getElementById('status');

    const setStatus = (message, error = false) => {
      status.textContent = message;
      status.style.color = error ? '#fca5a5' : '#94a3b8';
    };

    const parse = () => JSON.parse(input.value);

    document.getElementById('formatBtn').onclick = () => {
      try { output.value = JSON.stringify(parse(), null, 2); setStatus('OK'); }
      catch { setStatus('Invalid JSON', true); }
    };

    document.getElementById('minifyBtn').onclick = () => {
      try { output.value = JSON.stringify(parse()); setStatus('OK'); }
      catch { setStatus('Invalid JSON', true); }
    };

    document.getElementById('validateBtn').onclick = () => {
      try { parse(); setStatus('Valid JSON'); }
      catch { setStatus('Invalid JSON', true); }
    };

    document.getElementById('clearBtn').onclick = () => {
      input.value = '';
      output.value = '';
      setStatus('Ready.');
    };

    document.getElementById('copyBtn').onclick = async () => {
      try { await navigator.clipboard.writeText(output.value); setStatus('Copied'); }
      catch { setStatus('Copy error', true); }
    };
  });
</script>
