---
import { useTranslations, type Language } from '../../i18n';

const { lang = 'en' } = Astro.props as { lang?: Language };
const t = useTranslations(lang);
---

<section style="padding: 4rem 0;">
  <div class="eyebrow">Alon Tools</div>

  <h1>{t('urlEncoder.title')}</h1>

  <p class="hero-text">{t('urlEncoder.description')}</p>

  <section class="tool-card">
    <div class="toolbar">
      <button class="primary" id="encodeBtn">{t('urlEncoder.encode')}</button>
      <button id="decodeBtn">{t('urlEncoder.decode')}</button>
      <button id="swapBtn">{t('urlEncoder.swap')}</button>
      <button id="clearBtn">{t('urlEncoder.clear')}</button>
    </div>

    <div class="editor-grid">
      <div class="panel">
        <span>{t('urlEncoder.input')}</span>
        <textarea id="inputText" placeholder="https://example.com/?q=hello world"></textarea>
      </div>

      <div class="panel">
        <span>{t('urlEncoder.output')}</span>
        <textarea id="outputText" readonly placeholder={t('urlEncoder.output')}></textarea>
      </div>
    </div>
  </section>
</section>

<style>
  .toolbar{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:1rem}
  button{border-radius:14px;border:1px solid var(--border);background:#020617;color:white;padding:1rem;cursor:pointer;font:inherit}
  button.primary{background:var(--primary);color:black;border:none;font-weight:700}
  .editor-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1rem}
  .panel{display:flex;flex-direction:column;gap:.6rem}
  .panel span{color:var(--muted);font-size:.92rem}
  textarea{min-height:320px;border-radius:24px;border:1px solid var(--border);background:#020617;color:white;padding:1rem;resize:vertical;font-family:ui-monospace,monospace;line-height:1.7}
</style>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('inputText');
    const output = document.getElementById('outputText');

    document.getElementById('encodeBtn').onclick = () => {
      try { output.value = encodeURIComponent(input.value); }
      catch { alert('Encode error'); }
    };

    document.getElementById('decodeBtn').onclick = () => {
      try { output.value = decodeURIComponent(input.value); }
      catch { alert('Decode error'); }
    };

    document.getElementById('swapBtn').onclick = () => {
      const temp = input.value;
      input.value = output.value;
      output.value = temp;
    };

    document.getElementById('clearBtn').onclick = () => {
      input.value = '';
      output.value = '';
    };
  });
</script>
