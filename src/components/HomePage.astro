---
import Layout from '../layouts/Layout.astro';
import { homeTranslations } from '../i18n/tools';
import { getToolsByCategory } from '../data/tools';
import type { Lang } from '../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const copy = homeTranslations[lang];
const categories = getToolsByCategory(lang);
const favoriteCopy = {
  title: lang === 'es' ? 'Favoritas' : 'Favorites',
  add: lang === 'es' ? 'Añadir a favoritas' : 'Add to favorites',
  remove: lang === 'es' ? 'Quitar de favoritas' : 'Remove from favorites',
  added: lang === 'es' ? 'Herramienta añadida a favoritas.' : 'Tool added to favorites.',
  removed: lang === 'es' ? 'Herramienta quitada de favoritas.' : 'Tool removed from favorites.'
};
const totalTools = categories.reduce((total, category) => total + category.items.length, 0);
const privacyCopy = {
  provider: lang === 'es' ? 'Proveedor' : 'Provider'
};
---

<Layout title={copy.title} description={copy.description} lang={lang} path="/" translated={true}>
  {lang === 'en' && (
    <script is:inline>
      (() => {
        const isHome = window.location.pathname === '/';
        const alreadyRedirected = window.sessionStorage.getItem('alon-tools-lang-redirected');
        const preferredLanguages = navigator.languages?.length ? navigator.languages : [navigator.language];
        const prefersSpanish = preferredLanguages.some((language) => language?.toLowerCase().startsWith('es'));
        if (isHome && prefersSpanish && !alreadyRedirected) {
          window.sessionStorage.setItem('alon-tools-lang-redirected', '1');
          window.location.replace('/es/');
        }
      })();
    </script>
  )}

  <section class="hero">
    <div class="eyebrow">{copy.eyebrow}</div>
    <h1>{copy.heroTitle}</h1>
    <p class="hero-text">{copy.heroText}</p>
  </section>

  <section class="search-panel" aria-labelledby="toolsSearchTitle">
    <div class="search-heading">
      <div>
        <h2 id="toolsSearchTitle">{copy.searchTitle}</h2>
        <p id="toolsCount">{copy.showing(totalTools, totalTools)}</p>
      </div>
      <button id="clearFilters" class="btn btn-secondary" type="button">{copy.clearFilters}</button>
    </div>

    <label for="toolSearch">{copy.searchLabel}</label>
    <input id="toolSearch" type="search" placeholder={copy.searchPlaceholder} autocomplete="off" />

    <div class="category-filters" aria-label={copy.categoryFilters}>
      <button class="filter-button active" type="button" data-category-filter="all">{copy.filterAll}</button>
      {categories.map((category) => (
        <button class="filter-button" type="button" data-category-filter={category.title}>{category.title}</button>
      ))}
    </div>
  </section>

  <p class="empty-state" id="emptyState" hidden>{copy.emptyState}</p>

  <section class="category-section favorites-section" id="favoritesSection" data-category-section={favoriteCopy.title} hidden>
    <div class="category-header favorites-header">
      <h2>{favoriteCopy.title}</h2>
      <p>{lang === 'es' ? 'Se guardan solo en este navegador.' : 'Saved only in this browser.'}</p>
    </div>
    <div class="directory-grid" id="favoritesGrid"></div>
  </section>

  {categories.map((category) => (
    <section class="category-section" data-category-section={category.title}>
      <div class="category-header">
        <h2>{category.title}</h2>
      </div>

      <div class="directory-grid">
        {category.items.map((tool, index) => (
          <a
            class={`tool-link-card ${index < 3 ? 'featured-tool' : ''}`}
            href={tool.path}
            data-tool-card
            data-tool-path={tool.path}
            data-category={category.title}
            data-search={`${tool.title} ${tool.description} ${tool.path} ${tool.icon} ${tool.search ?? ''} ${category.title} ${tool.privacyLabel} ${tool.apiProvider ?? ''}`.toLowerCase()}
          >
            <button class="favorite-button" type="button" data-favorite-toggle aria-label={favoriteCopy.add} aria-pressed="false">☆</button>
            <div class="tool-icon">{tool.icon}</div>
            <div class="tool-card-content">
              <strong>{tool.title}</strong>
              <small>{tool.description}</small>
              <span class={`privacy-badge privacy-badge-${tool.privacy}`}>
                {tool.privacyLabel}{tool.apiProvider ? ` · ${privacyCopy.provider}: ${tool.apiProvider}` : ''}
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}

  <script define:vars={{ showingTemplate: copy.showing(0, 0), lang, favoriteCopy }}>
    const searchInput = document.getElementById('toolSearch');
    const clearFilters = document.getElementById('clearFilters');
    const toolsCount = document.getElementById('toolsCount');
    const emptyState = document.getElementById('emptyState');
    const favoritesSection = document.getElementById('favoritesSection');
    const favoritesGrid = document.getElementById('favoritesGrid');
    const cards = Array.from(document.querySelectorAll('[data-tool-card]'));
    const sections = Array.from(document.querySelectorAll('[data-category-section]'));
    const filterButtons = Array.from(document.querySelectorAll('[data-category-filter]'));
    const total = cards.length;
    const favoritesKey = 'alon-tools-favorite-tools';
    let activeCategory = 'all';
    let favoritePaths = new Set();

    const originalPlaces = new Map(cards.map((card, index) => [card, {
      parent: card.parentElement,
      index
    }]));

    const formatCount = (visible, countTotal) => {
      if (lang === 'es') return `Mostrando ${visible} de ${countTotal} herramientas`;
      return `Showing ${visible} of ${countTotal} tools`;
    };

    const readFavorites = () => {
      try {
        const stored = JSON.parse(window.localStorage.getItem(favoritesKey) || '[]');
        favoritePaths = new Set(Array.isArray(stored) ? stored : []);
      } catch {
        favoritePaths = new Set();
      }
    };

    const saveFavorites = () => {
      window.localStorage.setItem(favoritesKey, JSON.stringify([...favoritePaths]));
    };

    const setActiveButton = () => {
      filterButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.categoryFilter === activeCategory);
      });
    };

    const syncFavoriteButtons = () => {
      cards.forEach((card) => {
        const isFavorite = favoritePaths.has(card.dataset.toolPath);
        const button = card.querySelector('[data-favorite-toggle]');
        card.dataset.favorite = String(isFavorite);
        if (button) {
          button.textContent = isFavorite ? '★' : '☆';
          button.setAttribute('aria-pressed', String(isFavorite));
          button.setAttribute('aria-label', isFavorite ? favoriteCopy.remove : favoriteCopy.add);
          button.title = isFavorite ? favoriteCopy.remove : favoriteCopy.add;
        }
      });
    };

    const orderOriginalGrid = (parent) => {
      const children = cards
        .filter((card) => originalPlaces.get(card)?.parent === parent && !favoritePaths.has(card.dataset.toolPath))
        .sort((a, b) => originalPlaces.get(a).index - originalPlaces.get(b).index);
      children.forEach((card) => parent.append(card));
    };

    const placeFavoriteCards = () => {
      cards.forEach((card) => {
        if (favoritePaths.has(card.dataset.toolPath)) {
          favoritesGrid.append(card);
        }
      });

      const originalParents = [...new Set([...originalPlaces.values()].map((place) => place.parent))];
      originalParents.forEach(orderOriginalGrid);
      favoritesSection.hidden = favoritesGrid.children.length === 0;
    };

    const filterTools = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
        const matchesSearch = !query || card.dataset.search.includes(query);
        const show = matchesCategory && matchesSearch;
        card.hidden = !show;

        if (show) visible += 1;
      });

      sections.forEach((section) => {
        const hasVisibleCard = Boolean(section.querySelector('[data-tool-card]:not([hidden])'));
        section.hidden = section === favoritesSection
          ? !hasVisibleCard || favoritesGrid.children.length === 0
          : !hasVisibleCard;
      });

      toolsCount.textContent = formatCount(visible, total);
      emptyState.hidden = visible !== 0;
      setActiveButton();
    };

    const refreshFavorites = () => {
      syncFavoriteButtons();
      placeFavoriteCards();
      filterTools();
    };

    document.querySelectorAll('[data-favorite-toggle]').forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const card = button.closest('[data-tool-card]');
        if (!card?.dataset.toolPath) return;

        if (favoritePaths.has(card.dataset.toolPath)) {
          favoritePaths.delete(card.dataset.toolPath);
          toolsCount.textContent = favoriteCopy.removed;
        } else {
          favoritePaths.add(card.dataset.toolPath);
          toolsCount.textContent = favoriteCopy.added;
        }

        saveFavorites();
        refreshFavorites();
      });
    });

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.categoryFilter || 'all';
        filterTools();
      });
    });

    searchInput.addEventListener('input', filterTools);

    clearFilters.addEventListener('click', () => {
      searchInput.value = '';
      activeCategory = 'all';
      filterTools();
      searchInput.focus();
    });

    readFavorites();
    refreshFavorites();
  </script>
</Layout>

<style>
