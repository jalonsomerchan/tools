argin-top:var(--space-7,1.75rem)}.category-section[hidden]{display:none}.favorites-section{order:-1}.category-header{margin-bottom:var(--space-3)}.category-header h2{margin:0;font-size:clamp(1.35rem,2vw,1.75rem)}.favorites-header{display:flex;align-items:end;justify-content:space-between;gap:var(--space-4)}.favorites-header p{margin:0;color:var(--color-text-muted);font-size:.9rem}.directory-grid{display:grid;gap:.85rem;grid-template-columns:repeat(auto-fit,minmax(min(100%,245px),1fr))}.tool-link-card{position:relative;display:flex;gap:.85rem;min-height:7.15rem;padding:.95rem;padding-right:3.25rem;border-radius:var(--radius-xl);border:1px solid var(--color-border);background:color-mix(in srgb,var(--color-surface) 94%,transparent);color:inherit;text-decoration:none;box-shadow:var(--shadow-xs);transition:transform var(--transition-base),border-color var(--transition-base),box-shadow var(--transition-base),background-color var(--transition-base)}.tool-link-card:hover{transform:translateY(-2px);border-color:var(--color-border-strong);box-shadow:var(--shadow-sm);color:inherit}.tool-link-card[hidden]{display:none}.featured-tool{background:linear-gradient(135deg,color-mix(in srgb,var(--color-primary-soft) 48%,var(--color-surface)),var(--color-surface));}.tool-link-card[data-favorite='true']{border-color:color-mix(in srgb,var(--color-primary) 55%,var(--color-border));box-shadow:var(--shadow-sm)}.favorite-button{position:absolute;top:.72rem;right:.72rem;z-index:2;width:2rem;height:2rem;border-radius:var(--radius-full);border:1px solid var(--color-border);background:color-mix(in srgb,var(--color-surface) 95%,transparent);color:var(--color-text-muted);font-size:1.05rem;line-height:1;display:grid;place-items:center;cursor:pointer;box-shadow:var(--shadow-xs);transition:transform var(--transition-fast),background-color var(--transition-base),color var(--transition-base),border-color var(--transition-base)}.favorite-button:hover{transform:scale(1.06);color:var(--color-primary);border-color:var(--color-primary)}.tool-link-card[data-favorite='true'] .favorite-button{background:var(--color-primary);color:#fff;border-color:transparent}.tool-icon{width:3.25rem;height:3.25rem;display:grid;place-items:center;border-radius:var(--radius-md);background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));color:#fff;font-weight:900;font-size:.76rem;flex-shrink:0;box-shadow:var(--shadow-xs)}.tool-card-content{min-width:0}.tool-link-card strong{display:block;margin-bottom:.35rem;color:var(--color-text);line-height:1.22;font-size:.98rem}.tool-link-card small{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;color:var(--color-text-muted);font-size:.86rem;line-height:1.45}.privacy-badge{display:inline-flex;width:fit-content;margin-top:.55rem;padding:.26rem .48rem;border-radius:var(--radius-full);border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text-muted);font-size:.66rem;font-weight:900;line-height:1.1}.privacy-badge-local{border-color:color-mix(in srgb,var(--color-success) 35%,var(--color-border));color:var(--color-success)}.privacy-badge-external-api{border-color:color-mix(in srgb,var(--color-info) 35%,var(--color-border));color:var(--color-info)}@media(max-width:900px){.hero{padding-top:var(--space-8)}.hero h1{font-size:clamp(2rem,8vw,3.2rem)}.hero .hero-text{font-size:1rem}.directory-grid{grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))}}@media(max-width:640px){.hero{padding-top:var(--space-6);text-align:left}.hero h1,.hero .hero-text{margin-left:0;margin-right:0}.search-heading{flex-direction:column;align-items:stretch}#clearFilters,.filter-button{width:100%}.favorites-header{display:block}.favorites-header p{margin-top:var(--space-2)}.tool-link-card{min-height:0;padding:var(--space-4);padding-right:3.35rem}.favorite-button{top:.8rem;right:.8rem}.tool-icon{width:3rem;height:3rem}.tool-link-card small{-webkit-line-clamp:3}}
</style>