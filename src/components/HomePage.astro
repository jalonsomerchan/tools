---
import Layout from '../layouts/Layout.astro';
import { homeTranslations, getCatalogByCategory } from '../i18n/tools';
import type { Lang } from '../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const copy = homeTranslations[lang];
const categories = getCatalogByCategory(lang);
const extraTools = [
  {
    category: lang === 'es' ? 'Imágenes' : 'Images',
    path: '/screenshot-enhancer/',
    icon: 'SHOT',
    title: lang === 'es' ? 'Mejorador de capturas' : 'Screenshot enhancer',
    description: lang === 'es'
      ? 'Convierte capturas en imágenes profesionales con fondos, colores y exportación PNG, JPG, WebP o SVG.'
      : 'Turn screenshots into polished images with backgrounds, colors and PNG, JPG, WebP or SVG exports.',
    search: 'screenshot capture captura imagen fondos svg'
  },
  {
    category: lang === 'es' ? 'Desarrollo' : 'Development',
    path: '/uuid-generator/',
    icon: 'UUID',
    title: lang === 'es' ? 'Generador de UUID y claves' : 'UUID and random key generator',
    description: lang === 'es'
      ? 'Genera UUID v4 y cadenas aleatorias con Web Crypto, todo local en el navegador.'
      : 'Generate UUID v4 values and random strings with Web Crypto, fully local in the browser.',
    search: 'uuid random key clave token crypto'
  },
  {
    category: lang === 'es' ? 'Desarrollo' : 'Development',
    path: '/password-generator/',
    icon: 'PASS',
    title: lang === 'es' ? 'Generador de contraseñas' : 'Password and passphrase generator',
    description: lang === 'es'
      ? 'Crea contraseñas y frases seguras sin guardar datos ni hacer llamadas de red.'
      : 'Create passwords and secure passphrases without storing data or making network calls.',
    search: 'password contraseña passphrase seguridad crypto'
  },
  {
    category: lang === 'es' ? 'Internet y mapas' : 'Internet & maps',
    path: '/robots-sitemap-generator/',
    icon: 'SEO',
    title: lang === 'es' ? 'Generador de robots.txt y sitemap' : 'Robots.txt and sitemap generator',
    description: lang === 'es'
      ? 'Crea robots.txt y un sitemap XML básico pegando URLs manualmente, sin rastrear ni consultar servidores.'
      : 'Create robots.txt and a basic XML sitemap from pasted URLs, without crawling or server requests.',
    search: 'robots sitemap xml seo crawler rastreo'
  },
  {
    category: lang === 'es' ? 'Internet y mapas' : 'Internet & maps',
    path: '/meta-tags-generator/',
    icon: 'META',
    title: lang === 'es' ? 'Generador de meta tags y Open Graph' : 'Meta tags and Open Graph generator',
    description: lang === 'es'
      ? 'Genera title, description, canonical, Open Graph y Twitter Cards con vista previa local.'
      : 'Generate title, description, canonical, Open Graph and Twitter Cards with a local preview.',
    search: 'meta tags open graph twitter cards seo title description canonical'
  }
];
const extraCategories = [...new Set(extraTools.map((tool) => tool.category))];
const totalTools = categories.reduce((total, category) => total + category.items.length, 0) + extraTools.length;
---

<Layout title={copy.title} description={copy.description} lang={lang} path="/" translated={true}>
  {lang === 'en' && (
    <script is:inline>
      (() => {
        const isHome = window.location.pathname === '/';
        const alreadyRedirected = window.sessionStorage.getItem('alon-tools-lang-redirected');
        const preferredLanguages = navigator.languages?.length ? navigator.languages : [navigator.language];
        const prefersSpanish = preferredLanguages.some((language) => language?.toLowerCase().startsWith('es'));
        if (isHome && prefersSpanish && !alreadyRedirected) {
          window.sessionStorage.setItem('alon-tools-lang-redirected', '1');
          window.location.replace('/es/');
        }
      })();
    </script>
  )}

  <section class="hero">
    <div class="eyebrow">{copy.eyebrow}</div>
    <h1>{copy.heroTitle}</h1>
    <p class="hero-text">{copy.heroText}</p>
  </section>

  <section class="search-panel" aria-labelledby="toolsSearchTitle">
    <div class="search-heading">
      <div>
        <h2 id="toolsSearchTitle">{copy.searchTitle}</h2>
        <p id="toolsCount">{copy.showing(totalTools, totalTools)}</p>
      </div>
      <button id="clearFilters" class="btn btn-secondary" type="button">{copy.clearFilters}</button>
    </div>

    <label for="toolSearch">{copy.searchLabel}</label>
    <input id="toolSearch" type="search" placeholder={copy.searchPlaceholder} autocomplete="off" />

    <div class="category-filters" aria-label={copy.categoryFilters}>
      <button class="filter-button active" type="button" data-category-filter="all">{copy.filterAll}</button>
      {[...extraCategories, ...categories.map((category) => category.title)]
        .filter((title, index, all) => all.indexOf(title) === index)
        .map((title) => (
          <button class="filter-button" type="button" data-category-filter={title}>{title}</button>
        ))}
    </div>
  </section>

  <p class="empty-state" id="emptyState" hidden>{copy.emptyState}</p>

  <section class="category-section" data-category-section={lang === 'es' ? 'Nuevas herramientas' : 'New tools'}>
    <div class="category-header">
      <h2>{lang === 'es' ? 'Nuevas herramientas' : 'New tools'}</h2>
    </div>

    <div class="directory-grid">
      {extraTools.map((tool) => (
        <a
          class="tool-link-card featured-tool"
          href={tool.path}
          data-tool-card
          data-category={tool.category}
          data-search={`${tool.title} ${tool.description} ${tool.path} ${tool.icon} ${tool.search} ${tool.category}`.toLowerCase()}
        >
          <div class="tool-icon">{tool.icon}</div>
          <div>
            <strong>{tool.title}</strong>
            <small>{tool.description}</small>
          </div>
        </a>
      ))}
    </div>
  </section>

  {categories.map((category) => (
    <section class="category-section" data-category-section={category.title}>
      <div class="category-header">
        <h2>{category.title}</h2>
      </div>

      <div class="directory-grid">
        {category.items.map((tool) => (
          <a
            class="tool-link-card"
            href={tool.path}
            data-tool-card
            data-category={category.title}
            data-search={`${tool.title} ${tool.description} ${tool.path} ${tool.icon} ${category.title}`.toLowerCase()}
          >
            <div class="tool-icon">{tool.icon}</div>
            <div>
              <strong>{tool.title}</strong>
              <small>{tool.description}</small>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}

  <script define:vars={{ showingTemplate: copy.showing(0, 0), lang }}>
    const searchInput = document.getElementById('toolSearch');
    const clearFilters = document.getElementById('clearFilters');
    const toolsCount = document.getElementById('toolsCount');
    const emptyState = document.getElementById('emptyState');
    const cards = Array.from(document.querySelectorAll('[data-tool-card]'));
    const sections = Array.from(document.querySelectorAll('[data-category-section]'));
    const filterButtons = Array.from(document.querySelectorAll('[data-category-filter]'));
    const total = cards.length;
    let activeCategory = 'all';

    const formatCount = (visible, countTotal) => {
      if (lang === 'es') return `Mostrando ${visible} de ${countTotal} herramientas`;
      return `Showing ${visible} of ${countTotal} tools`;
    };

    const setActiveButton = () => {
      filterButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.categoryFilter === activeCategory);
      });
    };

    const filterTools = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
        const matchesSearch = !query || card.dataset.search.includes(query);
        const show = matchesCategory && matchesSearch;
        card.hidden = !show;

        if (show) visible += 1;
      });

      sections.forEach((section) => {
        section.hidden = !section.querySelector('[data-tool-card]:not([hidden])');
      });

      toolsCount.textContent = formatCount(visible, total);
      emptyState.hidden = visible !== 0;
      setActiveButton();
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.categoryFilter || 'all';
        filterTools();
      });
    });

    searchInput.addEventListener('input', filterTools);

    clearFilters.addEventListener('click', () => {
      searchInput.value = '';
      activeCategory = 'all';
      filterTools();
      searchInput.focus();
    });

    filterTools();
  </script>
</Layout>

<style>
  .hero{padding:clamp(3rem,8vw,6rem) 0 var(--space-8)}.search-panel{margin:var(--space-4) 0 var(--space-10);padding:clamp(1rem,3vw,1.5rem);border-radius:var(--radius-2xl);border:1px solid var(--color-border);background:color-mix(in srgb,var(--color-surface) 94%,transparent);box-shadow:var(--shadow-sm)}.search-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-4);margin-bottom:var(--space-4)}.search-heading h2{margin:0 0 var(--space-1);font-size:1.25rem}.search-heading p{margin:0;color:var(--color-text-muted)}input[type='search']{font-size:1rem}.category-filters{display:flex;gap:var(--space-2);flex-wrap:wrap;margin-top:var(--space-4)}.filter-button{min-height:2.55rem;border-radius:var(--radius-full);border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text-muted);padding:.65rem .9rem;cursor:pointer;font:inherit;font-weight:800;transition:transform var(--transition-fast),background-color var(--transition-base),color var(--transition-base),border-color var(--transition-base)}.filter-button:hover{transform:translateY(-1px);border-color:var(--color-border-strong);color:var(--color-text)}.filter-button.active{background:var(--color-primary);color:#fff;border-color:transparent}[data-theme='dark'] .filter-button.active{color:#020617}.empty-state{padding:var(--space-5);border-radius:var(--radius-xl);border:1px dashed var(--color-border-strong);background:var(--color-surface);color:var(--color-text-muted);text-align:center}.category-section{margin-top:var(--space-12)}.category-section[hidden]{display:none}.category-header{margin-bottom:var(--space-4)}.category-header h2{margin:0}.directory-grid{display:grid;gap:var(--space-4);grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))}.tool-link-card{display:flex;gap:var(--space-4);padding:var(--space-5);border-radius:var(--radius-2xl);border:1px solid var(--color-border);background:color-mix(in srgb,var(--color-surface) 94%,transparent);color:inherit;text-decoration:none;box-shadow:var(--shadow-xs);transition:transform var(--transition-base),border-color var(--transition-base),box-shadow var(--transition-base),background-color var(--transition-base)}.tool-link-card:hover{transform:translateY(-2px);border-color:var(--color-border-strong);box-shadow:var(--shadow-sm);color:inherit}.tool-link-card[hidden]{display:none}.featured-tool{background:linear-gradient(135deg,color-mix(in srgb,var(--color-primary-soft) 58%,var(--color-surface)),var(--color-surface));}.tool-icon{width:4rem;height:4rem;display:grid;place-items:center;border-radius:var(--radius-lg);background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));color:#fff;font-weight:900;font-size:.9rem;flex-shrink:0;box-shadow:var(--shadow-xs)}.tool-link-card strong{display:block;margin-bottom:var(--space-2);color:var(--color-text);line-height:1.3}.tool-link-card small{color:var(--color-text-muted);line-height:1.7}@media(max-width:640px){.hero{padding-top:var(--space-10)}.search-heading{flex-direction:column}#clearFilters,.filter-button{width:100%}.tool-link-card{padding:var(--space-4)}}
</style>
