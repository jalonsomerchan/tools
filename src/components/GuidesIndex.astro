---
import Layout from '../layouts/Layout.astro';
import {guides,getGuidePath,type GuideCategoryId} from '../data/guides';
import {toolCategoryLabels} from '../data/tools';
import {getLocalizedPath,type Lang} from '../i18n/ui';
const {lang}=Astro.props as {lang:Lang};const es=lang==='es';
const categories=[...new Set(guides.map((guide)=>guide.category))] as GuideCategoryId[];
const categoryName=(category:GuideCategoryId)=>category==='foundations'?(es?'Fundamentos':'Foundations'):toolCategoryLabels[category][lang];
const generatedCount=guides.filter((guide)=>guide.kind!=='foundational').length;
---
<Layout title={es?'Guías prácticas de herramientas online — Alon Tools':'Practical online tool guides — Alon Tools'} description={es?'Guías detalladas con ejemplos para usar herramientas locales, resolver errores y trabajar mejor con datos, texto, cálculos, conversiones e imágenes.':'Detailed guides with examples for using local tools, fixing mistakes and working effectively with data, text, calculations, conversions and images.'} lang={lang} path="/guides/" translated={true} pageType="collection">
  <article class="guides-page" data-guides-index>
    <header><span class="eyebrow">{es?'Centro de recursos':'Resource center'}</span><h1>{es?'Guías prácticas para resolver tareas en el navegador':'Practical guides for browser-based tasks'}</h1><p>{es?`${generatedCount} guías nuevas organizadas por intención: aprende el proceso paso a paso o corrige resultados inesperados con ejemplos reproducibles.`:`${generatedCount} new guides organised by intent: learn a workflow step by step or fix unexpected results with reproducible examples.`}</p></header>

    <nav class="topic-grid" aria-label={es?'Temas de las guías':'Guide topics'}>{categories.map((category)=>{
      const count=guides.filter((guide)=>guide.category===category).length;
      return <a href={getLocalizedPath(`/guides/topics/${category}/`,lang)}><strong>{categoryName(category)}</strong><span>{count} {es?'guías':'guides'} →</span></a>
    })}</nav>

    <section class="guide-controls" aria-labelledby="all-guides-title">
      <div><h2 id="all-guides-title">{es?'Explora todas las guías':'Explore all guides'}</h2><p>{es?'Busca por herramienta, tarea o problema.':'Search by tool, task or problem.'}</p></div>
      <div class="filters">
        <label><span>{es?'Buscar guías':'Search guides'}</span><input type="search" data-guide-search placeholder={es?'Ej.: convertir unidades, limpiar texto…':'E.g. convert units, clean text…'} /></label>
        <label><span>{es?'Tema':'Topic'}</span><select data-guide-category><option value="">{es?'Todos los temas':'All topics'}</option>{categories.map((category)=><option value={category}>{categoryName(category)}</option>)}</select></label>
        <label><span>{es?'Tipo de ayuda':'Type of help'}</span><select data-guide-kind><option value="">{es?'Todos los tipos':'All types'}</option><option value="how-to">{es?'Paso a paso':'Step by step'}</option><option value="troubleshooting">{es?'Errores y soluciones':'Mistakes and fixes'}</option><option value="foundational">{es?'Guías fundamentales':'Foundational guides'}</option></select></label>
      </div>
      <p class="results" data-guide-results role="status" aria-live="polite"></p>
    </section>

    <section class="guide-grid" aria-label={es?'Todas las guías':'All guides'}>{guides.map((guide,index)=>{const c=guide.copy[lang];return <a href={getGuidePath(guide,lang)} data-guide-card data-category={guide.category} data-kind={guide.kind} data-index={index} data-search={`${c.title} ${c.description} ${categoryName(guide.category)}`.toLowerCase()}>
      <span>{categoryName(guide.category)} · {c.reading}</span><h2>{c.title}</h2><p>{c.description}</p><strong>{es?'Leer guía':'Read guide'} →</strong>
    </a>})}</section>
    <button class="btn btn-secondary load-more" type="button" data-load-more>{es?'Mostrar más guías':'Show more guides'}</button>

    <section class="guides-cta"><div><h2>{es?'¿Necesitas resolver la tarea ahora?':'Need to solve the task now?'}</h2><p>{es?'Abre el catálogo completo y filtra herramientas que funcionan localmente y sin subir datos.':'Open the complete directory and filter tools that work locally without uploading data.'}</p></div><a class="btn btn-primary" href={getLocalizedPath('/',lang)}>{es?'Ver todas las herramientas':'Browse all tools'}</a></section>
  </article>
</Layout>

<script>
  document.querySelectorAll('[data-guides-index]').forEach((root)=>{
    if(!(root instanceof HTMLElement))return;
    const search=root.querySelector('[data-guide-search]');const category=root.querySelector('[data-guide-category]');const kind=root.querySelector('[data-guide-kind]');const result=root.querySelector('[data-guide-results]');const more=root.querySelector('[data-load-more]');const cards=[...root.querySelectorAll('[data-guide-card]')];
    if(!(search instanceof HTMLInputElement)||!(category instanceof HTMLSelectElement)||!(kind instanceof HTMLSelectElement)||!(result instanceof HTMLElement)||!(more instanceof HTMLButtonElement))return;
    let limit=36;
    const update=()=>{const query=search.value.trim().toLocaleLowerCase();const matches=cards.filter((card)=>card instanceof HTMLElement&&(!query||card.dataset.search?.includes(query))&&(!category.value||card.dataset.category===category.value)&&(!kind.value||card.dataset.kind===kind.value));cards.forEach((card)=>{if(card instanceof HTMLElement)card.hidden=true});matches.slice(0,limit).forEach((card)=>{if(card instanceof HTMLElement)card.hidden=false});result.textContent=`${matches.length} ${document.documentElement.lang==='es'?'guías encontradas':'guides found'}`;more.hidden=matches.length<=limit;};
    search.addEventListener('input',()=>{limit=36;update()});category.addEventListener('change',()=>{limit=36;update()});kind.addEventListener('change',()=>{limit=36;update()});more.addEventListener('click',()=>{limit+=36;update()});update();
  });
</script>

<style>
  .guides-page{max-width:76rem;margin:auto}.guides-page>header{display:grid;justify-items:center;gap:1rem;padding:clamp(2.5rem,7vw,5rem) 0 2.5rem;text-align:center}.guides-page>header p{max-width:52rem;font-size:1.15rem}.topic-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem;margin-bottom:3rem}.topic-grid a{display:flex;min-height:7.5rem;flex-direction:column;justify-content:space-between;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:var(--color-surface);color:var(--color-text);text-decoration:none}.topic-grid a:hover{border-color:var(--color-primary)}.topic-grid span{color:var(--color-primary);font-size:.85rem;font-weight:850}.guide-controls{display:grid;gap:1rem;margin:0 0 1.2rem;padding:1.2rem;border:1px solid var(--color-border);border-radius:var(--radius-2xl);background:var(--color-surface)}.guide-controls h2{margin:0}.guide-controls p{margin:.35rem 0 0}.filters{display:grid;grid-template-columns:2fr 1fr 1fr;gap:.75rem}.filters label{display:grid;gap:.4rem}.results{min-height:1.3rem;color:var(--color-text-soft);font-size:.85rem;font-weight:800}.guide-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.guide-grid>a{display:flex;min-height:17rem;flex-direction:column;padding:clamp(1.2rem,3vw,1.6rem);border:1px solid var(--color-border);border-radius:var(--radius-2xl);background:var(--color-surface);color:inherit;text-decoration:none;box-shadow:var(--shadow-xs);transition:transform var(--transition-base),border-color var(--transition-base),box-shadow var(--transition-base)}.guide-grid>a:hover{transform:translateY(-3px);border-color:var(--color-primary);box-shadow:var(--shadow-md);color:inherit}.guide-grid span{color:var(--color-primary);font:900 .72rem var(--font-mono)}.guide-grid h2{margin:1rem 0 .7rem;font-size:clamp(1.25rem,2vw,1.55rem)}.guide-grid p{font-size:.92rem}.guide-grid strong{margin-top:auto;color:var(--color-primary)}.load-more{display:flex;margin:1.5rem auto}.guides-cta{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:3rem;padding:clamp(1.2rem,4vw,2rem);border-radius:var(--radius-2xl);background:var(--color-primary-soft)}.guides-cta h2{margin:0 0 .5rem}.guides-cta p{margin:0}
  @media(max-width:900px){.topic-grid,.guide-grid{grid-template-columns:repeat(2,1fr)}.filters{grid-template-columns:1fr 1fr}.filters label:first-child{grid-column:1/-1}}
  @media(max-width:620px){.guides-page>header{justify-items:start;text-align:left}.topic-grid,.guide-grid,.filters{grid-template-columns:1fr}.filters label:first-child{grid-column:auto}.guides-cta{align-items:stretch;flex-direction:column}.guide-grid>a{min-height:14rem}}
</style>
