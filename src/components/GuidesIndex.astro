---
import Layout from '../layouts/Layout.astro';import {guides} from '../data/guides';import type {Lang} from '../i18n/ui';const {lang}=Astro.props as {lang:Lang};const es=lang==='es';
---
<Layout title={es?'Guías de herramientas online, privacidad y SEO — Alon Tools':'Online tools, privacy and SEO guides — Alon Tools'} description={es?'Guías prácticas para trabajar con datos, imágenes, SEO y herramientas locales del navegador.':'Practical guides for working with data, images, SEO and local browser tools.'} lang={lang} path="/guides/" translated={true} pageType="collection">
  <article class="guides-page"><header><span class="eyebrow">{es?'Centro de recursos':'Resource center'}</span><h1>{es?'Guías prácticas para trabajar mejor en el navegador':'Practical guides for better browser workflows'}</h1><p>{es?'Aprende a convertir datos, optimizar imágenes, revisar el SEO técnico y proteger información sensible con procesos sencillos y herramientas gratuitas.':'Learn to convert data, optimize images, review technical SEO and protect sensitive information with simple workflows and free tools.'}</p></header><section class="guide-grid" aria-label={es?'Todas las guías':'All guides'}>{guides.map((guide,index)=>{const c=guide.copy[lang];return <a href={`${lang==='es'?'/es':''}/guides/${guide.slug}/`}><span>0{index+1} · {c.reading}</span><h2>{c.title}</h2><p>{c.description}</p><strong>{es?'Leer guía':'Read guide'} →</strong></a>})}</section><section class="guides-cta"><div><h2>{es?'¿Necesitas resolver una tarea ahora?':'Need to solve a task now?'}</h2><p>{es?'Explora el índice completo y filtra por categoría o por herramientas que funcionan sin conexión.':'Browse the complete directory and filter by category or tools that work offline.'}</p></div><a class="btn btn-primary" href={lang==='es'?'/es/':'/'}>{es?'Ver todas las herramientas':'Browse all tools'}</a></section></article>
</Layout>
<style>.guides-page{max-width:72rem;margin:auto}.guides-page>header{display:grid;justify-items:center;gap:1rem;padding:clamp(2.5rem,7vw,5rem) 0 2.5rem;text-align:center}.guides-page>header p{max-width:48rem;font-size:1.15rem}.guide-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.guide-grid>a{display:flex;min-height:17rem;flex-direction:column;padding:clamp(1.2rem,3vw,2rem);border:1px solid var(--color-border);border-radius:var(--radius-2xl);background:var(--color-surface);color:inherit;text-decoration:none;box-shadow:var(--shadow-xs);transition:transform var(--transition-base),border-color var(--transition-base),box-shadow var(--transition-base)}.guide-grid>a:hover{transform:translateY(-3px);border-color:var(--color-primary);box-shadow:var(--shadow-md);color:inherit}.guide-grid span{color:var(--color-primary);font:900 .76rem var(--font-mono)}.guide-grid h2{margin:1rem 0 .7rem;font-size:clamp(1.45rem,3vw,2rem)}.guide-grid strong{margin-top:auto;color:var(--color-primary)}.guides-cta{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:3rem;padding:clamp(1.2rem,4vw,2rem);border-radius:var(--radius-2xl);background:var(--color-primary-soft)}.guides-cta h2{margin:0 0 .5rem}.guides-cta p{margin:0}@media(max-width:680px){.guides-page>header{justify-items:start;text-align:left}.guide-grid{grid-template-columns:1fr}.guides-cta{align-items:stretch;flex-direction:column}}</style>
