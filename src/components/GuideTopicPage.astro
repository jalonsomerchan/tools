---
import Layout from '../layouts/Layout.astro';
import {guides,getGuidePath,type GuideCategoryId} from '../data/guides';
import {getLocalizedPath,type Lang} from '../i18n/ui';
import {toolCategoryLabels} from '../data/tools';
const {lang,category}=Astro.props as {lang:Lang;category:GuideCategoryId};const es=lang==='es';
const items=guides.filter((guide)=>guide.category===category);
const title=category==='foundations'?(es?'Fundamentos para usar herramientas online':'Foundations for using online tools'):toolCategoryLabels[category][lang];
const description=es?`Guías prácticas de ${title.toLowerCase()} con procesos paso a paso, ejemplos reproducibles y soluciones para los errores más habituales.`:`Practical ${title.toLowerCase()} guides with step-by-step workflows, reproducible examples and fixes for the most common mistakes.`;
---
<Layout title={`${title}: ${es?'guías prácticas':'practical guides'} — Alon Tools`} description={description} lang={lang} path={`/guides/topics/${category}/`} translated={true} pageType="collection" breadcrumbs={[{name:es?'Herramientas':'Tools',path:getLocalizedPath('/',lang)},{name:es?'Guías':'Guides',path:getLocalizedPath('/guides/',lang)},{name:title,path:getLocalizedPath(`/guides/topics/${category}/`,lang)}]}>
  <article class="topic-page">
    <nav class="breadcrumb" aria-label={es?'Ruta de navegación':'Breadcrumb'}><a href={getLocalizedPath('/guides/',lang)}>{es?'Guías':'Guides'}</a><span>/</span><span>{title}</span></nav>
    <header><span class="eyebrow">{items.length} {es?'guías':'guides'}</span><h1>{title}: {es?'procesos, ejemplos y soluciones':'workflows, examples and fixes'}</h1><p>{description}</p></header>
    <div class="intent-links"><a href="#step-by-step"><strong>{es?'Paso a paso':'Step by step'}</strong><span>{es?'Aprende a utilizar cada herramienta con sus campos y ejemplo real.':'Learn each tool with its actual fields and example.'}</span></a><a href="#troubleshooting"><strong>{es?'Errores y soluciones':'Mistakes and fixes'}</strong><span>{es?'Comprueba unidades, formatos y resultados inesperados.':'Check units, formats and unexpected results.'}</span></a></div>
    {(['how-to','troubleshooting','foundational'] as const).map((kind)=>{const group=items.filter((guide)=>guide.kind===kind);if(!group.length)return null;const heading=kind==='how-to'?(es?'Guías paso a paso':'Step-by-step guides'):kind==='troubleshooting'?(es?'Errores comunes y soluciones':'Common mistakes and fixes'):(es?'Guías fundamentales':'Foundational guides');return <section id={kind==='how-to'?'step-by-step':kind}><h2>{heading}</h2><div class="guide-list">{group.map((guide)=>{const c=guide.copy[lang];return <a href={getGuidePath(guide,lang)}><span>{c.reading}</span><h3>{c.title}</h3><p>{c.description}</p><strong>{es?'Leer guía':'Read guide'} →</strong></a>})}</div></section>})}
    <aside class="back"><div><h2>{es?'Explora todos los temas':'Explore every topic'}</h2><p>{es?'Consulta el índice completo para combinar guías de distintas categorías.':'Use the complete index to combine guides from different categories.'}</p></div><a class="btn btn-primary" href={getLocalizedPath('/guides/',lang)}>{es?'Ver todas las guías':'Browse all guides'}</a></aside>
  </article>
</Layout>
<style>
  .topic-page{max-width:76rem;margin:auto}.breadcrumb{display:flex;gap:.5rem;padding-top:1rem;color:var(--color-text-soft);font-size:.8rem;font-weight:800}.breadcrumb a{color:var(--color-text-muted);text-decoration:none}.topic-page>header{display:grid;justify-items:start;gap:1rem;padding:clamp(2.5rem,7vw,5rem) 0 2.5rem}.topic-page>header p{max-width:52rem;font-size:1.15rem}.intent-links{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.intent-links a{display:grid;gap:.5rem;padding:1.2rem;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:var(--color-primary-soft);color:var(--color-text);text-decoration:none}.intent-links span{color:var(--color-text-muted)}.topic-page section{scroll-margin-top:5rem}.guide-list{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.guide-list>a{display:flex;min-height:15rem;flex-direction:column;padding:1.2rem;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:var(--color-surface);color:inherit;text-decoration:none}.guide-list>a:hover{border-color:var(--color-primary);box-shadow:var(--shadow-sm)}.guide-list span{color:var(--color-primary);font-size:.75rem;font-weight:900}.guide-list h3{margin:.8rem 0}.guide-list p{font-size:.9rem}.guide-list strong{margin-top:auto;color:var(--color-primary)}.back{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:3rem;padding:1.4rem;border-radius:var(--radius-2xl);background:var(--color-primary-soft)}.back h2{margin:0 0 .5rem}.back p{margin:0}@media(max-width:850px){.guide-list{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.intent-links,.guide-list{grid-template-columns:1fr}.back{align-items:stretch;flex-direction:column}}
</style>
