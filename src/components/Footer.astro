---
const { lang = 'en' } = Astro.props;
---

<footer class="site-footer">
  <div class="page-shell footer-inner">
    <div>
      <strong>Alon Tools</strong>
      <p>{lang === 'es' ? 'Herramientas rápidas, privadas y ligeras creadas con Astro.' : 'Fast, private and lightweight tools built with Astro.'}</p>
    </div>

    <nav aria-label={lang === 'es' ? 'Enlaces del pie' : 'Footer links'}>
      <a href={lang === 'es' ? '/es/' : '/'}>{lang === 'es' ? 'Inicio' : 'Home'}</a>
      <a href="/json-viewer/">JSON</a>
      <a href="/image-compressor/">{lang === 'es' ? 'Imágenes' : 'Images'}</a>
      <a href="/curl-builder/">cURL</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-12) 0 var(--space-16);
    color: var(--color-text-soft);
    font-size: .875rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  strong {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-text);
    font-weight: 950;
    letter-spacing: -.04em;
  }

  p {
    max-width: 46ch;
    margin: 0;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  a {
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    padding: .45rem .7rem;
    text-decoration: none;
    font-weight: 900;
    transition: background var(--transition-base), color var(--transition-base), transform var(--transition-base);
  }

  a:hover {
    background: var(--color-surface-soft);
    color: var(--color-text);
    transform: translateY(-1px);
  }

  @media (max-width: 700px) {
    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      justify-content: flex-start;
    }
  }
</style>
