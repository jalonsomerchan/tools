---
import { getLocalizedPath, useTranslations } from '../i18n/ui';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<footer class="site-footer">
  <div class="page-shell footer-inner">
    <div>
      <strong>Alon Tools</strong>
      <p>{t('footer.description')}</p>
    </div>

    <nav aria-label={t('footer.links')}>
      <a href={getLocalizedPath('/', lang)}>{t('nav.tools')}</a>
      <a href={getLocalizedPath('/tools/development/', lang)}>{lang === 'es' ? 'Desarrollo' : 'Development'}</a>
      <a href={getLocalizedPath('/tools/images/', lang)}>{t('nav.images')}</a>
      <a href={getLocalizedPath('/tools/writing/', lang)}>{lang === 'es' ? 'Texto' : 'Writing'}</a>
      <a href={getLocalizedPath('/guides/', lang)}>{t('nav.guides')}</a>
    </nav>
  </div>
</footer>

<script is:inline>
  (() => {
    const isJsonViewer = /\/json-viewer\/?$/.test(window.location.pathname.replace(/^\/es/, ''));
    if (!isJsonViewer) return;

    const icons = {
      pasteBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5h6M9 3h6a2 2 0 0 1 2 2v1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h1V5a2 2 0 0 1 2-2Z"/><path d="M8 6h8v2H8z"/></svg>',
      copyInputBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"/></svg>',
      selectAllBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>',
      formatBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h10M4 17h16"/><path d="m17 10 3 2-3 2"/></svg>',
      clearBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M6 6l1 14h10l1-14"/><path d="M10 11v5M14 11v5"/></svg>',
      sampleBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4z"/><path d="M8 8h8v8H8z"/><path d="M10 2v4M14 2v4M10 18v4M14 18v4M2 10h4M2 14h4M18 10h4M18 14h4"/></svg>',
      validateBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>',
      minifyBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3v6H2"/><path d="M16 21v-6h6"/><path d="M2 9l6-6"/><path d="m22 15-6 6"/></svg>',
      expandAllBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"/><path d="M3 3l7 7M21 3l-7 7M3 21l7-7M21 21l-7-7"/></svg>',
      collapseAllBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 3v7H3M14 3v7h7M10 21v-7H3M14 21v-7h7"/></svg>',
      copyBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1"/></svg>',
      downloadBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>',
      textViewBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>',
      treeViewBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3v18"/><path d="M6 7h6"/><path d="M6 17h6"/><rect x="12" y="5" width="7" height="4" rx="1"/><rect x="12" y="15" width="7" height="4" rx="1"/></svg>',
      tableViewBtn: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16M15 4v16"/></svg>'
    };

    const enhance = () => {
      Object.entries(icons).forEach(([id, icon]) => {
        const button = document.getElementById(id);
        if (!button || button.dataset.iconified === 'true') return;
        const label = button.textContent.trim() || button.getAttribute('aria-label') || id;
        button.dataset.iconified = 'true';
        button.dataset.tooltip = label;
        button.classList.add('icon-button');
        button.setAttribute('aria-label', label);
        button.setAttribute('title', label);
        button.innerHTML = `${icon}<span class="sr-only">${label}</span>`;
      });
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', enhance);
    else enhance();
  })();
</script>

<style is:global>
  main.page-shell > section:first-child {
    padding-top: clamp(1.25rem, 2.75vw, 2.25rem) !important;
  }

  main.page-shell > section:first-child > h1,
  main.page-shell .hero > h1 {
    margin-top: 0 !important;
  }

  main.page-shell .hero,
  main.page-shell .home-hero {
    gap: var(--space-3) !important;
    padding-top: clamp(1.25rem, 2.75vw, 2.25rem) !important;
    padding-bottom: clamp(1rem, 2vw, 1.75rem) !important;
  }

  .sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .json-tool .icon-button {
    position: relative;
    width: 2.35rem;
    min-width: 2.35rem;
    min-height: 2.35rem;
    padding: 0 !important;
    display: inline-grid !important;
    place-items: center;
    border-radius: .7rem !important;
  }

  .json-tool .icon-button svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .json-tool .icon-button[data-tooltip]::after {
    content: attr(data-tooltip);
    position: absolute;
    z-index: 70;
    left: 50%;
    top: calc(100% + .55rem);
    transform: translate(-50%, -.18rem);
    opacity: 0;
    pointer-events: none;
    width: max-content;
    max-width: 13rem;
    padding: .42rem .6rem;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: .65rem;
    background: #020617;
    color: #f8fafc;
    box-shadow: 0 14px 34px rgba(2,6,23,.34);
    font-family: var(--font-sans);
    font-size: .78rem;
    font-weight: 900;
    line-height: 1.15;
    white-space: nowrap;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .json-tool .icon-button[data-tooltip]::before {
    content: '';
    position: absolute;
    z-index: 71;
    left: 50%;
    top: calc(100% + .28rem);
    width: .55rem;
    height: .55rem;
    border-left: 1px solid rgba(255,255,255,.12);
    border-top: 1px solid rgba(255,255,255,.12);
    background: #020617;
    transform: translateX(-50%) rotate(45deg);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-fast);
  }

  .json-tool .icon-button[data-tooltip]:hover::after,
  .json-tool .icon-button[data-tooltip]:focus-visible::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .json-tool .icon-button[data-tooltip]:hover::before,
  .json-tool .icon-button[data-tooltip]:focus-visible::before {
    opacity: 1;
  }

  .json-tool .view-tab.icon-button {
    opacity: .78;
  }

  .json-tool .view-tab.icon-button.active {
    opacity: 1;
  }

  @media (max-width: 760px) {
    main.page-shell > section:first-child,
    main.page-shell .hero,
    main.page-shell .home-hero {
      padding-top: var(--space-5) !important;
    }
  }
</style>

<style>
  .site-footer {
    padding: var(--space-12) 0 var(--space-16);
    color: var(--color-text-soft);
    font-size: .875rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  strong {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-text);
    font-weight: 950;
    letter-spacing: -.04em;
  }

  p {
    max-width: 46ch;
    margin: 0;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  a {
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    padding: .45rem .7rem;
    text-decoration: none;
    font-weight: 900;
    transition: background var(--transition-base), color var(--transition-base), transform var(--transition-base);
  }

  a:hover {
    background: var(--color-surface-soft);
    color: var(--color-text);
    transform: translateY(-1px);
  }

  @media (max-width: 700px) {
    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      justify-content: flex-start;
    }
  }
</style>
