---
import { getLocalizedPath, useTranslations } from '../i18n/ui';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<footer class="site-footer">
  <div class="page-shell footer-inner">
    <div>
      <strong>Alon Tools</strong>
      <p>{t('footer.description')}</p>
    </div>

    <nav aria-label={t('footer.links')}>
      <a href={getLocalizedPath('/', lang)}>{t('nav.home')}</a>
      <a href={getLocalizedPath('/json-viewer/', lang)}>{t('nav.json')}</a>
      <a href={getLocalizedPath('/image-compressor/', lang)}>{t('nav.images')}</a>
      <a href={getLocalizedPath('/curl-builder/', lang)}>{t('nav.curl')}</a>
    </nav>
  </div>
</footer>

<style is:global>
  main.page-shell > section:first-child {
    padding-top: clamp(1.25rem, 2.75vw, 2.25rem) !important;
  }

  main.page-shell > section:first-child > .eyebrow,
  main.page-shell .hero > .eyebrow,
  main.page-shell .eyebrow {
    display: none !important;
  }

  main.page-shell > section:first-child > h1,
  main.page-shell .hero > h1 {
    margin-top: 0 !important;
  }

  main.page-shell .hero,
  main.page-shell .home-hero {
    gap: var(--space-3) !important;
    padding-top: clamp(1.25rem, 2.75vw, 2.25rem) !important;
    padding-bottom: clamp(1rem, 2vw, 1.75rem) !important;
  }

  @media (max-width: 760px) {
    main.page-shell > section:first-child,
    main.page-shell .hero,
    main.page-shell .home-hero {
      padding-top: var(--space-5) !important;
    }
  }
</style>

<style>
  .site-footer {
    padding: var(--space-12) 0 var(--space-16);
    color: var(--color-text-soft);
    font-size: .875rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  strong {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-text);
    font-weight: 950;
    letter-spacing: -.04em;
  }

  p {
    max-width: 46ch;
    margin: 0;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-2);
  }

  a {
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    padding: .45rem .7rem;
    text-decoration: none;
    font-weight: 900;
    transition: background var(--transition-base), color var(--transition-base), transform var(--transition-base);
  }

  a:hover {
    background: var(--color-surface-soft);
    color: var(--color-text);
    transform: translateY(-1px);
  }

  @media (max-width: 700px) {
    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      justify-content: flex-start;
    }
  }
</style>
