---
import LanguageSwitcher from './LanguageSwitcher.astro';

const {
  lang = 'en',
  path = '/'
} = Astro.props;

const isEs = lang === 'es';
---

<header>
  <div class="page-shell header-inner">
    <a href={isEs ? '/es/' : '/'} class="brand">
      <span class="brand-mark">A</span>
      <span>Alon Tools</span>
    </a>

    <div class="header-right">
      <nav>
        <a href={isEs ? '/es/' : '/'}>{isEs ? 'Inicio' : 'Home'}</a>
        <a href={isEs ? '/es/json-viewer/' : '/json-viewer/'}>JSON</a>
        <a href={isEs ? '/es/image-compressor/' : '/image-compressor/'}>{isEs ? 'Imágenes' : 'Images'}</a>
        <a href={isEs ? '/es/curl-builder/' : '/curl-builder/'}>cURL</a>
      </nav>

      <LanguageSwitcher current={lang} path={path} />
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(20px);
    background: rgba(2, 6, 23, .7);
    border-bottom: 1px solid rgba(148,163,184,.12);
  }

  .header-inner {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .header-right {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: .8rem;
    color: white;
    text-decoration: none;
    font-weight: 700;
  }

  .brand-mark {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--primary);
    color: black;
    font-weight: 900;
  }

  nav {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: white;
  }

  @media (max-width: 700px) {
    .header-inner {
      height: auto;
      min-height: 72px;
      padding: .9rem 0;
      align-items: flex-start;
      flex-direction: column;
      gap: .8rem;
    }

    .header-right {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
