---
import { getLocalizedPath, useTranslations } from '../i18n/ui';

const { lang = 'en', path = '/' } = Astro.props;
const t = useTranslations(lang);
const pathWithoutLocale = String(path).replace(/^\/es(?=\/|$)/, '') || '/';
const currentPath = pathWithoutLocale.startsWith('/') ? pathWithoutLocale : `/${pathWithoutLocale}`;
const enPath = getLocalizedPath(currentPath, 'en');
const esPath = getLocalizedPath(currentPath, 'es');
---

<header>
  <div class="page-shell header-inner">
    <a href={getLocalizedPath('/', lang)} class="brand">
      <span class="brand-mark">A</span>
      <span>Alon Tools</span>
    </a>

    <div class="header-right">
      <nav>
        <a href={getLocalizedPath('/', lang)}>{t('nav.home')}</a>
        <a href="/json-viewer/">JSON</a>
        <a href="/image-compressor/">{t('nav.images')}</a>
        <a href="/curl-builder/">{t('nav.curl')}</a>
      </nav>

      <div class="language-switcher" aria-label="Language selector">
        <a href={enPath} class={lang === 'en' ? 'active' : ''}>EN</a>
        <a href={esPath} class={lang === 'es' ? 'active' : ''}>ES</a>
      </div>
    </div>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(20px);
    background: rgba(2, 6, 23, .7);
    border-bottom: 1px solid rgba(148,163,184,.12);
  }

  .header-inner {
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: .8rem;
    color: white;
    text-decoration: none;
    font-weight: 700;
  }

  .brand-mark {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--primary);
    color: black;
    font-weight: 900;
  }

  .header-right,
  nav,
  .language-switcher {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  nav a,
  .language-switcher a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover,
  .language-switcher a:hover {
    color: white;
  }

  .language-switcher {
    gap: .4rem;
  }

  .language-switcher a {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: .35rem .65rem;
    font-size: .85rem;
  }

  .language-switcher a.active {
    background: var(--primary);
    color: black;
    border-color: transparent;
    font-weight: 700;
  }

  @media (max-width: 700px) {
    .header-inner {
      height: auto;
      min-height: 72px;
      padding: .9rem 0;
      align-items: flex-start;
      flex-direction: column;
      gap: .8rem;
    }

    .header-right {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
