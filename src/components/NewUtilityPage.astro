---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';
import { getNewUtility } from '../data/new-utilities';

const lang = getLangFromUrl(Astro.url);
const utility = getNewUtility(Astro.props.slug);
if (!utility) throw new Error(`Unknown utility: ${Astro.props.slug}`);
const t = utility.copy[lang];
const es = lang === 'es';
const kind = utility.kind;
const ui = {
  copy: es ? 'Copiar resultado' : 'Copy result', clear: es ? 'Limpiar' : 'Clear',
  ready: es ? 'Listo. Todo se procesa localmente.' : 'Ready. Everything is processed locally.',
  copied: es ? 'Resultado copiado.' : 'Result copied.', empty: es ? 'Introduce algún dato para continuar.' : 'Enter some data to continue.',
  done: es ? 'Resultado actualizado.' : 'Result updated.', invalid: es ? 'Revisa los valores introducidos.' : 'Check the entered values.'
};
const isText = !['chmod-calculator','cron-expression-builder','percentage-calculator','aspect-ratio-calculator'].includes(kind);
---

<Layout title={t.title} description={t.description} lang={lang} path={`/${utility.slug}/`} translated={true}>
  <article class="utility-page" data-kind={kind}>
    <header class="utility-hero">
      <span class="eyebrow">{t.eyebrow}</span><h1>{t.title}</h1><p>{t.intro}</p>
      <div class="trust-row"><span>✓ 100% local</span><span>✓ {es ? 'Sin registros' : 'No sign-up'}</span><span>✓ {es ? 'Adaptada a móvil' : 'Mobile friendly'}</span></div>
    </header>

    <section class="workbench" aria-labelledby="work-title">
      <div class="section-heading"><div><b>01</b><h2 id="work-title">{t.inputLabel}</h2></div><button class="btn quiet" id="example" type="button">{t.example}</button></div>

      {kind === 'text-case-converter' && <label class="field compact">{es ? 'Formato' : 'Format'}<select id="mode"><option value="upper">{es ? 'MAYÚSCULAS' : 'UPPERCASE'}</option><option value="lower">{es ? 'minúsculas' : 'lowercase'}</option><option value="title">{es ? 'Tipo Título' : 'Title Case'}</option><option value="sentence">{es ? 'Tipo oración' : 'Sentence case'}</option><option value="camel">camelCase</option><option value="snake">snake_case</option></select></label>}
      {kind === 'slug-generator' && <div class="options"><label class="field compact">{es ? 'Separador' : 'Separator'}<select id="separator"><option value="-">-</option><option value="_">_</option></select></label><label class="check"><input id="lowercase" type="checkbox" checked /> {es ? 'Minúsculas' : 'Lowercase'}</label></div>}
      {kind === 'list-cleaner' && <div class="options checks"><label class="check"><input id="trim" type="checkbox" checked /> {es ? 'Recortar espacios' : 'Trim spaces'}</label><label class="check"><input id="blanks" type="checkbox" checked /> {es ? 'Quitar vacíos' : 'Remove blanks'}</label><label class="check"><input id="duplicates" type="checkbox" checked /> {es ? 'Quitar duplicados' : 'Remove duplicates'}</label><label class="check"><input id="sort" type="checkbox" /> {es ? 'Ordenar A–Z' : 'Sort A–Z'}</label></div>}
      {kind === 'number-base-converter' && <label class="field compact">{es ? 'Base de entrada' : 'Input base'}<select id="base"><option value="10">Decimal (10)</option><option value="2">{es ? 'Binaria' : 'Binary'} (2)</option><option value="8">Octal (8)</option><option value="16">Hexadecimal (16)</option></select></label>}

      {kind === 'chmod-calculator' && <fieldset class="permission-grid"><legend class="sr-only">{t.inputLabel}</legend>{[['owner',es?'Propietario':'Owner'],['group',es?'Grupo':'Group'],['other',es?'Otros':'Others']].map(([group,name]) => <div class="permission"><strong>{name}</strong><label><input data-permission={group} value="4" type="checkbox" /> {es?'Lectura':'Read'}</label><label><input data-permission={group} value="2" type="checkbox" /> {es?'Escritura':'Write'}</label><label><input data-permission={group} value="1" type="checkbox" /> {es?'Ejecución':'Execute'}</label></div>)}</fieldset>}
      {kind === 'cron-expression-builder' && <div class="form-grid"><label class="field">{es?'Frecuencia':'Frequency'}<select id="schedule"><option value="minutes">{es?'Cada N minutos':'Every N minutes'}</option><option value="hourly">{es?'Cada hora':'Hourly'}</option><option value="daily">{es?'Cada día':'Daily'}</option><option value="weekday">{es?'Lunes a viernes':'Monday to Friday'}</option><option value="weekly">{es?'Cada semana':'Weekly'}</option><option value="monthly">{es?'Cada mes':'Monthly'}</option></select></label><label class="field">{es?'Intervalo (minutos)':'Interval (minutes)'}<input id="interval" type="number" min="1" max="59" value="15" /></label><label class="field">{es?'Hora':'Time'}<input id="cronTime" type="time" value="09:00" /></label><label class="field">{es?'Día semanal':'Weekday'}<select id="cronDay"><option value="1">{es?'Lunes':'Monday'}</option><option value="2">{es?'Martes':'Tuesday'}</option><option value="3">{es?'Miércoles':'Wednesday'}</option><option value="4">{es?'Jueves':'Thursday'}</option><option value="5">{es?'Viernes':'Friday'}</option><option value="6">{es?'Sábado':'Saturday'}</option><option value="0">{es?'Domingo':'Sunday'}</option></select></label></div>}
      {kind === 'percentage-calculator' && <div class="form-grid"><label class="field wide">{es?'Cálculo':'Calculation'}<select id="calculation"><option value="of">{es?'¿Cuánto es A% de B?':'What is A% of B?'}</option><option value="ratio">{es?'¿Qué porcentaje es A de B?':'A is what percent of B?'}</option><option value="change">{es?'Variación de A a B':'Change from A to B'}</option><option value="increase">{es?'Aumentar A un B%':'Increase A by B%'}</option><option value="discount">{es?'Descontar un B% de A':'Discount B% from A'}</option></select></label><label class="field">A<input id="valueA" type="number" step="any" value="20" /></label><label class="field">B<input id="valueB" type="number" step="any" value="150" /></label></div>}
      {kind === 'aspect-ratio-calculator' && <div class="form-grid"><label class="field">{es?'Ancho original':'Original width'}<input id="originalWidth" type="number" min="1" value="1920" /></label><label class="field">{es?'Alto original':'Original height'}<input id="originalHeight" type="number" min="1" value="1080" /></label><label class="field">{es?'Nuevo ancho':'Target width'}<input id="targetWidth" type="number" min="1" value="1280" /></label><label class="field">{es?'Nuevo alto':'Target height'}<input id="targetHeight" type="number" min="1" placeholder={es?'Automático':'Automatic'} /></label></div>}

      {isText && <label class="field"><span class="sr-only">{t.inputLabel}</span><textarea id="input" placeholder={t.inputPlaceholder} spellcheck={kind !== 'json-to-typescript'}></textarea></label>}
      <div class="actions"><button class="btn primary" id="primary" type="button">{t.primaryAction}</button>{t.secondaryAction && <button class="btn secondary" id="secondary" type="button">{t.secondaryAction}</button>}<button class="btn quiet" id="clear" type="button">{ui.clear}</button></div>

      <section class="result" aria-labelledby="result-title"><div class="section-heading"><div><b>02</b><h2 id="result-title">{t.outputLabel}</h2></div><button class="btn secondary" id="copy" type="button">{ui.copy}</button></div><label class="sr-only" for="output">{t.outputLabel}</label><textarea id="output" readonly placeholder={t.outputPlaceholder}></textarea><p id="status" class="status" role="status" aria-live="polite">{ui.ready}</p></section>
    </section>
    <section class="help"><b>03</b><div><h2>{t.helpTitle}</h2><p>{t.helpText}</p></div></section>
  </article>

  <script define:vars={{ kind, ui, exampleValue: t.exampleValue, isText }}>
    const q = (id) => document.getElementById(id); const root = document.querySelector('[data-kind]');
    const input = q('input'); const output = q('output'); const status = q('status');
    const message = (text, error = false) => { status.textContent = text; status.dataset.state = error ? 'error' : 'ok'; };
    const tokens = (value) => value.trim().normalize('NFKD').replace(/[\u0300-\u036f]/g,'').split(/[^\p{L}\p{N}]+/u).filter(Boolean);
    const typeName = (key) => tokens(key).map((w) => w[0].toUpperCase()+w.slice(1)).join('') || 'Item';
    const infer = (value, name, interfaces) => {
      if (value === null) return 'null';
      if (Array.isArray(value)) { const types=[...new Set(value.map((v)=>infer(v,`${name}Item`,interfaces)))]; return `(${types.join(' | ')||'unknown'})[]`; }
      if (typeof value === 'object') { const n=typeName(name); const fields=Object.entries(value).map(([k,v])=>`  ${/^[A-Za-z_$][\w$]*$/.test(k)?k:JSON.stringify(k)}: ${infer(v,k,interfaces)};`).join('\n'); interfaces.unshift(`export interface ${n} {\n${fields}\n}`); return n; }
      return typeof value;
    };
    const bigint = (raw, base) => { let value=raw.trim().replaceAll('_',''); const neg=value.startsWith('-'); if(neg)value=value.slice(1); value=value.replace(/^0[xob]/i,''); const valid=base===2?'01':base===8?'0-7':base===10?'0-9':'0-9a-f'; if(!value||!new RegExp(`^[${valid}]+$`,'i').test(value))throw 0; let n=0n; for(const c of value.toLowerCase())n=n*BigInt(base)+BigInt(parseInt(c,base)); return neg?-n:n; };
    const chmod = () => { const groups=['owner','group','other']; const nums=groups.map(g=>[...document.querySelectorAll(`[data-permission="${g}"]:checked`)].reduce((s,x)=>s+Number(x.value),0)); const symbols=groups.map(g=>{const v=new Set([...document.querySelectorAll(`[data-permission="${g}"]:checked`)].map(x=>x.value));return `${v.has('4')?'r':'-'}${v.has('2')?'w':'-'}${v.has('1')?'x':'-'}`}).join(''); output.value=`chmod ${nums.join('')} file\n${nums.join('')} · ${symbols}`; };
    const cron = () => { const s=q('schedule').value,[h,m]=q('cronTime').value.split(':').map(Number),d=q('cronDay').value,i=Math.min(59,Math.max(1,Number(q('interval').value)||1)); output.value={minutes:`*/${i} * * * *`,hourly:`${m} * * * *`,daily:`${m} ${h} * * *`,weekday:`${m} ${h} * * 1-5`,weekly:`${m} ${h} * * ${d}`,monthly:`${m} ${h} 1 * *`}[s]; };
    const percent = () => { const mode=q('calculation').value,a=Number(q('valueA').value),b=Number(q('valueB').value); if(!Number.isFinite(a)||!Number.isFinite(b)||(mode==='ratio'&&b===0)||(mode==='change'&&a===0))throw 0; const f=n=>new Intl.NumberFormat(undefined,{maximumFractionDigits:6}).format(n); const r={of:[a*b/100,`${a}% × ${b}`],ratio:[a/b*100,`${a} ÷ ${b} × 100`],change:[(b-a)/Math.abs(a)*100,`(${b} − ${a}) ÷ |${a}| × 100`],increase:[a*(1+b/100),`${a} × (1 + ${b}/100)`],discount:[a*(1-b/100),`${a} × (1 − ${b}/100)`]}[mode]; output.value=`${f(r[0])}${['ratio','change'].includes(mode)?'%':''}\n${r[1]}`; };
    const ratio = (height = false) => { const ow=Number(q('originalWidth').value),oh=Number(q('originalHeight').value); if(!(ow>0&&oh>0))throw 0; if(height&&Number(q('targetHeight').value)>0)q('targetWidth').value=String(Math.round(Number(q('targetHeight').value)*ow/oh)); else q('targetHeight').value=String(Math.round((Number(q('targetWidth').value)||ow)*oh/ow)); const gcd=(a,b)=>b?gcd(b,a%b):a,g=gcd(Math.round(ow),Math.round(oh)); output.value=`${q('targetWidth').value} × ${q('targetHeight').value}\n${Math.round(ow/g)}:${Math.round(oh/g)}`; };
    const run = (action='primary') => { try {
      if(kind==='chmod-calculator')chmod(); else if(kind==='cron-expression-builder')cron(); else if(kind==='percentage-calculator')percent(); else if(kind==='aspect-ratio-calculator')ratio(); else {
        if(!input.value.trim()){output.value='';return message(ui.empty,true)}
        if(kind==='text-case-converter'){const mode=q('mode').value,w=tokens(input.value); output.value=mode==='upper'?input.value.toLocaleUpperCase():mode==='lower'?input.value.toLocaleLowerCase():mode==='title'?input.value.toLocaleLowerCase().replace(/(^|[\s\-])([\p{L}])/gu,(_,a,b)=>a+b.toLocaleUpperCase()):mode==='sentence'?input.value.toLocaleLowerCase().replace(/(^\s*|[.!?]\s+)([\p{L}])/gu,(_,a,b)=>a+b.toLocaleUpperCase()):mode==='camel'?w.map((x,i)=>i?x[0].toUpperCase()+x.slice(1).toLowerCase():x.toLowerCase()).join(''):w.map(x=>x.toLowerCase()).join('_');}
        if(kind==='slug-generator'){const s=q('separator').value; let v=input.value.normalize('NFKD').replace(/[\u0300-\u036f]/g,'').replace(/[^\p{L}\p{N}]+/gu,s); v=v.split(s).filter(Boolean).join(s); output.value=q('lowercase').checked?v.toLocaleLowerCase():v;}
        if(kind==='list-cleaner'){const before=input.value.split(/\r?\n/);let lines=[...before];if(q('trim').checked)lines=lines.map(x=>x.trim());if(q('blanks').checked)lines=lines.filter(Boolean);if(q('duplicates').checked){const seen=new Set();lines=lines.filter(x=>{const k=x.toLocaleLowerCase();if(seen.has(k))return false;seen.add(k);return true})}if(q('sort').checked)lines.sort((a,b)=>a.localeCompare(b,undefined,{sensitivity:'base'}));output.value=lines.join('\n');return message(`${before.length} → ${lines.length}`)}
        if(kind==='html-entities')output.value=action==='secondary'?(()=>{const el=document.createElement('textarea');el.innerHTML=input.value;return el.value})():input.value.replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#39;');
        if(kind==='json-to-typescript'){const data=JSON.parse(input.value),interfaces=[],rootType=infer(data,'Root',interfaces);output.value=typeof data==='object'&&data!==null&&!Array.isArray(data)?interfaces.join('\n\n'):`${interfaces.join('\n\n')}${interfaces.length?'\n\n':''}export type Root = ${rootType};`;}
        if(kind==='number-base-converter'){const n=bigint(input.value,Number(q('base').value));output.value=`BIN  ${n.toString(2)}\nOCT  ${n.toString(8)}\nDEC  ${n}\nHEX  ${n.toString(16).toUpperCase()}`;}
      } message(ui.done);
    } catch { output.value=''; message(ui.invalid,true); } };
    q('primary').addEventListener('click',()=>run()); q('secondary')?.addEventListener('click',()=>run('secondary'));
    q('example').addEventListener('click',()=>{if(input)input.value=exampleValue;if(kind==='chmod-calculator')document.querySelectorAll('[data-permission]').forEach((x,i)=>x.checked=[0,1,2,3,5,6,8].includes(i));if(kind==='cron-expression-builder'){q('schedule').value='weekday';q('cronTime').value='09:00'}if(kind==='aspect-ratio-calculator'){q('originalWidth').value=1920;q('originalHeight').value=1080;q('targetWidth').value=1280}run()});
    q('clear').addEventListener('click',()=>{root.querySelectorAll('textarea').forEach(x=>x.value='');status.textContent=ui.ready;delete status.dataset.state;input?.focus()});
    q('copy').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(output.value);message(ui.copied)}catch{message(ui.invalid,true)}});
    root.querySelectorAll('select,input[type="checkbox"]').forEach(x=>x.addEventListener('change',()=>run()));q('targetWidth')?.addEventListener('input',()=>{try{ratio()}catch{message(ui.invalid,true)}});q('targetHeight')?.addEventListener('input',()=>{try{ratio(true)}catch{message(ui.invalid,true)}});
    let liveTimer; const scheduleRun=()=>{clearTimeout(liveTimer);liveTimer=setTimeout(()=>run(),300)};
    input?.addEventListener('input',scheduleRun);root.querySelectorAll('input[type="number"]:not(#targetWidth):not(#targetHeight)').forEach(x=>x.addEventListener('input',scheduleRun));
    root.addEventListener('keydown',(event)=>{if((event.metaKey||event.ctrlKey)&&event.key==='Enter'){event.preventDefault();run()}});
    if(!isText)run();
  </script>
</Layout>

<style>
  .utility-page{width:min(100%,68rem);margin:auto}.utility-hero{display:grid;justify-items:center;padding:clamp(2.5rem,7vw,5.5rem) 0 clamp(1.5rem,4vw,3rem);text-align:center}.utility-hero h1{margin:.75rem auto 0}.utility-hero>p{max-width:46rem;margin:1rem auto 0;font-size:clamp(1rem,2vw,1.18rem)}.trust-row{display:flex;flex-wrap:wrap;justify-content:center;gap:.5rem;margin-top:1rem}.trust-row span{padding:.4rem .65rem;border:1px solid color-mix(in srgb,var(--color-success) 30%,var(--color-border));border-radius:var(--radius-full);background:var(--color-success-soft);color:var(--color-success);font-size:.78rem;font-weight:850}.workbench{padding:clamp(1rem,3vw,2rem);border:1px solid var(--color-border);border-radius:var(--radius-2xl);background:var(--color-surface);box-shadow:var(--shadow-md)}.section-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-bottom:1rem}.section-heading>div,.help{display:flex;align-items:center;gap:.7rem}.section-heading b,.help>b{display:grid;place-items:center;width:2rem;height:2rem;flex:none;border-radius:.65rem;background:var(--color-primary-soft);color:var(--color-primary-hover);font:900 .72rem var(--font-mono)}h2{margin:0;font-size:clamp(1.2rem,2vw,1.5rem)}.field{display:grid;gap:.4rem;font-size:.88rem;font-weight:800}.compact{max-width:20rem;margin-bottom:1rem}textarea,input,select{width:100%;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface);color:var(--color-text);padding:.78rem .9rem}textarea{min-height:13rem;resize:vertical;font:400 .9rem/1.55 var(--font-mono)}textarea:focus,input:focus,select:focus{outline:0;border-color:var(--color-primary);box-shadow:var(--shadow-focus)}.options,.actions{display:flex;flex-wrap:wrap;align-items:end;gap:.65rem;margin-bottom:1rem}.check{display:flex;align-items:center;gap:.45rem;min-height:2.75rem;padding:.55rem .7rem;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface-soft);font-size:.86rem;font-weight:700}.check input,.permission input{width:1.1rem;height:1.1rem;padding:0;accent-color:var(--color-primary)}.actions{margin:1rem 0 0}.btn{min-height:2.75rem;padding:.7rem 1rem;border:1px solid transparent;border-radius:var(--radius-lg);font-weight:850;cursor:pointer;transition:transform var(--transition-fast),background var(--transition-base)}.btn:hover{transform:translateY(-1px)}.primary{background:var(--color-primary);color:#fff}.secondary,.quiet{border-color:var(--color-border);background:var(--color-surface);color:var(--color-text)}.quiet{background:transparent}.result{margin-top:1.25rem;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:var(--color-surface-soft)}.result textarea{min-height:9rem}.status{min-height:1.3rem;margin:.6rem 0 0;font-size:.85rem}.status[data-state="ok"]{color:var(--color-success)}.status[data-state="error"]{color:var(--color-danger);font-weight:750}.permission-grid,.form-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem;margin:0;padding:0;border:0}.form-grid{grid-template-columns:repeat(2,1fr)}.wide{grid-column:1/-1}.permission{display:grid;gap:.5rem;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface-soft)}.permission label{display:flex;align-items:center;gap:.5rem}.help{align-items:flex-start;margin-top:1.2rem;padding:1.25rem;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:var(--color-surface)}.help p{max-width:65ch;margin:.4rem 0 0}.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}@media(max-width:640px){.utility-hero{justify-items:start;text-align:left}.utility-hero h1{font-size:clamp(2.1rem,12vw,3rem)}.trust-row{justify-content:start}.workbench{border-radius:var(--radius-xl)}.permission-grid,.form-grid{grid-template-columns:1fr}.wide{grid-column:auto}.checks{display:grid}.check,.actions .btn{width:100%}.section-heading{align-items:flex-start}}
</style>
