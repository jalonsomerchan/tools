---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';
const title = es ? 'Comparador JSON' : 'JSON compare';
const description = es
  ? 'Compara dos JSON localmente y marca las líneas distintas directamente en los editores.'
  : 'Compare two JSON documents locally and highlight differing lines directly inside the editors.';
const ui = {
  eyebrow: '100% local',
  hero: es
    ? 'Pega dos documentos JSON, pulsa comparar y las líneas distintas se marcarán directamente en ambos editores.'
    : 'Paste two JSON documents, compare them and differing lines will be highlighted directly in both editors.',
  left: es ? 'JSON original' : 'Original JSON',
  right: es ? 'JSON modificado' : 'Changed JSON',
  sortKeys: es ? 'Ordenar claves de objetos antes de comparar' : 'Sort object keys before comparing',
  actions: {
    compare: es ? 'Comparar JSON' : 'Compare JSON',
    format: es ? 'Formatear ambos' : 'Format both',
    sample: es ? 'Ejemplo' : 'Sample',
    clear: es ? 'Limpiar' : 'Clear',
    copy: es ? 'Copiar resultado' : 'Copy result'
  },
  placeholders: {
    left: es ? 'Pega aquí el JSON original...' : 'Paste the original JSON here...',
    right: es ? 'Pega aquí el JSON modificado...' : 'Paste the changed JSON here...'
  },
  messages: {
    ready: es ? 'Listo para comparar.' : 'Ready to compare.',
    pasteBoth: es ? 'Pega los dos JSON antes de comparar.' : 'Paste both JSON documents before comparing.',
    invalidLeft: es ? 'El JSON original no es válido.' : 'The original JSON is invalid.',
    invalidRight: es ? 'El JSON modificado no es válido.' : 'The changed JSON is invalid.',
    compared: es ? 'Comparación actualizada. Las líneas distintas están marcadas en los editores.' : 'Comparison updated. Differing lines are highlighted in the editors.',
    noDiff: es ? 'No hay diferencias.' : 'No differences found.',
    formatted: es ? 'Ambos JSON se han formateado.' : 'Both JSON documents were formatted.',
    copied: es ? 'Resultado copiado al portapapeles.' : 'Result copied to clipboard.',
    copyError: es ? 'No se pudo copiar.' : 'Could not copy.',
    cleared: es ? 'Contenido eliminado.' : 'Content cleared.',
    sample: es ? 'Ejemplo cargado.' : 'Sample loaded.'
  }
};
---

<Layout title={title} description={description} lang={lang} path="/json-compare/" translated={true}>
  <section class="json-compare-page">
    <div class="eyebrow">{ui.eyebrow}</div>
    <h1>{title}</h1>
    <p class="hero-text">{ui.hero}</p>

    <section class="tool-card compare-tool" aria-label={title}>
      <div class="toolbar">
        <label class="option"><input id="sortKeys" type="checkbox" checked /> <span>{ui.sortKeys}</span></label>
        <div class="actions">
          <button id="compareBtn" type="button" class="primary-action">{ui.actions.compare}</button>
          <button id="formatBtn" type="button">{ui.actions.format}</button>
          <button id="sampleBtn" type="button">{ui.actions.sample}</button>
          <button id="copyBtn" type="button">{ui.actions.copy}</button>
          <button id="clearBtn" type="button">{ui.actions.clear}</button>
        </div>
      </div>

      <div class="editor-grid">
        <label class="editor-pane" for="leftInput">
          <span>{ui.left}</span>
          <div class="textarea-wrap">
            <ol id="leftHighlights" class="textarea-highlights" aria-hidden="true"></ol>
            <textarea id="leftInput" spellcheck="false" wrap="off" placeholder={ui.placeholders.left}></textarea>
          </div>
        </label>
        <label class="editor-pane" for="rightInput">
          <span>{ui.right}</span>
          <div class="textarea-wrap">
            <ol id="rightHighlights" class="textarea-highlights" aria-hidden="true"></ol>
            <textarea id="rightInput" spellcheck="false" wrap="off" placeholder={ui.placeholders.right}></textarea>
          </div>
        </label>
      </div>

      <p class="status" id="status" role="status" aria-live="polite">{ui.messages.ready}</p>
      <textarea id="reportOutput" class="report-output" readonly spellcheck="false" aria-label={ui.actions.copy}></textarea>
    </section>
  </section>

  <style>
    .json-compare-page{padding:clamp(2.5rem,6vw,4rem) 0}.compare-tool{padding:clamp(1rem,3vw,1.35rem);margin-top:2rem}.toolbar{display:grid;grid-template-columns:1fr;gap:var(--space-3);padding:var(--space-4);border:1px solid var(--color-border);border-radius:var(--radius-xl);background:color-mix(in srgb,var(--color-surface) 92%,transparent);box-shadow:var(--shadow-xs)}.option{display:flex;align-items:center;gap:.55rem;color:var(--color-text-muted);font-weight:800}.option input{width:1.05rem;height:1.05rem;accent-color:var(--color-primary)}.actions{display:flex;flex-wrap:wrap;gap:.5rem}.actions button{min-height:2.55rem;border-radius:var(--radius-full);border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text);padding:.65rem .9rem;cursor:pointer;font-weight:900;box-shadow:var(--shadow-xs);transition:transform var(--transition-fast),border-color var(--transition-base),background-color var(--transition-base)}.actions button:hover{transform:translateY(-1px);border-color:var(--color-border-strong)}.actions .primary-action{background:var(--color-primary);border-color:transparent;color:#fff}[data-theme='dark'] .actions .primary-action{color:#020617}.editor-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4);margin-top:var(--space-4)}.editor-pane{display:flex;min-width:0;flex-direction:column;overflow:hidden;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:#111827;box-shadow:var(--shadow-xs)}.editor-pane span{display:flex;align-items:center;min-height:2.75rem;padding:.55rem .8rem;background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));color:#fff;font-weight:950}.textarea-wrap{position:relative;min-height:520px;background:#111827;overflow:hidden}.editor-pane textarea{position:absolute;inset:0;z-index:2;width:100%;height:100%;min-height:520px;resize:vertical;border:0;background:transparent;color:#e5e7eb;padding:1rem;font-family:var(--font-mono);font-size:.94rem;line-height:1.55;tab-size:2;white-space:pre;overflow:auto;box-shadow:none!important}.editor-pane textarea::placeholder{color:#7c8497}.editor-pane textarea[data-invalid='true']{outline:2px solid rgba(252,165,165,.65);outline-offset:-2px}.textarea-highlights{position:absolute;z-index:1;inset:0;margin:0;padding:1rem 0;list-style:none;font-family:var(--font-mono);font-size:.94rem;line-height:1.55;pointer-events:none;overflow:hidden;color:transparent;white-space:pre}.textarea-highlights li{height:1.457rem;margin:0;padding:0 1rem;border-bottom:1px solid transparent}.textarea-highlights li.diff-line{background:linear-gradient(90deg,rgba(251,191,36,.34),rgba(251,191,36,.18));border-bottom-color:rgba(251,191,36,.22)}.textarea-highlights li.empty-line{background:rgba(248,113,113,.18);border-bottom-color:rgba(248,113,113,.22)}.status{margin:var(--space-4) 0 0;color:var(--color-text-muted);white-space:pre-wrap}.report-output{position:absolute;inline-size:1px;block-size:1px;opacity:.01;pointer-events:none}@media(min-width:840px){.toolbar{grid-template-columns:max-content 1fr;align-items:center}.actions{justify-content:flex-end}}@media(max-width:920px){.editor-grid{grid-template-columns:1fr}.textarea-wrap,.editor-pane textarea{min-height:380px}.actions button{flex:1 1 calc(50% - .5rem)}}@media(max-width:560px){.actions button{flex-basis:100%}.compare-tool{margin-inline:-.35rem}.textarea-wrap,.editor-pane textarea{min-height:330px}.editor-pane textarea,.textarea-highlights{font-size:.86rem}.textarea-highlights li{height:1.333rem}}
  </style>

  <script define:vars={{ copy: ui }}>
    window.addEventListener('DOMContentLoaded', () => {
      const leftInput = document.getElementById('leftInput');
      const rightInput = document.getElementById('rightInput');
      const leftHighlights = document.getElementById('leftHighlights');
      const rightHighlights = document.getElementById('rightHighlights');
      const sortKeys = document.getElementById('sortKeys');
      const status = document.getElementById('status');
      const reportOutput = document.getElementById('reportOutput');
      const sampleLeft = { app: 'Alon Tools', version: 1, settings: { theme: 'light', language: 'es', beta: false }, tools: [{ id: 'json-viewer', enabled: true }, { id: 'xml-formatter', enabled: true }] };
      const sampleRight = { app: 'Alon Tools', versiosfdfsn: 2, settings: { tfsdfheme: 'dark', language: 'es' }, tools: [{ id: 'json-viewer', enabled: true }, { id: 'json-compare', enabled: true }], updatedAt: '2026-05-25' };
      const setStatus = (message, error = false) => { status.textContent = message; status.style.color = error ? 'var(--color-danger)' : 'var(--color-text-muted)'; };
      const normalize = (value) => {
        if (!sortKeys.checked || value === null || typeof value !== 'object' || Array.isArray(value)) return Array.isArray(value) ? value.map(normalize) : value;
        return Object.keys(value).sort((a, b) => a.localeCompare(b)).reduce((acc, key) => { acc[key] = normalize(value[key]); return acc; }, {});
      };
      const parseJson = (input, invalidMessage) => {
        input.dataset.invalid = 'false';
        try { return normalize(JSON.parse(input.value)); }
        catch (error) { input.dataset.invalid = 'true'; throw new Error(`${invalidMessage}\n${error.message}`); }
      };
      const makeLine = (text, isDifferent, isMissing) => {
        const li = document.createElement('li');
        if (isDifferent) li.classList.add(isMissing ? 'empty-line' : 'diff-line');
        li.textContent = text || ' ';
        return li;
      };
      const syncScroll = (input, overlay) => {
        overlay.style.transform = `translate(${-input.scrollLeft}px, ${-input.scrollTop}px)`;
      };
      const renderHighlights = (leftLines = [], rightLines = []) => {
        leftHighlights.innerHTML = '';
        rightHighlights.innerHTML = '';
        const max = Math.max(leftLines.length, rightLines.length, 1);
        let diffCount = 0;
        for (let i = 0; i < max; i += 1) {
          const leftLine = leftLines[i];
          const rightLine = rightLines[i];
          const different = leftLine !== rightLine;
          if (different) diffCount += 1;
          leftHighlights.append(makeLine(leftLine, different, leftLine === undefined));
          rightHighlights.append(makeLine(rightLine, different, rightLine === undefined));
        }
        syncScroll(leftInput, leftHighlights);
        syncScroll(rightInput, rightHighlights);
        return diffCount;
      };
      const compare = () => {
        if (!leftInput.value.trim() || !rightInput.value.trim()) { setStatus(copy.messages.pasteBoth, true); return; }
        let left;
        let right;
        try {
          left = parseJson(leftInput, copy.messages.invalidLeft);
          right = parseJson(rightInput, copy.messages.invalidRight);
        } catch (error) {
          setStatus(error.message, true);
          return;
        }
        rightInput.dataset.invalid = 'false';
        const leftText = JSON.stringify(left, null, 2);
        const rightText = JSON.stringify(right, null, 2);
        leftInput.value = leftText;
        rightInput.value = rightText;
        const diffCount = renderHighlights(leftText.split('\n'), rightText.split('\n'));
        reportOutput.value = `${copy.left || 'Original'}\n${leftText}\n\n${copy.right || 'Changed'}\n${rightText}`;
        setStatus(diffCount ? copy.messages.compared : copy.messages.noDiff);
      };
      document.getElementById('compareBtn').onclick = compare;
      document.getElementById('formatBtn').onclick = () => {
        try {
          if (leftInput.value.trim()) leftInput.value = JSON.stringify(parseJson(leftInput, copy.messages.invalidLeft), null, 2);
          if (rightInput.value.trim()) rightInput.value = JSON.stringify(parseJson(rightInput, copy.messages.invalidRight), null, 2);
          leftInput.dataset.invalid = 'false';
          rightInput.dataset.invalid = 'false';
          renderHighlights(leftInput.value.split('\n'), rightInput.value.split('\n'));
          setStatus(copy.messages.formatted);
        } catch (error) {
          setStatus(error.message, true);
        }
      };
      document.getElementById('sampleBtn').onclick = () => { leftInput.value = JSON.stringify(sampleLeft, null, 2); rightInput.value = JSON.stringify(sampleRight, null, 2); setStatus(copy.messages.sample); compare(); };
      document.getElementById('clearBtn').onclick = () => { leftInput.value = ''; rightInput.value = ''; reportOutput.value = ''; leftInput.dataset.invalid = 'false'; rightInput.dataset.invalid = 'false'; renderHighlights([], []); setStatus(copy.messages.cleared); };
      document.getElementById('copyBtn').onclick = async () => {
        if (!reportOutput.value.trim()) compare();
        try { await navigator.clipboard.writeText(reportOutput.value); setStatus(copy.messages.copied); }
        catch { setStatus(copy.messages.copyError, true); }
      };
      sortKeys.addEventListener('change', () => { if (leftInput.value.trim() && rightInput.value.trim()) compare(); });
      [leftInput, rightInput].forEach((input) => {
        const overlay = input === leftInput ? leftHighlights : rightHighlights;
        input.addEventListener('scroll', () => syncScroll(input, overlay));
        input.addEventListener('keydown', (event) => { if (event.key === 'Tab') { event.preventDefault(); input.setRangeText('  ', input.selectionStart, input.selectionEnd, 'end'); } });
        input.addEventListener('input', () => renderHighlights([], []));
      });
      renderHighlights([], []);
    });
  </script>
</Layout>
