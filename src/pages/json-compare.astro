---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';
const title = es ? 'Comparador JSON' : 'JSON compare';
const description = es
  ? 'Compara dos JSON localmente en tu navegador y marca visualmente solo las líneas distintas.'
  : 'Compare two JSON documents locally in your browser and visually highlight only differing lines.';
const ui = {
  eyebrow: '100% local',
  hero: es
    ? 'Pega dos documentos JSON y revisa las diferencias línea a línea sin subir datos a servidores.'
    : 'Paste two JSON documents and review line-by-line differences without uploading data.',
  left: es ? 'JSON original' : 'Original JSON',
  right: es ? 'JSON modificado' : 'Changed JSON',
  result: es ? 'Diferencias línea a línea' : 'Line-by-line differences',
  sortKeys: es ? 'Ordenar claves de objetos antes de comparar' : 'Sort object keys before comparing',
  actions: {
    compare: es ? 'Comparar JSON' : 'Compare JSON',
    format: es ? 'Formatear ambos' : 'Format both',
    sample: es ? 'Ejemplo' : 'Sample',
    clear: es ? 'Limpiar' : 'Clear',
    copy: es ? 'Copiar resultado' : 'Copy result'
  },
  placeholders: {
    left: es ? 'Pega aquí el JSON original...' : 'Paste the original JSON here...',
    right: es ? 'Pega aquí el JSON modificado...' : 'Paste the changed JSON here...'
  },
  messages: {
    ready: es ? 'Listo para comparar.' : 'Ready to compare.',
    pasteBoth: es ? 'Pega los dos JSON antes de comparar.' : 'Paste both JSON documents before comparing.',
    invalidLeft: es ? 'El JSON original no es válido.' : 'The original JSON is invalid.',
    invalidRight: es ? 'El JSON modificado no es válido.' : 'The changed JSON is invalid.',
    compared: es ? 'Comparación actualizada. Solo se colorean las líneas distintas.' : 'Comparison updated. Only differing lines are highlighted.',
    noDiff: es ? 'No hay diferencias.' : 'No differences found.',
    formatted: es ? 'Ambos JSON se han formateado.' : 'Both JSON documents were formatted.',
    copied: es ? 'Resultado copiado al portapapeles.' : 'Result copied to clipboard.',
    copyError: es ? 'No se pudo copiar. El resultado queda seleccionado.' : 'Could not copy. The result has been selected.',
    cleared: es ? 'Contenido eliminado.' : 'Content cleared.',
    sample: es ? 'Ejemplo cargado.' : 'Sample loaded.'
  }
};
---

<Layout title={title} description={description} lang={lang} path="/json-compare/" translated={true}>
  <section class="json-compare-page">
    <div class="eyebrow">{ui.eyebrow}</div>
    <h1>{title}</h1>
    <p class="hero-text">{ui.hero}</p>

    <section class="tool-card compare-tool" aria-label={title}>
      <div class="toolbar">
        <label class="option"><input id="sortKeys" type="checkbox" checked /> <span>{ui.sortKeys}</span></label>
        <div class="actions">
          <button id="compareBtn" type="button" class="primary-action">{ui.actions.compare}</button>
          <button id="formatBtn" type="button">{ui.actions.format}</button>
          <button id="sampleBtn" type="button">{ui.actions.sample}</button>
          <button id="copyBtn" type="button">{ui.actions.copy}</button>
          <button id="clearBtn" type="button">{ui.actions.clear}</button>
        </div>
      </div>

      <div class="editor-grid">
        <label class="editor-pane" for="leftInput">
          <span>{ui.left}</span>
          <textarea id="leftInput" spellcheck="false" placeholder={ui.placeholders.left}></textarea>
        </label>
        <label class="editor-pane" for="rightInput">
          <span>{ui.right}</span>
          <textarea id="rightInput" spellcheck="false" placeholder={ui.placeholders.right}></textarea>
        </label>
      </div>

      <section class="result-panel" aria-labelledby="resultTitle">
        <div class="result-heading">
          <h2 id="resultTitle">{ui.result}</h2>
          <p id="status" role="status" aria-live="polite">{ui.messages.ready}</p>
        </div>

        <div class="line-diff-grid" id="lineDiffGrid" aria-live="polite">
          <section class="line-diff-pane" aria-label={ui.left}>
            <div class="line-diff-title">{ui.left}</div>
            <ol id="leftDiff" class="line-list"></ol>
          </section>
          <section class="line-diff-pane" aria-label={ui.right}>
            <div class="line-diff-title">{ui.right}</div>
            <ol id="rightDiff" class="line-list"></ol>
          </section>
        </div>
        <textarea id="reportOutput" class="report-output" readonly spellcheck="false" aria-label={ui.actions.copy}></textarea>
      </section>
    </section>
  </section>

  <style>
    .json-compare-page{padding:clamp(2.5rem,6vw,4rem) 0}.compare-tool{padding:clamp(1rem,3vw,1.35rem);margin-top:2rem}.toolbar{display:grid;grid-template-columns:1fr;gap:var(--space-3);padding:var(--space-4);border:1px solid var(--color-border);border-radius:var(--radius-xl);background:color-mix(in srgb,var(--color-surface) 92%,transparent);box-shadow:var(--shadow-xs)}.option{display:flex;align-items:center;gap:.55rem;color:var(--color-text-muted);font-weight:800}.option input{width:1.05rem;height:1.05rem;accent-color:var(--color-primary)}.actions{display:flex;flex-wrap:wrap;gap:.5rem}.actions button{min-height:2.55rem;border-radius:var(--radius-full);border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text);padding:.65rem .9rem;cursor:pointer;font-weight:900;box-shadow:var(--shadow-xs);transition:transform var(--transition-fast),border-color var(--transition-base),background-color var(--transition-base)}.actions button:hover{transform:translateY(-1px);border-color:var(--color-border-strong)}.actions .primary-action{background:var(--color-primary);border-color:transparent;color:#fff}[data-theme='dark'] .actions .primary-action{color:#020617}.editor-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4);margin-top:var(--space-4)}.editor-pane{display:flex;min-width:0;flex-direction:column;overflow:hidden;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:#111827;box-shadow:var(--shadow-xs)}.editor-pane span{display:flex;align-items:center;min-height:2.75rem;padding:.55rem .8rem;background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));color:#fff;font-weight:950}.editor-pane textarea{width:100%;min-height:360px;resize:vertical;border:0;background:#111827;color:#e5e7eb;padding:1rem;font-family:var(--font-mono);font-size:.94rem;line-height:1.55;tab-size:2}.editor-pane textarea[data-invalid='true']{outline:2px solid rgba(252,165,165,.65);outline-offset:-2px}.result-panel{margin-top:var(--space-4);border:1px solid var(--color-border);border-radius:var(--radius-xl);background:var(--color-surface);overflow:hidden}.result-heading{display:flex;justify-content:space-between;gap:var(--space-4);align-items:flex-start;padding:var(--space-4);border-bottom:1px solid var(--color-border)}.result-heading h2{margin:0;font-size:1.2rem}.result-heading p{margin:0;color:var(--color-text-muted);white-space:pre-wrap}.line-diff-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));background:#111827}.line-diff-pane{min-width:0;border-right:1px solid #374151}.line-diff-pane:last-child{border-right:0}.line-diff-title{position:sticky;top:0;z-index:2;padding:.65rem .9rem;background:#1f2937;color:#dbeafe;border-bottom:1px solid #374151;font-weight:950}.line-list{min-height:220px;max-height:560px;margin:0;padding:0;overflow:auto;list-style:none;font-family:var(--font-mono);font-size:.9rem;line-height:1.5}.line-list li{display:grid;grid-template-columns:4.25rem minmax(0,1fr);min-height:1.5rem;border-bottom:1px solid rgba(255,255,255,.04);color:#d1d5db}.line-list li::before{content:attr(data-line);padding:.08rem .75rem;color:#64748b;text-align:right;border-right:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.025);user-select:none}.line-list code{display:block;min-width:0;padding:.08rem .85rem;white-space:pre;overflow:auto;color:inherit;background:transparent}.line-list li.line-different{background:rgba(251,191,36,.16);color:#fde68a}.line-list li.line-different::before{background:rgba(251,191,36,.2);color:#fef3c7}.line-list li.line-empty code{color:#64748b}.report-output{position:absolute;inline-size:1px;block-size:1px;opacity:.01;pointer-events:none}@media(min-width:840px){.toolbar{grid-template-columns:max-content 1fr;align-items:center}.actions{justify-content:flex-end}}@media(max-width:920px){.editor-grid,.line-diff-grid{grid-template-columns:1fr}.editor-pane textarea{min-height:300px}.line-diff-pane{border-right:0;border-bottom:1px solid #374151}.result-heading{display:block}.result-heading p{margin-top:.35rem}.actions button{flex:1 1 calc(50% - .5rem)}}@media(max-width:560px){.actions button{flex-basis:100%}.compare-tool{margin-inline:-.35rem}.line-list{font-size:.82rem}.line-list li{grid-template-columns:3.35rem minmax(0,1fr)}}
  </style>

  <script define:vars={{ copy: ui }}>
    window.addEventListener('DOMContentLoaded', () => {
      const leftInput = document.getElementById('leftInput');
      const rightInput = document.getElementById('rightInput');
      const sortKeys = document.getElementById('sortKeys');
      const status = document.getElementById('status');
      const leftDiff = document.getElementById('leftDiff');
      const rightDiff = document.getElementById('rightDiff');
      const reportOutput = document.getElementById('reportOutput');
      const sampleLeft = { app: 'Alon Tools', version: 1, settings: { theme: 'light', language: 'es', beta: false }, tools: [{ id: 'json-viewer', enabled: true }, { id: 'xml-formatter', enabled: true }] };
      const sampleRight = { app: 'Alon Tools', version: 2, settings: { theme: 'dark', language: 'es' }, tools: [{ id: 'json-viewer', enabled: true }, { id: 'json-compare', enabled: true }], updatedAt: '2026-05-25' };
      const setStatus = (message, error = false) => { status.textContent = message; status.style.color = error ? 'var(--color-danger)' : 'var(--color-text-muted)'; };
      const normalize = (value) => {
        if (!sortKeys.checked || value === null || typeof value !== 'object' || Array.isArray(value)) return Array.isArray(value) ? value.map(normalize) : value;
        return Object.keys(value).sort((a, b) => a.localeCompare(b)).reduce((acc, key) => {
          acc[key] = normalize(value[key]);
          return acc;
        }, {});
      };
      const parseJson = (input, invalidMessage) => {
        input.dataset.invalid = 'false';
        try { return normalize(JSON.parse(input.value)); }
        catch (error) { input.dataset.invalid = 'true'; throw new Error(`${invalidMessage}\n${error.message}`); }
      };
      const renderLine = (list, line, index, different) => {
        const item = document.createElement('li');
        item.dataset.line = line === undefined ? '' : String(index + 1);
        item.className = `${different ? 'line-different ' : ''}${line === undefined ? 'line-empty' : ''}`.trim();
        const code = document.createElement('code');
        code.textContent = line === undefined ? ' ' : line || ' ';
        item.append(code);
        list.append(item);
      };
      const renderEmpty = (message) => {
        leftDiff.innerHTML = '';
        rightDiff.innerHTML = '';
        renderLine(leftDiff, message, 0, false);
        renderLine(rightDiff, message, 0, false);
      };
      const compare = () => {
        if (!leftInput.value.trim() || !rightInput.value.trim()) { setStatus(copy.messages.pasteBoth, true); return; }
        let left;
        let right;
        try {
          left = parseJson(leftInput, copy.messages.invalidLeft);
          right = parseJson(rightInput, copy.messages.invalidRight);
        } catch (error) {
          setStatus(error.message, true);
          return;
        }
        rightInput.dataset.invalid = 'false';
        const leftText = JSON.stringify(left, null, 2);
        const rightText = JSON.stringify(right, null, 2);
        const leftLines = leftText.split('\n');
        const rightLines = rightText.split('\n');
        const maxLines = Math.max(leftLines.length, rightLines.length);
        let diffCount = 0;
        leftDiff.innerHTML = '';
        rightDiff.innerHTML = '';
        for (let i = 0; i < maxLines; i += 1) {
          const different = leftLines[i] !== rightLines[i];
          if (different) diffCount += 1;
          renderLine(leftDiff, leftLines[i], i, different);
          renderLine(rightDiff, rightLines[i], i, different);
        }
        reportOutput.value = `${copy.left || 'Original'}\n${leftText}\n\n${copy.right || 'Changed'}\n${rightText}`;
        setStatus(diffCount ? copy.messages.compared : copy.messages.noDiff, false);
      };
      document.getElementById('compareBtn').onclick = compare;
      document.getElementById('formatBtn').onclick = () => {
        try {
          if (leftInput.value.trim()) leftInput.value = JSON.stringify(parseJson(leftInput, copy.messages.invalidLeft), null, 2);
          if (rightInput.value.trim()) rightInput.value = JSON.stringify(parseJson(rightInput, copy.messages.invalidRight), null, 2);
          leftInput.dataset.invalid = 'false';
          rightInput.dataset.invalid = 'false';
          setStatus(copy.messages.formatted);
          if (leftInput.value.trim() && rightInput.value.trim()) compare();
        } catch (error) {
          setStatus(error.message, true);
        }
      };
      document.getElementById('sampleBtn').onclick = () => { leftInput.value = JSON.stringify(sampleLeft, null, 2); rightInput.value = JSON.stringify(sampleRight, null, 2); setStatus(copy.messages.sample); compare(); };
      document.getElementById('clearBtn').onclick = () => { leftInput.value = ''; rightInput.value = ''; reportOutput.value = ''; leftInput.dataset.invalid = 'false'; rightInput.dataset.invalid = 'false'; renderEmpty(copy.messages.ready); setStatus(copy.messages.cleared); };
      document.getElementById('copyBtn').onclick = async () => {
        if (!reportOutput.value.trim()) compare();
        try { await navigator.clipboard.writeText(reportOutput.value); setStatus(copy.messages.copied); }
        catch { reportOutput.focus(); reportOutput.select(); setStatus(copy.messages.copyError, true); }
      };
      sortKeys.addEventListener('change', () => { if (leftInput.value.trim() && rightInput.value.trim()) compare(); });
      [leftInput, rightInput].forEach((input) => input.addEventListener('keydown', (event) => { if (event.key === 'Tab') { event.preventDefault(); input.setRangeText('  ', input.selectionStart, input.selectionEnd, 'end'); } }));
      renderEmpty(copy.messages.ready);
    });
  </script>
</Layout>
