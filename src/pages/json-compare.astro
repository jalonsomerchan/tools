---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';
const title = es ? 'Comparador JSON' : 'JSON compare';
const desc = es ? 'Compara dos JSON y resalta las lineas distintas.' : 'Compare two JSON documents and highlight different lines.';
---
<Layout title={title} description={desc} lang={lang} path="/json-compare/" translated={true}>
<section class="jc"><h1>{title}</h1><p class="hero-text">{es?'Pega dos JSON y las lineas distintas se resaltaran claramente en el resultado.':'Paste two JSON documents and different lines will be clearly highlighted in the result.'}</p><section class="tool-card"><div class="bar"><label><input id="sort" type="checkbox" checked /> {es?'Ordenar claves':'Sort keys'}</label><div><button id="cmp" class="primary">{es?'Comparar':'Compare'}</button><button id="fmt">{es?'Formatear':'Format'}</button><button id="ex">{es?'Ejemplo':'Sample'}</button><button id="clear">{es?'Limpiar':'Clear'}</button></div></div><div class="inputs"><label>{es?'JSON original':'Original JSON'}<textarea id="a" spellcheck="false"></textarea></label><label>{es?'JSON modificado':'Changed JSON'}<textarea id="b" spellcheck="false"></textarea></label></div><p id="st" class="st">{es?'Listo para comparar.':'Ready to compare.'}</p><div class="out"><section><h2>{es?'Original':'Original'}</h2><ol id="oa"></ol></section><section><h2>{es?'Modificado':'Changed'}</h2><ol id="ob"></ol></section></div></section></section>
<style>.jc{padding:2rem 0}.bar{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:var(--color-surface)}.bar label{display:flex;align-items:center;gap:.5rem;font-weight:900;color:var(--color-text-muted)}.bar input{accent-color:var(--color-primary)}.bar div{display:flex;gap:.5rem;flex-wrap:wrap}.bar button{border:1px solid var(--color-border);border-radius:999px;background:var(--color-surface);color:var(--color-text);padding:.65rem 1rem;font-weight:900;cursor:pointer}.bar .primary{background:var(--color-primary);border-color:transparent;color:#fff}.inputs{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem}.inputs label{display:grid;gap:.5rem;font-weight:900;color:var(--color-text-muted)}textarea{min-height:260px;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:#111827;color:#e5e7eb;padding:1rem;font-family:var(--font-mono);line-height:1.55;resize:vertical}.st{color:var(--color-text-muted);white-space:pre-wrap}.out{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem}.out section{overflow:hidden;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:#111827}.out h2{margin:0;padding:.7rem 1rem;background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));color:#fff;font-size:1rem}.out ol{margin:0;padding:1rem 0;list-style:none;max-height:620px;overflow:auto;font-family:var(--font-mono);font-size:.92rem;line-height:1.55}.out li{display:grid;grid-template-columns:3.4rem minmax(0,1fr);min-height:1.55em;color:#d1d5db}.out li:before{content:attr(data-n);padding:0 .75rem;text-align:right;color:#64748b;border-right:1px solid rgba(255,255,255,.08)}.out code{padding:0 .85rem;white-space:pre;overflow:auto;color:inherit}.out li.diff{background:rgba(251,191,36,.28);color:#fde68a}.out li.add,.out li.del{background:rgba(248,113,113,.24);color:#fecdd3}.out li.diff:before{color:#fef3c7}.out li.add:before,.out li.del:before{color:#ffe4e6}@media(max-width:900px){.inputs,.out{grid-template-columns:1fr}.bar button{flex:1 1 calc(50% - .5rem)}}@media(max-width:560px){.bar button{flex-basis:100%}.out ol{font-size:.82rem}.out li{grid-template-columns:2.8rem minmax(0,1fr)}}</style>
<script define:vars={{ es }}>window.addEventListener('DOMContentLoaded',()=>{const a=document.getElementById('a'),b=document.getElementById('b'),oa=document.getElementById('oa'),ob=document.getElementById('ob'),st=document.getElementById('st'),sort=document.getElementById('sort');const msg={both:es?'Pega los dos JSON.':'Paste both JSON documents.',badA:es?'El JSON original no es valido.':'Original JSON is invalid.',badB:es?'El JSON modificado no es valido.':'Changed JSON is invalid.',ok:es?'Diferencias resaltadas en amarillo/rojo.':'Differences highlighted in yellow/red.',same:es?'No hay diferencias.':'No differences found.',fmt:es?'Formateado.':'Formatted.',clear:es?'Limpio.':'Cleared.'};const sa={app:'Alon Tools',version:1,settings:{theme:'light',language:'es',beta:false},tools:[{id:'json-viewer',enabled:true},{id:'xml-formatter',enabled:true}]};const sb={app:'Alon Toos',version:2,settings:{theme:'dark',language:'es'},tools:[{id:'json-viewer',enabled:true},{id:'json-compare',enabled:true}],updatedAt:'2026-05-25'};const set=(t,e=false)=>{st.textContent=t;st.style.color=e?'var(--color-danger)':'var(--color-text-muted)'};const norm=v=>{if(!sort.checked||v===null||typeof v!=='object'||Array.isArray(v))return Array.isArray(v)?v.map(norm):v;return Object.keys(v).sort((x,y)=>x.localeCompare(y)).reduce((o,k)=>(o[k]=norm(v[k]),o),{})};const parse=(el,err)=>{try{return norm(JSON.parse(el.value))}catch(e){throw new Error(err+'\n'+e.message)}};const esc=s=>String(s??'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));const render=(box,rows)=>{box.innerHTML=rows.map(r=>`<li class="${r.t}" data-n="${r.n??''}"><code>${esc(r.v||' ')}</code></li>`).join('')};const diff=(x,y)=>{let n=x.length,m=y.length,dp=Array.from({length:n+1},()=>Array(m+1).fill(0));for(let i=n-1;i>=0;i--)for(let j=m-1;j>=0;j--)dp[i][j]=x[i]===y[j]?dp[i+1][j+1]+1:Math.max(dp[i+1][j],dp[i][j+1]);let i=0,j=0,A=[],B=[],c=0;while(i<n||j<m){if(i<n&&j<m&&x[i]===y[j]){A.push({n:i+1,v:x[i],t:''});B.push({n:j+1,v:y[j],t:''});i++;j++}else if(j>=m||(i<n&&dp[i+1][j]>=dp[i][j+1])){A.push({n:i+1,v:x[i],t:'del'});B.push({v:'',t:'add'});i++;c++}else{A.push({v:'',t:'del'});B.push({n:j+1,v:y[j],t:'add'});j++;c++}}render(oa,A);render(ob,B);return c};const run=()=>{if(!a.value.trim()||!b.value.trim()){set(msg.both,true);return}try{let x=JSON.stringify(parse(a,msg.badA),null,2),y=JSON.stringify(parse(b,msg.badB),null,2);a.value=x;b.value=y;set(diff(x.split('\n'),y.split('\n'))?msg.ok:msg.same)}catch(e){set(e.message,true)}};document.getElementById('cmp').onclick=run;document.getElementById('fmt').onclick=()=>{try{if(a.value.trim())a.value=JSON.stringify(parse(a,msg.badA),null,2);if(b.value.trim())b.value=JSON.stringify(parse(b,msg.badB),null,2);set(msg.fmt)}catch(e){set(e.message,true)}};document.getElementById('ex').onclick=()=>{a.value=JSON.stringify(sa,null,2);b.value=JSON.stringify(sb,null,2);run()};document.getElementById('clear').onclick=()=>{a.value='';b.value='';oa.innerHTML='';ob.innerHTML='';set(msg.clear)};sort.onchange=()=>{if(a.value.trim()&&b.value.trim())run()}})</script>
</Layout>
