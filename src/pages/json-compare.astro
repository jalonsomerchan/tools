---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';
const title = es ? 'Comparador JSON' : 'JSON compare';
const desc = es ? 'Compara dos JSON y resalta las lineas distintas en los paneles principales.' : 'Compare two JSON documents and highlight different lines in the main panels.';
---
<Layout title={title} description={desc} lang={lang} path="/json-compare/" translated={true}>
<section class="jc"><h1>{title}</h1><p class="hero-text">{es?'Pega dos JSON en los paneles principales. Al comparar, las lineas distintas se resaltan en esos mismos paneles.':'Paste two JSON documents in the main panels. Different lines are highlighted in those same panels.'}</p><section class="tool-card"><div class="bar"><label><input id="sort" type="checkbox" checked /> {es?'Ordenar claves':'Sort keys'}</label><div><button id="cmp" class="primary">{es?'Comparar':'Compare'}</button><button id="fmt">{es?'Formatear':'Format'}</button><button id="ex">{es?'Ejemplo':'Sample'}</button><button id="clear">{es?'Limpiar':'Clear'}</button></div></div><div class="grid"><section><h2>{es?'JSON original':'Original JSON'}</h2><pre id="a" class="editor" contenteditable="true" spellcheck="false"></pre></section><section><h2>{es?'JSON modificado':'Changed JSON'}</h2><pre id="b" class="editor" contenteditable="true" spellcheck="false"></pre></section></div><p id="st" class="st">{es?'Listo para comparar.':'Ready to compare.'}</p></section></section>
<style>.jc{padding:2rem 0}.bar{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:var(--color-surface)}.bar label{display:flex;align-items:center;gap:.5rem;font-weight:900;color:var(--color-text-muted)}.bar input{accent-color:var(--color-primary)}.bar div{display:flex;gap:.5rem;flex-wrap:wrap}.bar button{border:1px solid var(--color-border);border-radius:999px;background:var(--color-surface);color:var(--color-text);padding:.65rem 1rem;font-weight:900;cursor:pointer}.bar .primary{background:var(--color-primary);border-color:transparent;color:#fff}.grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1rem}.grid section{overflow:hidden;border:1px solid var(--color-border);border-radius:var(--radius-xl);background:#111827;box-shadow:var(--shadow-xs)}.grid h2{margin:0;padding:.7rem 1rem;background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));color:#fff;font-size:1rem}.editor{min-height:560px;max-height:720px;margin:0;padding:1rem 0;overflow:auto;background:#111827;color:#d1d5db;font-family:var(--font-mono);font-size:.92rem;line-height:1.55;white-space:pre;outline:0}.editor:empty:before{content:'Pega aqui tu JSON...';display:block;padding:0 1rem;color:#64748b}.line{display:block;min-height:1.55em;padding:0 1rem;white-space:pre}.line.diff{background:rgba(251,191,36,.32);color:#fde68a;box-shadow:inset .35rem 0 #fbbf24}.line.add,.line.del{background:rgba(248,113,113,.26);color:#fecdd3;box-shadow:inset .35rem 0 #fb7185}.st{margin:1rem 0 0;color:var(--color-text-muted);white-space:pre-wrap}@media(max-width:900px){.grid{grid-template-columns:1fr}.editor{min-height:420px}.bar button{flex:1 1 calc(50% - .5rem)}}@media(max-width:560px){.bar button{flex-basis:100%}.editor{min-height:340px;font-size:.82rem}}</style>
<script define:vars={{ es }}>window.addEventListener('DOMContentLoaded',()=>{const a=document.getElementById('a'),b=document.getElementById('b'),st=document.getElementById('st'),sort=document.getElementById('sort');const msg={both:es?'Pega los dos JSON.':'Paste both JSON documents.',badA:es?'El JSON original no es valido.':'Original JSON is invalid.',badB:es?'El JSON modificado no es valido.':'Changed JSON is invalid.',ok:es?'Diferencias resaltadas en los paneles.':'Differences highlighted in the panels.',same:es?'No hay diferencias.':'No differences found.',fmt:es?'Formateado.':'Formatted.',clear:es?'Limpio.':'Cleared.'};const sa={app:'Alon Tools',version:1,settings:{theme:'light',language:'es',beta:false},tools:[{id:'json-viewer',enabled:true},{id:'xml-formatter',enabled:true}]};const sb={app:'Alon Toos',version:2,settings:{theme:'dark',language:'es'},tools:[{id:'json-viewer',enabled:true},{id:'json-compare',enabled:true}],updatedAt:'2026-05-25'};const set=(t,e=false)=>{st.textContent=t;st.style.color=e?'var(--color-danger)':'var(--color-text-muted)'};const esc=s=>String(s??'').replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));const raw=el=>el.innerText.replace(/\u00a0/g,' ').trim();const norm=v=>{if(!sort.checked||v===null||typeof v!=='object'||Array.isArray(v))return Array.isArray(v)?v.map(norm):v;return Object.keys(v).sort((x,y)=>x.localeCompare(y)).reduce((o,k)=>(o[k]=norm(v[k]),o),{})};const parse=(el,err)=>{try{return norm(JSON.parse(raw(el)))}catch(e){throw new Error(err+'\n'+e.message)}};const put=(el,rows)=>{el.innerHTML=rows.map(r=>`<span class="line ${r.t||''}">${esc(r.v||' ')}</span>`).join('')};const putText=(el,t)=>{put(el,t.split('\n').map(v=>({v,t:''})))};const diff=(x,y)=>{let n=x.length,m=y.length,dp=Array.from({length:n+1},()=>Array(m+1).fill(0));for(let i=n-1;i>=0;i--)for(let j=m-1;j>=0;j--)dp[i][j]=x[i]===y[j]?dp[i+1][j+1]+1:Math.max(dp[i+1][j],dp[i][j+1]);let i=0,j=0,A=[],B=[],c=0;while(i<n||j<m){if(i<n&&j<m&&x[i]===y[j]){A.push({v:x[i]});B.push({v:y[j]});i++;j++}else if(j>=m||(i<n&&dp[i+1][j]>=dp[i][j+1])){A.push({v:x[i],t:'del'});B.push({v:'',t:'add'});i++;c++}else{A.push({v:'',t:'del'});B.push({v:y[j],t:'add'});j++;c++}}put(a,A);put(b,B);return c};const run=()=>{if(!raw(a)||!raw(b)){set(msg.both,true);return}try{let x=JSON.stringify(parse(a,msg.badA),null,2),y=JSON.stringify(parse(b,msg.badB),null,2);set(diff(x.split('\n'),y.split('\n'))?msg.ok:msg.same)}catch(e){set(e.message,true)}};document.getElementById('cmp').onclick=run;document.getElementById('fmt').onclick=()=>{try{if(raw(a))putText(a,JSON.stringify(parse(a,msg.badA),null,2));if(raw(b))putText(b,JSON.stringify(parse(b,msg.badB),null,2));set(msg.fmt)}catch(e){set(e.message,true)}};document.getElementById('ex').onclick=()=>{putText(a,JSON.stringify(sa,null,2));putText(b,JSON.stringify(sb,null,2));run()};document.getElementById('clear').onclick=()=>{a.textContent='';b.textContent='';set(msg.clear)};sort.onchange=()=>{if(raw(a)&&raw(b))run()};[a,b].forEach(el=>el.addEventListener('paste',e=>{e.preventDefault();document.execCommand('insertText',false,(e.clipboardData||window.clipboardData).getData('text'))}))})</script>
</Layout>
