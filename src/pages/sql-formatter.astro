---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';
import { getToolTranslations, type ToolTranslationsMap } from '../i18n/tools';

const lang = getLangFromUrl(Astro.url);
const t = getToolTranslations('sql-formatter', lang) as ToolTranslationsMap['sql-formatter']['en'];
---

<Layout title={t.title} description={t.description} lang={lang} path="/sql-formatter/" translated={true}>
  <section class="sql-page">
    <div class="eyebrow">{t.heroEyebrow}</div>
    <h1>{t.title}</h1>
    <p class="hero-text">{t.heroText}</p>

    <section class="tool-card sql-tool" aria-labelledby="sqlToolTitle">
      <div class="tool-header">
        <div>
          <h2 id="sqlToolTitle">{t.workspaceTitle}</h2>
          <p>{t.workspaceText}</p>
        </div>
      </div>

      <div class="options-grid" aria-label={t.aria.options}>
        <label for="dialectSelect">
          {t.labels.dialect}
          <select id="dialectSelect">
            <option value="standard">{t.options.standard}</option>
            <option value="mysql">MySQL</option>
            <option value="postgresql">PostgreSQL</option>
            <option value="sqlite">SQLite</option>
          </select>
        </label>

        <label for="keywordCase">
          {t.labels.keywordCase}
          <select id="keywordCase">
            <option value="upper">UPPERCASE</option>
            <option value="lower">lowercase</option>
            <option value="preserve">{t.options.preserve}</option>
          </select>
        </label>

        <label for="indentSelect">
          {t.labels.indentation}
          <select id="indentSelect">
            <option value="2">{t.options.spaces2}</option>
            <option value="4">{t.options.spaces4}</option>
            <option value="tab">{t.options.tab}</option>
          </select>
        </label>
      </div>

      <div class="toolbar" aria-label={t.aria.actions}>
        <button class="primary" id="formatBtn" type="button">{t.actions.format}</button>
        <button id="minifyBtn" type="button">{t.actions.minify}</button>
        <button id="copyBtn" type="button">{t.actions.copy}</button>
        <button id="downloadBtn" type="button">{t.actions.download}</button>
        <button id="clearBtn" type="button">{t.actions.clear}</button>
      </div>

      <div class="notice" role="note">{t.notice}</div>

      <div class="workspace">
        <label class="editor-label" for="inputSql">{t.labels.input}</label>
        <label class="editor-label" for="outputSql">{t.labels.result}</label>
        <textarea id="inputSql" spellcheck="false" placeholder={t.placeholders.input}></textarea>
        <textarea id="outputSql" spellcheck="false" readonly placeholder={t.placeholders.output}></textarea>
      </div>

      <div class="stats-grid" aria-label={t.aria.stats}>
        <output class="stat-card" id="lineCount">{t.stats.lines}: 0</output>
        <output class="stat-card" id="charCount">{t.stats.characters}: 0</output>
        <output class="stat-card" id="sizeCount">{t.stats.size}: 0 B</output>
      </div>

      <p class="status" id="status" role="status" aria-live="polite">{t.messages.ready}</p>
    </section>
  </section>

  <style>
    .sql-page{padding:clamp(2rem,6vw,4rem) 0}.sql-tool{display:grid;gap:var(--space-4)}.tool-header{display:flex;justify-content:space-between;gap:var(--space-4);align-items:flex-start}.tool-header h2{margin:0 0 var(--space-2);font-size:clamp(1.25rem,2vw,1.6rem)}.tool-header p,.status,.notice{margin:0;color:var(--color-text-muted,var(--muted));line-height:1.7}.options-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-3)}.options-grid label{display:grid;gap:.45rem;color:var(--color-text-muted,var(--muted));font-weight:800}.toolbar{display:flex;gap:var(--space-2);flex-wrap:wrap}button,select{border-radius:var(--radius-lg,14px);border:1px solid var(--color-border,var(--border));background:var(--color-surface,#020617);color:var(--color-text,#fff);padding:.85rem 1rem;font:inherit;font-weight:800;cursor:pointer}button.primary{background:var(--color-primary,var(--primary));color:#020617;border-color:transparent}.notice{padding:1rem;border:1px solid var(--color-border,var(--border));border-radius:var(--radius-xl,18px);background:color-mix(in srgb,var(--color-surface,#020617) 92%,transparent)}.workspace{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-3);align-items:start}.editor-label{color:var(--color-text-muted,var(--muted));font-weight:800}textarea{width:100%;min-height:440px;border-radius:var(--radius-xl,18px);border:1px solid var(--color-border,var(--border));background:#020617;color:#e5e7eb;padding:1rem;font:500 .95rem/1.65 ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;resize:vertical;tab-size:2;white-space:pre;overflow:auto}textarea[data-invalid='true']{border-color:rgba(252,165,165,.72);box-shadow:0 0 0 2px rgba(252,165,165,.12)}.stats-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-3)}.stat-card{border:1px solid var(--color-border,var(--border));border-radius:var(--radius-lg,14px);background:color-mix(in srgb,var(--color-surface,#020617) 92%,transparent);color:var(--color-text-muted,var(--muted));padding:.85rem 1rem;font-weight:800}.status.success{color:#86efac}.status.error{color:#fca5a5;white-space:pre-wrap}@media(max-width:860px){.options-grid,.workspace,.stats-grid{grid-template-columns:1fr}.editor-label:nth-of-type(2){grid-row:3}button,select{width:100%}}
  </style>

  <script define:vars={{ copy: t }}>
    type Token = { type: 'word' | 'string' | 'comment' | 'operator' | 'punctuation' | 'space'; value: string };

    const inputSql = document.getElementById('inputSql') as HTMLTextAreaElement;
    const outputSql = document.getElementById('outputSql') as HTMLTextAreaElement;
    const dialectSelect = document.getElementById('dialectSelect') as HTMLSelectElement;
    const keywordCase = document.getElementById('keywordCase') as HTMLSelectElement;
    const indentSelect = document.getElementById('indentSelect') as HTMLSelectElement;
    const formatBtn = document.getElementById('formatBtn') as HTMLButtonElement;
    const minifyBtn = document.getElementById('minifyBtn') as HTMLButtonElement;
    const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement;
    const downloadBtn = document.getElementById('downloadBtn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clearBtn') as HTMLButtonElement;
    const status = document.getElementById('status') as HTMLParagraphElement;
    const lineCount = document.getElementById('lineCount') as HTMLOutputElement;
    const charCount = document.getElementById('charCount') as HTMLOutputElement;
    const sizeCount = document.getElementById('sizeCount') as HTMLOutputElement;

    const lineKeywords = new Set(['SELECT','FROM','WHERE','GROUP','ORDER','HAVING','LIMIT','OFFSET','JOIN','INNER','LEFT','RIGHT','FULL','CROSS','UNION','VALUES','SET','RETURNING','CREATE','ALTER','DROP','INSERT','UPDATE','DELETE','WITH']);
    const clauseContinuations = new Set(['BY','INTO','TABLE','VIEW','INDEX','DATABASE','OR','AND','ON','ELSE','WHEN']);
    const allKeywords = new Set(['ADD','ALL','ALTER','AND','AS','ASC','BETWEEN','BY','CASE','CHECK','COLUMN','CONSTRAINT','CREATE','CROSS','DATABASE','DEFAULT','DELETE','DESC','DISTINCT','DROP','ELSE','END','EXISTS','FOREIGN','FROM','FULL','GROUP','HAVING','IN','INDEX','INNER','INSERT','INTO','IS','JOIN','KEY','LEFT','LIKE','LIMIT','NOT','NULL','OFFSET','ON','OR','ORDER','OUTER','PRIMARY','REFERENCES','RETURNING','RIGHT','SELECT','SET','TABLE','THEN','UNION','UNIQUE','UPDATE','VALUES','VIEW','WHEN','WHERE','WITH']);

    const setStatus = (message: string, type: 'default' | 'success' | 'error' = 'default') => {
      status.textContent = message;
      status.classList.toggle('success', type === 'success');
      status.classList.toggle('error', type === 'error');
      inputSql.dataset.invalid = String(type === 'error');
      outputSql.dataset.invalid = String(type === 'error');
    };

    const getIndent = () => indentSelect.value === 'tab' ? '\t' : ' '.repeat(Number(indentSelect.value));
    const byteSize = (value: string) => new Blob([value]).size;
    const formatBytes = (bytes: number) => bytes < 1024 ? `${bytes} B` : bytes < 1024 * 1024 ? `${(bytes / 1024).toFixed(1)} KB` : `${(bytes / 1024 / 1024).toFixed(2)} MB`;

    const updateStats = () => {
      const value = outputSql.value || inputSql.value;
      lineCount.textContent = `${copy.stats.lines}: ${value ? value.split('\n').length : 0}`;
      charCount.textContent = `${copy.stats.characters}: ${value.length}`;
      sizeCount.textContent = `${copy.stats.size}: ${formatBytes(byteSize(value))}`;
    };

    const isWordChar = (char: string) => /[A-Za-z0-9_.$]/.test(char);
    const applyCase = (word: string) => {
      const upper = word.toUpperCase();
      if (!allKeywords.has(upper)) return word;
      if (keywordCase.value === 'lower') return word.toLowerCase();
      if (keywordCase.value === 'upper') return upper;
      return word;
    };

    const tokenize = (sql: string) => {
      const tokens: Token[] = [];
      let i = 0;

      while (i < sql.length) {
        const char = sql[i];
        const next = sql[i + 1];

        if (/\s/.test(char)) {
          let value = char;
          i += 1;
          while (i < sql.length && /\s/.test(sql[i])) value += sql[i++];
          tokens.push({ type: 'space', value });
          continue;
        }

        if (char === '-' && next === '-') {
          let value = '--';
          i += 2;
          while (i < sql.length && sql[i] !== '\n') value += sql[i++];
          tokens.push({ type: 'comment', value });
          continue;
        }

        if (char === '/' && next === '*') {
          let value = '/*';
          i += 2;
          let closed = false;
          while (i < sql.length) {
            value += sql[i];
            if (sql[i] === '*' && sql[i + 1] === '/') {
              value += '/';
              i += 2;
              closed = true;
              break;
            }
            i += 1;
          }
          if (!closed) throw new Error(copy.messages.unclosedComment);
          tokens.push({ type: 'comment', value });
          continue;
        }

        if (char === '\'' || char === '"' || char === '`') {
          const quote = char;
          let value = char;
          i += 1;
          let closed = false;
          while (i < sql.length) {
            value += sql[i];
            if (sql[i] === quote) {
              if (sql[i + 1] === quote) {
                value += sql[i + 1];
                i += 2;
                continue;
              }
              i += 1;
              closed = true;
              break;
            }
            if (sql[i] === '\\' && i + 1 < sql.length) {
              value += sql[i + 1];
              i += 2;
              continue;
            }
            i += 1;
          }
          if (!closed) throw new Error(copy.messages.unclosedQuote.replace('{quote}', quote));
          tokens.push({ type: 'string', value });
          continue;
        }

        if (isWordChar(char)) {
          let value = char;
          i += 1;
          while (i < sql.length && isWordChar(sql[i])) value += sql[i++];
          tokens.push({ type: 'word', value });
          continue;
        }

        if ('(),;'.includes(char)) {
          tokens.push({ type: 'punctuation', value: char });
          i += 1;
          continue;
        }

        tokens.push({ type: 'operator', value: char });
        i += 1;
      }

      return tokens.filter((token) => token.type !== 'space');
    };

    const trimRight = (value: string) => value.replace(/[ \t]+$/g, '');
    const trimBlankLines = (value: string) => value.replace(/\n{3,}/g, '\n\n').trim();

    const formatSql = (sql: string) => {
      const tokens = tokenize(sql.trim());
      if (!tokens.length) throw new Error(copy.messages.pasteFirst);

      const indent = getIndent();
      let level = 0;
      let result = '';
      let previous = '';

      const newline = (extra = 0) => {
        result = trimRight(result);
        if (result && !result.endsWith('\n')) result += '\n';
        result += indent.repeat(Math.max(level + extra, 0));
      };

      const append = (value: string) => {
        if (!result || result.endsWith('\n') || result.endsWith(' ') || value === ',' || value === ')' || value === ';') result += value;
        else result += ` ${value}`;
        previous = value;
      };

      tokens.forEach((token) => {
        const upper = token.value.toUpperCase();

        if (token.type === 'comment') {
          newline();
          append(token.value);
          newline();
          return;
        }

        if (token.value === '(') {
          append('(');
          level += 1;
          return;
        }

        if (token.value === ')') {
          level = Math.max(level - 1, 0);
          if (result.endsWith('\n')) result += indent.repeat(level);
          append(')');
          return;
        }

        if (token.value === ',') {
          result = trimRight(result) + ',';
          newline();
          return;
        }

        if (token.value === ';') {
          result = trimRight(result) + ';';
          newline();
          newline();
          return;
        }

        if (token.type === 'word' && lineKeywords.has(upper)) {
          if (result && !result.endsWith('\n') && previous !== '(') newline();
          append(applyCase(token.value));
          return;
        }

        if (token.type === 'word' && clauseContinuations.has(upper)) {
          append(applyCase(token.value));
          return;
        }

        append(token.type === 'word' ? applyCase(token.value) : token.value);
      });

      return trimBlankLines(result);
    };

    const minifySql = (sql: string) => {
      const tokens = tokenize(sql.trim());
      if (!tokens.length) throw new Error(copy.messages.pasteFirst);
      return tokens.map((token, index) => {
        const previous = tokens[index - 1];
        const value = token.type === 'word' ? applyCase(token.value) : token.value;
        if (!previous || token.value === ',' || token.value === ')' || token.value === ';' || previous.value === '(') return value;
        if (previous.value === ',' || previous.value === '(') return value;
        return ` ${value}`;
      }).join('').replace(/\s+/g, ' ').trim();
    };

    const run = async (mode: 'format' | 'minify') => {
      await new Promise((resolve) => window.requestAnimationFrame(resolve));

      try {
        outputSql.value = mode === 'format' ? formatSql(inputSql.value) : minifySql(inputSql.value);
        setStatus(
          (mode === 'format' ? copy.messages.formatted : copy.messages.minified)
            .replace('{dialect}', dialectSelect.options[dialectSelect.selectedIndex].text),
          'success'
        );
      } catch (error) {
        outputSql.value = '';
        setStatus(error instanceof Error ? error.message : copy.messages.formatError, 'error');
      }

      updateStats();
    };

    formatBtn.addEventListener('click', () => run('format'));
    minifyBtn.addEventListener('click', () => run('minify'));

    copyBtn.addEventListener('click', async () => {
      if (!outputSql.value) {
        setStatus(copy.messages.noCopy, 'error');
        return;
      }

      try {
        await navigator.clipboard.writeText(outputSql.value);
        setStatus(copy.messages.copied, 'success');
      } catch {
        outputSql.focus();
        outputSql.select();
        setStatus(copy.messages.copyError, 'error');
      }
    });

    downloadBtn.addEventListener('click', () => {
      const value = outputSql.value || inputSql.value;
      if (!value.trim()) {
        setStatus(copy.messages.noDownload, 'error');
        return;
      }

      const blob = new Blob([value], { type: 'text/sql;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'query.sql';
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      setStatus(copy.messages.downloaded, 'success');
    });

    clearBtn.addEventListener('click', () => {
      inputSql.value = '';
      outputSql.value = '';
      setStatus(copy.messages.cleared);
      updateStats();
      inputSql.focus();
    });

    [inputSql, outputSql].forEach((element) => element.addEventListener('input', updateStats));
    [indentSelect, keywordCase, dialectSelect].forEach((element) => element.addEventListener('change', () => {
      if (inputSql.value.trim()) run('format');
    }));

    updateStats();
  </script>
</Layout>
