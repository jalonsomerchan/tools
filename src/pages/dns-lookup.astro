---
import Layout from '../layouts/Layout.astro';

const title = 'DNS lookup';
const description = 'Consulta registros DNS con Google Public DNS JSON API directamente desde el navegador, sin backend propio.';
---

<Layout title={title} description={description} path="/dns-lookup/" translated={false}>
  <section class="dns-page">
    <div class="eyebrow">Consulta externa</div>

    <h1>{title}</h1>

    <p class="hero-text">
      Consulta registros A, AAAA, CNAME, MX, TXT, NS, SOA y CAA usando Google Public DNS JSON API desde el navegador.
    </p>

    <div class="warning-box" role="note">
      ⚠️ Esta herramienta no es 100% local. El dominio que introduzcas y el tipo de registro seleccionado se enviarán a Google Public DNS para resolver la consulta. Alon Tools no usa backend propio ni almacena la consulta en servidor.
    </div>

    <section class="tool-card" aria-labelledby="lookupTitle">
      <div class="section-heading">
        <div>
          <h2 id="lookupTitle">Consultar DNS</h2>
          <p>Introduce un dominio sin protocolo, por ejemplo <code>example.com</code>.</p>
        </div>
      </div>

      <form id="dnsForm" class="lookup-form">
        <div class="field domain-field">
          <label for="domainInput">Dominio</label>
          <input id="domainInput" type="text" placeholder="example.com" autocomplete="off" spellcheck="false" inputmode="url" />
        </div>

        <div class="field type-field">
          <label for="recordType">Tipo</label>
          <select id="recordType">
            <option value="A">A</option>
            <option value="AAAA">AAAA</option>
            <option value="CNAME">CNAME</option>
            <option value="MX">MX</option>
            <option value="TXT">TXT</option>
            <option value="NS">NS</option>
            <option value="SOA">SOA</option>
            <option value="CAA">CAA</option>
          </select>
        </div>

        <button class="primary" id="lookupBtn" type="submit">Consultar</button>
      </form>

      <p class="status" id="status" role="status" aria-live="polite">Listo para consultar registros DNS.</p>
    </section>

    <section class="results" id="results" hidden aria-labelledby="resultsTitle">
      <div class="results-header">
        <div>
          <h2 id="resultsTitle">Resultados</h2>
          <p id="queryInfo">-</p>
        </div>

        <div class="toolbar">
          <button id="copySummaryBtn" type="button">Copiar resumen</button>
          <button id="copyJsonBtn" type="button">Copiar JSON</button>
        </div>
      </div>

      <div class="summary-grid" id="summaryGrid"></div>

      <div class="json-panel">
        <h3>Respuesta JSON completa</h3>
        <pre id="jsonOutput"></pre>
      </div>
    </section>

    <section class="tool-card history-panel" aria-labelledby="historyTitle">
      <div class="results-header">
        <div>
          <h2 id="historyTitle">Historial local</h2>
          <p>Últimas consultas guardadas solo en este navegador mediante localStorage.</p>
        </div>

        <button id="clearHistoryBtn" type="button">Borrar historial</button>
      </div>

      <div id="historyList" class="history-list">
        <p class="empty-history">Todavía no hay consultas guardadas.</p>
      </div>
    </section>
  </section>

  <style>
    .dns-page {
      padding: 4rem 0;
    }

    .warning-box {
      margin-top: 1.5rem;
      margin-bottom: 2rem;
      padding: 1rem 1.2rem;
      border-radius: 18px;
      background: rgba(251, 191, 36, .12);
      border: 1px solid rgba(251,191,36,.25);
      color: #fde68a;
      line-height: 1.7;
    }

    .section-heading,
    .results-header {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.5rem;
      align-items: flex-start;
    }

    h2,
    h3 {
      margin: 0 0 .35rem;
    }

    .section-heading p,
    .results-header p {
      margin: 0;
      color: var(--muted);
      line-height: 1.7;
    }

    code {
      color: white;
      background: rgba(148, 163, 184, .12);
      border-radius: .4rem;
      padding: .1rem .35rem;
    }

    .lookup-form {
      display: grid;
      grid-template-columns: minmax(220px, 1fr) minmax(120px, 180px) auto;
      gap: 1rem;
      align-items: end;
    }

    label {
      display: block;
      margin-bottom: .55rem;
      font-weight: 700;
    }

    input,
    select {
      width: 100%;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      font: inherit;
    }

    button {
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #0f172a;
      color: white;
      padding: 1rem 1.2rem;
      cursor: pointer;
      font-weight: 700;
      transition: transform .15s ease, border-color .15s ease, opacity .15s ease;
    }

    button:hover:not(:disabled) {
      transform: translateY(-1px);
      border-color: rgba(56,189,248,.45);
    }

    button.primary {
      background: var(--primary);
      color: #020617;
      border-color: transparent;
    }

    button:disabled {
      cursor: not-allowed;
      opacity: .55;
    }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: .75rem;
    }

    .status {
      color: var(--muted);
      margin: 1rem 0 0;
      line-height: 1.7;
    }

    .status.error {
      color: #fca5a5;
    }

    .status.success {
      color: #86efac;
    }

    .results,
    .history-panel {
      margin-top: 1.5rem;
      padding: 1.5rem;
      border-radius: 24px;
      border: 1px solid var(--border);
      background: var(--card);
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
    }

    .result-card,
    .json-panel,
    .history-item {
      border-radius: 20px;
      border: 1px solid var(--border);
      background: rgba(2,6,23,.55);
      padding: 1rem;
    }

    .result-card span,
    .history-item span {
      display: block;
      color: var(--muted);
      font-size: .92rem;
      margin-bottom: .45rem;
    }

    .result-card strong {
      display: block;
      line-height: 1.55;
      overflow-wrap: anywhere;
      white-space: pre-wrap;
    }

    .json-panel {
      margin-top: 1.5rem;
    }

    pre {
      white-space: pre-wrap;
      word-break: break-word;
      overflow-x: auto;
      line-height: 1.6;
      color: var(--muted);
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      margin-bottom: 0;
    }

    .history-list {
      display: grid;
      gap: .8rem;
    }

    .history-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    .history-item button {
      flex-shrink: 0;
      padding: .75rem 1rem;
    }

    .empty-history {
      color: var(--muted);
      margin: 0;
    }

    @media (max-width: 820px) {
      .lookup-form,
      .section-heading,
      .results-header,
      .history-item {
        grid-template-columns: 1fr;
        flex-direction: column;
        align-items: stretch;
      }
    }
  </style>

  <script>
    const DNS_TYPES = ['A', 'AAAA', 'CNAME', 'MX', 'TXT', 'NS', 'SOA', 'CAA'];
    const HISTORY_KEY = 'alon-tools-dns-lookup-history';

    const dnsForm = document.getElementById('dnsForm') as HTMLFormElement;
    const domainInput = document.getElementById('domainInput') as HTMLInputElement;
    const recordType = document.getElementById('recordType') as HTMLSelectElement;
    const lookupBtn = document.getElementById('lookupBtn') as HTMLButtonElement;
    const status = document.getElementById('status') as HTMLParagraphElement;
    const results = document.getElementById('results') as HTMLElement;
    const queryInfo = document.getElementById('queryInfo') as HTMLParagraphElement;
    const summaryGrid = document.getElementById('summaryGrid') as HTMLDivElement;
    const jsonOutput = document.getElementById('jsonOutput') as HTMLPreElement;
    const copySummaryBtn = document.getElementById('copySummaryBtn') as HTMLButtonElement;
    const copyJsonBtn = document.getElementById('copyJsonBtn') as HTMLButtonElement;
    const historyList = document.getElementById('historyList') as HTMLDivElement;
    const clearHistoryBtn = document.getElementById('clearHistoryBtn') as HTMLButtonElement;

    let lastSummary = '';
    let lastJson = '';

    const setStatus = (message: string, type: 'default' | 'success' | 'error' = 'default') => {
      status.textContent = message;
      status.classList.toggle('success', type === 'success');
      status.classList.toggle('error', type === 'error');
    };

    const normalizeDomain = (value: string) => value
      .trim()
      .replace(/^https?:\/\//i, '')
      .replace(/^\/\//, '')
      .split('/')[0]
      .split('?')[0]
      .split('#')[0]
      .replace(/\.$/, '')
      .toLowerCase();

    const isValidDomain = (domain: string) => {
      if (!domain || domain.length > 253 || domain.includes('..') || domain.includes('_')) {
        return false;
      }

      const labels = domain.split('.');

      if (labels.length < 2) {
        return false;
      }

      return labels.every((label) => /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/.test(label));
    };

    const getHistory = () => {
      try {
        const value = localStorage.getItem(HISTORY_KEY);
        const parsed = value ? JSON.parse(value) : [];
        return Array.isArray(parsed) ? parsed.slice(0, 10) : [];
      } catch {
        return [];
      }
    };

    const saveHistoryItem = (domain: string, type: string) => {
      const history = getHistory().filter((item) => item.domain !== domain || item.type !== type);
      history.unshift({ domain, type, date: new Date().toISOString() });
      localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(0, 10)));
      renderHistory();
    };

    const renderHistory = () => {
      const history = getHistory();

      if (!history.length) {
        historyList.innerHTML = '<p class="empty-history">Todavía no hay consultas guardadas.</p>';
        return;
      }

      historyList.replaceChildren(...history.map((item) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'history-item';

        const text = document.createElement('div');
        const date = item.date ? new Date(item.date).toLocaleString() : 'Fecha desconocida';
        text.innerHTML = `<span>${date}</span><strong>${item.domain} · ${item.type}</strong>`;

        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = 'Repetir';
        button.addEventListener('click', () => {
          domainInput.value = item.domain;
          recordType.value = item.type;
          dnsForm.requestSubmit();
        });

        wrapper.append(text, button);
        return wrapper;
      }));
    };

    const dnsStatusText = (code: number) => {
      const codes: Record<number, string> = {
        0: 'NOERROR',
        1: 'FORMERR',
        2: 'SERVFAIL',
        3: 'NXDOMAIN',
        4: 'NOTIMP',
        5: 'REFUSED'
      };

      return codes[code] || `Código ${code}`;
    };

    const typeName = (type: number) => {
      const types: Record<number, string> = {
        1: 'A',
        2: 'NS',
        5: 'CNAME',
        6: 'SOA',
        15: 'MX',
        16: 'TXT',
        28: 'AAAA',
        257: 'CAA'
      };

      return types[type] || String(type);
    };

    const createCard = (label: string, value: string) => {
      const card = document.createElement('div');
      card.className = 'result-card';
      const span = document.createElement('span');
      span.textContent = label;
      const strong = document.createElement('strong');
      strong.textContent = value || '-';
      card.append(span, strong);
      return card;
    };

    const summarizeAnswer = (answer) => {
      if (!answer?.length) {
        return 'Sin registros en Answer.';
      }

      return answer.map((record) => `${typeName(record.type)} · TTL ${record.TTL ?? '-'} · ${record.data || '-'}`).join('\n');
    };

    const renderResults = (domain: string, type: string, data) => {
      const answers = Array.isArray(data.Answer) ? data.Answer : [];
      const authority = Array.isArray(data.Authority) ? data.Authority : [];
      const question = Array.isArray(data.Question) ? data.Question : [];
      const statusText = dnsStatusText(Number(data.Status));
      const answerSummary = summarizeAnswer(answers);

      summaryGrid.replaceChildren(
        createCard('Dominio consultado', domain),
        createCard('Tipo solicitado', type),
        createCard('Estado DNS', statusText),
        createCard('Respuestas', String(answers.length)),
        createCard('Registros Answer', answerSummary),
        createCard('Authority', authority.length ? summarizeAnswer(authority) : 'Sin registros Authority.'),
        createCard('Question', question.map((item) => `${item.name || domain} · ${typeName(item.type)}`).join('\n') || '-')
      );

      queryInfo.textContent = `${domain} · ${type} · enviado a https://dns.google/resolve`;
      lastSummary = `DNS lookup\nDominio: ${domain}\nTipo: ${type}\nEstado: ${statusText}\nRespuestas: ${answers.length}\n\n${answerSummary}`;
      lastJson = JSON.stringify(data, null, 2);
      jsonOutput.textContent = lastJson;
      results.hidden = false;
    };

    dnsForm.addEventListener('submit', async (event) => {
      event.preventDefault();

      const domain = normalizeDomain(domainInput.value);
      const type = recordType.value;
      domainInput.value = domain;

      if (!isValidDomain(domain)) {
        setStatus('Introduce un dominio válido, sin protocolo ni rutas. Ejemplo: example.com', 'error');
        domainInput.focus();
        return;
      }

      if (!DNS_TYPES.includes(type)) {
        setStatus('Selecciona un tipo de registro DNS válido.', 'error');
        return;
      }

      lookupBtn.disabled = true;
      setStatus(`Consultando ${type} de ${domain} en Google Public DNS...`);

      try {
        const endpoint = new URL('https://dns.google/resolve');
        endpoint.searchParams.set('name', domain);
        endpoint.searchParams.set('type', type);

        const response = await fetch(endpoint.toString(), {
          headers: {
            accept: 'application/dns-json'
          }
        });

        if (!response.ok) {
          throw new Error('dns-request-failed');
        }

        const data = await response.json();
        renderResults(domain, type, data);
        saveHistoryItem(domain, type);

        if (Number(data.Status) === 0) {
          setStatus('Consulta DNS completada.', 'success');
        } else {
          setStatus(`Consulta completada con estado ${dnsStatusText(Number(data.Status))}.`, 'error');
        }
      } catch {
        setStatus('No se pudo consultar Google Public DNS. Revisa la conexión o prueba más tarde.', 'error');
      } finally {
        lookupBtn.disabled = false;
      }
    });

    copySummaryBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(lastSummary);
        setStatus('Resumen copiado.', 'success');
      } catch {
        setStatus('No se pudo copiar el resumen.', 'error');
      }
    });

    copyJsonBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(lastJson);
        setStatus('JSON copiado.', 'success');
      } catch {
        setStatus('No se pudo copiar el JSON.', 'error');
      }
    });

    clearHistoryBtn.addEventListener('click', () => {
      localStorage.removeItem(HISTORY_KEY);
      renderHistory();
      setStatus('Historial local borrado.', 'success');
    });

    renderHistory();
  </script>
</Layout>
