---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';
const title = 'SimplePostman';
const description = es ? 'Cliente HTTP ligero para probar APIs desde el navegador.' : 'Lightweight HTTP client to test APIs from the browser.';
const t = {
  intro: es ? 'Prepara peticiones HTTP, genera cURL y revisa respuestas sin salir del navegador.' : 'Prepare HTTP requests, generate cURL and inspect responses without leaving the browser.',
  method: es ? 'Método' : 'Method', url: 'URL', send: es ? 'Enviar' : 'Send', curl: 'cURL', request: es ? 'Petición' : 'Request', response: es ? 'Respuesta' : 'Response', headers: 'Headers', auth: 'Auth', body: 'Body', addHeader: es ? 'Añadir header' : 'Add header', clear: es ? 'Limpiar' : 'Clear', format: es ? 'Generar cURL' : 'Generate cURL', copy: es ? 'Copiar' : 'Copy', importCurl: es ? 'Importar cURL' : 'Import cURL', parseCurl: es ? 'Leer cURL' : 'Parse cURL', status: es ? 'Estado' : 'Status', time: es ? 'Tiempo' : 'Time', size: es ? 'Tamaño' : 'Size',
  noAuth: es ? 'Sin auth' : 'No auth', bearer: 'Bearer token', basic: 'Basic auth', noBody: es ? 'Sin body' : 'No body', bodyType: es ? 'Tipo de body' : 'Body type',
  ready: es ? 'Listo para preparar una petición.' : 'Ready to prepare a request.', invalidUrl: es ? 'La URL debe empezar por http:// o https://.' : 'URL must start with http:// or https://.', invalidJson: es ? 'El body JSON no es válido.' : 'JSON body is not valid.', done: es ? 'Petición completada.' : 'Request completed.', fetchError: es ? 'No se pudo completar la petición. Puede ser CORS o red.' : 'Request could not be completed. It may be CORS or network.', copied: es ? 'Copiado.' : 'Copied.', cleared: es ? 'Contenido limpiado.' : 'Cleared.', curlParsed: es ? 'cURL importado.' : 'cURL imported.',
  bodyPlaceholder: '{\n  "title": "Hola",\n  "body": "Probando SimplePostman"\n}'
};
---

<Layout title={title} description={description} lang={lang} path="/simple-postman/" translated={true}>
  <section class="sp-page">
    <h1>{title}</h1>
    <p class="hero-text">{t.intro}</p>

    <section class="tool-card sp-tool" aria-label={title}>
      <div class="topbar">
        <label><span>{t.method}</span><select id="method"><option>GET</option><option>POST</option><option>PUT</option><option>PATCH</option><option>DELETE</option><option>HEAD</option><option>OPTIONS</option></select></label>
        <label class="url"><span>{t.url}</span><input id="url" type="url" placeholder="https://jsonplaceholder.typicode.com/posts/1" /></label>
        <button id="send" class="primary" type="button">🚀 {t.send}</button>
        <button id="makeCurl" type="button">⌘ {t.format}</button>
      </div>

      <div class="chips">
        <button data-example="get" type="button">GET JSONPlaceholder</button>
        <button data-example="github" type="button">GET GitHub</button>
        <button data-example="post" type="button">POST test</button>
      </div>

      <div class="grid">
        <section class="panel">
          <div class="panel-head"><div><h2>🧩 {t.request}</h2><p>{es ? 'Headers y auth quedan recogidos. Body queda abierto.' : 'Headers and auth are collapsed. Body stays open.'}</p></div><button id="clear" class="danger" type="button">🧹 {t.clear}</button></div>

          <div class="presets">
            <button data-preset="json" type="button">{} JSON</button>
            <button data-preset="form" type="button">▤ Form</button>
            <button data-preset="header" type="button">＋ Header</button>
          </div>

          <details>
            <summary>📋 {t.headers}</summary>
            <div id="headers" class="headers"></div>
            <button id="addHeader" type="button">＋ {t.addHeader}</button>
          </details>

          <details>
            <summary>🔐 {t.auth}</summary>
            <div class="auth-grid">
              <label>{t.auth}<select id="auth"><option value="none">{t.noAuth}</option><option value="bearer">{t.bearer}</option><option value="basic">{t.basic}</option></select></label>
              <label data-auth-field="bearer">Token<input id="token" type="password" placeholder="Token" /></label>
              <label data-auth-field="basic">User<input id="user" type="text" placeholder="user" /></label>
              <label data-auth-field="basic">Password<input id="pass" type="password" placeholder="password" /></label>
            </div>
          </details>

          <details open>
            <summary>✍️ {t.body}</summary>
            <label>{t.bodyType}<select id="bodyType"><option value="none">{t.noBody}</option><option value="json" selected>JSON</option><option value="text">Text</option><option value="form">x-www-form-urlencoded</option></select></label>
            <textarea id="body" aria-label={t.body} spellcheck="false" placeholder={t.bodyPlaceholder}></textarea>
          </details>

          <details>
            <summary>🧾 {t.curl}</summary>
            <textarea id="curlIn" aria-label={t.importCurl} class="code small" spellcheck="false" placeholder="curl -X GET https://api.example.com"></textarea>
            <div class="actions"><button id="parseCurl" type="button">📥 {t.parseCurl}</button><button id="copyCurl" type="button">📋 {t.copy} cURL</button></div>
            <textarea id="curlOut" aria-label={t.curl} class="code small" readonly spellcheck="false"></textarea>
          </details>

          <ul id="warnings" class="warnings"></ul>
        </section>

        <section class="panel">
          <div class="panel-head"><div><h2>📡 {t.response}</h2><p id="statusText">{t.ready}</p></div><button id="copyResponse" type="button">📋 {t.copy}</button></div>
          <div class="metrics"><output id="statusMetric">● {t.status}: —</output><output id="timeMetric">⏱️ {t.time}: —</output><output id="sizeMetric">📦 {t.size}: —</output></div>
          <div class="tabs"><button class="tab active" data-view="pretty" type="button">✨ pretty</button><button class="tab" data-view="raw" type="button">◇ raw</button><button class="tab" data-view="headers" type="button">▦ headers</button></div>
          <pre id="response" class="response">{es ? 'La respuesta aparecerá aquí.' : 'The response will appear here.'}</pre>
        </section>
      </div>
    </section>
  </section>

  <style>
    .sp-page{padding:clamp(2rem,6vw,3.5rem) 0}.sp-tool{margin-top:1.25rem;padding:1rem;display:grid;gap:1rem}.topbar{position:sticky;top:.75rem;z-index:5;display:grid;grid-template-columns:8.5rem minmax(0,1fr) max-content max-content;gap:.65rem;align-items:end;padding:.85rem;border:1px solid var(--color-border);border-radius:24px;background:color-mix(in srgb,var(--color-surface) 94%,transparent);box-shadow:var(--shadow-sm);backdrop-filter:blur(14px)}.topbar label{display:grid;gap:.25rem}.topbar span{font-size:.76rem;text-transform:uppercase;letter-spacing:.08em;color:var(--color-text-soft);font-weight:950}.chips,.presets,.actions,.tabs{display:flex;flex-wrap:wrap;gap:.5rem}.chips{padding:.65rem;border:1px solid var(--color-border);border-radius:18px;background:var(--color-surface-soft)}button{min-height:2.5rem;border:1px solid var(--color-border);border-radius:999px;background:var(--color-surface);color:var(--color-text);padding:.58rem .86rem;font:inherit;font-weight:900;cursor:pointer;box-shadow:var(--shadow-xs);white-space:nowrap}button:hover{border-color:color-mix(in srgb,var(--color-primary) 55%,var(--color-border));transform:translateY(-1px)}button.primary{background:var(--color-primary);border-color:transparent;color:#020617}.danger{color:var(--color-danger)}.grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(390px,1fr);gap:1rem;align-items:start}.panel{display:grid;gap:1rem;min-width:0;padding:1rem;border:1px solid var(--color-border);border-radius:24px;background:color-mix(in srgb,var(--color-surface) 95%,transparent);box-shadow:var(--shadow-xs)}.panel-head{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.panel h2{margin:0 0 .2rem;font-size:1.18rem}.panel p{margin:0;color:var(--color-text-muted)}details{padding:.85rem;border:1px solid var(--color-border);border-radius:18px;background:var(--color-surface-soft)}summary{cursor:pointer;color:var(--color-text);font-weight:950}details[open] summary{margin-bottom:.75rem}label{display:grid;gap:.4rem;color:var(--color-text-muted);font-weight:850}input,select,textarea{width:100%;min-width:0;border:1px solid var(--color-border);border-radius:14px;background:var(--color-surface);color:var(--color-text);padding:.75rem .85rem;font:inherit}textarea{min-height:170px;font-family:var(--font-mono);line-height:1.55;resize:vertical}.code{background:#111827;color:#e5e7eb}.small{min-height:100px}.headers{display:grid;gap:.55rem;margin-bottom:.75rem}.header-row{display:grid!important;grid-template-columns:minmax(7rem,1fr) minmax(8rem,1.25fr) 2.6rem!important;gap:.5rem;align-items:center}.header-row input{height:2.6rem;min-height:2.6rem;padding:.52rem .7rem}.header-row button{width:2.6rem!important;min-width:2.6rem!important;height:2.6rem!important;min-height:2.6rem!important;padding:0!important;border-radius:12px}.auth-grid,.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.metrics{grid-template-columns:repeat(3,minmax(0,1fr))}.metrics output{padding:.8rem;border:1px solid var(--color-border);border-radius:16px;background:var(--color-surface-soft);color:var(--color-text-muted);font-weight:900}.metrics output.ok{color:var(--color-success);border-color:color-mix(in srgb,var(--color-success) 35%,var(--color-border))}.metrics output.err{color:var(--color-danger);border-color:color-mix(in srgb,var(--color-danger) 35%,var(--color-border))}.tab.active{background:#111827;color:#fff;border-color:#111827}.response{min-height:620px;max-height:820px;overflow:auto;margin:0;padding:1rem;border-radius:18px;background:#111827;color:#e5e7eb;font:500 .92rem/1.6 var(--font-mono);white-space:pre-wrap;word-break:break-word}.warnings{margin:0;padding-left:1.2rem;color:#f59e0b}.warnings:empty{display:none}[data-hidden=true]{display:none}.status-ok{color:var(--color-success)!important}.status-error{color:var(--color-danger)!important}@media(max-width:1080px){.topbar{position:static;grid-template-columns:8rem minmax(0,1fr)}.topbar button{width:100%}.grid{grid-template-columns:1fr}.response{min-height:360px}.metrics{grid-template-columns:1fr}}@media(max-width:640px){.topbar{grid-template-columns:1fr}.auth-grid{grid-template-columns:1fr}.header-row{grid-template-columns:minmax(5.5rem,.9fr) minmax(6.5rem,1.1fr) 2.4rem!important;gap:.35rem}.header-row input{font-size:.88rem;padding:.5rem}.header-row button{width:2.4rem!important;min-width:2.4rem!important}.chips button,.presets button,.actions button,.tabs button{flex:1 1 calc(50% - .5rem)}}
  </style>

  <script define:vars={{ t }}>
    window.addEventListener('DOMContentLoaded',()=>{
      const $=id=>document.getElementById(id), method=$('method'), url=$('url'), headers=$('headers'), auth=$('auth'), token=$('token'), user=$('user'), pass=$('pass'), bodyType=$('bodyType'), body=$('body'), curlIn=$('curlIn'), curlOut=$('curlOut'), response=$('response'), statusText=$('statusText'), statusMetric=$('statusMetric'), timeMetric=$('timeMetric'), sizeMetric=$('sizeMetric'), warnings=$('warnings');
      let current={pretty:'',raw:'',headers:''}, view='pretty';
      const status=(m,type='')=>{statusText.textContent=m;statusText.classList.toggle('status-ok',type==='ok');statusText.classList.toggle('status-error',type==='error')};
      const warn=m=>{const li=document.createElement('li');li.textContent=m;warnings.append(li)};
      const clearWarn=()=>warnings.replaceChildren();
      const validUrl=v=>{try{const u=new URL(v);return ['http:','https:'].includes(u.protocol)}catch{return false}};
      const bytes=n=>n<1024?`${n} B`:n<1048576?`${(n/1024).toFixed(1)} KB`:`${(n/1048576).toFixed(2)} MB`;
      const quote=v=>`'${String(v).replaceAll("'","'\\''")}'`;
      const addHeader=(name='',value='')=>{const row=document.createElement('div');row.className='header-row';row.innerHTML='<input data-name aria-label="Header name" placeholder="Content-Type"><input data-value aria-label="Header value" placeholder="application/json"><button type="button" aria-label="Remove">×</button>';row.querySelector('[data-name]').value=name;row.querySelector('[data-value]').value=value;row.querySelector('button').onclick=()=>{row.remove();makeCurl()};row.querySelectorAll('input').forEach(i=>i.oninput=makeCurl);headers.append(row)};
      const readHeaders=()=>[...headers.querySelectorAll('.header-row')].map(r=>({name:r.querySelector('[data-name]').value.trim(),value:r.querySelector('[data-value]').value.trim()})).filter(h=>h.name);
      const setHeader=(n,v)=>{const row=[...headers.querySelectorAll('.header-row')].find(r=>r.querySelector('[data-name]').value.trim().toLowerCase()===n.toLowerCase());row?row.querySelector('[data-value]').value=v:addHeader(n,v)};
      const updateAuth=()=>document.querySelectorAll('[data-auth-field]').forEach(el=>el.dataset.hidden=String(el.dataset.authField!==auth.value));
      const getBody=()=>{const m=method.value.toUpperCase();if(m==='GET'||m==='HEAD'||bodyType.value==='none')return undefined;if(bodyType.value==='json'){const raw=body.value.trim();if(!raw)return undefined;JSON.parse(raw);return raw}if(bodyType.value==='form')return new URLSearchParams(body.value).toString();return body.value};
      const buildHeaders=()=>{const h=new Headers();readHeaders().forEach(x=>h.set(x.name,x.value));if(auth.value==='bearer'&&token.value.trim())h.set('Authorization',`Bearer ${token.value.trim()}`);if(auth.value==='basic'&&user.value)h.set('Authorization',`Basic ${btoa(`${user.value}:${pass.value}`)}`);return h};
      const validate=()=>{clearWarn();if(!validUrl(url.value.trim())){warn(t.invalidUrl);return false}if(bodyType.value==='json'&&body.value.trim()&&!['GET','HEAD'].includes(method.value)){try{JSON.parse(body.value)}catch{warn(t.invalidJson);return false}}return true};
      const makeCurl=()=>{const parts=['curl','-X',method.value,quote(url.value.trim()||'https://api.example.com')];readHeaders().forEach(h=>parts.push('-H',quote(`${h.name}: ${h.value}`)));if(auth.value==='bearer'&&token.value.trim())parts.push('-H',quote(`Authorization: Bearer ${token.value.trim()}`));if(auth.value==='basic'&&user.value)parts.push('-u',quote(`${user.value}:${pass.value}`));try{const b=getBody();if(b!==undefined)parts.push('--data-raw',quote(b))}catch{}curlOut.value=parts.join(' \\\n  ');validate();return curlOut.value};
      const render=()=>{document.querySelectorAll('.tab').forEach(tab=>tab.classList.toggle('active',tab.dataset.view===view));response.textContent=current[view]||''};
      const send=async()=>{if(!validate()){status(t.invalidUrl,'error');return}let payload;try{payload=getBody()}catch{status(t.invalidJson,'error');return}const btn=$('send');btn.disabled=true;btn.textContent='⏳ ...';const start=performance.now();try{const res=await fetch(url.value.trim(),{method:method.value,headers:buildHeaders(),body:payload,mode:'cors'});const raw=await res.text();let pretty=raw;if((res.headers.get('content-type')||'').includes('json')||/^[\[{]/.test(raw.trim()))try{pretty=JSON.stringify(JSON.parse(raw),null,2)}catch{}current={pretty,raw,headers:[...res.headers.entries()].map(([k,v])=>`${k}: ${v}`).join('\n')};view='pretty';render();statusMetric.textContent=`${t.status}: ${res.status} ${res.statusText}`;statusMetric.className=res.ok?'ok':'err';timeMetric.textContent=`⏱️ ${t.time}: ${Math.round(performance.now()-start)} ms`;sizeMetric.textContent=`📦 ${t.size}: ${bytes(new Blob([raw]).size)}`;status(t.done,res.ok?'ok':'error')}catch(e){current={pretty:`${t.fetchError}\n\n${e.message||e}`,raw:'',headers:''};view='pretty';render();warn(t.fetchError);status(t.fetchError,'error')}finally{btn.disabled=false;btn.textContent=`🚀 ${t.send}`}};
      const parseCurl=()=>{const raw=curlIn.value.trim();if(!raw)return;const urlMatch=raw.match(/https?:\/\/[^\s'\"]+/);if(urlMatch)url.value=urlMatch[0];const methodMatch=raw.match(/(?:-X|--request)\s+([A-Z]+)/i);if(methodMatch)method.value=methodMatch[1].toUpperCase();headers.replaceChildren();[...raw.matchAll(/(?:-H|--header)\s+['\"]([^:'\"]+):\s*([^'\"]+)['\"]/g)].forEach(m=>addHeader(m[1],m[2]));const data=raw.match(/(?:-d|--data(?:-raw)?)\s+['\"]([^'\"]+)['\"]/);if(data){body.value=data[1];bodyType.value=data[1].trim().startsWith('{')?'json':'text';if(method.value==='GET')method.value='POST'}makeCurl();status(t.curlParsed,'ok')};
      document.querySelectorAll('[data-preset]').forEach(b=>b.onclick=()=>{if(b.dataset.preset==='json'){setHeader('Accept','application/json');setHeader('Content-Type','application/json');bodyType.value='json'}else if(b.dataset.preset==='form'){setHeader('Content-Type','application/x-www-form-urlencoded');bodyType.value='form'}else addHeader();makeCurl()});
      document.querySelectorAll('[data-example]').forEach(b=>b.onclick=()=>{if(b.dataset.example==='get'){method.value='GET';url.value='https://jsonplaceholder.typicode.com/posts/1'}if(b.dataset.example==='github'){method.value='GET';url.value='https://api.github.com/repos/jalonsomerchan/tools'}if(b.dataset.example==='post'){method.value='POST';url.value='https://jsonplaceholder.typicode.com/posts';bodyType.value='json';body.value=t.bodyPlaceholder;setHeader('Content-Type','application/json')}makeCurl()});
      $('addHeader').onclick=()=>addHeader();$('send').onclick=send;$('makeCurl').onclick=()=>{makeCurl();status('cURL generado','ok')};$('copyCurl').onclick=async()=>{await navigator.clipboard.writeText(makeCurl());status(t.copied,'ok')};$('copyResponse').onclick=async()=>{await navigator.clipboard.writeText(current[view]||response.textContent||'');status(t.copied,'ok')};$('parseCurl').onclick=parseCurl;$('clear').onclick=()=>{url.value='';body.value='';curlIn.value='';curlOut.value='';headers.replaceChildren();addHeader('Accept','application/json');current={pretty:'',raw:'',headers:''};render();response.textContent='';statusMetric.textContent=`● ${t.status}: —`;statusMetric.className='';timeMetric.textContent=`⏱️ ${t.time}: —`;sizeMetric.textContent=`📦 ${t.size}: —`;clearWarn();status(t.cleared)};
      [method,url,auth,token,user,pass,bodyType,body].forEach(el=>el.addEventListener('input',()=>{updateAuth();makeCurl()}));document.querySelectorAll('.tab').forEach(tab=>tab.onclick=()=>{view=tab.dataset.view;render()});addHeader('Accept','application/json');updateAuth();makeCurl();
    });
  </script>
</Layout>
