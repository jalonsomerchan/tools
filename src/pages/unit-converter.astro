---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, getLocalizedPath } from '../i18n/ui';
const lang=getLangFromUrl(Astro.url);const es=lang==='es';
const c=es?{title:'Conversor de unidades online y offline',description:'Convierte longitud, masa, temperatura y almacenamiento digital al instante. Gratis, sin registros y con cálculo local.',intro:'Convierte medidas habituales al instante, con precisión configurable y sin enviar datos por internet.',category:'Magnitud',value:'Valor',from:'De',to:'A',swap:'Intercambiar',precision:'Decimales',result:'Resultado',copy:'Copiar resultado',copied:'Resultado copiado.',length:'Longitud',mass:'Masa',temperature:'Temperatura',data:'Almacenamiento',how:'Cómo usar el conversor',privacy:'Disponible sin conexión',related:'Herramientas relacionadas'}:{title:'Online and offline unit converter',description:'Convert length, mass, temperature and digital storage instantly. Free, no sign-up and calculated locally.',intro:'Convert common measurements instantly with adjustable precision and no data sent over the internet.',category:'Measurement',value:'Value',from:'From',to:'To',swap:'Swap',precision:'Decimals',result:'Result',copy:'Copy result',copied:'Result copied.',length:'Length',mass:'Mass',temperature:'Temperature',data:'Digital storage',how:'How to use the converter',privacy:'Available offline',related:'Related tools'};
---
<Layout title={`${c.title} — Alon Tools`} description={c.description} lang={lang} path="/unit-converter/" translated={true}>
  <article class="tool-page"><header class="tool-hero"><span class="badge">100% local · Offline</span><h1>{c.title}</h1><p class="hero-text">{c.intro}</p></header>
    <section class="tool-card converter" aria-labelledby="converterTitle"><h2 id="converterTitle">{es?'Convertir medida':'Convert measurement'}</h2>
      <label>{c.category}<select id="category"><option value="length">{c.length}</option><option value="mass">{c.mass}</option><option value="temperature">{c.temperature}</option><option value="data">{c.data}</option></select></label>
      <div class="conversion-grid"><label>{c.value}<input id="value" type="number" inputmode="decimal" value="1" step="any" /></label><label>{c.from}<select id="from"></select></label><button id="swap" type="button" aria-label={c.swap} title={c.swap}>⇄</button><label>{c.to}<select id="to"></select></label></div>
      <label class="precision">{c.precision}<input id="precision" type="range" min="0" max="10" value="4" /><output id="precisionValue">4</output></label>
      <section class="result" aria-labelledby="resultTitle"><span id="resultTitle">{c.result}</span><output id="resultOutput">1</output><small id="formula"></small></section>
      <button id="copyBtn" class="primary" type="button">{c.copy}</button><p id="status" class="status" role="status" aria-live="polite"></p>
    </section>
    <section class="content-grid"><div><h2>{c.how}</h2><p>{es?'Elige la magnitud, escribe un valor y selecciona las unidades de origen y destino. Puedes intercambiarlas y ajustar el número de decimales.':'Choose a measurement, enter a value and select source and target units. You can swap them and adjust decimal precision.'}</p></div><div><h2>{c.privacy}</h2><p>{es?'Todas las conversiones se calculan en el navegador. La herramienta no usa cookies, cuentas ni una API remota.':'Every conversion is calculated in your browser. The tool uses no cookies, accounts or remote API.'}</p></div></section>
    <section class="related"><h2>{c.related}</h2><p><a href={getLocalizedPath('/vat-calculator/',lang)}>{es?'Calculadora de IVA':'VAT calculator'}</a> · <a href={getLocalizedPath('/timestamp-converter/',lang)}>{es?'Conversor de tiempo':'Time converter'}</a> · <a href={getLocalizedPath('/currency-converter/',lang)}>{es?'Conversor de divisas':'Currency converter'}</a></p></section>
  </article>
  <script define:vars={{ c }}>
    const definitions={length:{m:['m',1],km:['km',1000],cm:['cm',.01],mm:['mm',.001],in:['in',.0254],ft:['ft',.3048],yd:['yd',.9144],mi:['mi',1609.344]},mass:{kg:['kg',1],g:['g',.001],mg:['mg',.000001],t:['t',1000],oz:['oz',.028349523125],lb:['lb',.45359237],st:['st',6.35029318]},data:{B:['B',1],KB:['KB',1000],MB:['MB',1e6],GB:['GB',1e9],TB:['TB',1e12],KiB:['KiB',1024],MiB:['MiB',1048576],GiB:['GiB',1073741824],TiB:['TiB',1099511627776]},temperature:{C:['°C',1],F:['°F',1],K:['K',1]}};
    const category=document.getElementById('category'),value=document.getElementById('value'),from=document.getElementById('from'),to=document.getElementById('to'),precision=document.getElementById('precision'),precisionValue=document.getElementById('precisionValue'),result=document.getElementById('resultOutput'),formula=document.getElementById('formula'),status=document.getElementById('status');
    const temperature=(number,source,target)=>{const celsius=source==='C'?number:source==='F'?(number-32)*5/9:number-273.15;return target==='C'?celsius:target==='F'?celsius*9/5+32:celsius+273.15};
    const populate=()=>{const units=definitions[category.value];from.replaceChildren();to.replaceChildren();Object.entries(units).forEach(([key,[label]])=>{from.add(new Option(label,key));to.add(new Option(label,key))});to.selectedIndex=1;convert()};
    const formatNumber=(number,digits)=>new Intl.NumberFormat(undefined,{maximumFractionDigits:digits}).format(Number(number.toFixed(digits)));
    const convert=()=>{const number=Number(value.value);const digits=Number(precision.value);precisionValue.textContent=String(digits);if(!Number.isFinite(number)){result.textContent='—';formula.textContent='';return}const units=definitions[category.value];const converted=category.value==='temperature'?temperature(number,from.value,to.value):number*units[from.value][1]/units[to.value][1];result.textContent=`${formatNumber(converted,digits)} ${units[to.value][0]}`;formula.textContent=`${formatNumber(number,digits)} ${units[from.value][0]} = ${formatNumber(converted,digits)} ${units[to.value][0]}`};
    category.addEventListener('change',populate);[value,from,to,precision].forEach((element)=>element.addEventListener('input',convert));document.getElementById('swap').addEventListener('click',()=>{const current=from.value;from.value=to.value;to.value=current;convert()});document.getElementById('copyBtn').addEventListener('click',async()=>{await navigator.clipboard.writeText(formula.textContent);status.textContent=c.copied});populate();
  </script>
</Layout>
<style>
  .tool-page{padding-bottom:var(--space-8)}.tool-hero{display:grid;gap:var(--space-3);padding:clamp(1.5rem,5vw,3.5rem) 0}.tool-hero h1{font-size:clamp(2.15rem,5vw,3.8rem)}.converter{display:grid;gap:var(--space-4);max-width:58rem;margin-inline:auto}.converter h2{margin:0;font-size:1.45rem}.converter label{display:grid;gap:.45rem}.conversion-grid{display:grid;grid-template-columns:1fr 1fr auto 1fr;gap:var(--space-3);align-items:end}.conversion-grid button{width:2.9rem;height:2.9rem;border:1px solid var(--color-border);border-radius:999px;background:var(--color-surface);font-size:1.25rem;cursor:pointer}.precision{grid-template-columns:auto minmax(8rem,1fr) 2rem!important;align-items:center}.precision input{accent-color:var(--color-primary)}.result{display:grid;gap:.4rem;padding:clamp(1.2rem,4vw,2rem);border:1px solid color-mix(in srgb,var(--color-primary) 35%,var(--color-border));border-radius:var(--radius-xl);background:var(--color-primary-soft)}.result span,.result small{color:var(--color-text-muted)}.result output{color:var(--color-text);font-size:clamp(2rem,6vw,3.4rem);font-weight:900;letter-spacing:-.04em;overflow-wrap:anywhere}.converter>.primary{justify-self:end;min-height:2.8rem;padding:.75rem 1rem;border-radius:999px;font-weight:850;cursor:pointer}.status{min-height:1.5rem;margin:0}.content-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-8)}.content-grid h2,.related h2{font-size:1.55rem}.related a{font-weight:800}@media(max-width:720px){.conversion-grid{grid-template-columns:1fr 1fr}.conversion-grid label:first-child{grid-column:1/-1}.conversion-grid button{grid-column:1/-1;justify-self:center;transform:rotate(90deg)}.content-grid{grid-template-columns:1fr}.converter>.primary{width:100%}}
</style>
