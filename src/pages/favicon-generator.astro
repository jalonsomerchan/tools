---
import Layout from '../layouts/Layout.astro';

const title = 'Generador de favicon';
---

<Layout title={title}>
  <section style="padding: 4rem 0;">
    <div class="eyebrow">Alon Tools</div>

    <h1>{title}</h1>

    <p class="hero-text">
      Crea favicons a partir de una imagen o de letras personalizadas con colores, formas y vista previa inmediata.
    </p>

    <section class="tool-card">
      <div class="mode-tabs">
        <button class="primary" id="lettersModeBtn">Letras</button>
        <button id="imageModeBtn">Imagen</button>
      </div>

      <div id="lettersPanel" class="settings-grid">
        <label>
          Letras
          <input id="lettersInput" type="text" maxlength="4" value="A" />
        </label>

        <label>
          Color de fondo
          <input id="backgroundColor" type="color" value="#38bdf8" />
        </label>

        <label>
          Color del texto
          <input id="textColor" type="color" value="#020617" />
        </label>

        <label>
          Forma
          <select id="shape">
            <option value="rounded">Redondeado</option>
            <option value="circle">Círculo</option>
            <option value="square">Cuadrado</option>
          </select>
        </label>
      </div>

      <div id="imagePanel" class="settings-grid" hidden>
        <label class="upload-btn">
          Subir imagen
          <input id="imageInput" type="file" accept="image/*" hidden />
        </label>

        <label>
          Fondo para transparencias
          <input id="imageBackground" type="color" value="#ffffff" />
        </label>
      </div>

      <div class="preview-area">
        <div class="favicon-preview large">
          <canvas id="canvas128" width="128" height="128"></canvas>
        </div>

        <div class="sizes-row">
          <canvas id="canvas64" width="64" height="64"></canvas>
          <canvas id="canvas32" width="32" height="32"></canvas>
          <canvas id="canvas16" width="16" height="16"></canvas>
        </div>
      </div>

      <div class="actions">
        <button class="primary" id="generateBtn">Generar</button>
        <button id="downloadPngBtn">Descargar PNG 512</button>
        <button id="downloadPackBtn">Descargar pack PNG</button>
        <button id="copyHtmlBtn">Copiar HTML</button>
      </div>

      <div class="code-panel">
        <h2>HTML recomendado</h2>
        <pre id="htmlCode">&lt;link rel="icon" type="image/png" href="/favicon.png" /&gt;</pre>
      </div>
    </section>
  </section>

  <style>
    .mode-tabs,
    .actions {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    button,
    input,
    select,
    .upload-btn {
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      cursor: pointer;
      font: inherit;
    }

    button.primary,
    .upload-btn {
      background: var(--primary);
      color: black;
      border: none;
      font-weight: 700;
    }

    .settings-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: .45rem;
      color: var(--muted);
      font-size: .92rem;
    }

    .preview-area {
      border-radius: 24px;
      border: 1px solid var(--border);
      background: rgba(2,6,23,.55);
      padding: 2rem;
      display: grid;
      place-items: center;
      gap: 1.5rem;
      margin-bottom: 1rem;
    }

    .favicon-preview {
      padding: 1rem;
      border-radius: 28px;
      background: rgba(148,163,184,.08);
    }

    canvas {
      image-rendering: auto;
      border-radius: 12px;
    }

    .sizes-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: rgba(15,23,42,.7);
      padding: 1rem;
      border-radius: 18px;
    }

    .code-panel {
      border-radius: 24px;
      border: 1px solid var(--border);
      background: rgba(2,6,23,.55);
      padding: 1rem;
      margin-top: 1rem;
    }

    .code-panel h2 {
      margin-top: 0;
      font-size: 1.1rem;
    }

    pre {
      white-space: pre-wrap;
      word-break: break-word;
      color: var(--muted);
      line-height: 1.6;
      font-family: ui-monospace, monospace;
    }
  </style>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const canvases = [
        document.getElementById('canvas128'),
        document.getElementById('canvas64'),
        document.getElementById('canvas32'),
        document.getElementById('canvas16')
      ];

      const lettersPanel = document.getElementById('lettersPanel');
      const imagePanel = document.getElementById('imagePanel');
      const lettersModeBtn = document.getElementById('lettersModeBtn');
      const imageModeBtn = document.getElementById('imageModeBtn');
      const imageInput = document.getElementById('imageInput');

      let mode = 'letters';
      let uploadedImage = null;

      const drawRoundedRect = (ctx, x, y, width, height, radius) => {
        ctx.beginPath();
        ctx.moveTo(x + radius, y);
        ctx.arcTo(x + width, y, x + width, y + height, radius);
        ctx.arcTo(x + width, y + height, x, y + height, radius);
        ctx.arcTo(x, y + height, x, y, radius);
        ctx.arcTo(x, y, x + width, y, radius);
        ctx.closePath();
      };

      const renderLetters = (canvas) => {
        const ctx = canvas.getContext('2d');
        const size = canvas.width;
        const letters = document.getElementById('lettersInput').value.trim() || 'A';
        const bg = document.getElementById('backgroundColor').value;
        const color = document.getElementById('textColor').value;
        const shape = document.getElementById('shape').value;

        ctx.clearRect(0, 0, size, size);
        ctx.fillStyle = bg;

        if (shape === 'circle') {
          ctx.beginPath();
          ctx.arc(size / 2, size / 2, size / 2, 0, Math.PI * 2);
          ctx.fill();
        } else if (shape === 'rounded') {
          drawRoundedRect(ctx, 0, 0, size, size, size * .22);
          ctx.fill();
        } else {
          ctx.fillRect(0, 0, size, size);
        }

        ctx.fillStyle = color;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.font = `900 ${Math.max(12, size / (letters.length > 2 ? 2.5 : 1.8))}px system-ui`;
        ctx.fillText(letters.toUpperCase(), size / 2, size / 2 + size * .03);
      };

      const renderImage = (canvas) => {
        const ctx = canvas.getContext('2d');
        const size = canvas.width;
        const bg = document.getElementById('imageBackground').value;

        ctx.clearRect(0, 0, size, size);
        ctx.fillStyle = bg;
        ctx.fillRect(0, 0, size, size);

        if (!uploadedImage) return;

        const ratio = Math.max(size / uploadedImage.width, size / uploadedImage.height);
        const width = uploadedImage.width * ratio;
        const height = uploadedImage.height * ratio;
        const x = (size - width) / 2;
        const y = (size - height) / 2;

        ctx.drawImage(uploadedImage, x, y, width, height);
      };

      const render = () => {
        canvases.forEach((canvas) => {
          if (mode === 'letters') {
            renderLetters(canvas);
          } else {
            renderImage(canvas);
          }
        });
      };

      const downloadCanvas = (canvas, filename) => {
        const link = document.createElement('a');
        link.href = canvas.toDataURL('image/png');
        link.download = filename;
        link.click();
      };

      lettersModeBtn.onclick = () => {
        mode = 'letters';
        lettersPanel.hidden = false;
        imagePanel.hidden = true;
        lettersModeBtn.classList.add('primary');
        imageModeBtn.classList.remove('primary');
        render();
      };

      imageModeBtn.onclick = () => {
        mode = 'image';
        lettersPanel.hidden = true;
        imagePanel.hidden = false;
        imageModeBtn.classList.add('primary');
        lettersModeBtn.classList.remove('primary');
        render();
      };

      imageInput.addEventListener('change', () => {
        const file = imageInput.files[0];
        if (!file) return;

        const img = new Image();
        img.onload = () => {
          uploadedImage = img;
          render();
        };
        img.src = URL.createObjectURL(file);
      });

      document.querySelectorAll('input, select').forEach((element) => {
        element.addEventListener('input', render);
        element.addEventListener('change', render);
      });

      document.getElementById('generateBtn').onclick = render;

      document.getElementById('downloadPngBtn').onclick = () => {
        const canvas = document.createElement('canvas');
        canvas.width = 512;
        canvas.height = 512;

        if (mode === 'letters') {
          renderLetters(canvas);
        } else {
          renderImage(canvas);
        }

        downloadCanvas(canvas, 'favicon-512.png');
      };

      document.getElementById('downloadPackBtn').onclick = () => {
        canvases.forEach((canvas) => {
          downloadCanvas(canvas, `favicon-${canvas.width}.png`);
        });
      };

      document.getElementById('copyHtmlBtn').onclick = async () => {
        const html = `<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />\n<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />\n<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />`;
        await navigator.clipboard.writeText(html);
      };

      render();
    });
  </script>
</Layout>
