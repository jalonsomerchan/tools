---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';
import { getToolTranslations, type ToolTranslationsMap } from '../i18n/tools';

const lang = getLangFromUrl(Astro.url);
const t = getToolTranslations('json-viewer', lang) as ToolTranslationsMap['json-viewer']['en'];
---

<Layout title={t.title} description={t.description} lang={lang} path="/json-viewer/" translated={true}>
  <section style="padding: 4rem 0;">
    <div class="eyebrow">{t.heroEyebrow}</div>
    <h1>{t.title}</h1>
    <p class="hero-text">{t.heroText}</p>

    <section class="tool-card">
      <div class="toolbar">
        <button class="primary" id="formatBtn">{t.actions.format}</button>
        <button id="minifyBtn">{t.actions.minify}</button>
        <button id="validateBtn">{t.actions.validate}</button>
        <button id="clearBtn">{t.actions.clear}</button>
        <button id="copyBtn">{t.actions.copy}</button>
      </div>

      <div class="workspace">
        <textarea id="input" placeholder={t.placeholders.input}></textarea>
        <textarea id="output" readonly placeholder={t.placeholders.output}></textarea>
      </div>

      <p class="status" id="status" role="status" aria-live="polite">{t.messages.ready}</p>
    </section>
  </section>

  <style>
    .toolbar { display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
    button { background: #0f172a; color: white; border: 1px solid var(--border); border-radius: 14px; padding: 1rem; cursor: pointer; }
    button.primary { background: var(--primary); color: black; }
    .workspace { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    textarea { width: 100%; min-height: 400px; border-radius: 18px; border: 1px solid var(--border); background: #020617; color: white; padding: 1rem; font-family: monospace; line-height: 1.6; resize: vertical; tab-size: 2; }
    textarea[data-invalid='true'] { border-color: rgba(252, 165, 165, .6); box-shadow: 0 0 0 1px rgba(252, 165, 165, .15); }
    .status { margin-top: 1rem; color: var(--muted); white-space: pre-wrap; }
    @media (max-width: 860px) { .workspace { grid-template-columns: 1fr; } }
  </style>

  <script define:vars={{ copy: t }}>
    window.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('input');
      const output = document.getElementById('output');
      const status = document.getElementById('status');
      const formatBtn = document.getElementById('formatBtn');
      const minifyBtn = document.getElementById('minifyBtn');
      const validateBtn = document.getElementById('validateBtn');
      const clearBtn = document.getElementById('clearBtn');
      const copyBtn = document.getElementById('copyBtn');

      const INDENT = '  ';

      const setStatus = (message, error = false) => {
        status.textContent = message;
        status.style.color = error ? '#fca5a5' : '#94a3b8';
        output.dataset.invalid = String(error);
      };

      const parse = () => JSON.parse(input.value);

      const getJsonErrorDetails = (error) => {
        const message = error instanceof Error ? error.message : copy.messages.invalid;
        const positionMatch = message.match(/position\s+(\d+)/i);
        const position = positionMatch ? Number(positionMatch[1]) : null;

        if (position === null || Number.isNaN(position)) {
          return message;
        }

        const beforeError = input.value.slice(0, position);
        const line = beforeError.split('\n').length;
        const column = beforeError.length - beforeError.lastIndexOf('\n');

        return `${message}\n${copy.messages.lineColumn.replace('{line}', String(line)).replace('{column}', String(column))}`;
      };

      const formatBrokenJson = (value) => {
        let formatted = '';
        let depth = 0;
        let inString = false;
        let escaped = false;

        const addNewLine = () => {
          formatted = formatted.trimEnd();
          formatted += `\n${INDENT.repeat(Math.max(depth, 0))}`;
        };

        for (const char of value) {
          if (inString) {
            formatted += char;

            if (escaped) {
              escaped = false;
              continue;
            }

            if (char === '\\') {
              escaped = true;
              continue;
            }

            if (char === '"') {
              inString = false;
            }

            continue;
          }

          if (char === '"') {
            inString = true;
            formatted += char;
            continue;
          }

          if (char === '{' || char === '[') {
            formatted += char;
            depth += 1;
            addNewLine();
            continue;
          }

          if (char === '}' || char === ']') {
            depth = Math.max(depth - 1, 0);
            addNewLine();
            formatted += char;
            continue;
          }

          if (char === ',') {
            formatted += char;
            addNewLine();
            continue;
          }

          if (char === ':') {
            formatted += ': ';
            continue;
          }

          if (/\s/.test(char)) {
            if (formatted && !formatted.endsWith(' ') && !formatted.endsWith('\n')) {
              formatted += ' ';
            }
            continue;
          }

          formatted += char;
        }

        return formatted.trim();
      };

      const minifyLooseJson = (value) => {
        let minified = '';
        let inString = false;
        let escaped = false;

        for (const char of value) {
          if (inString) {
            minified += char;

            if (escaped) {
              escaped = false;
              continue;
            }

            if (char === '\\') {
              escaped = true;
              continue;
            }

            if (char === '"') {
              inString = false;
            }

            continue;
          }

          if (char === '"') {
            inString = true;
            minified += char;
            continue;
          }

          if (!/\s/.test(char)) minified += char;
        }

        return minified;
      };

      const showBrokenJson = (error, transform = formatBrokenJson) => {
        output.value = transform(input.value);
        setStatus(copy.messages.invalidPartial.replace('{details}', getJsonErrorDetails(error)), true);
      };

      formatBtn.onclick = () => {
        try {
          output.value = JSON.stringify(parse(), null, 2);
          setStatus(copy.messages.formatted);
        } catch (error) {
          showBrokenJson(error);
        }
      };

      minifyBtn.onclick = () => {
        try {
          output.value = JSON.stringify(parse());
          setStatus(copy.messages.minified);
        } catch (error) {
          showBrokenJson(error, minifyLooseJson);
        }
      };

      validateBtn.onclick = () => {
        try {
          parse();
          output.value = JSON.stringify(parse(), null, 2);
          setStatus(copy.messages.valid);
        } catch (error) {
          showBrokenJson(error);
        }
      };

      clearBtn.onclick = () => {
        input.value = '';
        output.value = '';
        setStatus(copy.messages.cleared);
      };

      copyBtn.onclick = async () => {
        try {
          await navigator.clipboard.writeText(output.value);
          setStatus(copy.messages.copied);
        } catch {
          setStatus(copy.messages.copyError, true);
        }
      };

      input.addEventListener('input', () => {
        if (!input.value.trim()) {
          output.value = '';
          setStatus(copy.messages.ready);
          return;
        }

        try {
          output.value = JSON.stringify(parse(), null, 2);
          setStatus(copy.messages.valid);
        } catch (error) {
          showBrokenJson(error);
        }
      });
    });
  </script>
</Layout>
