---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';
import { getToolTranslations, type ToolTranslationsMap } from '../i18n/tools';

const lang = getLangFromUrl(Astro.url);
const t = getToolTranslations('json-viewer', lang) as ToolTranslationsMap['json-viewer']['en'];

const ui = lang === 'es'
  ? {
      panels: {
        input: 'JSON de entrada',
        output: 'JSON resultante',
        tree: 'Árbol editable',
        stats: 'Resumen'
      },
      actions: {
        format: t.actions.format,
        minify: t.actions.minify,
        validate: t.actions.validate,
        clear: t.actions.clear,
        copy: t.actions.copy,
        expandAll: 'Expandir todo',
        collapseAll: 'Contraer todo',
        download: 'Descargar .json',
        sample: 'Cargar ejemplo'
      },
      labels: {
        type: 'Tipo',
        value: 'Valor',
        emptyObject: 'Objeto vacío',
        emptyArray: 'Array vacío',
        nullValue: 'null',
        root: 'raíz',
        items: 'elementos',
        keys: 'claves'
      },
      stats: {
        nodes: 'Nodos',
        objects: 'Objetos',
        arrays: 'Arrays',
        primitives: 'Valores',
        size: 'Tamaño'
      },
      messages: {
        ...t.messages,
        pasteFirst: 'Pega primero un JSON.',
        treeReady: 'Árbol editable generado.',
        edited: 'Valor editado y JSON actualizado.',
        editError: 'No se pudo aplicar el cambio.',
        collapsedAll: 'Todos los nodos se han contraído.',
        expandedAll: 'Todos los nodos se han expandido.',
        downloaded: 'Archivo JSON descargado.',
        sampleLoaded: 'Ejemplo cargado.',
        noTree: 'El árbol aparecerá cuando el JSON sea válido.',
        noCopy: 'No hay resultado para copiar.'
      }
    }
  : {
      panels: {
        input: 'Input JSON',
        output: 'Result JSON',
        tree: 'Editable tree',
        stats: 'Summary'
      },
      actions: {
        format: t.actions.format,
        minify: t.actions.minify,
        validate: t.actions.validate,
        clear: t.actions.clear,
        copy: t.actions.copy,
        expandAll: 'Expand all',
        collapseAll: 'Collapse all',
        download: 'Download .json',
        sample: 'Load sample'
      },
      labels: {
        type: 'Type',
        value: 'Value',
        emptyObject: 'Empty object',
        emptyArray: 'Empty array',
        nullValue: 'null',
        root: 'root',
        items: 'items',
        keys: 'keys'
      },
      stats: {
        nodes: 'Nodes',
        objects: 'Objects',
        arrays: 'Arrays',
        primitives: 'Values',
        size: 'Size'
      },
      messages: {
        ...t.messages,
        pasteFirst: 'Paste JSON first.',
        treeReady: 'Editable tree generated.',
        edited: 'Value edited and JSON updated.',
        editError: 'Could not apply the change.',
        collapsedAll: 'All nodes collapsed.',
        expandedAll: 'All nodes expanded.',
        downloaded: 'JSON file downloaded.',
        sampleLoaded: 'Sample loaded.',
        noTree: 'The tree will appear when the JSON is valid.',
        noCopy: 'There is no result to copy.'
      }
    };
---

<Layout title={t.title} description={t.description} lang={lang} path="/json-viewer/" translated={true}>
  <section class="json-page">
    <div class="eyebrow">{t.heroEyebrow}</div>
    <h1>{t.title}</h1>
    <p class="hero-text">{t.heroText}</p>

    <section class="tool-card json-tool" aria-label={t.title}>
      <div class="toolbar" aria-label="JSON actions">
        <button class="primary" id="formatBtn" type="button">{ui.actions.format}</button>
        <button id="minifyBtn" type="button">{ui.actions.minify}</button>
        <button id="validateBtn" type="button">{ui.actions.validate}</button>
        <button id="expandAllBtn" type="button">{ui.actions.expandAll}</button>
        <button id="collapseAllBtn" type="button">{ui.actions.collapseAll}</button>
        <button id="downloadBtn" type="button">{ui.actions.download}</button>
        <button id="copyBtn" type="button">{ui.actions.copy}</button>
        <button id="sampleBtn" type="button">{ui.actions.sample}</button>
        <button id="clearBtn" type="button">{ui.actions.clear}</button>
      </div>

      <div class="workspace">
        <label class="panel">
          <span class="panel-title">{ui.panels.input}</span>
          <textarea id="input" spellcheck="false" placeholder={t.placeholders.input}></textarea>
        </label>

        <label class="panel">
          <span class="panel-title">{ui.panels.output}</span>
          <textarea id="output" readonly spellcheck="false" placeholder={t.placeholders.output}></textarea>
        </label>
      </div>

      <div class="tree-layout">
        <section class="tree-panel" aria-labelledby="treeTitle">
          <div class="panel-header">
            <h2 id="treeTitle">{ui.panels.tree}</h2>
            <p>{ui.messages.noTree}</p>
          </div>
          <div class="json-tree" id="tree" role="tree" aria-live="polite"></div>
        </section>

        <aside class="stats-panel" aria-labelledby="statsTitle">
          <h2 id="statsTitle">{ui.panels.stats}</h2>
          <dl class="stats-grid">
            <div><dt>{ui.stats.nodes}</dt><dd id="statNodes">0</dd></div>
            <div><dt>{ui.stats.objects}</dt><dd id="statObjects">0</dd></div>
            <div><dt>{ui.stats.arrays}</dt><dd id="statArrays">0</dd></div>
            <div><dt>{ui.stats.primitives}</dt><dd id="statPrimitives">0</dd></div>
            <div><dt>{ui.stats.size}</dt><dd id="statSize">0 B</dd></div>
          </dl>
        </aside>
      </div>

      <p class="status" id="status" role="status" aria-live="polite">{ui.messages.ready}</p>
    </section>
  </section>

  <style>
    .json-page { padding: clamp(2.5rem, 6vw, 4rem) 0; }
    .json-tool { padding: clamp(1rem, 2vw, 1.35rem); margin-top: 2rem; overflow: visible; }
    .toolbar { display: flex; gap: .7rem; margin-bottom: 1rem; flex-wrap: wrap; }
    button {
      min-height: 2.65rem;
      background: var(--color-surface);
      color: var(--color-text);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: .7rem 1rem;
      cursor: pointer;
      font-weight: 900;
      box-shadow: var(--shadow-xs);
      transition: transform var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
    }
    button:hover:not(:disabled) { transform: translateY(-1px); border-color: color-mix(in srgb, var(--primary) 45%, var(--border)); }
    button:disabled { cursor: not-allowed; opacity: .5; }
    button.primary { background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); color: #fff; border-color: transparent; box-shadow: var(--shadow-brand); }
    .workspace { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; }
    .panel { display: grid; gap: .5rem; min-width: 0; }
    .panel-title { color: var(--color-text); font-weight: 900; }
    textarea {
      width: 100%;
      min-height: 420px;
      border-radius: 18px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      font-family: var(--font-mono);
      line-height: 1.6;
      resize: vertical;
      tab-size: 2;
    }
    textarea[data-invalid='true'] { border-color: rgba(252, 165, 165, .75); box-shadow: 0 0 0 1px rgba(252, 165, 165, .18); }
    .tree-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(220px, 300px); gap: 1rem; margin-top: 1rem; align-items: start; }
    .tree-panel, .stats-panel {
      border: 1px solid var(--border);
      border-radius: 20px;
      background: color-mix(in srgb, var(--color-surface) 92%, transparent);
      padding: 1rem;
      box-shadow: var(--shadow-xs);
    }
    .panel-header { display: flex; justify-content: space-between; gap: 1rem; align-items: start; margin-bottom: .75rem; }
    .panel-header h2, .stats-panel h2 { margin: 0; font-size: 1.05rem; letter-spacing: -.02em; }
    .panel-header p { margin: 0; font-size: .9rem; color: var(--muted); text-align: right; }
    .json-tree {
      min-height: 160px;
      max-height: 560px;
      overflow: auto;
      border-radius: 16px;
      background: color-mix(in srgb, var(--color-bg) 70%, var(--color-surface));
      padding: .75rem;
      font-family: var(--font-mono);
      font-size: .92rem;
    }
    .tree-empty { color: var(--muted); margin: .25rem; font-family: var(--font-sans); }
    .tree-node { --depth: 0; margin-left: calc(var(--depth) * 1rem); }
    .node-row {
      display: flex;
      align-items: center;
      gap: .45rem;
      min-height: 2rem;
      padding: .2rem .35rem;
      border-radius: 10px;
    }
    .node-row:hover { background: color-mix(in srgb, var(--primary) 9%, transparent); }
    .toggle {
      width: 1.6rem;
      min-width: 1.6rem;
      min-height: 1.6rem;
      padding: 0;
      border-radius: 8px;
      font-family: var(--font-mono);
      line-height: 1;
      box-shadow: none;
    }
    .toggle.placeholder { visibility: hidden; }
    .node-key { color: var(--color-primary-hover); font-weight: 900; word-break: break-word; }
    .node-meta { color: var(--muted); font-size: .82rem; }
    .node-children { border-left: 1px dashed var(--border); margin-left: .78rem; padding-left: .15rem; }
    .value-editor {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      flex-wrap: wrap;
      min-width: 0;
    }
    .value-editor select,
    .value-editor input {
      width: auto !important;
      min-height: 2rem !important;
      padding: .35rem .55rem !important;
      border-radius: 10px !important;
      font-family: var(--font-mono);
      font-size: .88rem;
      box-shadow: none !important;
    }
    .value-editor input { min-width: min(320px, 52vw); }
    .value-editor input[data-kind='number'] { min-width: 8rem; }
    .value-editor input[data-kind='boolean'], .value-editor input[data-kind='null'] { min-width: 5.5rem; color: var(--muted); }
    .type-string { color: #22c55e; }
    .type-number { color: #38bdf8; }
    .type-boolean { color: #f59e0b; }
    .type-null { color: #a78bfa; }
    .stats-grid { display: grid; gap: .65rem; margin: .75rem 0 0; }
    .stats-grid div {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      padding: .7rem .8rem;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--color-surface);
    }
    .stats-grid dt { color: var(--muted); font-weight: 800; }
    .stats-grid dd { margin: 0; color: var(--color-text); font-weight: 950; }
    .status { margin: 1rem 0 0; color: var(--muted); white-space: pre-wrap; }
    @media (max-width: 980px) {
      .workspace, .tree-layout { grid-template-columns: 1fr; }
      .panel-header { display: block; }
      .panel-header p { margin-top: .35rem; text-align: left; }
      textarea { min-height: 330px; }
    }
    @media (max-width: 560px) {
      .json-tool { margin-inline: -.25rem; padding: .8rem; border-radius: 18px; }
      .toolbar button { flex: 1 1 calc(50% - .7rem); padding-inline: .7rem; }
      .value-editor { display: grid; width: 100%; grid-template-columns: 1fr; }
      .value-editor select, .value-editor input { width: 100% !important; }
    }
  </style>

  <script define:vars={{ copy: ui }}>
    window.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('input');
      const output = document.getElementById('output');
      const status = document.getElementById('status');
      const tree = document.getElementById('tree');
      const formatBtn = document.getElementById('formatBtn');
      const minifyBtn = document.getElementById('minifyBtn');
      const validateBtn = document.getElementById('validateBtn');
      const clearBtn = document.getElementById('clearBtn');
      const copyBtn = document.getElementById('copyBtn');
      const expandAllBtn = document.getElementById('expandAllBtn');
      const collapseAllBtn = document.getElementById('collapseAllBtn');
      const downloadBtn = document.getElementById('downloadBtn');
      const sampleBtn = document.getElementById('sampleBtn');
      const statNodes = document.getElementById('statNodes');
      const statObjects = document.getElementById('statObjects');
      const statArrays = document.getElementById('statArrays');
      const statPrimitives = document.getElementById('statPrimitives');
      const statSize = document.getElementById('statSize');

      const INDENT = '  ';
      const collapsedPaths = new Set();
      let currentJson = null;
      let hasCurrentJson = false;
      let lastValidText = '';

      const sampleJson = {
        project: 'Alon Tools',
        tool: 'JSON viewer',
        enabled: true,
        version: 2,
        features: [
          'format',
          'validate',
          'collapse nodes',
          'edit values'
        ],
        theme: {
          light: true,
          dark: true,
          accent: 'orange'
        },
        limits: null
      };

      const setStatus = (message, error = false) => {
        status.textContent = message;
        status.style.color = error ? '#fca5a5' : 'var(--muted)';
        output.dataset.invalid = String(error);
      };

      const parse = () => JSON.parse(input.value);

      const getType = (value) => {
        if (value === null) return 'null';
        if (Array.isArray(value)) return 'array';
        return typeof value;
      };

      const pathToKey = (path) => path.length ? path.join('.') : '$';

      const formatBytes = (bytes) => {
        if (bytes < 1024) return `${bytes} B`;
        if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
        return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
      };

      const getJsonErrorDetails = (error) => {
        const message = error instanceof Error ? error.message : copy.messages.invalid;
        const positionMatch = message.match(/position\s+(\d+)/i);
        const position = positionMatch ? Number(positionMatch[1]) : null;

        if (position === null || Number.isNaN(position)) {
          return message;
        }

        const beforeError = input.value.slice(0, position);
        const line = beforeError.split('\n').length;
        const column = beforeError.length - beforeError.lastIndexOf('\n');

        return `${message}\n${copy.messages.lineColumn.replace('{line}', String(line)).replace('{column}', String(column))}`;
      };

      const formatBrokenJson = (value) => {
        let formatted = '';
        let depth = 0;
        let inString = false;
        let escaped = false;

        const addNewLine = () => {
          formatted = formatted.trimEnd();
          formatted += `\n${INDENT.repeat(Math.max(depth, 0))}`;
        };

        for (const char of value) {
          if (inString) {
            formatted += char;

            if (escaped) {
              escaped = false;
              continue;
            }

            if (char === '\\') {
              escaped = true;
              continue;
            }

            if (char === '"') {
              inString = false;
            }

            continue;
          }

          if (char === '"') {
            inString = true;
            formatted += char;
            continue;
          }

          if (char === '{' || char === '[') {
            formatted += char;
            depth += 1;
            addNewLine();
            continue;
          }

          if (char === '}' || char === ']') {
            depth = Math.max(depth - 1, 0);
            addNewLine();
            formatted += char;
            continue;
          }

          if (char === ',') {
            formatted += char;
            addNewLine();
            continue;
          }

          if (char === ':') {
            formatted += ': ';
            continue;
          }

          if (/\s/.test(char)) {
            if (formatted && !formatted.endsWith(' ') && !formatted.endsWith('\n')) {
              formatted += ' ';
            }
            continue;
          }

          formatted += char;
        }

        return formatted.trim();
      };

      const minifyLooseJson = (value) => {
        let minified = '';
        let inString = false;
        let escaped = false;

        for (const char of value) {
          if (inString) {
            minified += char;

            if (escaped) {
              escaped = false;
              continue;
            }

            if (char === '\\') {
              escaped = true;
              continue;
            }

            if (char === '"') {
              inString = false;
            }

            continue;
          }

          if (char === '"') {
            inString = true;
            minified += char;
            continue;
          }

          if (!/\s/.test(char)) minified += char;
        }

        return minified;
      };

      const showBrokenJson = (error, transform = formatBrokenJson) => {
        currentJson = null;
        hasCurrentJson = false;
        output.value = transform(input.value);
        renderTree(null, false);
        updateStats(null);
        setStatus(copy.messages.invalidPartial.replace('{details}', getJsonErrorDetails(error)), true);
      };

      const updateStats = (data) => {
        const stats = { nodes: 0, objects: 0, arrays: 0, primitives: 0 };

        const walk = (value) => {
          stats.nodes += 1;
          if (Array.isArray(value)) {
            stats.arrays += 1;
            value.forEach(walk);
            return;
          }
          if (value && typeof value === 'object') {
            stats.objects += 1;
            Object.values(value).forEach(walk);
            return;
          }
          stats.primitives += 1;
        };

        if (data !== null || hasCurrentJson) walk(data);
        statNodes.textContent = String(stats.nodes);
        statObjects.textContent = String(stats.objects);
        statArrays.textContent = String(stats.arrays);
        statPrimitives.textContent = String(stats.primitives);
        statSize.textContent = formatBytes(new Blob([output.value || input.value || '']).size);
      };

      const setValueAtPath = (target, path, value) => {
        if (!path.length) return value;
        const clone = structuredClone(target);
        let pointer = clone;
        for (let index = 0; index < path.length - 1; index += 1) {
          pointer = pointer[path[index]];
        }
        pointer[path[path.length - 1]] = value;
        return clone;
      };

      const parseEditedValue = (type, rawValue) => {
        if (type === 'string') return rawValue;
        if (type === 'number') {
          const parsed = Number(rawValue);
          if (!Number.isFinite(parsed)) throw new Error('Invalid number');
          return parsed;
        }
        if (type === 'boolean') return rawValue === 'true';
        return null;
      };

      const syncFromCurrentJson = (message = copy.messages.treeReady) => {
        hasCurrentJson = true;
        const formatted = JSON.stringify(currentJson, null, 2);
        lastValidText = formatted;
        input.value = formatted;
        output.value = formatted;
        renderTree(currentJson);
        updateStats(currentJson);
        setStatus(message);
      };

      const applyValueEdit = (path, type, rawValue) => {
        try {
          const value = parseEditedValue(type, rawValue);
          currentJson = setValueAtPath(currentJson, path, value);
          syncFromCurrentJson(copy.messages.edited);
        } catch {
          setStatus(copy.messages.editError, true);
        }
      };

      const createText = (text, className) => {
        const span = document.createElement('span');
        span.textContent = text;
        if (className) span.className = className;
        return span;
      };

      const getChildrenEntries = (value) => {
        if (Array.isArray(value)) return value.map((item, index) => [index, item]);
        if (value && typeof value === 'object') return Object.entries(value);
        return [];
      };

      const renderPrimitiveEditor = (value, path) => {
        const editor = document.createElement('span');
        editor.className = 'value-editor';

        const type = getType(value);
        const select = document.createElement('select');
        select.setAttribute('aria-label', copy.labels.type);
        ['string', 'number', 'boolean', 'null'].forEach((optionType) => {
          const option = document.createElement('option');
          option.value = optionType;
          option.textContent = optionType;
          option.selected = optionType === type;
          select.append(option);
        });

        const field = document.createElement('input');
        field.setAttribute('aria-label', copy.labels.value);
        field.dataset.kind = type;
        field.className = `type-${type}`;

        const refreshField = () => {
          const selectedType = select.value;
          field.dataset.kind = selectedType;
          field.className = `type-${selectedType}`;
          field.disabled = selectedType === 'null';
          if (selectedType === 'boolean') {
            field.setAttribute('list', 'jsonBooleanValues');
            field.value = value === false ? 'false' : 'true';
          } else {
            field.removeAttribute('list');
            field.value = selectedType === 'null' ? copy.labels.nullValue : String(value ?? '');
          }
        };

        select.addEventListener('change', () => {
          const selectedType = select.value;
          const nextRawValue = selectedType === 'boolean' ? 'true' : field.value;
          applyValueEdit(path, selectedType, nextRawValue);
        });

        field.addEventListener('change', () => {
          applyValueEdit(path, select.value, field.value);
        });

        field.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') {
            event.preventDefault();
            field.blur();
          }
        });

        refreshField();
        editor.append(select, field);
        return editor;
      };

      const renderNode = (key, value, path, depth = 0) => {
        const type = getType(value);
        const isContainer = type === 'array' || type === 'object';
        const pathKey = pathToKey(path);
        const isCollapsed = collapsedPaths.has(pathKey);
        const node = document.createElement('div');
        node.className = 'tree-node';
        node.style.setProperty('--depth', String(depth));
        node.setAttribute('role', 'treeitem');
        node.setAttribute('aria-expanded', isContainer ? String(!isCollapsed) : 'false');

        const row = document.createElement('div');
        row.className = 'node-row';

        const toggle = document.createElement('button');
        toggle.type = 'button';
        toggle.className = isContainer ? 'toggle' : 'toggle placeholder';
        toggle.textContent = isCollapsed ? '+' : '−';
        toggle.setAttribute('aria-label', isCollapsed ? copy.actions.expandAll : copy.actions.collapseAll);
        toggle.addEventListener('click', () => {
          if (collapsedPaths.has(pathKey)) {
            collapsedPaths.delete(pathKey);
          } else {
            collapsedPaths.add(pathKey);
          }
          renderTree(currentJson);
        });
        row.append(toggle);

        const keyLabel = key === null ? copy.labels.root : String(key);
        row.append(createText(keyLabel, 'node-key'));

        if (isContainer) {
          const entries = getChildrenEntries(value);
          const countLabel = type === 'array' ? copy.labels.items : copy.labels.keys;
          row.append(createText(`${type} · ${entries.length} ${countLabel}`, 'node-meta'));
        } else {
          row.append(createText(`${type}:`, `node-meta type-${type}`));
          row.append(renderPrimitiveEditor(value, path));
        }

        node.append(row);

        if (isContainer && !isCollapsed) {
          const entries = getChildrenEntries(value);
          const children = document.createElement('div');
          children.className = 'node-children';
          children.setAttribute('role', 'group');

          if (!entries.length) {
            children.append(createText(type === 'array' ? copy.labels.emptyArray : copy.labels.emptyObject, 'tree-empty'));
          } else {
            entries.forEach(([childKey, childValue]) => {
              children.append(renderNode(childKey, childValue, [...path, childKey], depth + 1));
            });
          }

          node.append(children);
        }

        return node;
      };

      const renderTree = (data, hasData = hasCurrentJson) => {
        tree.replaceChildren();
        if (!hasData) {
          const empty = document.createElement('p');
          empty.className = 'tree-empty';
          empty.textContent = copy.messages.noTree;
          tree.append(empty);
          return;
        }

        tree.append(renderNode(null, data, [], 0));

        if (!document.getElementById('jsonBooleanValues')) {
          const datalist = document.createElement('datalist');
          datalist.id = 'jsonBooleanValues';
          datalist.append(new Option('true'), new Option('false'));
          document.body.append(datalist);
        }
      };

      const collectContainerPaths = (value, path = [], paths = []) => {
        const type = getType(value);
        if (type === 'array' || type === 'object') {
          paths.push(pathToKey(path));
          getChildrenEntries(value).forEach(([childKey, childValue]) => {
            collectContainerPaths(childValue, [...path, childKey], paths);
          });
        }
        return paths;
      };

      const renderValidJson = (data, message) => {
        currentJson = data;
        hasCurrentJson = true;
        lastValidText = JSON.stringify(data, null, 2);
        output.value = lastValidText;
        renderTree(data);
        updateStats(data);
        setStatus(message);
      };

      const formatCurrentInput = () => {
        if (!input.value.trim()) {
          setStatus(copy.messages.pasteFirst, true);
          return;
        }

        try {
          const data = parse();
          input.value = JSON.stringify(data, null, 2);
          renderValidJson(data, copy.messages.formatted);
        } catch (error) {
          showBrokenJson(error);
        }
      };

      formatBtn.onclick = formatCurrentInput;

      minifyBtn.onclick = () => {
        if (!input.value.trim()) {
          setStatus(copy.messages.pasteFirst, true);
          return;
        }

        try {
          const data = parse();
          currentJson = data;
          const minified = JSON.stringify(data);
          output.value = minified;
          lastValidText = JSON.stringify(data, null, 2);
          renderTree(data);
          updateStats(data);
          setStatus(copy.messages.minified);
        } catch (error) {
          showBrokenJson(error, minifyLooseJson);
        }
      };

      validateBtn.onclick = () => {
        if (!input.value.trim()) {
          setStatus(copy.messages.pasteFirst, true);
          return;
        }

        try {
          const data = parse();
          renderValidJson(data, copy.messages.valid);
        } catch (error) {
          showBrokenJson(error);
        }
      };

      expandAllBtn.onclick = () => {
        collapsedPaths.clear();
        renderTree(currentJson);
        setStatus(copy.messages.expandedAll);
      };

      collapseAllBtn.onclick = () => {
        if (!hasCurrentJson) {
          setStatus(copy.messages.noTree, true);
          return;
        }
        collapsedPaths.clear();
        collectContainerPaths(currentJson).forEach((path) => collapsedPaths.add(path));
        renderTree(currentJson);
        setStatus(copy.messages.collapsedAll);
      };

      downloadBtn.onclick = () => {
        const text = output.value || lastValidText;
        if (!text.trim()) {
          setStatus(copy.messages.noCopy, true);
          return;
        }

        const blob = new Blob([text], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = 'data.json';
        link.click();
        URL.revokeObjectURL(url);
        setStatus(copy.messages.downloaded);
      };

      clearBtn.onclick = () => {
        input.value = '';
        output.value = '';
        currentJson = null;
        hasCurrentJson = false;
        lastValidText = '';
        collapsedPaths.clear();
        renderTree(null, false);
        updateStats(null);
        setStatus(copy.messages.cleared);
      };

      copyBtn.onclick = async () => {
        const text = output.value || lastValidText;
        if (!text.trim()) {
          setStatus(copy.messages.noCopy, true);
          return;
        }

        try {
          await navigator.clipboard.writeText(text);
          setStatus(copy.messages.copied);
        } catch {
          output.focus();
          output.select();
          setStatus(copy.messages.copyError, true);
        }
      };

      sampleBtn.onclick = () => {
        currentJson = sampleJson;
        collapsedPaths.clear();
        syncFromCurrentJson(copy.messages.sampleLoaded);
      };

      input.addEventListener('input', () => {
        if (!input.value.trim()) {
          output.value = '';
          currentJson = null;
          hasCurrentJson = false;
          lastValidText = '';
          collapsedPaths.clear();
          renderTree(null, false);
          updateStats(null);
          setStatus(copy.messages.ready);
          return;
        }

        try {
          const data = parse();
          renderValidJson(data, copy.messages.valid);
        } catch (error) {
          showBrokenJson(error);
        }
      });

      input.addEventListener('keydown', (event) => {
        if (event.key === 'Tab') {
          event.preventDefault();
          const start = input.selectionStart;
          const end = input.selectionEnd;
          input.setRangeText(INDENT, start, end, 'end');
        }
      });

      renderTree(null, false);
      updateStats(null);
    });
  </script>
</Layout>
