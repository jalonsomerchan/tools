---
import Layout from '../layouts/Layout.astro';

const title = 'JSON viewer y formatter';
---

<Layout title={title}>
  <section style="padding: 4rem 0;">
    <div class="eyebrow">Alon Tools</div>

    <h1>{title}</h1>

    <p class="hero-text">
      Visualiza, valida y formatea JSON directamente desde el navegador.
    </p>

    <section class="tool-card">
      <div class="toolbar">
        <button class="primary" id="formatBtn">Formatear</button>
        <button id="minifyBtn">Minificar</button>
        <button id="validateBtn">Validar</button>
        <button id="clearBtn">Limpiar</button>
        <button id="copyBtn">Copiar resultado</button>
      </div>

      <div class="workspace">
        <textarea id="input" placeholder='Pega aquí tu JSON...'></textarea>

        <textarea id="output" readonly placeholder='Resultado...'></textarea>
      </div>

      <p class="status" id="status">Listo.</p>
    </section>
  </section>

  <style>
    .toolbar {
      display: flex;
      gap: 1rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }

    button {
      background: #0f172a;
      color: white;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1rem;
      cursor: pointer;
    }

    button.primary {
      background: var(--primary);
      color: black;
    }

    .workspace {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    textarea {
      width: 100%;
      min-height: 400px;
      border-radius: 18px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      font-family: monospace;
    }

    .status {
      margin-top: 1rem;
      color: var(--muted);
    }

    @media (max-width: 860px) {
      .workspace {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('input');
      const output = document.getElementById('output');
      const status = document.getElementById('status');

      const setStatus = (message, error = false) => {
        status.textContent = message;
        status.style.color = error ? '#fca5a5' : '#94a3b8';
      };

      const parse = () => JSON.parse(input.value);

      document.getElementById('formatBtn').onclick = () => {
        try {
          output.value = JSON.stringify(parse(), null, 2);
          setStatus('JSON formateado correctamente.');
        } catch (e) {
          setStatus('JSON inválido.', true);
        }
      };

      document.getElementById('minifyBtn').onclick = () => {
        try {
          output.value = JSON.stringify(parse());
          setStatus('JSON minificado correctamente.');
        } catch {
          setStatus('JSON inválido.', true);
        }
      };

      document.getElementById('validateBtn').onclick = () => {
        try {
          parse();
          setStatus('JSON válido.');
        } catch {
          setStatus('JSON inválido.', true);
        }
      };

      document.getElementById('clearBtn').onclick = () => {
        input.value = '';
        output.value = '';
        setStatus('Contenido eliminado.');
      };

      document.getElementById('copyBtn').onclick = async () => {
        try {
          await navigator.clipboard.writeText(output.value);
          setStatus('Resultado copiado.');
        } catch {
          setStatus('No se pudo copiar.', true);
        }
      };
    });
  </script>
</Layout>
