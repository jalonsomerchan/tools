---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';
import { getToolTranslations, type ToolTranslationsMap } from '../i18n/tools';

const lang = getLangFromUrl(Astro.url);
const t = getToolTranslations('json-viewer', lang) as ToolTranslationsMap['json-viewer']['en'];

const ui = lang === 'es'
  ? {
      input: 'Texto JSON', tree: 'Árbol', table: 'Tabla', output: 'Salida', stats: 'Resumen',
      actions: { format: t.actions.format, minify: t.actions.minify, validate: t.actions.validate, clear: t.actions.clear, copy: t.actions.copy, expandAll: 'Expandir todo', collapseAll: 'Contraer todo', download: 'Descargar .json', sample: 'Ejemplo' },
      labels: { root: 'raíz', object: 'objeto', array: 'array', props: 'props', items: 'items', value: 'valor', emptyObject: 'Objeto vacío', emptyArray: 'Array vacío', repaired: 'JSON reparado automáticamente para poder mostrar el árbol.' },
      messages: { ...t.messages, pasteFirst: 'Pega primero un JSON.', validTree: 'JSON válido. Árbol actualizado.', repaired: 'JSON no válido. Se ha intentado cerrar automáticamente y se muestra una versión reparada.', repairFailed: 'JSON no válido. No se ha podido reparar lo suficiente para crear el árbol.', edited: 'Valor editado y JSON actualizado.', collapsedAll: 'Todos los nodos contraídos.', expandedAll: 'Todos los nodos expandidos.', noResult: 'No hay resultado para copiar.', downloaded: 'Archivo JSON descargado.', sampleLoaded: 'Ejemplo cargado.' }
    }
  : {
      input: 'JSON text', tree: 'Tree', table: 'Table', output: 'Output', stats: 'Summary',
      actions: { format: t.actions.format, minify: t.actions.minify, validate: t.actions.validate, clear: t.actions.clear, copy: t.actions.copy, expandAll: 'Expand all', collapseAll: 'Collapse all', download: 'Download .json', sample: 'Sample' },
      labels: { root: 'root', object: 'object', array: 'array', props: 'props', items: 'items', value: 'value', emptyObject: 'Empty object', emptyArray: 'Empty array', repaired: 'JSON was automatically repaired to show the tree.' },
      messages: { ...t.messages, pasteFirst: 'Paste JSON first.', validTree: 'Valid JSON. Tree updated.', repaired: 'Invalid JSON. It was closed automatically and a repaired version is shown.', repairFailed: 'Invalid JSON. It could not be repaired enough to create the tree.', edited: 'Value edited and JSON updated.', collapsedAll: 'All nodes collapsed.', expandedAll: 'All nodes expanded.', noResult: 'There is no result to copy.', downloaded: 'JSON file downloaded.', sampleLoaded: 'Sample loaded.' }
    };
---

<Layout title={t.title} description={t.description} lang={lang} path="/json-viewer/" translated={true}>
  <section class="json-page">
    <div class="eyebrow">{t.heroEyebrow}</div>
    <h1>{t.title}</h1>
    <p class="hero-text">{t.heroText}</p>

    <section class="tool-card json-tool" aria-label={t.title}>
      <div class="toolbar" aria-label="JSON actions">
        <button class="primary" id="formatBtn" type="button">{ui.actions.format}</button>
        <button id="minifyBtn" type="button">{ui.actions.minify}</button>
        <button id="validateBtn" type="button">{ui.actions.validate}</button>
        <button id="expandAllBtn" type="button">{ui.actions.expandAll}</button>
        <button id="collapseAllBtn" type="button">{ui.actions.collapseAll}</button>
        <button id="downloadBtn" type="button">{ui.actions.download}</button>
        <button id="copyBtn" type="button">{ui.actions.copy}</button>
        <button id="sampleBtn" type="button">{ui.actions.sample}</button>
        <button id="clearBtn" type="button">{ui.actions.clear}</button>
      </div>

      <div class="editor-shell">
        <section class="text-pane" aria-label={ui.input}>
          <div class="pane-tabs" aria-hidden="true"><span class="active">text</span><span>tree</span><span>table</span></div>
          <textarea id="input" spellcheck="false" placeholder={t.placeholders.input}></textarea>
        </section>

        <section class="tree-pane" aria-label={ui.tree}>
          <div class="pane-tabs" aria-hidden="true"><span>text</span><span class="active">tree</span><span>table</span></div>
          <div class="tree-status"><span id="treeBadge">0 items</span><button id="rootToggleBtn" type="button" aria-label={ui.actions.collapseAll}>⌄</button></div>
          <div class="json-tree" id="tree" role="tree" aria-live="polite"></div>
        </section>
      </div>

      <details class="output-details">
        <summary>{ui.output} · {ui.stats}</summary>
        <textarea id="output" readonly spellcheck="false" placeholder={t.placeholders.output}></textarea>
        <dl class="stats-grid">
          <div><dt>Nodos</dt><dd id="statNodes">0</dd></div>
          <div><dt>Objetos</dt><dd id="statObjects">0</dd></div>
          <div><dt>Arrays</dt><dd id="statArrays">0</dd></div>
          <div><dt>Tamaño</dt><dd id="statSize">0 B</dd></div>
        </dl>
      </details>

      <p class="status" id="status" role="status" aria-live="polite">{ui.messages.ready}</p>
    </section>
  </section>

  <style>
    .json-page { padding: clamp(2.5rem, 6vw, 4rem) 0; }
    .json-tool { padding: clamp(.75rem, 2vw, 1rem); margin-top: 2rem; overflow: hidden; }
    .toolbar { display: flex; gap: .55rem; margin-bottom: .8rem; flex-wrap: wrap; }
    button { min-height: 2.35rem; background: var(--color-surface); color: var(--color-text); border: 1px solid var(--border); border-radius: 999px; padding: .55rem .85rem; cursor: pointer; font-weight: 850; box-shadow: var(--shadow-xs); }
    button:hover { border-color: color-mix(in srgb, var(--primary) 45%, var(--border)); }
    button.primary { background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); color: #fff; border-color: transparent; }
    .editor-shell { display: grid; grid-template-columns: minmax(0, 1fr) minmax(360px, 1fr); min-height: 680px; border: 1px solid var(--border); border-radius: 20px; overflow: hidden; background: #1f2937; }
    .text-pane, .tree-pane { min-width: 0; display: flex; flex-direction: column; background: #111827; }
    .text-pane { border-right: 1px solid #374151; }
    .pane-tabs { display: flex; align-items: center; gap: .25rem; min-height: 2.6rem; padding: .35rem .6rem; background: color-mix(in srgb, var(--color-primary) 70%, #64748b); color: #fff; font-weight: 800; }
    .pane-tabs span { padding: .25rem .55rem; border-radius: .35rem; opacity: .75; }
    .pane-tabs .active { outline: 1px solid rgba(255,255,255,.8); opacity: 1; background: rgba(255,255,255,.12); }
    textarea { width: 100%; flex: 1; min-height: 540px; border: 0; border-radius: 0; background: #111827; color: #e5e7eb; padding: 1rem; font-family: var(--font-mono); line-height: 1.55; resize: vertical; tab-size: 2; box-shadow: none !important; }
    textarea[data-invalid='true'] { outline: 2px solid rgba(252, 165, 165, .45); outline-offset: -2px; }
    .tree-status { display: flex; justify-content: space-between; align-items: center; min-height: 2.4rem; padding: .35rem .75rem; background: #1f2937; color: #d1d5db; border-bottom: 1px solid #374151; }
    .tree-status span { display: inline-flex; border-radius: 999px; padding: .2rem .55rem; background: rgba(255,255,255,.1); color: #cbd5e1; font-size: .85rem; }
    .tree-status button { min-height: 1.8rem; padding: .1rem .4rem; border-radius: .4rem; background: transparent; color: #e5e7eb; box-shadow: none; font-size: 1.2rem; }
    .json-tree { flex: 1; max-height: 640px; overflow: auto; background: #111827; color: #d1d5db; padding: .75rem .75rem 2rem; font-family: var(--font-mono); font-size: .94rem; }
    .tree-empty { margin: 1rem; color: #9ca3af; font-family: var(--font-sans); }
    .tree-node { --depth: 0; margin-left: calc(var(--depth) * 1.15rem); }
    .node-row { display: flex; align-items: center; gap: .35rem; min-height: 1.75rem; padding: .1rem .2rem; border-radius: .35rem; white-space: nowrap; }
    .node-row:hover { background: rgba(255,255,255,.06); }
    .toggle { width: 1.35rem; min-width: 1.35rem; min-height: 1.35rem; padding: 0; border: 0; background: transparent; color: #d1d5db; box-shadow: none; border-radius: .25rem; font-size: 1rem; }
    .toggle.placeholder { visibility: hidden; }
    .node-key { color: #93c5fd; font-weight: 850; }
    .node-meta { color: #9ca3af; }
    .node-summary { color: #9ca3af; border-radius: .35rem; padding: .08rem .38rem; background: rgba(255,255,255,.08); }
    .node-children { border-left: 1px dotted rgba(255,255,255,.16); margin-left: .65rem; }
    .value-editor { display: inline-flex; align-items: center; gap: .35rem; }
    .value-editor select, .value-editor input { width: auto !important; min-height: 1.8rem !important; padding: .25rem .45rem !important; border-radius: .35rem !important; border-color: #374151 !important; background: #020617 !important; color: #e5e7eb !important; font-family: var(--font-mono); font-size: .88rem; box-shadow: none !important; }
    .value-editor input { min-width: min(280px, 42vw); }
    .type-string { color: #86efac; } .type-number { color: #67e8f9; } .type-boolean { color: #fbbf24; } .type-null { color: #c4b5fd; }
    .output-details { margin-top: .85rem; border: 1px solid var(--border); border-radius: 16px; background: var(--color-surface); overflow: hidden; }
    .output-details summary { cursor: pointer; padding: .8rem 1rem; color: var(--color-text); font-weight: 900; }
    .output-details textarea { min-height: 220px; max-height: 360px; }
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .55rem; margin: 0; padding: .75rem; }
    .stats-grid div { display: flex; justify-content: space-between; gap: .5rem; padding: .65rem; border-radius: 12px; background: var(--color-surface-soft); border: 1px solid var(--border); }
    .stats-grid dt { color: var(--muted); font-weight: 800; } .stats-grid dd { margin: 0; font-weight: 950; color: var(--color-text); }
    .status { margin: .85rem 0 0; color: var(--muted); white-space: pre-wrap; }
    @media (max-width: 980px) { .editor-shell { grid-template-columns: 1fr; min-height: auto; } .text-pane { border-right: 0; border-bottom: 1px solid #374151; } textarea { min-height: 340px; } .json-tree { max-height: 520px; } .stats-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .json-tool { margin-inline: -.35rem; } .toolbar button { flex: 1 1 calc(50% - .55rem); padding-inline: .5rem; } .value-editor { display: grid; grid-template-columns: 1fr; width: 100%; } .value-editor select, .value-editor input { width: 100% !important; } .stats-grid { grid-template-columns: 1fr; } }
  </style>

  <script define:vars={{ copy: ui }}>
    window.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('input');
      const output = document.getElementById('output');
      const status = document.getElementById('status');
      const tree = document.getElementById('tree');
      const treeBadge = document.getElementById('treeBadge');
      const formatBtn = document.getElementById('formatBtn');
      const minifyBtn = document.getElementById('minifyBtn');
      const validateBtn = document.getElementById('validateBtn');
      const clearBtn = document.getElementById('clearBtn');
      const copyBtn = document.getElementById('copyBtn');
      const expandAllBtn = document.getElementById('expandAllBtn');
      const collapseAllBtn = document.getElementById('collapseAllBtn');
      const rootToggleBtn = document.getElementById('rootToggleBtn');
      const downloadBtn = document.getElementById('downloadBtn');
      const sampleBtn = document.getElementById('sampleBtn');
      const statNodes = document.getElementById('statNodes');
      const statObjects = document.getElementById('statObjects');
      const statArrays = document.getElementById('statArrays');
      const statSize = document.getElementById('statSize');

      const INDENT = '  ';
      const collapsedPaths = new Set();
      let currentJson = null;
      let hasCurrentJson = false;
      let lastValidText = '';

      const sampleJson = { name: 'La1.TV', events: [{ hi: 1778302800, hf: 1778313600, t: 'Noticias 24H', d: 'Noticias de actualidad.', g: 'NEWS' }, { hi: 1778313600, hf: 1778315400, t: 'Audiencia abierta', d: 'Espacio de servicio público.', g: 'NEWS' }], active: true, meta: { source: 'sample', quality: null } };

      const setStatus = (message, error = false) => { status.textContent = message; status.style.color = error ? '#fca5a5' : 'var(--muted)'; input.dataset.invalid = String(error); output.dataset.invalid = String(error); };
      const getType = (value) => value === null ? 'null' : Array.isArray(value) ? 'array' : typeof value;
      const pathToKey = (path) => path.length ? path.map(String).join('.') : '$';
      const getChildrenEntries = (value) => Array.isArray(value) ? value.map((item, index) => [index, item]) : value && typeof value === 'object' ? Object.entries(value) : [];
      const formatBytes = (bytes) => bytes < 1024 ? `${bytes} B` : bytes < 1048576 ? `${(bytes / 1024).toFixed(1)} KB` : `${(bytes / 1048576).toFixed(1)} MB`;

      const parseJson = (value) => JSON.parse(value);
      const stripUnsafeTrailingTokens = (value) => value.replace(/[,{:\s]*$/u, '').replace(/,\s*([}\]])/gu, '$1');

      const closeLooseJson = (raw) => {
        let text = raw.trim();
        if (!text) return null;
        const stack = [];
        let inString = false;
        let escaped = false;
        let lastToken = '';

        for (const char of text) {
          if (inString) {
            if (escaped) { escaped = false; continue; }
            if (char === '\\') { escaped = true; continue; }
            if (char === '"') inString = false;
            continue;
          }
          if (char === '"') { inString = true; lastToken = char; continue; }
          if (char === '{') { stack.push('}'); lastToken = char; continue; }
          if (char === '[') { stack.push(']'); lastToken = char; continue; }
          if ((char === '}' || char === ']') && stack[stack.length - 1] === char) stack.pop();
          if (!/\s/.test(char)) lastToken = char;
        }

        if (inString) text += '"';
        text = stripUnsafeTrailingTokens(text);
        if (lastToken === ':') text += 'null';
        return text + stack.reverse().join('');
      };

      const tryParseOrRepair = () => {
        try { return { data: parseJson(input.value), repaired: false, text: input.value }; }
        catch (error) {
          const repairedText = closeLooseJson(input.value);
          if (!repairedText) throw error;
          return { data: parseJson(repairedText), repaired: true, text: repairedText, error };
        }
      };

      const updateStats = (data) => {
        const stats = { nodes: 0, objects: 0, arrays: 0 };
        const walk = (value) => { stats.nodes += 1; if (Array.isArray(value)) { stats.arrays += 1; value.forEach(walk); return; } if (value && typeof value === 'object') { stats.objects += 1; Object.values(value).forEach(walk); } };
        if (hasCurrentJson) walk(data);
        statNodes.textContent = String(stats.nodes); statObjects.textContent = String(stats.objects); statArrays.textContent = String(stats.arrays); statSize.textContent = formatBytes(new Blob([output.value || input.value || '']).size);
        const rootCount = hasCurrentJson && (Array.isArray(data) || (data && typeof data === 'object')) ? getChildrenEntries(data).length : 0;
        treeBadge.textContent = `${rootCount} ${Array.isArray(data) ? copy.labels.items : copy.labels.props}`;
      };

      const setValueAtPath = (target, path, value) => { if (!path.length) return value; const clone = structuredClone(target); let pointer = clone; for (let index = 0; index < path.length - 1; index += 1) pointer = pointer[path[index]]; pointer[path[path.length - 1]] = value; return clone; };
      const parseEditedValue = (type, rawValue) => { if (type === 'string') return rawValue; if (type === 'number') { const parsed = Number(rawValue); if (!Number.isFinite(parsed)) throw new Error('Invalid number'); return parsed; } if (type === 'boolean') return rawValue === 'true'; return null; };
      const createText = (text, className) => { const span = document.createElement('span'); span.textContent = text; if (className) span.className = className; return span; };

      const syncJson = (data, message, repaired = false, sourceText = null) => {
        currentJson = data; hasCurrentJson = true; lastValidText = JSON.stringify(data, null, 2);
        output.value = repaired && sourceText ? sourceText : lastValidText;
        renderTree(data); updateStats(data); setStatus(message, repaired);
      };

      const applyValueEdit = (path, type, rawValue) => {
        try { currentJson = setValueAtPath(currentJson, path, parseEditedValue(type, rawValue)); input.value = JSON.stringify(currentJson, null, 2); syncJson(currentJson, copy.messages.edited); }
        catch { setStatus(copy.messages.editError || 'Could not edit value.', true); }
      };

      const renderPrimitiveEditor = (value, path) => {
        const editor = document.createElement('span'); editor.className = 'value-editor';
        const type = getType(value); const select = document.createElement('select'); select.setAttribute('aria-label', 'type');
        ['string', 'number', 'boolean', 'null'].forEach((optionType) => { const option = document.createElement('option'); option.value = optionType; option.textContent = optionType; option.selected = optionType === type; select.append(option); });
        const field = document.createElement('input'); field.setAttribute('aria-label', copy.labels.value); field.dataset.kind = type; field.className = `type-${type}`;
        const setFieldValue = () => { const selectedType = select.value; field.dataset.kind = selectedType; field.className = `type-${selectedType}`; field.disabled = selectedType === 'null'; if (selectedType === 'boolean') { field.setAttribute('list', 'jsonBooleanValues'); field.value = value === false ? 'false' : 'true'; } else { field.removeAttribute('list'); field.value = selectedType === 'null' ? 'null' : String(value ?? ''); } };
        select.addEventListener('change', () => applyValueEdit(path, select.value, select.value === 'boolean' ? 'true' : field.value));
        field.addEventListener('change', () => applyValueEdit(path, select.value, field.value));
        field.addEventListener('keydown', (event) => { if (event.key === 'Enter') { event.preventDefault(); field.blur(); } });
        setFieldValue(); editor.append(select, field); return editor;
      };

      const renderNode = (key, value, path, depth = 0) => {
        const type = getType(value); const isContainer = type === 'array' || type === 'object'; const pathKey = pathToKey(path); const isCollapsed = collapsedPaths.has(pathKey);
        const node = document.createElement('div'); node.className = 'tree-node'; node.style.setProperty('--depth', String(depth)); node.setAttribute('role', 'treeitem'); node.setAttribute('aria-expanded', isContainer ? String(!isCollapsed) : 'false');
        const row = document.createElement('div'); row.className = 'node-row';
        const toggle = document.createElement('button'); toggle.type = 'button'; toggle.className = isContainer ? 'toggle' : 'toggle placeholder'; toggle.textContent = isCollapsed ? '›' : '⌄';
        toggle.addEventListener('click', () => { collapsedPaths.has(pathKey) ? collapsedPaths.delete(pathKey) : collapsedPaths.add(pathKey); renderTree(currentJson); }); row.append(toggle);
        row.append(createText(key === null ? copy.labels.root : String(key), 'node-key'));
        if (isContainer) { const entries = getChildrenEntries(value); row.append(createText(':', 'node-meta')); row.append(createText(`${type === 'array' ? '[' : '{'} ${entries.length} ${type === 'array' ? copy.labels.items : copy.labels.props} ${type === 'array' ? ']' : '}'}`, 'node-summary')); }
        else { row.append(createText(':', `node-meta type-${type}`)); row.append(renderPrimitiveEditor(value, path)); }
        node.append(row);
        if (isContainer && !isCollapsed) { const children = document.createElement('div'); children.className = 'node-children'; children.setAttribute('role', 'group'); const entries = getChildrenEntries(value); if (!entries.length) children.append(createText(type === 'array' ? copy.labels.emptyArray : copy.labels.emptyObject, 'tree-empty')); else entries.forEach(([childKey, childValue]) => children.append(renderNode(childKey, childValue, [...path, childKey], depth + 1))); node.append(children); }
        return node;
      };

      const renderTree = (data) => {
        tree.replaceChildren();
        if (!hasCurrentJson) { tree.append(createText(t.placeholders.output, 'tree-empty')); treeBadge.textContent = '0 items'; return; }
        tree.append(renderNode(null, data, [], 0));
        if (!document.getElementById('jsonBooleanValues')) { const datalist = document.createElement('datalist'); datalist.id = 'jsonBooleanValues'; datalist.append(new Option('true'), new Option('false')); document.body.append(datalist); }
      };

      const collectContainerPaths = (value, path = [], paths = []) => { const type = getType(value); if (type === 'array' || type === 'object') { paths.push(pathToKey(path)); getChildrenEntries(value).forEach(([childKey, childValue]) => collectContainerPaths(childValue, [...path, childKey], paths)); } return paths; };

      const updateFromInput = (formatInput = false, successMessage = copy.messages.validTree) => {
        if (!input.value.trim()) { hasCurrentJson = false; currentJson = null; output.value = ''; renderTree(null); updateStats(null); setStatus(copy.messages.ready); return; }
        try { const result = tryParseOrRepair(); if (formatInput || result.repaired) input.value = JSON.stringify(result.data, null, 2); syncJson(result.data, result.repaired ? copy.messages.repaired : successMessage, result.repaired, result.repaired ? JSON.stringify(result.data, null, 2) : null); }
        catch { hasCurrentJson = false; currentJson = null; output.value = closeLooseJson(input.value) || input.value; renderTree(null); updateStats(null); setStatus(copy.messages.repairFailed, true); }
      };

      formatBtn.onclick = () => updateFromInput(true, copy.messages.formatted);
      validateBtn.onclick = () => updateFromInput(false, copy.messages.valid);
      minifyBtn.onclick = () => { if (!input.value.trim()) { setStatus(copy.messages.pasteFirst, true); return; } try { const result = tryParseOrRepair(); currentJson = result.data; hasCurrentJson = true; output.value = JSON.stringify(result.data); lastValidText = JSON.stringify(result.data, null, 2); renderTree(result.data); updateStats(result.data); setStatus(result.repaired ? copy.messages.repaired : copy.messages.minified, result.repaired); } catch { output.value = closeLooseJson(input.value) || input.value; setStatus(copy.messages.repairFailed, true); } };
      expandAllBtn.onclick = () => { collapsedPaths.clear(); renderTree(currentJson); setStatus(copy.messages.expandedAll); };
      collapseAllBtn.onclick = () => { if (!hasCurrentJson) return; collapsedPaths.clear(); collectContainerPaths(currentJson).forEach((path) => collapsedPaths.add(path)); renderTree(currentJson); setStatus(copy.messages.collapsedAll); };
      rootToggleBtn.onclick = () => { if (!hasCurrentJson) return; collapsedPaths.has('$') ? collapsedPaths.delete('$') : collapsedPaths.add('$'); renderTree(currentJson); };
      clearBtn.onclick = () => { input.value = ''; output.value = ''; currentJson = null; hasCurrentJson = false; lastValidText = ''; collapsedPaths.clear(); renderTree(null); updateStats(null); setStatus(copy.messages.cleared); };
      copyBtn.onclick = async () => { const text = output.value || lastValidText; if (!text.trim()) { setStatus(copy.messages.noResult, true); return; } try { await navigator.clipboard.writeText(text); setStatus(copy.messages.copied); } catch { output.focus(); output.select(); setStatus(copy.messages.copyError, true); } };
      downloadBtn.onclick = () => { const text = output.value || lastValidText; if (!text.trim()) { setStatus(copy.messages.noResult, true); return; } const blob = new Blob([text], { type: 'application/json' }); const url = URL.createObjectURL(blob); const link = document.createElement('a'); link.href = url; link.download = 'data.json'; link.click(); URL.revokeObjectURL(url); setStatus(copy.messages.downloaded); };
      sampleBtn.onclick = () => { collapsedPaths.clear(); input.value = JSON.stringify(sampleJson, null, 2); syncJson(sampleJson, copy.messages.sampleLoaded); };
      input.addEventListener('input', () => updateFromInput(false));
      input.addEventListener('keydown', (event) => { if (event.key === 'Tab') { event.preventDefault(); input.setRangeText(INDENT, input.selectionStart, input.selectionEnd, 'end'); } });
      renderTree(null); updateStats(null);
    });
  </script>
</Layout>
