---
import Layout from '../layouts/Layout.astro';
import JsonViewerTool from '../components/tools/JsonViewerTool.astro';
import { useTranslations } from '../i18n';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout
  title={t('json.title')}
  description={t('json.description')}
  lang={lang}
  path="/json-viewer/"
>
  <JsonViewerTool lang={lang} />
</Layout>
