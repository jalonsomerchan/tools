---
import Layout from '../layouts/Layout.astro';

const title = 'Coordenadas de direcciones';
---

<Layout title={title}>
  <section style="padding: 4rem 0;">
    <div class="eyebrow">Alon Tools</div>

    <h1>{title}</h1>

    <p class="hero-text">
      Obtén coordenadas GPS buscando una dirección o seleccionando un punto directamente sobre el mapa.
    </p>

    <section class="tool-card">
      <div class="toolbar">
        <input id="searchInput" type="text" placeholder="Buscar dirección o lugar..." />
        <button class="primary" id="searchBtn">Buscar</button>
      </div>

      <div id="map"></div>

      <div class="results-grid">
        <div class="result-card">
          <span>Latitud</span>
          <strong id="latitude">-</strong>
        </div>

        <div class="result-card">
          <span>Longitud</span>
          <strong id="longitude">-</strong>
        </div>

        <div class="result-card">
          <span>Dirección</span>
          <strong id="address">-</strong>
        </div>
      </div>

      <div class="buttons-row">
        <button id="copyBtn">Copiar coordenadas</button>
        <button id="googleBtn">Abrir en Google Maps</button>
      </div>
    </section>
  </section>

  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  />

  <style>
    .toolbar {
      display: flex;
      gap: 1rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }

    input {
      flex: 1;
      min-width: 260px;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      font-size: 1rem;
    }

    button {
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      cursor: pointer;
      font: inherit;
    }

    button.primary {
      background: var(--primary);
      color: black;
      border: none;
      font-weight: 700;
    }

    #map {
      width: 100%;
      height: 520px;
      border-radius: 24px;
      overflow: hidden;
      border: 1px solid var(--border);
      margin-top: 1rem;
    }

    .results-grid {
      margin-top: 1rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1rem;
    }

    .result-card {
      border-radius: 20px;
      border: 1px solid var(--border);
      background: rgba(2,6,23,.55);
      padding: 1rem;
      display: flex;
      flex-direction: column;
      gap: .45rem;
    }

    .result-card span {
      color: var(--muted);
      font-size: .92rem;
    }

    .buttons-row {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-top: 1rem;
    }
  </style>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const map = L.map('map').setView([40.4168, -3.7038], 6);

      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
      }).addTo(map);

      let marker = null;
      let currentLat = null;
      let currentLng = null;

      const setData = (lat, lng, address = 'Ubicación seleccionada') => {
        currentLat = lat;
        currentLng = lng;

        document.getElementById('latitude').textContent = lat.toFixed(6);
        document.getElementById('longitude').textContent = lng.toFixed(6);
        document.getElementById('address').textContent = address;
      };

      const placeMarker = (lat, lng) => {
        if (marker) {
          marker.setLatLng([lat, lng]);
        } else {
          marker = L.marker([lat, lng]).addTo(map);
        }
      };

      map.on('click', async (e) => {
        const { lat, lng } = e.latlng;

        placeMarker(lat, lng);
        setData(lat, lng);

        try {
          const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`);
          const data = await response.json();

          if (data.display_name) {
            setData(lat, lng, data.display_name);
          }
        } catch {}
      });

      document.getElementById('searchBtn').onclick = async () => {
        const query = document.getElementById('searchInput').value.trim();

        if (!query) return;

        const response = await fetch(`https://nominatim.openstreetmap.org/search?format=jsonv2&q=${encodeURIComponent(query)}`);
        const data = await response.json();

        if (!data.length) {
          alert('No se encontraron resultados');
          return;
        }

        const result = data[0];
        const lat = parseFloat(result.lat);
        const lng = parseFloat(result.lon);

        map.setView([lat, lng], 15);
        placeMarker(lat, lng);
        setData(lat, lng, result.display_name);
      };

      document.getElementById('copyBtn').onclick = async () => {
        if (currentLat === null) return;

        await navigator.clipboard.writeText(`${currentLat}, ${currentLng}`);
      };

      document.getElementById('googleBtn').onclick = () => {
        if (currentLat === null) return;

        window.open(`https://maps.google.com/?q=${currentLat},${currentLng}`, '_blank');
      };
    });
  </script>
</Layout>
