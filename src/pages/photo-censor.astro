---
import Layout from '../layouts/Layout.astro';

const title = 'Censurador de fotos';
---

<Layout title={title}>
  <section style="padding: 4rem 0;">
    <div class="eyebrow">Alon Tools</div>

    <h1>{title}</h1>

    <p class="hero-text">
      Sube una imagen, marca las zonas sensibles y censúralas con pixelado, desenfoque o bloque negro. Todo ocurre en tu navegador.
    </p>

    <section class="tool-card">
      <div class="controls">
        <label class="file-button">
          Subir imagen
          <input id="fileInput" type="file" accept="image/*" hidden />
        </label>

        <label>
          Modo
          <select id="mode">
            <option value="pixelate">Pixelar</option>
            <option value="blur">Desenfocar</option>
            <option value="black">Bloque negro</option>
          </select>
        </label>

        <label>
          Intensidad
          <input id="intensity" type="range" min="4" max="40" value="18" />
        </label>

        <label>
          Zoom
          <input id="zoom" type="range" min="50" max="300" value="100" />
        </label>

        <button id="undoBtn">Deshacer</button>
        <button id="resetBtn">Reiniciar</button>
        <button class="primary" id="downloadBtn">Descargar</button>
      </div>

      <div class="canvas-wrap" id="canvasWrap">
        <canvas id="canvas"></canvas>
        <div id="selectionBox"></div>
        <p id="emptyState">Sube una imagen para empezar. Después arrastra sobre la foto para censurar una zona.</p>
      </div>

      <p class="mobile-tip">
        En móvil puedes hacer zoom y desplazarte con dos dedos para seleccionar zonas pequeñas con más precisión.
      </p>

      <p class="status" id="status">Listo.</p>
    </section>
  </section>

  <style>
    .controls {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      align-items: end;
      margin-bottom: 1.5rem;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: .45rem;
      color: var(--muted);
      font-size: .92rem;
    }

    select,
    input[type="range"] {
      min-width: 180px;
    }

    select,
    button,
    .file-button {
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      cursor: pointer;
      font: inherit;
    }

    button.primary {
      background: var(--primary);
      color: black;
      border: none;
      font-weight: 700;
    }

    .file-button {
      color: black;
      background: var(--primary);
      font-weight: 700;
    }

    .canvas-wrap {
      position: relative;
      min-height: 420px;
      border-radius: 24px;
      border: 1px solid var(--border);
      overflow: auto;
      display: grid;
      place-items: center;
      touch-action: pan-x pan-y pinch-zoom;
      background:
        linear-gradient(45deg, rgba(148,163,184,.08) 25%, transparent 25%),
        linear-gradient(-45deg, rgba(148,163,184,.08) 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, rgba(148,163,184,.08) 75%),
        linear-gradient(-45deg, transparent 75%, rgba(148,163,184,.08) 75%);
      background-size: 24px 24px;
    }

    canvas {
      max-width: none;
      display: none;
      cursor: crosshair;
      transform-origin: top left;
    }

    #selectionBox {
      position: absolute;
      border: 2px dashed var(--primary);
      background: rgba(56,189,248,.15);
      pointer-events: none;
      display: none;
      border-radius: 8px;
    }

    #emptyState,
    .mobile-tip,
    .status {
      color: var(--muted);
    }

    .mobile-tip {
      margin-top: 1rem;
      line-height: 1.7;
    }

    @media (max-width: 768px) {
      .controls {
        gap: .7rem;
      }

      button,
      .file-button,
      select {
        width: 100%;
      }
    }
  </style>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const fileInput = document.getElementById('fileInput');
      const canvas = document.getElementById('canvas');
      const ctx = canvas.getContext('2d');
      const mode = document.getElementById('mode');
      const intensity = document.getElementById('intensity');
      const zoom = document.getElementById('zoom');
      const emptyState = document.getElementById('emptyState');
      const status = document.getElementById('status');
      const selectionBox = document.getElementById('selectionBox');

      let originalImage = null;
      let history = [];
      let drawing = false;
      let startX = 0;
      let startY = 0;
      let zoomLevel = 1;

      const setStatus = (message) => {
        status.textContent = message;
      };

      const updateZoom = () => {
        zoomLevel = Number(zoom.value) / 100;
        canvas.style.transform = `scale(${zoomLevel})`;
      };

      zoom.addEventListener('input', updateZoom);

      const getPointer = (event) => {
        const rect = canvas.getBoundingClientRect();
        const clientX = event.touches ? event.touches[0].clientX : event.clientX;
        const clientY = event.touches ? event.touches[0].clientY : event.clientY;

        return {
          x: (clientX - rect.left) / zoomLevel,
          y: (clientY - rect.top) / zoomLevel,
          rawX: clientX - rect.left,
          rawY: clientY - rect.top
        };
      };

      const saveState = () => {
        history.push(ctx.getImageData(0, 0, canvas.width, canvas.height));
        if (history.length > 20) history.shift();
      };

      const drawImage = (image) => {
        const maxWidth = 1600;
        const ratio = Math.min(1, maxWidth / image.width);

        canvas.width = Math.round(image.width * ratio);
        canvas.height = Math.round(image.height * ratio);

        ctx.drawImage(image, 0, 0, canvas.width, canvas.height);
        canvas.style.display = 'block';
        emptyState.hidden = true;
        history = [];
        saveState();
        updateZoom();
      };

      const pixelate = (x, y, width, height, blockSize) => {
        for (let yy = y; yy < y + height; yy += blockSize) {
          for (let xx = x; xx < x + width; xx += blockSize) {
            const pixel = ctx.getImageData(xx, yy, 1, 1).data;
            ctx.fillStyle = `rgb(${pixel[0]}, ${pixel[1]}, ${pixel[2]})`;
            ctx.fillRect(xx, yy, blockSize, blockSize);
          }
        }
      };

      const blurArea = (x, y, width, height, amount) => {
        const temp = document.createElement('canvas');
        temp.width = width;
        temp.height = height;
        const tempCtx = temp.getContext('2d');

        tempCtx.drawImage(canvas, x, y, width, height, 0, 0, width, height);

        ctx.save();
        ctx.filter = `blur(${amount}px)`;
        ctx.drawImage(temp, x, y);
        ctx.restore();
      };

      const censorArea = (a, b) => {
        const x = Math.min(a.x, b.x);
        const y = Math.min(a.y, b.y);
        const width = Math.abs(a.x - b.x);
        const height = Math.abs(a.y - b.y);

        if (width < 4 || height < 4) return;

        saveState();

        if (mode.value === 'pixelate') {
          pixelate(x, y, width, height, Number(intensity.value));
        }

        if (mode.value === 'blur') {
          blurArea(x, y, width, height, Math.round(Number(intensity.value) / 3));
        }

        if (mode.value === 'black') {
          ctx.fillStyle = '#000';
          ctx.fillRect(x, y, width, height);
        }

        setStatus('Zona censurada.');
      };

      const updateSelection = (a, b) => {
        selectionBox.style.display = 'block';
        selectionBox.style.left = `${Math.min(a.rawX, b.rawX)}px`;
        selectionBox.style.top = `${Math.min(a.rawY, b.rawY)}px`;
        selectionBox.style.width = `${Math.abs(a.rawX - b.rawX)}px`;
        selectionBox.style.height = `${Math.abs(a.rawY - b.rawY)}px`;
      };

      fileInput.addEventListener('change', () => {
        const file = fileInput.files[0];
        if (!file) return;

        const image = new Image();
        image.onload = () => {
          originalImage = image;
          drawImage(image);
          setStatus('Imagen cargada.');
        };

        image.src = URL.createObjectURL(file);
      });

      const startDraw = (event) => {
        if (!originalImage) return;
        drawing = true;
        const point = getPointer(event);
        startX = point.x;
        startY = point.y;
      };

      const moveDraw = (event) => {
        if (!drawing) return;
        updateSelection({ rawX: startX * zoomLevel, rawY: startY * zoomLevel }, getPointer(event));
      };

      const endDraw = (event) => {
        if (!drawing) return;
        drawing = false;
        selectionBox.style.display = 'none';
        censorArea({ x: startX, y: startY }, getPointer(event));
      };

      canvas.addEventListener('mousedown', startDraw);
      canvas.addEventListener('mousemove', moveDraw);
      canvas.addEventListener('mouseup', endDraw);

      canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length !== 1) return;
        e.preventDefault();
        startDraw(e);
      }, { passive: false });

      canvas.addEventListener('touchmove', (e) => {
        if (e.touches.length !== 1) return;
        e.preventDefault();
        moveDraw(e);
      }, { passive: false });

      canvas.addEventListener('touchend', (e) => {
        e.preventDefault();
        endDraw(e.changedTouches ? { touches: [e.changedTouches[0]] } : e);
      }, { passive: false });

      document.getElementById('undoBtn').onclick = () => {
        if (history.length <= 1) return;
        history.pop();
        ctx.putImageData(history[history.length - 1], 0, 0);
      };

      document.getElementById('resetBtn').onclick = () => {
        if (!originalImage) return;
        drawImage(originalImage);
      };

      document.getElementById('downloadBtn').onclick = () => {
        if (!originalImage) return;
        const link = document.createElement('a');
        link.download = 'imagen-censurada.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      };
    });
  </script>
</Layout>
