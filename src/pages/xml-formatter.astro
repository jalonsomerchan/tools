---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';
import { getToolTranslations, type ToolTranslationsMap } from '../i18n/tools';
const lang=getLangFromUrl(Astro.url);
const t=getToolTranslations('xml-formatter',lang) as ToolTranslationsMap['xml-formatter']['en'];
const es=lang==='es';
const ui={paste:es?'Pegar':'Paste',copyInput:es?'Copiar editor':'Copy editor',selectAll:es?'Seleccionar todo':'Select all',sample:es?'Ejemplo':'Sample',expand:es?'Expandir todo':'Expand all',collapse:es?'Contraer todo':'Collapse all',summary:es?'Resumen':'Summary',nodes:es?'nodos':'nodes',attrs:es?'atributos':'attrs',path:es?'ruta':'path',tag:es?'etiqueta':'tag',text:es?'texto':'text',edit:es?'Nuevo valor':'New value',edited:es?'Valor actualizado.':'Value updated.',valid:es?'XML válido. Vista actualizada.':'Valid XML. View updated.',repaired:es?'XML no válido. Se ha cerrado automáticamente para poder mostrarlo.':'Invalid XML. It was automatically closed so it can be shown.',failed:es?'XML no válido. No se ha podido reparar lo suficiente.':'Invalid XML. It could not be repaired enough.',empty:es?'No hay resultado para copiar.':'There is no result to copy.',pasted:es?'Contenido pegado.':'Content pasted.',selected:es?'Texto seleccionado.':'Text selected.',expanded:es?'Nodos expandidos.':'Nodes expanded.',collapsed:es?'Nodos contraídos.':'Nodes collapsed.'};
---
<Layout title={t.title} description={t.description} lang={lang} path="/xml-formatter/" translated={true}>
<section class="xml-page"><div class="eyebrow">{t.heroEyebrow}</div><h1>{t.title}</h1><p class="hero-text">{t.heroText}</p>
<section class="tool-card xml-tool" aria-label={t.title}><div class="shell"><section class="pane"><div class="bar"><b>xml</b><span><button type="button" id="paste">{ui.paste}</button><button type="button" id="copyIn">{ui.copyInput}</button><button type="button" id="sel">{ui.selectAll}</button><button type="button" id="fmt">{t.actions.format}</button><button type="button" id="clear">{t.actions.clear}</button><button type="button" id="sample">{ui.sample}</button></span></div><textarea id="input" aria-label={t.placeholders.input} spellcheck="false" placeholder={t.placeholders.input}></textarea></section><section class="pane"><div class="bar"><span><button type="button" class="tab on" data-v="text">text</button><button type="button" class="tab" data-v="tree">tree</button><button type="button" class="tab" data-v="table">table</button></span><span><button type="button" id="val">{t.actions.validate}</button><button type="button" id="min">{t.actions.minify}</button><button type="button" id="exp">{ui.expand}</button><button type="button" id="col">{ui.collapse}</button><button type="button" id="copy">{t.actions.copy}</button><button type="button" id="down">{t.actions.download}</button></span></div><div class="badge"><span id="badge">0 {ui.nodes}</span><button type="button" id="root">⌄</button></div><div id="view" class="view"></div></section></div><details><summary>{ui.summary}</summary><p class="opts"><label>{t.labels.indentation}<select id="ind"><option value="2">{t.options.spaces2}</option><option value="4">{t.options.spaces4}</option><option value="tab">{t.options.tab}</option></select></label><label class="file">{t.loadFile}<input id="file" type="file" accept=".xml,application/xml,text/xml,.svg,image/svg+xml" hidden></label></p><textarea id="output" aria-label={t.placeholders.output} readonly placeholder={t.placeholders.output}></textarea><dl class="stats"><div><dt>{t.stats.nodes}</dt><dd id="sn">0</dd></div><div><dt>Tags</dt><dd id="st">0</dd></div><div><dt>{ui.attrs}</dt><dd id="sa">0</dd></div><div><dt>Tamaño</dt><dd id="ss">0 B</dd></div></dl></details><p id="status" class="status">{t.messages.ready}</p></section></section>
<style>.xml-page{padding:clamp(2rem,6vw,4rem) 0}.xml-tool{padding:1rem;margin-top:2rem}.shell{display:grid;grid-template-columns:1fr 1fr;min-height:660px;border:1px solid var(--border);border-radius:20px;overflow:hidden;background:#111827}.pane{min-width:0;display:flex;flex-direction:column}.pane:first-child{border-right:1px solid #374151}.bar{display:flex;justify-content:space-between;gap:.5rem;flex-wrap:wrap;padding:.45rem .6rem;background:color-mix(in srgb,var(--color-primary) 70%,#64748b);color:#fff}.bar span{display:flex;gap:.35rem;flex-wrap:wrap}.bar button,.badge button{min-height:2rem;border-radius:.45rem;border:1px solid rgba(255,255,255,.24);background:rgba(255,255,255,.12);color:#fff;padding:.25rem .55rem;font-weight:800}.tab{opacity:.7}.tab.on{opacity:1;outline:1px solid rgba(255,255,255,.8)}textarea{width:100%;flex:1;min-height:520px;border:0;background:#111827;color:#e5e7eb;padding:1rem;font-family:var(--font-mono);line-height:1.55;tab-size:2;white-space:pre;overflow:auto}textarea[data-invalid=true]{outline:2px solid rgba(252,165,165,.5);outline-offset:-2px}.badge{display:flex;justify-content:space-between;padding:.35rem .75rem;background:#1f2937;color:#cbd5e1}.badge span{border-radius:999px;padding:.2rem .55rem;background:rgba(255,255,255,.1);font-size:.85rem}.view{--i:2rem;flex:1;max-height:640px;overflow:auto;background:#111827;color:#d1d5db;padding:.75rem 1rem 2rem;font-family:var(--font-mono);font-size:.94rem}details{margin-top:.85rem;border:1px solid var(--border);border-radius:16px;background:var(--color-surface);overflow:hidden}summary{cursor:pointer;padding:.8rem 1rem;font-weight:900}.opts{display:flex;gap:.7rem;flex-wrap:wrap;padding:0 .75rem}.opts label:not(.file){display:grid;gap:.3rem;color:var(--muted);font-weight:800}.file,select{border:1px solid var(--border);border-radius:999px;padding:.55rem .8rem;font-weight:800}.file{background:var(--color-primary);color:#020617}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:.55rem;margin:0;padding:.75rem}.stats div{display:flex;justify-content:space-between;padding:.65rem;border-radius:12px;background:var(--color-surface-soft);border:1px solid var(--border)}.status{color:var(--muted);white-space:pre-wrap}.status.ok{color:#86efac}.status.err{color:#fca5a5}@media(max-width:900px){.shell{grid-template-columns:1fr}.pane:first-child{border-right:0;border-bottom:1px solid #374151}textarea{min-height:330px}.stats{grid-template-columns:1fr 1fr}}@media(max-width:560px){.bar button{flex:1 1 45%}.stats{grid-template-columns:1fr}}</style>
<style is:global>.view pre{margin:0;white-space:pre;font:inherit}.empty{color:#9ca3af}.node{--d:0;position:relative}.node:before{content:'';position:absolute;left:calc((var(--d)*var(--i)) + .62rem);top:0;bottom:0;border-left:1px dotted rgba(255,255,255,.18)}.node[data-d='0']:before{display:none}.row{display:flex;align-items:baseline;gap:.35rem;width:max-content;margin-left:calc(var(--d)*var(--i));min-height:1.75rem;padding:.1rem .35rem;border-radius:.35rem}.row:hover{background:rgba(255,255,255,.06)}.tg{width:1.2rem;min-width:1.2rem;min-height:1.2rem;padding:0;border:0;background:transparent;color:#aaa;box-shadow:none}.tg.hide{visibility:hidden}.tag{color:#93c5fd;font-weight:850}.m{color:#9ca3af}.sum{color:#9ca3af;border-radius:.35rem;padding:.08rem .38rem;background:rgba(255,255,255,.08)}.an{color:#fbbf24}.av,.tx{color:#d69a7c;cursor:text}.av:hover,.tx:hover{background:rgba(255,255,255,.1)}.com{color:#86efac}.tbl{width:100%;border-collapse:collapse;min-width:620px}.tbl th,.tbl td{border-bottom:1px solid rgba(255,255,255,.12);padding:.55rem .7rem;text-align:left;vertical-align:top}.tbl th{position:sticky;top:0;background:#1f2937;color:#dbeafe}</style>
<script define:vars={{copy:ui,base:t}}>addEventListener('DOMContentLoaded',()=>{const $=x=>document.getElementById(x),I=$('input'),O=$('output'),V=$('view'),B=$('badge'),S=$('status'),C=new Set,P=new DOMParser,R=new XMLSerializer,T=[...document.querySelectorAll('.tab')];let D=null,OK=false,L='',M='tree';const smp='<root updated="2026-05-10"><channel id="la1"><title>Telediario</title><event genre="NEWS">Actualidad</event></channel><channel id="la2" /></root>',ms=(m,t='')=>{S.textContent=m;S.classList.toggle('ok',t==='ok');S.classList.toggle('err',t==='err');I.dataset.invalid=O.dataset.invalid=String(t==='err')},ind=()=>$('ind').value==='tab'?'\t':' '.repeat(+$('ind').value),err=d=>d.querySelector('parsererror')?.textContent?.replace(/\s+/g,' ').trim()||'',parse=x=>{const d=P.parseFromString(x,'application/xml'),e=err(d);if(e)throw Error(e);return d},loose=x=>{let y=x.trim().replace(/<[^<>]*$/,'').trim(),s=[],r=/<\/?([A-Za-z_][\w:.-]*)(?:\s[^<>]*)?>/g,m;if(!y)return null;while((m=r.exec(y))){const z=m[0],n=m[1];if(z.startsWith('</')){const i=s.lastIndexOf(n);if(i>-1)s.splice(i)}else if(!/\/\s*>$/.test(z)&&!z.startsWith('<?')&&!z.startsWith('<!'))s.push(n)}return y+s.reverse().map(n=>`</${n}>`).join('')},tryP=()=>{try{return{d:parse(I.value.trim()),r:false}}catch(e){const x=loose(I.value);if(!x)throw e;return{d:parse(x),r:true}}},min=x=>x.replace(/>\s+</g,'><').trim(),pretty=x=>{let d=0;return min(x).replace(/(>)(<)(\/?)/g,'$1\n$2$3').split('\n').map(x=>x.trim()).filter(Boolean).map(l=>{if(/^<\//.test(l))d=Math.max(0,d-1);const o=ind().repeat(d)+l;if(/^<[^!?/][^>]*[^/]?>$/.test(l)&&!/<\/[^>]+>$/.test(l))d++;return o}).join('\n')},ser=(d,m=false)=>m?min(R.serializeToString(d)):pretty(R.serializeToString(d)),kids=n=>[...n.childNodes].filter(c=>c.nodeType!==3||c.textContent.trim()),path=n=>{let a=[];for(let c=n;c&&c.nodeType!==9;c=c.parentNode){let p=c.parentNode;if(!p)break;let ss=[...p.childNodes].filter(x=>x.nodeType===c.nodeType&&x.nodeName===c.nodeName);a.unshift(c.nodeName+(ss.length>1?'['+(ss.indexOf(c)+1)+']':''))}return'$/'+a.join('/')},sp=(x,c)=>{let s=document.createElement('span');s.textContent=x;if(c)s.className=c;return s},tg=(p,h)=>{let b=document.createElement('button');b.className=h?'tg':'tg hide';b.textContent=C.has(p)?'›':'⌄';b.onclick=()=>{C.has(p)?C.delete(p):C.add(p);ren()};return b},commit=()=>{L=ser(D);I.value=O.value=L;stat();ren();ms(copy.edited,'ok')},edit=(n,a='')=>{let v=prompt(copy.edit+':',a?n.getAttribute(a):n.textContent);if(v===null)return;a?n.setAttribute(a,v):n.textContent=v;commit()},nview=(n,d=0)=>{let p=path(n),ch=kids(n),has=n.nodeType===1&&ch.length,w=document.createElement('div'),r=document.createElement('div');w.className='node';w.dataset.d=d;w.style.setProperty('--d',d);r.className='row';r.append(tg(p,has));if(n.nodeType===1){r.append(sp('<','m'),sp(n.nodeName,'tag'));[...n.attributes].forEach(a=>{r.append(sp(' ','m'),sp(a.name,'an'),sp('="','m'));let v=sp(a.value,'av');v.ondblclick=()=>edit(n,a.name);r.append(v,sp('"','m'))});r.append(sp(ch.length?'>':' />','m'));if(ch.length)r.append(sp(ch.length+' '+copy.nodes,'sum'))}else if(n.nodeType===3||n.nodeType===4){let v=sp(n.textContent.trim(),'tx');v.ondblclick=()=>edit(n);r.append(sp(n.nodeType===4?'CDATA: ':'text: ','m'),v)}else if(n.nodeType===8)r.append(sp('<!-- ','m'),sp(n.textContent.trim(),'com'),sp(' -->','m'));w.append(r);if(has&&!C.has(p))ch.forEach(c=>w.append(nview(c,d+1)));return w},tree=()=>{V.replaceChildren();if(!OK||!D?.documentElement)return V.append(sp(base.messages.ready,'empty'));if(C.has('$'))return V.append(sp(D.documentElement.nodeName,'tag'));V.append(nview(D.documentElement))},table=()=>{V.innerHTML='';if(!OK||!D?.documentElement)return V.append(sp(base.messages.ready,'empty'));let rows=[],w=document.createTreeWalker(D.documentElement,NodeFilter.SHOW_ELEMENT);do{let e=w.currentNode;rows.push([path(e),e.nodeName,[...e.attributes].map(a=>a.name+'="'+a.value+'"').join(' '),[...e.childNodes].filter(c=>c.nodeType===3).map(c=>c.textContent.trim()).filter(Boolean).join(' ')])}while(w.nextNode());let tb=document.createElement('table');tb.className='tbl';tb.innerHTML='<thead><tr><th>'+[copy.path,copy.tag,copy.attrs,copy.text].join('</th><th>')+'</th></tr></thead><tbody>'+rows.map(r=>'<tr>'+r.map(v=>'<td></td>').join('')+'</tr>').join('')+'</tbody>';[...tb.querySelectorAll('tbody tr')].forEach((tr,i)=>[...tr.children].forEach((td,j)=>td.textContent=rows[i][j]));V.append(tb)},text=()=>{V.innerHTML='';let p=document.createElement('pre');p.textContent=O.value||L;V.append(p)},ren=()=>{T.forEach(t=>t.classList.toggle('on',t.dataset.v===M));M==='text'?text():M==='table'?table():tree()},stat=()=>{let n=0,e=0,a=0;if(D?.documentElement){let w=document.createTreeWalker(D,NodeFilter.SHOW_ELEMENT|NodeFilter.SHOW_TEXT|NodeFilter.SHOW_COMMENT|NodeFilter.SHOW_CDATA_SECTION);while(w.nextNode()){let x=w.currentNode;if(x.nodeType===3&&!x.textContent.trim())continue;n++;if(x.nodeType===1){e++;a+=x.attributes.length}}}$('sn').textContent=n;$('st').textContent=e;$('sa').textContent=a;$('ss').textContent=new Blob([O.value||I.value||'']).size+' B';B.textContent=n+' '+copy.nodes+' · '+a+' '+copy.attrs},upd=(fmt=false,suc=copy.valid)=>{if(!I.value.trim()){OK=false;D=null;O.value='';ren();stat();return ms(base.messages.ready)}try{let r=tryP();D=r.d;OK=true;L=ser(D);O.value=L;if(fmt||r.r)I.value=L;ren();stat();ms(r.r?copy.repaired:suc,r.r?'err':'ok')}catch(e){OK=false;D=null;O.value=loose(I.value)||I.value;ren();stat();ms(e instanceof Error?e.message:copy.failed,'err')}};T.forEach(t=>t.onclick=()=>{M=t.dataset.v;ren()});$('fmt').onclick=()=>upd(true,base.messages.formatted);$('val').onclick=()=>upd(false,base.messages.valid);$('min').onclick=()=>{try{let r=tryP();D=r.d;OK=true;O.value=ser(D,true);L=ser(D);ren();stat();ms(base.messages.minified,'ok')}catch(e){ms(e.message,'err')}};$('exp').onclick=()=>{C.clear();M='tree';ren();ms(copy.expanded,'ok')};$('col').onclick=()=>{if(!OK)return;C.clear();let f=n=>{if(kids(n).length)C.add(path(n));kids(n).filter(x=>x.nodeType===1).forEach(f)};f(D.documentElement);M='tree';ren();ms(copy.collapsed,'ok')};$('root').onclick=()=>{OK&&(C.has('$')?C.delete('$'):C.add('$'),M='tree',ren())};$('clear').onclick=()=>{I.value=O.value=L='';D=null;OK=false;C.clear();ren();stat();ms(base.messages.cleared)};$('paste').onclick=async()=>{I.value=await navigator.clipboard.readText();upd(false,copy.pasted)};$('copyIn').onclick=async()=>{await navigator.clipboard.writeText(I.value);ms(base.messages.copied,'ok')};$('sel').onclick=()=>{I.focus();I.select();ms(copy.selected,'ok')};$('copy').onclick=async()=>{let v=O.value||L;if(!v.trim())return ms(copy.empty,'err');await navigator.clipboard.writeText(v);ms(base.messages.copied,'ok')};$('down').onclick=()=>{let v=O.value||L||I.value;if(!v.trim())return ms(base.messages.noDownload,'err');let u=URL.createObjectURL(new Blob([v],{type:'application/xml'})),a=document.createElement('a');a.href=u;a.download='data.xml';a.click();URL.revokeObjectURL(u);ms(base.messages.downloaded,'ok')};$('sample').onclick=()=>{I.value=smp;C.clear();upd(true,copy.valid)};$('file').onchange=async e=>{let f=e.target.files?.[0];if(f){I.value=await f.text();C.clear();upd(true,base.messages.loaded?.replace('{name}',f.name)||copy.valid);e.target.value=''}};I.oninput=()=>upd();I.onkeydown=e=>{if(e.key==='Tab'){e.preventDefault();I.setRangeText(ind(),I.selectionStart,I.selectionEnd,'end')}};$('ind').onchange=()=>OK&&commit();ren();stat()})</script>
</Layout>
