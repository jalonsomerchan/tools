---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';
import { getToolTranslations, type ToolTranslationsMap } from '../i18n/tools';

const lang = getLangFromUrl(Astro.url);
const t = getToolTranslations('xml-formatter', lang) as ToolTranslationsMap['xml-formatter']['en'];
---

<Layout title={t.title} description={t.description} lang={lang} path="/xml-formatter/" translated={true}>
  <section class="xml-page">
    <div class="eyebrow">{t.heroEyebrow}</div>
    <h1>{t.title}</h1>
    <p class="hero-text">{t.heroText}</p>

    <section class="tool-card xml-tool" aria-labelledby="xmlToolTitle">
      <div class="tool-header">
        <div>
          <h2 id="xmlToolTitle">{t.workspaceTitle}</h2>
          <p>{t.workspaceText}</p>
        </div>

        <label class="file-button">
          {t.loadFile}
          <input id="fileInput" type="file" accept=".xml,application/xml,text/xml" hidden />
        </label>
      </div>

      <div class="settings-row">
        <label for="indentSelect">
          {t.labels.indentation}
          <select id="indentSelect">
            <option value="2">{t.options.spaces2}</option>
            <option value="4">{t.options.spaces4}</option>
            <option value="tab">{t.options.tab}</option>
          </select>
        </label>
      </div>

      <div class="toolbar" aria-label={t.aria.actions}>
        <button class="primary" id="formatBtn" type="button">{t.actions.format}</button>
        <button id="minifyBtn" type="button">{t.actions.minify}</button>
        <button id="validateBtn" type="button">{t.actions.validate}</button>
        <button id="copyBtn" type="button">{t.actions.copy}</button>
        <button id="downloadBtn" type="button">{t.actions.download}</button>
        <button id="clearBtn" type="button">{t.actions.clear}</button>
      </div>

      <div class="workspace">
        <label class="editor-label" for="inputXml">{t.labels.input}</label>
        <label class="editor-label" for="outputXml">{t.labels.result}</label>
        <textarea id="inputXml" spellcheck="false" placeholder={t.placeholders.input}></textarea>
        <textarea id="outputXml" spellcheck="false" readonly placeholder={t.placeholders.output}></textarea>
      </div>

      <div class="stats-grid" aria-label={t.aria.stats}>
        <output class="stat-card" id="originalSize">{t.stats.original}: 0 B</output>
        <output class="stat-card" id="finalSize">{t.stats.result}: 0 B</output>
        <output class="stat-card" id="nodeCount">{t.stats.nodes}: 0</output>
      </div>

      <p class="status" id="status" role="status" aria-live="polite">{t.messages.ready}</p>
    </section>
  </section>

  <style>
    .xml-page{padding:clamp(2rem,6vw,4rem) 0}.xml-tool{display:grid;gap:var(--space-4)}.tool-header{display:flex;justify-content:space-between;gap:var(--space-4);align-items:flex-start}.tool-header h2{margin:0 0 var(--space-2);font-size:clamp(1.25rem,2vw,1.6rem)}.tool-header p,.status{margin:0;color:var(--color-text-muted,var(--muted));line-height:1.7}.file-button,button,select{border-radius:var(--radius-lg,14px);border:1px solid var(--color-border,var(--border));background:var(--color-surface,#020617);color:var(--color-text,#fff);padding:.85rem 1rem;font:inherit;font-weight:800;cursor:pointer}button.primary,.file-button{background:var(--color-primary,var(--primary));color:#020617;border-color:transparent}.settings-row{display:flex;gap:var(--space-3);flex-wrap:wrap;align-items:flex-end}.settings-row label{display:grid;gap:.45rem;color:var(--color-text-muted,var(--muted));min-width:min(100%,220px)}.toolbar{display:flex;gap:var(--space-2);flex-wrap:wrap}.workspace{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-3);align-items:start}.editor-label{color:var(--color-text-muted,var(--muted));font-weight:800}textarea{width:100%;min-height:440px;border-radius:var(--radius-xl,18px);border:1px solid var(--color-border,var(--border));background:#020617;color:#e5e7eb;padding:1rem;font:500 .95rem/1.65 ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;resize:vertical;tab-size:2;white-space:pre;overflow:auto}textarea[data-invalid='true']{border-color:rgba(252,165,165,.72);box-shadow:0 0 0 2px rgba(252,165,165,.12)}.stats-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-3)}.stat-card{border:1px solid var(--color-border,var(--border));border-radius:var(--radius-lg,14px);background:color-mix(in srgb,var(--color-surface,#020617) 92%,transparent);color:var(--color-text-muted,var(--muted));padding:.85rem 1rem;font-weight:800}.status.success{color:#86efac}.status.error{color:#fca5a5;white-space:pre-wrap}@media(max-width:860px){.tool-header,.workspace{grid-template-columns:1fr}.tool-header{flex-direction:column}.editor-label:nth-of-type(2){grid-row:3}.stats-grid{grid-template-columns:1fr}button,.file-button,select{width:100%}}
  </style>

  <script define:vars={{ copy: t }}>
    const inputXml = document.getElementById('inputXml') as HTMLTextAreaElement;
    const outputXml = document.getElementById('outputXml') as HTMLTextAreaElement;
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const indentSelect = document.getElementById('indentSelect') as HTMLSelectElement;
    const formatBtn = document.getElementById('formatBtn') as HTMLButtonElement;
    const minifyBtn = document.getElementById('minifyBtn') as HTMLButtonElement;
    const validateBtn = document.getElementById('validateBtn') as HTMLButtonElement;
    const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement;
    const downloadBtn = document.getElementById('downloadBtn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clearBtn') as HTMLButtonElement;
    const status = document.getElementById('status') as HTMLParagraphElement;
    const originalSize = document.getElementById('originalSize') as HTMLOutputElement;
    const finalSize = document.getElementById('finalSize') as HTMLOutputElement;
    const nodeCount = document.getElementById('nodeCount') as HTMLOutputElement;

    const parser = new DOMParser();
    const serializer = new XMLSerializer();

    const setStatus = (message: string, type: 'default' | 'success' | 'error' = 'default') => {
      status.textContent = message;
      status.classList.toggle('success', type === 'success');
      status.classList.toggle('error', type === 'error');
      inputXml.dataset.invalid = String(type === 'error');
      outputXml.dataset.invalid = String(type === 'error');
    };

    const byteSize = (value: string) => new Blob([value]).size;
    const formatBytes = (bytes: number) => {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / 1024 / 1024).toFixed(2)} MB`;
    };

    const updateStats = (doc: XMLDocument | null = null) => {
      originalSize.textContent = `${copy.stats.original}: ${formatBytes(byteSize(inputXml.value))}`;
      finalSize.textContent = `${copy.stats.result}: ${formatBytes(byteSize(outputXml.value))}`;

      if (!doc) {
        nodeCount.textContent = `${copy.stats.nodes}: 0`;
        return;
      }

      const walker = document.createTreeWalker(
        doc,
        NodeFilter.SHOW_ELEMENT | NodeFilter.SHOW_TEXT | NodeFilter.SHOW_COMMENT | NodeFilter.SHOW_PROCESSING_INSTRUCTION
      );
      let count = 0;
      while (walker.nextNode()) count += 1;
      nodeCount.textContent = `${copy.stats.nodes}: ${count}`;
    };

    const getIndent = () => indentSelect.value === 'tab' ? '\t' : ' '.repeat(Number(indentSelect.value));

    const getParserError = (doc: XMLDocument) => {
      const parserError = doc.querySelector('parsererror');
      if (!parserError) return '';
      return parserError.textContent?.trim().replace(/\s+/g, ' ') || copy.messages.invalidSyntax;
    };

    const parseXml = () => {
      const value = inputXml.value.trim();
      if (!value) throw new Error(copy.messages.pasteFirst);

      const doc = parser.parseFromString(value, 'application/xml');
      const parserError = getParserError(doc);
      if (parserError) throw new Error(parserError);
      return doc;
    };

    const normalizeSerializedXml = (doc: XMLDocument) => serializer.serializeToString(doc).trim();

    const prettyPrint = (xml: string, indent: string) => {
      const lines = xml.replace(/>\s*</g, '><').replace(/(>)(<)(\/?)/g, '$1\n$2$3').split('\n');
      let depth = 0;

      return lines
        .map((line) => line.trim())
        .filter(Boolean)
        .map((line) => {
          if (/^<\//.test(line)) depth = Math.max(depth - 1, 0);

          const currentLine = `${indent.repeat(depth)}${line}`;
          const isOpening = /^<[^!?/][^>]*[^/]?>$/.test(line);
          const isSelfClosing = /\/\s*>$/.test(line);
          const isDeclaration = /^<\?/.test(line);
          const isComment = /^<!--/.test(line);
          const hasClosingOnSameLine = /<\/[^>]+>$/.test(line);

          if (isOpening && !isSelfClosing && !isDeclaration && !isComment && !hasClosingOnSameLine) {
            depth += 1;
          }

          return currentLine;
        })
        .join('\n');
    };

    const minifyXml = (xml: string) => xml.replace(/>\s+</g, '><').trim();

    const run = async (mode: 'format' | 'minify' | 'validate') => {
      await new Promise((resolve) => window.requestAnimationFrame(resolve));

      try {
        const doc = parseXml();
        const serialized = normalizeSerializedXml(doc);

        if (mode === 'format') {
          outputXml.value = prettyPrint(serialized, getIndent());
          setStatus(copy.messages.formatted, 'success');
        }

        if (mode === 'minify') {
          outputXml.value = minifyXml(serialized);
          setStatus(copy.messages.minified, 'success');
        }

        if (mode === 'validate') {
          outputXml.value = prettyPrint(serialized, getIndent());
          setStatus(copy.messages.valid, 'success');
        }

        updateStats(doc);
      } catch (error) {
        outputXml.value = '';
        setStatus(error instanceof Error ? error.message : copy.messages.invalidSyntax, 'error');
        updateStats(null);
      }
    };

    formatBtn.addEventListener('click', () => run('format'));
    minifyBtn.addEventListener('click', () => run('minify'));
    validateBtn.addEventListener('click', () => run('validate'));

    copyBtn.addEventListener('click', async () => {
      if (!outputXml.value) {
        setStatus(copy.messages.noCopy, 'error');
        return;
      }

      try {
        await navigator.clipboard.writeText(outputXml.value);
        setStatus(copy.messages.copied, 'success');
      } catch {
        outputXml.focus();
        outputXml.select();
        setStatus(copy.messages.copyError, 'error');
      }
    });

    downloadBtn.addEventListener('click', () => {
      const value = outputXml.value || inputXml.value;
      if (!value.trim()) {
        setStatus(copy.messages.noDownload, 'error');
        return;
      }

      const blob = new Blob([value], { type: 'application/xml;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'formatted.xml';
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      setStatus(copy.messages.downloaded, 'success');
    });

    clearBtn.addEventListener('click', () => {
      inputXml.value = '';
      outputXml.value = '';
      setStatus(copy.messages.cleared);
      updateStats(null);
      inputXml.focus();
    });

    fileInput.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      try {
        inputXml.value = await file.text();
        outputXml.value = '';
        setStatus(copy.messages.loaded.replace('{name}', file.name), 'success');
        updateStats(null);
        run('format');
      } catch {
        setStatus(copy.messages.readError, 'error');
      } finally {
        fileInput.value = '';
      }
    });

    inputXml.addEventListener('input', () => updateStats(null));
    outputXml.addEventListener('input', () => updateStats(null));
    indentSelect.addEventListener('change', () => {
      if (inputXml.value.trim()) run('format');
    });

    updateStats(null);
  </script>
</Layout>
