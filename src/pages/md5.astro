---
import Layout from '../layouts/Layout.astro';
import Md5Tool from '../components/tools/Md5Tool.astro';
import { useTranslations } from '../i18n';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout
  title={t('md5.title')}
  description={t('md5.description')}
  lang={lang}
  path="/md5/"
>
  <Md5Tool lang={lang} />
</Layout>
