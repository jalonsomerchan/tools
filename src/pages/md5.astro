---
import Layout from '../layouts/Layout.astro';

const title = 'Generador MD5';
---

<Layout title={title}>
  <section style="padding: 4rem 0;">
    <div class="eyebrow">Alon Tools</div>

    <h1>{title}</h1>

    <p class="hero-text">
      Genera hashes MD5 de texto directamente desde el navegador. Útil para comprobaciones rápidas, pruebas y desarrollo.
    </p>

    <section class="tool-card">
      <div class="toolbar">
        <button class="primary" id="generateBtn">Generar MD5</button>
        <button id="uppercaseBtn">Mayúsculas</button>
        <button id="lowercaseBtn">Minúsculas</button>
        <button id="clearBtn">Limpiar</button>
        <button id="copyBtn">Copiar hash</button>
      </div>

      <div class="workspace">
        <textarea id="input" placeholder="Texto para calcular MD5..."></textarea>

        <textarea id="output" readonly placeholder="Hash MD5..."></textarea>
      </div>

      <p class="status" id="status">Listo para generar.</p>
    </section>
  </section>

  <style>
    .toolbar {
      display: flex;
      gap: 1rem;
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }

    button {
      background: #0f172a;
      color: white;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 1rem;
      cursor: pointer;
    }

    button.primary {
      background: var(--primary);
      color: black;
    }

    .workspace {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    textarea {
      width: 100%;
      min-height: 350px;
      border-radius: 18px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      line-height: 1.6;
    }

    .status {
      color: var(--muted);
      margin-top: 1rem;
    }

    @media (max-width: 860px) {
      .workspace {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('input');
      const output = document.getElementById('output');
      const status = document.getElementById('status');

      const setStatus = (message, error = false) => {
        status.textContent = message;
        status.style.color = error ? '#fca5a5' : '#94a3b8';
      };

      const rotateLeft = (value, amount) => (value << amount) | (value >>> (32 - amount));
      const addUnsigned = (a, b) => (a + b) >>> 0;
      const toHex = (value) => {
        let result = '';
        for (let i = 0; i <= 3; i++) {
          result += ((value >>> (i * 8)) & 255).toString(16).padStart(2, '0');
        }
        return result;
      };

      const md5 = (text) => {
        const bytes = Array.from(new TextEncoder().encode(text));
        const originalBitLength = bytes.length * 8;

        bytes.push(0x80);

        while ((bytes.length % 64) !== 56) {
          bytes.push(0);
        }

        for (let i = 0; i < 8; i++) {
          bytes.push((originalBitLength / Math.pow(256, i)) & 255);
        }

        let a0 = 0x67452301;
        let b0 = 0xefcdab89;
        let c0 = 0x98badcfe;
        let d0 = 0x10325476;

        const shifts = [
          7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
          5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
          4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
          6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
        ];

        const constants = Array.from({ length: 64 }, (_, i) =>
          Math.floor(Math.abs(Math.sin(i + 1)) * Math.pow(2, 32)) >>> 0
        );

        for (let offset = 0; offset < bytes.length; offset += 64) {
          const words = [];

          for (let i = 0; i < 16; i++) {
            const j = offset + i * 4;
            words[i] = bytes[j] | (bytes[j + 1] << 8) | (bytes[j + 2] << 16) | (bytes[j + 3] << 24);
          }

          let a = a0;
          let b = b0;
          let c = c0;
          let d = d0;

          for (let i = 0; i < 64; i++) {
            let f;
            let g;

            if (i < 16) {
              f = (b & c) | ((~b) & d);
              g = i;
            } else if (i < 32) {
              f = (d & b) | ((~d) & c);
              g = (5 * i + 1) % 16;
            } else if (i < 48) {
              f = b ^ c ^ d;
              g = (3 * i + 5) % 16;
            } else {
              f = c ^ (b | (~d));
              g = (7 * i) % 16;
            }

            const temp = d;
            d = c;
            c = b;
            b = addUnsigned(b, rotateLeft(addUnsigned(addUnsigned(a, f), addUnsigned(constants[i], words[g])), shifts[i]));
            a = temp;
          }

          a0 = addUnsigned(a0, a);
          b0 = addUnsigned(b0, b);
          c0 = addUnsigned(c0, c);
          d0 = addUnsigned(d0, d);
        }

        return `${toHex(a0)}${toHex(b0)}${toHex(c0)}${toHex(d0)}`;
      };

      document.getElementById('generateBtn').onclick = () => {
        output.value = md5(input.value);
        setStatus('Hash MD5 generado correctamente.');
      };

      document.getElementById('uppercaseBtn').onclick = () => {
        output.value = output.value.toUpperCase();
        setStatus('Hash convertido a mayúsculas.');
      };

      document.getElementById('lowercaseBtn').onclick = () => {
        output.value = output.value.toLowerCase();
        setStatus('Hash convertido a minúsculas.');
      };

      document.getElementById('clearBtn').onclick = () => {
        input.value = '';
        output.value = '';
        setStatus('Contenido eliminado.');
      };

      document.getElementById('copyBtn').onclick = async () => {
        if (!output.value) {
          setStatus('No hay hash para copiar.', true);
          return;
        }

        try {
          await navigator.clipboard.writeText(output.value);
          setStatus('Hash copiado.');
        } catch {
          setStatus('No se pudo copiar.', true);
        }
      };
    });
  </script>
</Layout>
