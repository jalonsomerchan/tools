---
import Layout from '../layouts/Layout.astro';

const title = 'Generador de iconos para apps';
const description = 'Crea iconos para apps con editor visual sobre canvas, capas de imagen, texto e iconos Lucide y exportación local a PNG o ZIP.';
---

<Layout title={title} description={description} path="/app-icon-generator/" translated={false}>
  <section class="app-icon-page">
    <div class="eyebrow">100% local</div>
    <h1>{title}</h1>
    <p class="hero-text">Diseña iconos para apps editando directamente sobre el canvas: añade imágenes, textos e iconos, transforma cada capa con asas visuales y exporta todos los tamaños desde tu navegador.</p>

    <section class="tool-card app-editor" aria-labelledby="appIconEditorTitle">
      <div class="editor-head">
        <div>
          <h2 id="appIconEditorTitle">Editor visual</h2>
          <p>Selecciona una capa y arrástrala. Usa las esquinas para escalar y el asa superior para rotar.</p>
        </div>
        <output id="exportInfo">4 tamaños seleccionados</output>
      </div>

      <div class="add-toolbar" aria-label="Añadir contenido al icono">
        <label class="add-card add-image" aria-label="Añadir imagen desde tu dispositivo">
          <span class="add-emoji" aria-hidden="true">🖼️</span>
          <span><strong>Añadir imagen</strong><small>Sube una foto o logo</small></span>
          <input id="imageInput" type="file" accept="image/*" hidden />
        </label>
        <button class="add-card" id="addTextBtn" type="button" aria-label="Añadir una capa de texto">
          <span class="add-emoji" aria-hidden="true">T</span>
          <span><strong>Añadir texto</strong><small>Título, iniciales o marca</small></span>
        </button>
        <button class="add-card" id="addIconBtn" type="button" aria-label="Añadir una capa de icono Lucide">
          <span class="add-emoji" aria-hidden="true">✦</span>
          <span><strong>Añadir icono</strong><small>Iconos Lucide locales</small></span>
        </button>
      </div>

      <div class="quick-toolbar" aria-label="Acciones rápidas">
        <button id="duplicateLayerBtn" type="button" aria-label="Duplicar capa seleccionada">Duplicar</button>
        <button id="deleteLayerBtn" type="button" aria-label="Borrar capa seleccionada">Borrar</button>
        <button id="resetBtn" type="button" aria-label="Reiniciar editor">Reset</button>
        <button class="primary" id="downloadBtn" type="button" aria-label="Exportar iconos">Exportar</button>
      </div>

      <div class="editor-grid">
        <main class="canvas-panel" aria-label="Área de edición del icono">
          <div class="canvas-shell"><canvas id="previewCanvas" width="512" height="512" aria-label="Editor visual del icono de app" role="img"></canvas></div>
          <p class="canvas-help">Toca una capa para seleccionarla. Arrastra dentro para mover, en las esquinas para escalar y en el punto superior para rotar.</p>
        </main>

        <aside class="side-panel" aria-label="Panel de capas y propiedades">
          <details class="panel-section" open>
            <summary>Capas</summary>
            <div id="layersList" class="layers-list" aria-label="Lista de capas"></div>
            <div class="layer-actions" aria-label="Acciones de capa">
              <button id="bringForwardBtn" type="button">Traer delante</button>
              <button id="sendBackwardBtn" type="button">Enviar detrás</button>
              <button id="centerLayerBtn" type="button">Centrar</button>
              <button id="fitLayerBtn" type="button">Ajustar al lienzo</button>
            </div>
          </details>

          <details class="panel-section" open>
            <summary>Propiedades de la capa</summary>
            <div id="emptyContext" class="empty-context">Selecciona una capa para editar sus opciones.</div>
            <div id="commonContext" class="context-grid" hidden>
              <label>Nombre<input id="layerName" type="text" maxlength="32" /></label>
              <label>Opacidad<input id="layerOpacity" type="range" min="0" max="1" step="0.05" /></label>
              <label>Sombra<input id="layerShadow" type="range" min="0" max="60" step="1" /></label>
            </div>
            <div id="textContext" class="context-grid" hidden>
              <label>Texto<input id="textContent" type="text" maxlength="48" /></label>
              <label>Color<input id="textColor" type="color" /></label>
              <label>Peso<select id="textWeight"><option value="500">Medio</option><option value="700">Negrita</option><option value="900">Extra bold</option></select></label>
            </div>
            <div id="iconContext" class="context-grid" hidden>
              <label>Icono<select id="iconName"><option value="Rocket">Rocket</option><option value="Star">Star</option><option value="Heart">Heart</option><option value="Camera">Camera</option><option value="Image">Image</option><option value="Music">Music</option><option value="Video">Video</option><option value="MessageCircle">MessageCircle</option><option value="ShoppingBag">ShoppingBag</option><option value="MapPin">MapPin</option><option value="Calendar">Calendar</option><option value="Gamepad2">Gamepad2</option><option value="Trophy">Trophy</option><option value="Zap">Zap</option><option value="Shield">Shield</option><option value="Lock">Lock</option><option value="Cloud">Cloud</option><option value="Globe">Globe</option><option value="Code2">Code2</option><option value="Wrench">Wrench</option><option value="PenTool">PenTool</option><option value="Sparkles">Sparkles</option></select></label>
              <label>Color<input id="iconColor" type="color" /></label>
              <label>Grosor de trazo<input id="iconStroke" type="range" min="1" max="8" step="0.5" /></label>
            </div>
          </details>

          <details class="panel-section">
            <summary>Fondo y forma</summary>
            <div class="context-grid">
              <label>Color de fondo<input id="backgroundColor" type="color" value="#38bdf8" /></label>
              <label>Radio del borde<input id="cornerRadius" type="range" min="0" max="50" value="22" /></label>
              <label>Borde<input id="borderWidth" type="range" min="0" max="80" value="0" /></label>
              <label>Color del borde<input id="borderColor" type="color" value="#020617" /></label>
              <label>Sombra interior suave<input id="innerShadow" type="range" min="0" max="60" value="12" /></label>
            </div>
          </details>

          <details class="panel-section">
            <summary>Exportación</summary>
            <div class="sizes-grid" id="sizesGrid"><label><input type="checkbox" value="64" />64</label><label><input type="checkbox" value="128" />128</label><label><input type="checkbox" value="180" checked />180</label><label><input type="checkbox" value="192" checked />192</label><label><input type="checkbox" value="256" />256</label><label><input type="checkbox" value="512" checked />512</label><label><input type="checkbox" value="1024" checked />1024</label></div>
            <div class="custom-size-row"><label>Tamaño personalizado<input id="customSize" type="number" min="16" max="4096" step="1" placeholder="Ej. 1200" /></label><button id="addCustomSizeBtn" type="button">Añadir</button></div>
          </details>
        </aside>
      </div>
      <p class="status" id="status" role="status" aria-live="polite">Listo para crear iconos.</p>
    </section>
  </section>

  <style>
    .app-icon-page{padding:clamp(2rem,6vw,4rem) 0;overflow-x:hidden}.app-editor{display:grid;gap:1rem}.editor-head{display:flex;justify-content:space-between;align-items:start;gap:1rem}.editor-head h2{margin:0 0 .35rem;font-size:clamp(1.25rem,2vw,1.65rem)}.editor-head p,.canvas-help,.status,.empty-context{color:var(--muted);line-height:1.65;margin:0}#exportInfo{border-radius:999px;border:1px solid var(--border);color:var(--primary);padding:.45rem .75rem;white-space:nowrap}button,input,select,.add-card{border-radius:14px;border:1px solid var(--border);background:#020617;color:white;padding:.78rem .9rem;cursor:pointer;font:inherit;min-width:0}input,select{width:100%;cursor:auto}input[type=range],input[type=checkbox],input[type=color]{cursor:pointer}input[type=color]{min-height:46px;padding:.25rem}button.primary{background:var(--primary);color:#020617;border-color:transparent;font-weight:900}button:disabled{opacity:.45;cursor:not-allowed}.add-toolbar{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}.add-card{display:flex;align-items:center;gap:.75rem;text-align:left;text-decoration:none;background:linear-gradient(135deg,rgba(56,189,248,.22),rgba(15,23,42,.92));border-color:color-mix(in srgb,var(--primary),transparent 45%);min-height:76px}.add-card:hover,.add-card:focus-visible{transform:translateY(-1px);box-shadow:0 16px 40px rgba(0,0,0,.25);outline:2px solid color-mix(in srgb,var(--primary),transparent 45%);outline-offset:2px}.add-card strong{display:block;font-weight:950}.add-card small{display:block;color:var(--muted);font-size:.82rem;margin-top:.15rem}.add-emoji{width:2.5rem;height:2.5rem;display:grid;place-items:center;border-radius:14px;background:rgba(255,255,255,.12);font-weight:950;font-size:1.25rem;flex:0 0 auto}.quick-toolbar{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.55rem;position:sticky;top:.5rem;z-index:5;padding:.55rem;border:1px solid var(--border);border-radius:20px;background:rgba(2,6,23,.86);backdrop-filter:blur(14px)}.quick-toolbar>*{text-align:center;padding-inline:.55rem}.editor-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,380px);gap:1rem;align-items:start}.canvas-panel,.side-panel,.panel-section{border-radius:24px;border:1px solid var(--border);background:rgba(2,6,23,.45)}.canvas-panel{padding:clamp(.75rem,2vw,1.25rem);display:grid;gap:.85rem;min-width:0}.canvas-shell{display:grid;place-items:center;border-radius:22px;border:1px dashed rgba(148,163,184,.32);background:linear-gradient(45deg,rgba(148,163,184,.08) 25%,transparent 25%),linear-gradient(-45deg,rgba(148,163,184,.08) 25%,transparent 25%),linear-gradient(45deg,transparent 75%,rgba(148,163,184,.08) 75%),linear-gradient(-45deg,transparent 75%,rgba(148,163,184,.08) 75%);background-position:0 0,0 12px,12px -12px,-12px 0;background-size:24px 24px;padding:clamp(.5rem,2vw,1rem);overflow:hidden}#previewCanvas{width:min(512px,100%);height:auto;max-height:min(68vh,512px);aspect-ratio:1;border-radius:24px;box-shadow:0 24px 70px rgba(0,0,0,.35);touch-action:none;cursor:default;user-select:none}.side-panel{display:grid;gap:.75rem;padding:.75rem;min-width:0}.panel-section{padding:.85rem}.panel-section summary{cursor:pointer;font-weight:900}.panel-section summary+*{margin-top:.9rem}.layers-list{display:grid;gap:.45rem}.layer-row{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:.65rem;width:100%;text-align:left;border-radius:14px;border:1px solid var(--border);background:rgba(15,23,42,.78);color:white;padding:.65rem}.layer-row.is-active{border-color:var(--primary);box-shadow:0 0 0 2px color-mix(in srgb,var(--primary),transparent 70%)}.layer-row strong{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.layer-row small{color:var(--muted)}.layer-icon{width:2rem;height:2rem;display:grid;place-items:center;border-radius:10px;background:rgba(148,163,184,.14)}.layer-inline-actions{display:grid;grid-template-columns:1fr 1fr;gap:.45rem;margin:.45rem 0 .15rem}.mini-action{padding:.45rem .55rem;border-radius:10px}.layer-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem;margin-top:.75rem}.context-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem}.context-grid label,.custom-size-row label{display:grid;gap:.4rem;color:var(--muted);font-size:.9rem;margin:0}.context-grid label:first-child{grid-column:1/-1}.sizes-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.45rem}.sizes-grid label{display:flex;align-items:center;gap:.45rem;margin:0;padding:.65rem;border:1px solid var(--border);border-radius:12px;background:rgba(15,23,42,.78);color:var(--muted)}.sizes-grid input{width:auto;accent-color:var(--primary)}.custom-size-row{display:grid;grid-template-columns:1fr auto;gap:.55rem;margin-top:.75rem;align-items:end}.status{min-height:1.6rem}.status.success{color:#86efac}.status.error{color:#fca5a5}@media (max-width:980px){.editor-head{flex-direction:column}.editor-grid{grid-template-columns:1fr}.side-panel{grid-row:2}.add-toolbar{grid-template-columns:1fr}.quick-toolbar{grid-template-columns:repeat(4,minmax(0,1fr))}}@media (max-width:640px){.tool-card{padding-inline:.75rem}.quick-toolbar{grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem;top:.25rem}.quick-toolbar>*{font-size:.86rem;padding:.65rem .35rem}.add-card{min-height:66px;padding:.65rem}.add-emoji{width:2.15rem;height:2.15rem}.canvas-panel,.side-panel{border-radius:18px}.canvas-shell{padding:.35rem}#previewCanvas{max-height:58vh;border-radius:18px}.context-grid,.layer-actions,.custom-size-row{grid-template-columns:1fr}.sizes-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  </style>

  <script is:inline src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

  <script>
    import JSZip from 'jszip';
    type BaseLayer={id:number;type:'image'|'text'|'icon';name:string;x:number;y:number;w:number;h:number;scale:number;rotation:number;opacity:number;shadow:number};
    type ImageLayer=BaseLayer&{type:'image';src:string};type TextLayer=BaseLayer&{type:'text';text:string;color:string;weight:string;fontSize:number};type IconLayer=BaseLayer&{type:'icon';iconName:string;color:string;stroke:number};type Layer=ImageLayer|TextLayer|IconLayer;type Point={x:number;y:number};type DragMode='none'|'move'|'scale'|'rotate';type HandleName='nw'|'ne'|'se'|'sw'|'rotate';type IconNode=[string,Record<string,string|number>][];type LucideGlobal={icons?:Record<string,IconNode|{iconNode?:IconNode}>;createElement?:(icon:unknown,attrs?:Record<string,string|number>)=>SVGSVGElement;[key:string]:unknown};
    const BASE=512,HANDLE=18,ROTATE_OFFSET=52,$=<T extends HTMLElement>(id:string)=>document.getElementById(id) as T;
    const canvas=$<HTMLCanvasElement>('previewCanvas'),ctx=canvas.getContext('2d') as CanvasRenderingContext2D,imageInput=$<HTMLInputElement>('imageInput'),addTextBtn=$<HTMLButtonElement>('addTextBtn'),addIconBtn=$<HTMLButtonElement>('addIconBtn'),duplicateLayerBtn=$<HTMLButtonElement>('duplicateLayerBtn'),deleteLayerBtn=$<HTMLButtonElement>('deleteLayerBtn'),resetBtn=$<HTMLButtonElement>('resetBtn'),downloadBtn=$<HTMLButtonElement>('downloadBtn'),bringForwardBtn=$<HTMLButtonElement>('bringForwardBtn'),sendBackwardBtn=$<HTMLButtonElement>('sendBackwardBtn'),centerLayerBtn=$<HTMLButtonElement>('centerLayerBtn'),fitLayerBtn=$<HTMLButtonElement>('fitLayerBtn'),layersList=$<HTMLDivElement>('layersList'),status=$<HTMLParagraphElement>('status'),exportInfo=$<HTMLOutputElement>('exportInfo'),sizesGrid=$<HTMLDivElement>('sizesGrid'),customSize=$<HTMLInputElement>('customSize'),addCustomSizeBtn=$<HTMLButtonElement>('addCustomSizeBtn'),backgroundColor=$<HTMLInputElement>('backgroundColor'),cornerRadius=$<HTMLInputElement>('cornerRadius'),borderWidth=$<HTMLInputElement>('borderWidth'),borderColor=$<HTMLInputElement>('borderColor'),innerShadow=$<HTMLInputElement>('innerShadow'),emptyContext=$<HTMLDivElement>('emptyContext'),commonContext=$<HTMLDivElement>('commonContext'),textContext=$<HTMLDivElement>('textContext'),iconContext=$<HTMLDivElement>('iconContext'),layerName=$<HTMLInputElement>('layerName'),layerOpacity=$<HTMLInputElement>('layerOpacity'),layerShadow=$<HTMLInputElement>('layerShadow'),textContent=$<HTMLInputElement>('textContent'),textColor=$<HTMLInputElement>('textColor'),textWeight=$<HTMLSelectElement>('textWeight'),iconName=$<HTMLSelectElement>('iconName'),iconColor=$<HTMLInputElement>('iconColor'),iconStroke=$<HTMLInputElement>('iconStroke');
    const imageCache=new Map<string,HTMLImageElement>(),iconCache=new Map<string,HTMLImageElement>();let objectUrls:string[]=[],layers:Layer[]=[],selectedId:number|null=null,nextId=1,renderToken=0;let drag:{mode:DragMode;handle?:HandleName;pointerId?:number;start:Point;startLayer?:Layer;startDistance?:number;startAngle?:number}={mode:'none',start:{x:0,y:0}};
    const clamp=(v:number,min:number,max:number)=>Math.min(max,Math.max(min,v)),rad=(d:number)=>d*Math.PI/180,deg=(r:number)=>r*180/Math.PI,selected=()=>layers.find(l=>l.id===selectedId)||null,clone=<T extends Layer>(l:T):T=>({...l} as T),setStatus=(m:string,t:'default'|'success'|'error'='default')=>{status.textContent=m;status.classList.toggle('success',t==='success');status.classList.toggle('error',t==='error')};
    function roundedRect(c:CanvasRenderingContext2D,x:number,y:number,w:number,h:number,r:number){r=Math.min(r,w/2,h/2);c.beginPath();c.moveTo(x+r,y);c.arcTo(x+w,y,x+w,y+h,r);c.arcTo(x+w,y+h,x,y+h,r);c.arcTo(x,y+h,x,y,r);c.arcTo(x,y,x+w,y,r);c.closePath()}
    const escapeAttr=(value:string|number)=>String(value).replaceAll('&','&amp;').replaceAll('"','&quot;').replaceAll('<','&lt;').replaceAll('>','&gt;');
    const toKebab=(name:string)=>name.replace(/([a-z0-9])([A-Z])/g,'$1-$2').toLowerCase();
    const getLucide=()=>((window as Window&{lucide?:LucideGlobal}).lucide);
    function svgFromIconNode(node:IconNode,color:string,stroke:number){const children=node.map(([tag,attrs])=>`<${tag} ${Object.entries(attrs).map(([k,v])=>`${k}="${escapeAttr(v)}"`).join(' ')} />`).join('');return `<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 24 24" fill="none" stroke="${escapeAttr(color)}" stroke-width="${stroke}" stroke-linecap="round" stroke-linejoin="round">${children}</svg>`}
    function iconToSvg(name:string,color:string,stroke:number){const lucide=getLucide();if(!lucide)return '';const kebab=toKebab(name);const icon=(lucide.icons?.[name]||lucide.icons?.[kebab]||lucide[name]||lucide[kebab]) as IconNode|{iconNode?:IconNode}|unknown;if(lucide.createElement&&icon){try{const element=lucide.createElement(icon,{width:512,height:512,color,strokeWidth:stroke,fill:'none'});element.setAttribute('xmlns','http://www.w3.org/2000/svg');element.setAttribute('width','512');element.setAttribute('height','512');element.setAttribute('stroke',color);element.setAttribute('stroke-width',String(stroke));return new XMLSerializer().serializeToString(element)}catch{}}
      const node=Array.isArray(icon)?icon:((icon as {iconNode?:IconNode})?.iconNode);return Array.isArray(node)?svgFromIconNode(node,color,stroke):''}
    const point=(e:PointerEvent):Point=>{const r=canvas.getBoundingClientRect();return{x:(e.clientX-r.left)*(BASE/r.width),y:(e.clientY-r.top)*(BASE/r.height)}};
    const toLocal=(l:Layer,p:Point):Point=>{const c=Math.cos(-rad(l.rotation)),s=Math.sin(-rad(l.rotation)),dx=p.x-l.x,dy=p.y-l.y;return{x:(dx*c-dy*s)/l.scale,y:(dx*s+dy*c)/l.scale}};
    const fromLocal=(l:Layer,p:Point):Point=>{const c=Math.cos(rad(l.rotation)),s=Math.sin(rad(l.rotation)),x=p.x*l.scale,y=p.y*l.scale;return{x:l.x+x*c-y*s,y:l.y+x*s+y*c}};
    const corners=(l:Layer)=>[fromLocal(l,{x:-l.w/2,y:-l.h/2}),fromLocal(l,{x:l.w/2,y:-l.h/2}),fromLocal(l,{x:l.w/2,y:l.h/2}),fromLocal(l,{x:-l.w/2,y:l.h/2})];
    const handles=(l:Layer):Record<HandleName,Point>=>{const [nw,ne,se,sw]=corners(l);return{nw,ne,se,sw,rotate:fromLocal(l,{x:0,y:-l.h/2-ROTATE_OFFSET/Math.max(l.scale,.01)})}};
    const loadImage=(src:string)=>imageCache.get(src)?Promise.resolve(imageCache.get(src) as HTMLImageElement):new Promise<HTMLImageElement>((res,rej)=>{const i=new Image();i.onload=()=>{imageCache.set(src,i);res(i)};i.onerror=()=>rej(new Error('image'));i.src=src});
    const getIcon=(l:IconLayer)=>{const key=`${l.iconName}-${l.color}-${l.stroke}`,cached=iconCache.get(key);if(cached)return Promise.resolve(cached);const svg=iconToSvg(l.iconName,l.color,l.stroke);if(!svg)return Promise.reject(new Error('icon'));const img=new Image(),url=`data:image/svg+xml;charset=utf-8,${encodeURIComponent(svg)}`;return new Promise<HTMLImageElement>((res,rej)=>{img.onload=()=>{iconCache.set(key,img);res(img)};img.onerror=()=>rej(new Error('icon'));img.src=url})};
    async function drawLayer(c:CanvasRenderingContext2D,l:Layer,s:number){c.save();c.translate(l.x*s,l.y*s);c.rotate(rad(l.rotation));c.scale(l.scale*s,l.scale*s);c.globalAlpha=l.opacity;if(l.shadow>0){c.shadowColor='rgba(0,0,0,.42)';c.shadowBlur=l.shadow*s;c.shadowOffsetY=l.shadow*s*.22}if(l.type==='image'){const img=await loadImage(l.src);c.drawImage(img,-l.w/2,-l.h/2,l.w,l.h)}if(l.type==='text'){c.fillStyle=l.color;c.textAlign='center';c.textBaseline='middle';c.font=`${l.weight} ${l.fontSize}px Inter, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif`;c.fillText(l.text,0,0,l.w)}if(l.type==='icon'){try{const img=await getIcon(l);c.drawImage(img,-l.w/2,-l.h/2,l.w,l.h)}catch{drawIconFallback(c,l)}}c.restore()}
    function drawIconFallback(c:CanvasRenderingContext2D,l:IconLayer){c.save();c.strokeStyle=l.color;c.lineWidth=Math.max(2,l.stroke*4);c.lineCap='round';c.lineJoin='round';c.beginPath();c.moveTo(-l.w*.22,-l.h*.22);c.lineTo(l.w*.22,l.h*.22);c.moveTo(l.w*.22,-l.h*.22);c.lineTo(-l.w*.22,l.h*.22);c.stroke();c.restore()}
    function drawSelection(c:CanvasRenderingContext2D,l:Layer){const cs=corners(l),hs=handles(l),top=fromLocal(l,{x:0,y:-l.h/2});c.save();c.lineWidth=2;c.strokeStyle='#67e8f9';c.fillStyle='#020617';c.beginPath();c.moveTo(cs[0].x,cs[0].y);cs.slice(1).forEach(p=>c.lineTo(p.x,p.y));c.closePath();c.stroke();c.beginPath();c.moveTo(top.x,top.y);c.lineTo(hs.rotate.x,hs.rotate.y);c.stroke();(['nw','ne','se','sw'] as HandleName[]).forEach(n=>{const p=hs[n];c.beginPath();c.rect(p.x-HANDLE/2,p.y-HANDLE/2,HANDLE,HANDLE);c.fill();c.stroke()});c.beginPath();c.arc(hs.rotate.x,hs.rotate.y,HANDLE/2,0,Math.PI*2);c.fill();c.stroke();c.restore()}
    async function renderIcon(target:HTMLCanvasElement,size:number,selectBox=false){target.width=size;target.height=size;const c=target.getContext('2d') as CanvasRenderingContext2D,s=size/BASE,r=size*(Number(cornerRadius.value)/100),b=Number(borderWidth.value)*s;c.clearRect(0,0,size,size);c.save();roundedRect(c,0,0,size,size,r);c.clip();c.fillStyle=backgroundColor.value;c.fillRect(0,0,size,size);for(const l of layers)await drawLayer(c,l,s);const sh=Number(innerShadow.value)*s;if(sh>0){const g=c.createRadialGradient(size/2,size/2,size*.18,size/2,size/2,size*.72);g.addColorStop(0,'rgba(255,255,255,0)');g.addColorStop(1,`rgba(0,0,0,${Math.min(.38,sh/140)})`);c.fillStyle=g;c.fillRect(0,0,size,size)}c.restore();if(b>0){c.save();roundedRect(c,b/2,b/2,size-b,size-b,Math.max(0,r-b/2));c.lineWidth=b;c.strokeStyle=borderColor.value;c.stroke();c.restore()}if(selectBox&&selected())drawSelection(c,selected() as Layer)}
    async function render(){const t=++renderToken;try{await renderIcon(canvas,BASE,true);if(t===renderToken)updateUi()}catch{updateUi();setStatus('No se pudo renderizar alguna capa. Prueba con otro icono o imagen.','error')}}
    const hitHandle=(p:Point,l:Layer):HandleName|null=>{const hs=handles(l);for(const n of ['rotate','nw','ne','se','sw'] as HandleName[])if(Math.hypot(p.x-hs[n].x,p.y-hs[n].y)<=HANDLE)return n;return null};
    const hitLayer=(p:Point):Layer|null=>{for(let i=layers.length-1;i>=0;i--){const l=layers[i],q=toLocal(l,p);if(Math.abs(q.x)<=l.w/2&&Math.abs(q.y)<=l.h/2)return l}return null};
    function textW(t:string,fs:number,w:string){ctx.save();ctx.font=`${w} ${fs}px Inter, system-ui, sans-serif`;const width=Math.max(90,ctx.measureText(t||'Texto').width+28);ctx.restore();return Math.min(460,width)}
    function add(l:Layer){layers.push(l);selectedId=l.id;setStatus(`${l.name} añadida y seleccionada.`,'success');render()}function addText(){const id=nextId++,text='APP';add({id,type:'text',name:`Texto ${id}`,x:256,y:300,w:textW(text,96,'900'),h:116,scale:1,rotation:0,opacity:1,shadow:0,text,color:'#020617',weight:'900',fontSize:96})}function addIcon(){if(!getLucide())setStatus('Cargando Lucide desde CDN. Si no aparece, revisa la conexión o el bloqueador de scripts.','error');const id=nextId++;add({id,type:'icon',name:`Icono ${id}`,x:256,y:228,w:180,h:180,scale:1,rotation:0,opacity:1,shadow:0,iconName:'Rocket',color:'#020617',stroke:3})}
    function patch(p:Partial<Layer>){const l=selected();if(!l)return;Object.assign(l,p);if(l.type==='text')l.w=textW(l.text,l.fontSize,l.weight);render()}function selectLayer(id:number){selectedId=id;setStatus(`Capa seleccionada: ${selected()?.name||'capa'}.`);render()}function duplicate(){const l=selected();if(!l)return setStatus('Selecciona una capa para duplicarla.','error');const c=clone(l);c.id=nextId++;c.name=`${l.name} copia`;c.x=clamp(l.x+24,0,BASE);c.y=clamp(l.y+24,0,BASE);layers.push(c);selectedId=c.id;setStatus('Capa duplicada.','success');render()}function remove(){if(selectedId===null)return setStatus('Selecciona una capa para borrarla.','error');const i=layers.findIndex(l=>l.id===selectedId);layers=layers.filter(l=>l.id!==selectedId);selectedId=layers[Math.min(i,layers.length-1)]?.id||null;setStatus('Capa eliminada.','success');render()}function order(where:'front'|'back'){const i=layers.findIndex(l=>l.id===selectedId);if(i<0)return setStatus('Selecciona una capa para reordenarla.','error');const [l]=layers.splice(i,1);layers.splice(where==='front'?layers.length:0,0,l);render()}function fit(){const l=selected();if(!l)return setStatus('Selecciona una capa para ajustarla.','error');if(l.type==='text')l.scale=Math.min(1.8,(BASE*.84)/Math.max(l.w,l.h));else{l.w=BASE*.92;l.h=BASE*.92;l.scale=1}l.x=256;l.y=256;render()}
    function renderList(){const nodes:HTMLElement[]=[];[...layers].reverse().forEach(l=>{const row=document.createElement('button');row.type='button';row.className=`layer-row${l.id===selectedId?' is-active':''}`;row.setAttribute('aria-label',`Seleccionar capa ${l.name}`);row.innerHTML=`<span class="layer-icon" aria-hidden="true">${l.type==='image'?'🖼️':l.type==='text'?'T':'✦'}</span><span><strong></strong><small>${l.type==='image'?'Imagen':l.type==='text'?'Texto':'Icono'}</small></span>`;(row.querySelector('strong') as HTMLElement).textContent=l.name;row.onclick=()=>selectLayer(l.id);nodes.push(row);if(l.id===selectedId){const actions=document.createElement('div');actions.className='layer-inline-actions';const dup=document.createElement('button');dup.type='button';dup.className='mini-action';dup.textContent='Duplicar';dup.onclick=duplicate;const del=document.createElement('button');del.type='button';del.className='mini-action';del.textContent='Borrar';del.onclick=remove;actions.append(dup,del);nodes.push(actions)}});layersList.replaceChildren(...nodes);if(!nodes.length)layersList.textContent='No hay capas todavía.'}
    function syncPanel(){const l=selected(),on=!!l;emptyContext.hidden=on;commonContext.hidden=!on;textContext.hidden=l?.type!=='text';iconContext.hidden=l?.type!=='icon';if(!l)return;layerName.value=l.name;layerOpacity.value=String(l.opacity);layerShadow.value=String(l.shadow);if(l.type==='text'){textContent.value=l.text;textColor.value=l.color;textWeight.value=l.weight}if(l.type==='icon'){iconName.value=l.iconName;iconColor.value=l.color;iconStroke.value=String(l.stroke)}}
    const sizes=()=>Array.from(sizesGrid.querySelectorAll('input[type="checkbox"]')).filter(i=>(i as HTMLInputElement).checked).map(i=>Number((i as HTMLInputElement).value)).filter(s=>Number.isFinite(s)&&s>=16&&s<=4096).sort((a,b)=>a-b);function updateInfo(){const n=sizes().length;exportInfo.textContent=`${n} tamaño${n===1?'':'s'} seleccionado${n===1?'':'s'}`}function updateUi(){renderList();syncPanel();updateInfo();const on=selectedId!==null;[duplicateLayerBtn,deleteLayerBtn,bringForwardBtn,sendBackwardBtn,centerLayerBtn,fitLayerBtn].forEach(b=>b.disabled=!on)}
    const blob=(c:HTMLCanvasElement)=>new Promise<Blob>((res,rej)=>c.toBlob(b=>b?res(b):rej(new Error('blob')),'image/png')),save=(b:Blob,n:string)=>{const u=URL.createObjectURL(b),a=document.createElement('a');a.href=u;a.download=n;document.body.append(a);a.click();a.remove();URL.revokeObjectURL(u)};async function download(){const ss=sizes();if(!ss.length)return setStatus('Selecciona al menos un tamaño para exportar.','error');try{if(ss.length===1){const c=document.createElement('canvas');await renderIcon(c,ss[0],false);save(await blob(c),`app-icon-${ss[0]}.png`);return setStatus('PNG descargado.','success')}const zip=new JSZip();for(const s of ss){const c=document.createElement('canvas');await renderIcon(c,s,false);zip.file(`app-icon-${s}.png`,await blob(c))}zip.file('manifest-icons.json',JSON.stringify({icons:ss.map(s=>({src:`/icons/app-icon-${s}.png`,sizes:`${s}x${s}`,type:'image/png'}))},null,2));save(await zip.generateAsync({type:'blob'}),'app-icons.zip');setStatus('ZIP descargado con manifest-icons.json.','success')}catch{setStatus('No se pudo exportar el icono.','error')}}
    function reset(){objectUrls.forEach(URL.revokeObjectURL);objectUrls=[];imageCache.clear();iconCache.clear();layers=[];selectedId=null;nextId=1;backgroundColor.value='#38bdf8';cornerRadius.value='22';borderWidth.value='0';borderColor.value='#020617';innerShadow.value='12';addText();setStatus('Editor reiniciado.','success')}
    imageInput.onchange=()=>{const f=imageInput.files?.[0];if(!f)return;if(!f.type.startsWith('image/'))return setStatus('El archivo seleccionado no parece una imagen.','error');const src=URL.createObjectURL(f);objectUrls.push(src);const img=new Image();img.onload=()=>{imageCache.set(src,img);const cover=Math.max(BASE/img.width,BASE/img.height),id=nextId++;add({id,type:'image',name:f.name.slice(0,28)||`Imagen ${id}`,src,x:256,y:256,w:img.width*cover,h:img.height*cover,scale:1,rotation:0,opacity:1,shadow:0});imageInput.value=''};img.onerror=()=>setStatus('No se pudo cargar la imagen.','error');img.src=src};
    canvas.onpointerdown=e=>{const p=point(e),cur=selected(),h=cur?hitHandle(p,cur):null;if(h){drag={mode:h==='rotate'?'rotate':'scale',handle:h,pointerId:e.pointerId,start:p,startLayer:clone(cur as Layer),startDistance:Math.hypot(p.x-cur!.x,p.y-cur!.y),startAngle:Math.atan2(p.y-cur!.y,p.x-cur!.x)}}else{const hit=hitLayer(p);if(hit)selectedId=hit.id;drag=hit?{mode:'move',pointerId:e.pointerId,start:p,startLayer:clone(hit)}:{mode:'none',start:p}}canvas.setPointerCapture(e.pointerId);render()};
    canvas.onpointermove=e=>{const l=selected();if(!l||drag.mode==='none'||drag.pointerId!==e.pointerId||!drag.startLayer)return;const p=point(e);if(drag.mode==='move'){l.x=drag.startLayer.x+p.x-drag.start.x;l.y=drag.startLayer.y+p.y-drag.start.y}if(drag.mode==='scale'){const d0=drag.startDistance||1,d=Math.hypot(p.x-drag.startLayer.x,p.y-drag.startLayer.y);l.scale=clamp(drag.startLayer.scale*d/d0,.08,6)}if(drag.mode==='rotate'){const a0=drag.startAngle||0,a=Math.atan2(p.y-drag.startLayer.y,p.x-drag.startLayer.x);l.rotation=drag.startLayer.rotation+deg(a-a0)}render()};const end=(e:PointerEvent)=>{if(drag.pointerId===e.pointerId)drag={mode:'none',start:{x:0,y:0}}};canvas.onpointerup=end;canvas.onpointercancel=end;
    addTextBtn.onclick=addText;addIconBtn.onclick=addIcon;duplicateLayerBtn.onclick=duplicate;deleteLayerBtn.onclick=remove;bringForwardBtn.onclick=()=>order('front');sendBackwardBtn.onclick=()=>order('back');centerLayerBtn.onclick=()=>patch({x:256,y:256} as Partial<Layer>);fitLayerBtn.onclick=fit;resetBtn.onclick=reset;downloadBtn.onclick=download;layerName.oninput=()=>patch({name:layerName.value||'Capa'} as Partial<Layer>);layerOpacity.oninput=()=>patch({opacity:Number(layerOpacity.value)} as Partial<Layer>);layerShadow.oninput=()=>patch({shadow:Number(layerShadow.value)} as Partial<Layer>);textContent.oninput=()=>{const l=selected();if(l?.type==='text'){l.text=textContent.value;l.w=textW(l.text,l.fontSize,l.weight);render()}};textColor.oninput=()=>{const l=selected();if(l?.type==='text'){l.color=textColor.value;render()}};textWeight.onchange=()=>{const l=selected();if(l?.type==='text'){l.weight=textWeight.value;l.w=textW(l.text,l.fontSize,l.weight);render()}};iconName.onchange=()=>{const l=selected();if(l?.type==='icon'){l.iconName=iconName.value;iconCache.clear();render()}};iconColor.oninput=()=>{const l=selected();if(l?.type==='icon'){l.color=iconColor.value;render()}};iconStroke.oninput=()=>{const l=selected();if(l?.type==='icon'){l.stroke=Number(iconStroke.value);render()}};[backgroundColor,cornerRadius,borderWidth,borderColor,innerShadow].forEach(i=>i.addEventListener('input',render));sizesGrid.onchange=updateInfo;addCustomSizeBtn.onclick=()=>{const parsed=Number(customSize.value);if(!Number.isFinite(parsed))return setStatus('Introduce un tamaño válido.','error');const size=Math.round(clamp(parsed,16,4096)),label=document.createElement('label'),box=document.createElement('input');box.type='checkbox';box.value=String(size);box.checked=true;label.append(box,document.createTextNode(String(size)));sizesGrid.append(label);customSize.value='';updateInfo()};addText();
  </script>
</Layout>
