---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const copy = {
  en: {
    title: 'AI text detector',
    description: 'Estimate whether a text may have been generated by AI using a RoBERTa model in the browser.',
    eyebrow: 'Transformers.js · local analysis',
    hero: 'Paste a text and get an estimated probability that it was AI-generated. The model runs in your browser; the text is not uploaded to a server.',
    input: 'Text to analyze',
    placeholder: 'Paste here at least a few paragraphs for a more useful estimate...',
    analyze: 'Analyze text',
    copyReport: 'Copy report',
    downloadReport: 'Download report',
    clear: 'Clear',
    result: 'Result',
    probabilityAi: 'AI probability',
    probabilityHuman: 'Human probability',
    labelAi: 'Likely AI-generated',
    labelHuman: 'Likely human-written',
    labelUncertain: 'Uncertain result',
    confidence: 'Confidence',
    model: 'Model: roberta-base-openai-detector',
    privacyTitle: 'Important limitation',
    privacyText: 'AI detectors are not definitive proof. Use this as a signal only: short texts, edited texts, translations or niche topics can produce false positives or false negatives.',
    localText: 'Your text is processed locally. The browser downloads the RoBERTa model the first time and may cache it.',
    ready: 'Ready.',
    loadingModel: 'Loading RoBERTa model. The first run can take longer because the browser downloads it.',
    analyzing: 'Analyzing text locally...',
    done: 'Analysis complete.',
    tooShort: 'Paste at least 200 characters for a minimally useful estimate.',
    tooLong: 'The text is too long. Use up to 20,000 characters to keep the browser responsive.',
    noReport: 'Analyze a text before copying or downloading the report.',
    copied: 'Report copied.',
    downloaded: 'Report downloaded.',
    copyError: 'Could not copy the report. It has been selected so you can copy it manually.',
    processError: 'Could not analyze the text in this browser. Try again or use a browser with WebAssembly/WebGPU support.',
    cleared: 'Tool cleared.',
    chars: 'Characters',
    words: 'Words',
    sentences: 'Sentences',
    progress: 'Model download progress',
    reportTitle: 'AI text detector report'
  },
  es: {
    title: 'Detector de textos con IA',
    description: 'Estima si un texto puede haber sido generado por IA usando un modelo RoBERTa en el navegador.',
    eyebrow: 'Transformers.js · análisis local',
    hero: 'Pega un texto y obtén una probabilidad estimada de que haya sido generado por IA. El modelo se ejecuta en tu navegador; el texto no se sube a ningún servidor.',
    input: 'Texto a analizar',
    placeholder: 'Pega aquí al menos unos párrafos para que la estimación sea más útil...',
    analyze: 'Analizar texto',
    copyReport: 'Copiar informe',
    downloadReport: 'Descargar informe',
    clear: 'Limpiar',
    result: 'Resultado',
    probabilityAi: 'Probabilidad IA',
    probabilityHuman: 'Probabilidad humano',
    labelAi: 'Probablemente generado con IA',
    labelHuman: 'Probablemente escrito por humano',
    labelUncertain: 'Resultado incierto',
    confidence: 'Confianza',
    model: 'Modelo: roberta-base-openai-detector',
    privacyTitle: 'Limitación importante',
    privacyText: 'Los detectores de IA no son una prueba definitiva. Úsalo solo como señal: textos cortos, editados, traducidos o de temas nicho pueden dar falsos positivos o falsos negativos.',
    localText: 'Tu texto se procesa localmente. El navegador descarga el modelo RoBERTa la primera vez y puede cachearlo.',
    ready: 'Listo.',
    loadingModel: 'Cargando modelo RoBERTa. La primera ejecución puede tardar más porque el navegador lo descarga.',
    analyzing: 'Analizando texto localmente...',
    done: 'Análisis completo.',
    tooShort: 'Pega al menos 200 caracteres para una estimación mínimamente útil.',
    tooLong: 'El texto es demasiado largo. Usa hasta 20.000 caracteres para mantener el navegador fluido.',
    noReport: 'Analiza un texto antes de copiar o descargar el informe.',
    copied: 'Informe copiado.',
    downloaded: 'Informe descargado.',
    copyError: 'No se pudo copiar el informe. Queda seleccionado para que puedas copiarlo manualmente.',
    processError: 'No se pudo analizar el texto en este navegador. Reinténtalo o usa un navegador compatible con WebAssembly/WebGPU.',
    cleared: 'Herramienta limpiada.',
    chars: 'Caracteres',
    words: 'Palabras',
    sentences: 'Frases',
    progress: 'Progreso de descarga del modelo',
    reportTitle: 'Informe del detector de textos con IA'
  }
}[lang];
---

<Layout title={copy.title} description={copy.description} lang={lang} path="/ai-text-detector/" translated={true}>
  <section class="ai-detector-page">
    <div class="eyebrow">{copy.eyebrow}</div>
    <h1>{copy.title}</h1>
    <p class="hero-text">{copy.hero}</p>

    <section class="tool-card detector-tool" aria-labelledby="detectorTitle">
      <div class="tool-header">
        <div>
          <h2 id="detectorTitle">{copy.input}</h2>
          <p>{copy.localText}</p>
        </div>
        <span class="model-badge">{copy.model}</span>
      </div>

      <label class="input-label" for="textInput">{copy.input}</label>
      <textarea id="textInput" spellcheck="true" placeholder={copy.placeholder}></textarea>

      <div class="stats-grid" aria-label="Text statistics">
        <output class="stat-card" id="charCount">{copy.chars}: 0</output>
        <output class="stat-card" id="wordCount">{copy.words}: 0</output>
        <output class="stat-card" id="sentenceCount">{copy.sentences}: 0</output>
      </div>

      <div class="toolbar" aria-label="AI text detector actions">
        <button class="primary" id="analyzeBtn" type="button">{copy.analyze}</button>
        <button id="copyBtn" type="button">{copy.copyReport}</button>
        <button id="downloadBtn" type="button">{copy.downloadReport}</button>
        <button id="clearBtn" type="button">{copy.clear}</button>
      </div>

      <div class="progress-wrap" id="progressWrap" hidden>
        <div class="progress-meta">
          <span>{copy.progress}</span>
          <strong id="progressText">0%</strong>
        </div>
        <progress id="progressBar" max="100" value="0"></progress>
      </div>

      <div class="notice" role="note">
        <strong>{copy.privacyTitle}</strong>
        <span>{copy.privacyText}</span>
      </div>

      <p class="status" id="status" role="status" aria-live="polite">{copy.ready}</p>

      <section class="result-panel" aria-labelledby="resultTitle">
        <div class="result-header">
          <h2 id="resultTitle">{copy.result}</h2>
          <strong id="verdict">—</strong>
        </div>

        <div class="score-card">
          <span id="scoreLabel">{copy.probabilityAi}</span>
          <strong id="aiScore">—</strong>
          <div class="meter" aria-hidden="true"><span id="meterFill"></span></div>
        </div>

        <div class="result-grid">
          <div class="mini-card"><span>{copy.probabilityHuman}</span><strong id="humanScore">—</strong></div>
          <div class="mini-card"><span>{copy.confidence}</span><strong id="confidenceScore">—</strong></div>
        </div>

        <textarea id="reportOutput" readonly aria-label={copy.reportTitle}></textarea>
      </section>
    </section>
  </section>

  <script type="application/json" id="aiDetectorCopy" set:html={JSON.stringify(copy)}></script>

  <style>
    .ai-detector-page{padding:clamp(2rem,6vw,4rem) 0}.detector-tool{display:grid;gap:var(--space-4)}.tool-header{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-4)}.tool-header h2{margin:0 0 var(--space-2);font-size:clamp(1.25rem,2vw,1.6rem)}.tool-header p,.status,.notice{margin:0;color:var(--color-text-muted,var(--muted));line-height:1.7}.model-badge{display:inline-flex;white-space:nowrap;border:1px solid color-mix(in srgb,var(--color-primary,var(--primary)) 35%,var(--color-border,var(--border)));border-radius:var(--radius-full,999px);padding:.55rem .75rem;background:var(--color-primary-soft,rgba(34,211,238,.12));color:var(--color-text);font-weight:900;font-size:.82rem}.input-label{font-weight:900;color:var(--color-text-muted,var(--muted))}textarea{width:100%;min-height:260px;border-radius:var(--radius-xl,18px);border:1px solid var(--color-border,var(--border));background:#020617;color:#e5e7eb;padding:1rem;font:500 1rem/1.7 ui-sans-serif,system-ui,sans-serif;resize:vertical}#reportOutput{min-height:180px;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.9rem}.stats-grid,.result-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-3)}.result-grid{grid-template-columns:repeat(2,minmax(0,1fr));margin-top:var(--space-3)}.stat-card,.mini-card{border:1px solid var(--color-border,var(--border));border-radius:var(--radius-lg,14px);background:color-mix(in srgb,var(--color-surface,#020617) 92%,transparent);color:var(--color-text-muted,var(--muted));padding:.85rem 1rem;font-weight:800}.mini-card{display:grid;gap:.35rem}.mini-card strong{font-size:1.35rem;color:var(--color-text)}.toolbar{display:flex;gap:var(--space-2);flex-wrap:wrap}button{border-radius:var(--radius-lg,14px);border:1px solid var(--color-border,var(--border));background:var(--color-surface,#020617);color:var(--color-text,#fff);padding:.85rem 1rem;font:inherit;font-weight:850;cursor:pointer;transition:transform var(--transition-fast),border-color var(--transition-fast),opacity var(--transition-fast)}button:hover:not(:disabled){transform:translateY(-1px);border-color:var(--color-primary,var(--primary))}button.primary{background:var(--color-primary,var(--primary));color:#020617;border-color:transparent}button:disabled{opacity:.62;cursor:wait}.notice{display:grid;gap:.25rem;padding:1rem;border:1px solid var(--color-border,var(--border));border-radius:var(--radius-xl,18px);background:color-mix(in srgb,var(--color-surface,#020617) 92%,transparent)}.notice strong{color:var(--color-text)}.status.success{color:#86efac}.status.error{color:#fca5a5;white-space:pre-wrap}.progress-wrap{display:grid;gap:.45rem}.progress-meta{display:flex;justify-content:space-between;gap:1rem;color:var(--color-text-muted,var(--muted));font-weight:800}.progress-meta strong{color:var(--color-text)}progress{width:100%;height:.85rem;border:0;border-radius:999px;overflow:hidden;background:var(--color-surface,#020617)}progress::-webkit-progress-bar{background:var(--color-surface,#020617);border-radius:999px}progress::-webkit-progress-value{background:var(--color-primary,var(--primary));border-radius:999px}progress::-moz-progress-bar{background:var(--color-primary,var(--primary));border-radius:999px}.result-panel{border-radius:var(--radius-2xl,24px);border:1px solid var(--color-border,var(--border));background:rgba(2,6,23,.55);padding:var(--space-4);display:grid;gap:var(--space-3)}.result-header{display:flex;align-items:center;justify-content:space-between;gap:var(--space-3);flex-wrap:wrap}.result-header h2{margin:0;font-size:1.2rem}.result-header strong{font-size:1rem;padding:.45rem .7rem;border-radius:999px;background:var(--color-surface,#020617);border:1px solid var(--color-border,var(--border))}.score-card{display:grid;gap:.5rem;padding:clamp(1rem,3vw,1.5rem);border-radius:var(--radius-xl,18px);background:linear-gradient(135deg,color-mix(in srgb,var(--color-primary-soft,rgba(34,211,238,.12)) 70%,transparent),rgba(2,6,23,.72));border:1px solid color-mix(in srgb,var(--color-primary,var(--primary)) 25%,var(--color-border,var(--border)))}.score-card span{color:var(--color-text-muted,var(--muted));font-weight:800}.score-card strong{font-size:clamp(2.5rem,8vw,4.8rem);line-height:1;color:var(--color-text)}.meter{height:.8rem;border-radius:999px;background:#0f172a;overflow:hidden}.meter span{display:block;height:100%;width:0%;background:var(--color-primary,var(--primary));transition:width .25s ease}@media(max-width:820px){.tool-header,.stats-grid,.result-grid{grid-template-columns:1fr;display:grid}.model-badge{white-space:normal}.toolbar button{width:100%}}
  </style>

  <script>
    import { pipeline, env } from '@huggingface/transformers';

    type ClassifierResult = Array<{ label: string; score: number }> | { label: string; score: number };
    type Classifier = (input: string, options?: Record<string, unknown>) => Promise<ClassifierResult>;

    const copy = JSON.parse(document.getElementById('aiDetectorCopy')?.textContent || '{}') as Record<string, string>;
    const MODEL_ID = 'roberta-base-openai-detector';
    const MIN_CHARS = 200;
    const MAX_CHARS = 20000;

    env.allowLocalModels = false;
    env.allowRemoteModels = true;

    const textInput = document.getElementById('textInput') as HTMLTextAreaElement;
    const analyzeBtn = document.getElementById('analyzeBtn') as HTMLButtonElement;
    const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement;
    const downloadBtn = document.getElementById('downloadBtn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clearBtn') as HTMLButtonElement;
    const status = document.getElementById('status') as HTMLParagraphElement;
    const progressWrap = document.getElementById('progressWrap') as HTMLDivElement;
    const progressBar = document.getElementById('progressBar') as HTMLProgressElement;
    const progressText = document.getElementById('progressText') as HTMLElement;
    const charCount = document.getElementById('charCount') as HTMLOutputElement;
    const wordCount = document.getElementById('wordCount') as HTMLOutputElement;
    const sentenceCount = document.getElementById('sentenceCount') as HTMLOutputElement;
    const verdict = document.getElementById('verdict') as HTMLElement;
    const aiScore = document.getElementById('aiScore') as HTMLElement;
    const humanScore = document.getElementById('humanScore') as HTMLElement;
    const confidenceScore = document.getElementById('confidenceScore') as HTMLElement;
    const meterFill = document.getElementById('meterFill') as HTMLElement;
    const reportOutput = document.getElementById('reportOutput') as HTMLTextAreaElement;

    let classifierPromise: Promise<Classifier> | null = null;
    let latestReport = '';

    const setStatus = (message: string, type: 'default' | 'success' | 'error' = 'default') => {
      status.textContent = message;
      status.classList.toggle('success', type === 'success');
      status.classList.toggle('error', type === 'error');
    };

    const setBusy = (busy: boolean) => {
      analyzeBtn.disabled = busy;
      textInput.disabled = busy;
      analyzeBtn.textContent = busy ? copy.analyzing : copy.analyze;
    };

    const setProgress = (progress: number) => {
      const value = Math.max(0, Math.min(100, Math.round(progress)));
      progressWrap.hidden = value <= 0 || value >= 100;
      progressBar.value = value;
      progressText.textContent = `${value}%`;
    };

    const getClassifier = async () => {
      if (!classifierPromise) {
        setStatus(copy.loadingModel);
        classifierPromise = pipeline('text-classification', MODEL_ID, {
          progress_callback: (event: { progress?: number }) => {
            if (typeof event.progress === 'number') setProgress(event.progress);
          }
        }) as Promise<Classifier>;
      }
      return classifierPromise;
    };

    const countWords = (value: string) => (value.trim().match(/\S+/g) || []).length;
    const countSentences = (value: string) => (value.trim().match(/[^.!?。！？]+[.!?。！？]+/g) || []).length;
    const pct = (value: number) => `${Math.round(value * 100)}%`;

    const updateStats = () => {
      const value = textInput.value;
      charCount.textContent = `${copy.chars}: ${value.length}`;
      wordCount.textContent = `${copy.words}: ${countWords(value)}`;
      sentenceCount.textContent = `${copy.sentences}: ${countSentences(value)}`;
    };

    const normalizeResults = (raw: ClassifierResult) => Array.isArray(raw) ? raw : [raw];

    const extractScores = (raw: ClassifierResult) => {
      const results = normalizeResults(raw);
      let ai = 0;
      let human = 0;
      for (const item of results) {
        const label = item.label.toLowerCase();
        if (label.includes('fake') || label.includes('ai') || label.includes('generated')) ai = Math.max(ai, item.score);
        if (label.includes('real') || label.includes('human')) human = Math.max(human, item.score);
      }
      if (!ai && !human && results.length >= 2) {
        human = results[0].score;
        ai = results[1].score;
      } else if (!ai && !human && results.length === 1) {
        ai = results[0].score;
        human = 1 - ai;
      }
      const total = ai + human;
      if (total > 0) {
        ai /= total;
        human /= total;
      }
      return { ai, human };
    };

    const buildReport = (ai: number, human: number, label: string) => [
      copy.reportTitle,
      '-----------------------',
      `${copy.result}: ${label}`,
      `${copy.probabilityAi}: ${pct(ai)}`,
      `${copy.probabilityHuman}: ${pct(human)}`,
      `${copy.confidence}: ${pct(Math.max(ai, human))}`,
      `${copy.model}`,
      '',
      copy.privacyText
    ].join('\n');

    const renderResult = (ai: number, human: number) => {
      let label = copy.labelUncertain;
      if (ai >= 0.65) label = copy.labelAi;
      else if (human >= 0.65) label = copy.labelHuman;

      verdict.textContent = label;
      aiScore.textContent = pct(ai);
      humanScore.textContent = pct(human);
      confidenceScore.textContent = pct(Math.max(ai, human));
      meterFill.style.width = pct(ai);
      latestReport = buildReport(ai, human, label);
      reportOutput.value = latestReport;
    };

    const analyze = async () => {
      const text = textInput.value.trim();
      if (text.length < MIN_CHARS) {
        setStatus(copy.tooShort, 'error');
        return;
      }
      if (text.length > MAX_CHARS) {
        setStatus(copy.tooLong, 'error');
        return;
      }

      try {
        setBusy(true);
        setProgress(1);
        const classifier = await getClassifier();
        setProgress(100);
        setStatus(copy.analyzing);
        const raw = await classifier(text, { topk: 2 });
        const scores = extractScores(raw);
        renderResult(scores.ai, scores.human);
        setStatus(copy.done, 'success');
      } catch (error) {
        console.error(error);
        setStatus(copy.processError, 'error');
      } finally {
        setBusy(false);
        setProgress(100);
      }
    };

    textInput.addEventListener('input', updateStats);
    analyzeBtn.addEventListener('click', analyze);

    copyBtn.addEventListener('click', async () => {
      if (!latestReport) {
        setStatus(copy.noReport, 'error');
        return;
      }
      try {
        await navigator.clipboard.writeText(latestReport);
        setStatus(copy.copied, 'success');
      } catch {
        reportOutput.focus();
        reportOutput.select();
        setStatus(copy.copyError, 'error');
      }
    });

    downloadBtn.addEventListener('click', () => {
      if (!latestReport) {
        setStatus(copy.noReport, 'error');
        return;
      }
      const blob = new Blob([latestReport], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'ai-text-detector-report.txt';
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      setStatus(copy.downloaded, 'success');
    });

    clearBtn.addEventListener('click', () => {
      textInput.value = '';
      latestReport = '';
      verdict.textContent = '—';
      aiScore.textContent = '—';
      humanScore.textContent = '—';
      confidenceScore.textContent = '—';
      meterFill.style.width = '0%';
      reportOutput.value = '';
      updateStats();
      setStatus(copy.cleared);
      textInput.focus();
    });

    updateStats();
  </script>
</Layout>
