---
import Layout from '../layouts/Layout.astro';

const title = 'Mejorador de capturas de pantalla';
const description = 'Crea imágenes profesionales a partir de capturas con fondos personalizables, marco, sombras y exportación a PNG, JPG, WebP y SVG.';
---

<Layout title={`${title} — Alon Tools`} description={description} path="/screenshot-enhancer/">
  <section class="hero tool-hero">
    <div class="eyebrow">100% local</div>
    <h1>{title}</h1>
    <p class="hero-text">
      Sube una captura con drag and drop, colócala en una composición vistosa, personaliza colores y descarga el resultado en varios formatos.
    </p>
  </section>

  <section class="editor-shell" aria-label="Editor de capturas">
    <aside class="control-panel" aria-label="Opciones de diseño">
      <div class="drop-zone" id="dropZone">
        <input id="fileInput" type="file" accept="image/*" hidden />
        <div class="drop-icon" aria-hidden="true">IMG</div>
        <div>
          <strong>Arrastra una captura aquí</strong>
          <span>o pulsa para seleccionar una imagen</span>
        </div>
      </div>

      <div class="panel-section">
        <h2>Fondo</h2>
        <div class="preset-grid" id="presetGrid" aria-label="Fondos generados">
          <button type="button" class="preset active" data-preset="soft" aria-label="Fondo suave"><span></span></button>
          <button type="button" class="preset" data-preset="aurora" aria-label="Fondo aurora"><span></span></button>
          <button type="button" class="preset" data-preset="mesh" aria-label="Fondo mesh"><span></span></button>
          <button type="button" class="preset" data-preset="stripes" aria-label="Fondo con líneas"><span></span></button>
          <button type="button" class="preset" data-preset="grid" aria-label="Fondo de rejilla"><span></span></button>
          <button type="button" class="preset" data-preset="solid" aria-label="Fondo sólido"><span></span></button>
        </div>

        <div class="field-grid two">
          <label>Color 1 <input id="colorA" type="color" value="#dbeafe" /></label>
          <label>Color 2 <input id="colorB" type="color" value="#ccfbf1" /></label>
          <label>Color 3 <input id="colorC" type="color" value="#ffffff" /></label>
          <label>Tarjeta <input id="cardColor" type="color" value="#ffffff" /></label>
        </div>
      </div>

      <div class="panel-section">
        <h2>Composición</h2>
        <div class="field-grid">
          <label>Tamaño
            <select id="sizePreset">
              <option value="1200x800">1200 × 800</option>
              <option value="1600x900">1600 × 900</option>
              <option value="1080x1080">1080 × 1080</option>
              <option value="1200x1200">1200 × 1200</option>
              <option value="1920x1080">1920 × 1080</option>
              <option value="custom">Personalizado</option>
            </select>
          </label>
          <div class="field-grid two custom-size" id="customSize" hidden>
            <label>Ancho <input id="canvasWidth" type="number" min="400" max="4000" value="1200" /></label>
            <label>Alto <input id="canvasHeight" type="number" min="300" max="4000" value="800" /></label>
          </div>
          <label>Margen exterior <input id="padding" type="range" min="40" max="220" value="82" /></label>
          <label>Radio fondo <input id="cardRadius" type="range" min="0" max="80" value="48" /></label>
          <label>Zoom captura <input id="imageScale" type="range" min="55" max="115" value="86" /></label>
          <label>Radio captura <input id="imageRadius" type="range" min="0" max="42" value="18" /></label>
          <label class="check-row"><input id="browserFrame" type="checkbox" checked /> Añadir barra superior tipo navegador</label>
          <label class="check-row"><input id="shadow" type="checkbox" checked /> Sombra suave</label>
        </div>
      </div>

      <div class="panel-section">
        <h2>Exportar</h2>
        <div class="download-grid">
          <button class="btn btn-primary" type="button" data-download="png">PNG</button>
          <button class="btn btn-secondary" type="button" data-download="jpeg">JPG</button>
          <button class="btn btn-secondary" type="button" data-download="webp">WebP</button>
          <button class="btn btn-secondary" type="button" data-download="svg">SVG</button>
        </div>
        <p class="help-text" id="status">Sube una imagen para empezar.</p>
      </div>
    </aside>

    <div class="preview-panel">
      <div class="canvas-wrap">
        <canvas id="previewCanvas" width="1200" height="800" aria-label="Vista previa de la captura mejorada"></canvas>
      </div>
    </div>
  </section>

  <script>
    const state = {
      image: null,
      imageName: 'captura',
      preset: 'soft',
      width: 1200,
      height: 800
    };

    const els = {
      canvas: document.getElementById('previewCanvas'),
      dropZone: document.getElementById('dropZone'),
      fileInput: document.getElementById('fileInput'),
      presetGrid: document.getElementById('presetGrid'),
      colorA: document.getElementById('colorA'),
      colorB: document.getElementById('colorB'),
      colorC: document.getElementById('colorC'),
      cardColor: document.getElementById('cardColor'),
      sizePreset: document.getElementById('sizePreset'),
      customSize: document.getElementById('customSize'),
      canvasWidth: document.getElementById('canvasWidth'),
      canvasHeight: document.getElementById('canvasHeight'),
      padding: document.getElementById('padding'),
      cardRadius: document.getElementById('cardRadius'),
      imageScale: document.getElementById('imageScale'),
      imageRadius: document.getElementById('imageRadius'),
      browserFrame: document.getElementById('browserFrame'),
      shadow: document.getElementById('shadow'),
      status: document.getElementById('status')
    };

    const ctx = els.canvas.getContext('2d');

    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));
    const escapeXml = (value) => String(value).replace(/[&<>'"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\'': '&apos;', '"': '&quot;' }[char]));

    function roundRectPath(context, x, y, width, height, radius) {
      const r = clamp(radius, 0, Math.min(width, height) / 2);
      context.beginPath();
      context.moveTo(x + r, y);
      context.lineTo(x + width - r, y);
      context.quadraticCurveTo(x + width, y, x + width, y + r);
      context.lineTo(x + width, y + height - r);
      context.quadraticCurveTo(x + width, y + height, x + width - r, y + height);
      context.lineTo(x + r, y + height);
      context.quadraticCurveTo(x, y + height, x, y + height - r);
      context.lineTo(x, y + r);
      context.quadraticCurveTo(x, y, x + r, y);
      context.closePath();
    }

    function setCanvasSize() {
      const dpr = window.devicePixelRatio || 1;
      els.canvas.width = state.width * dpr;
      els.canvas.height = state.height * dpr;
      els.canvas.style.aspectRatio = `${state.width} / ${state.height}`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function drawBackground(context, width, height) {
      const a = els.colorA.value;
      const b = els.colorB.value;
      const c = els.colorC.value;
      context.fillStyle = c;
      context.fillRect(0, 0, width, height);

      if (state.preset === 'solid') {
        context.fillStyle = a;
        context.fillRect(0, 0, width, height);
        return;
      }

      const linear = context.createLinearGradient(0, 0, width, height);
      linear.addColorStop(0, c);
      linear.addColorStop(0.55, '#f8fbff');
      linear.addColorStop(1, b);
      context.fillStyle = linear;
      context.fillRect(0, 0, width, height);

      if (state.preset === 'soft' || state.preset === 'aurora' || state.preset === 'mesh') {
        const circles = state.preset === 'soft'
          ? [[a, -width * 0.04, -height * 0.1, width * 0.34], [b, width * 0.9, -height * 0.08, width * 0.36]]
          : [[a, width * 0.08, height * 0.04, width * 0.42], [b, width * 0.72, height * 0.08, width * 0.44], ['#fde68a', width * 0.42, height * 0.78, width * 0.34]];
        circles.forEach(([color, x, y, r]) => {
          context.save();
          context.globalAlpha = state.preset === 'mesh' ? 0.64 : 0.72;
          context.fillStyle = color;
          context.beginPath();
          context.arc(x, y, r, 0, Math.PI * 2);
          context.fill();
          context.restore();
        });
      }

      if (state.preset === 'stripes') {
        context.save();
        context.globalAlpha = 0.18;
        context.strokeStyle = a;
        context.lineWidth = 7;
        for (let x = -height; x < width + height; x += 46) {
          context.beginPath();
          context.moveTo(x, height);
          context.lineTo(x + height, 0);
          context.stroke();
        }
        context.restore();
      }

      if (state.preset === 'grid') {
        context.save();
        context.globalAlpha = 0.22;
        context.strokeStyle = a;
        context.lineWidth = 1;
        for (let x = 0; x <= width; x += 48) { context.beginPath(); context.moveTo(x, 0); context.lineTo(x, height); context.stroke(); }
        for (let y = 0; y <= height; y += 48) { context.beginPath(); context.moveTo(0, y); context.lineTo(width, y); context.stroke(); }
        context.restore();
      }
    }

    function drawPlaceholder(context, box) {
      context.save();
      roundRectPath(context, box.x, box.y, box.w, box.h, Number(els.imageRadius.value));
      context.fillStyle = 'rgba(15,23,42,.05)';
      context.fill();
      context.strokeStyle = 'rgba(15,23,42,.12)';
      context.setLineDash([16, 14]);
      context.lineWidth = 3;
      context.stroke();
      context.fillStyle = '#334155';
      context.font = '800 32px system-ui, sans-serif';
      context.textAlign = 'center';
      context.fillText('Arrastra una captura', box.x + box.w / 2, box.y + box.h / 2 - 8);
      context.font = '500 20px system-ui, sans-serif';
      context.fillStyle = '#64748b';
      context.fillText('La imagen se colocará en el centro', box.x + box.w / 2, box.y + box.h / 2 + 28);
      context.restore();
    }

    function getLayout() {
      const padding = Number(els.padding.value);
      const frameH = els.browserFrame.checked ? Math.max(46, Math.round(state.height * 0.09)) : 0;
      const card = {
        x: padding,
        y: padding,
        w: state.width - padding * 2,
        h: state.height - padding * 2,
        r: Number(els.cardRadius.value),
        frameH
      };
      const innerPad = Math.max(28, Math.round(Math.min(card.w, card.h) * 0.05));
      const imageBox = {
        x: card.x + innerPad,
        y: card.y + innerPad + frameH,
        w: card.w - innerPad * 2,
        h: card.h - innerPad * 2 - frameH
      };
      return { card, imageBox };
    }

    function drawCard(context, card) {
      context.save();
      if (els.shadow.checked) {
        context.shadowColor = 'rgba(15, 23, 42, .18)';
        context.shadowBlur = 42;
        context.shadowOffsetY = 22;
      }
      roundRectPath(context, card.x, card.y, card.w, card.h, card.r);
      context.fillStyle = els.cardColor.value;
      context.fill();
      context.restore();

      if (!els.browserFrame.checked) return;
      context.save();
      roundRectPath(context, card.x + 48, card.y + 48, card.w - 96, Math.max(62, card.frameH * .82), 26);
      context.fillStyle = '#0f172a';
      context.fill();
      context.fillStyle = '#2563eb';
      roundRectPath(context, card.x + 82, card.y + 68, 48, 30, 10);
      context.fill();
      context.fillStyle = '#f8fafc';
      roundRectPath(context, card.x + 154, card.y + 74, Math.min(178, card.w * .22), 18, 99);
      context.fill();
      context.globalAlpha = 0.12;
      context.fillStyle = '#f8fafc';
      roundRectPath(context, card.x + card.w - 280, card.y + 70, 104, 24, 99);
      context.fill();
      roundRectPath(context, card.x + card.w - 154, card.y + 70, 112, 24, 99);
      context.fill();
      context.restore();
    }

    function drawImage(context, box) {
      if (!state.image) {
        drawPlaceholder(context, box);
        return;
      }
      const scale = Number(els.imageScale.value) / 100;
      const fit = Math.min(box.w / state.image.width, box.h / state.image.height) * scale;
      const w = state.image.width * fit;
      const h = state.image.height * fit;
      const x = box.x + (box.w - w) / 2;
      const y = box.y + (box.h - h) / 2;
      context.save();
      if (els.shadow.checked) {
        context.shadowColor = 'rgba(15, 23, 42, .16)';
        context.shadowBlur = 28;
        context.shadowOffsetY = 16;
      }
      roundRectPath(context, x, y, w, h, Number(els.imageRadius.value));
      context.clip();
      context.drawImage(state.image, x, y, w, h);
      context.restore();
    }

    function render() {
      setCanvasSize();
      drawBackground(ctx, state.width, state.height);
      const { card, imageBox } = getLayout();
      drawCard(ctx, card);
      drawImage(ctx, imageBox);
    }

    function loadFile(file) {
      if (!file || !file.type.startsWith('image/')) {
        els.status.textContent = 'Selecciona un archivo de imagen válido.';
        return;
      }
      const reader = new FileReader();
      reader.onload = () => {
        const image = new Image();
        image.onload = () => {
          state.image = image;
          state.imageName = file.name.replace(/\.[^/.]+$/, '') || 'captura';
          els.status.textContent = `${file.name} cargada. Puedes exportarla en PNG, JPG, WebP o SVG.`;
          render();
        };
        image.src = reader.result;
      };
      reader.readAsDataURL(file);
    }

    function downloadBlob(blob, filename) {
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = filename;
      link.click();
      URL.revokeObjectURL(url);
    }

    function getSvgMarkup() {
      const imageData = state.image?.src || '';
      const { card, imageBox } = getLayout();
      const scale = state.image ? Math.min(imageBox.w / state.image.width, imageBox.h / state.image.height) * (Number(els.imageScale.value) / 100) : 1;
      const imgW = state.image ? state.image.width * scale : imageBox.w;
      const imgH = state.image ? state.image.height * scale : imageBox.h;
      const imgX = imageBox.x + (imageBox.w - imgW) / 2;
      const imgY = imageBox.y + (imageBox.h - imgH) / 2;
      const bg = `<rect width="100%" height="100%" fill="${escapeXml(els.colorC.value)}"/><circle cx="${state.width * .02}" cy="${state.height * -.04}" r="${state.width * .36}" fill="${escapeXml(els.colorA.value)}" opacity=".72"/><circle cx="${state.width * .92}" cy="${state.height * -.02}" r="${state.width * .38}" fill="${escapeXml(els.colorB.value)}" opacity=".72"/>`;
      const frame = els.browserFrame.checked ? `<rect x="${card.x + 48}" y="${card.y + 48}" width="${card.w - 96}" height="${Math.max(62, card.frameH * .82)}" rx="26" fill="#0f172a"/><rect x="${card.x + 82}" y="${card.y + 68}" width="48" height="30" rx="10" fill="#2563eb"/><rect x="${card.x + 154}" y="${card.y + 74}" width="${Math.min(178, card.w * .22)}" height="18" rx="9" fill="#f8fafc" opacity=".95"/>` : '';
      const image = state.image ? `<clipPath id="clipImage"><rect x="${imgX}" y="${imgY}" width="${imgW}" height="${imgH}" rx="${els.imageRadius.value}"/></clipPath><image href="${escapeXml(imageData)}" x="${imgX}" y="${imgY}" width="${imgW}" height="${imgH}" preserveAspectRatio="none" clip-path="url(#clipImage)"/>` : `<rect x="${imageBox.x}" y="${imageBox.y}" width="${imageBox.w}" height="${imageBox.h}" rx="${els.imageRadius.value}" fill="rgba(15,23,42,.05)" stroke="rgba(15,23,42,.12)" stroke-dasharray="16 14"/>`;
      const filter = els.shadow.checked ? '<filter id="softShadow" x="-20%" y="-20%" width="140%" height="150%"><feDropShadow dx="0" dy="22" stdDeviation="18" flood-color="#0f172a" flood-opacity=".18"/></filter>' : '';
      return `<svg xmlns="http://www.w3.org/2000/svg" width="${state.width}" height="${state.height}" viewBox="0 0 ${state.width} ${state.height}"><defs>${filter}</defs>${bg}<rect x="${card.x}" y="${card.y}" width="${card.w}" height="${card.h}" rx="${card.r}" fill="${escapeXml(els.cardColor.value)}" filter="${els.shadow.checked ? 'url(#softShadow)' : ''}"/>${frame}${image}</svg>`;
    }

    function download(format) {
      const filename = `${state.imageName}-mejorada-${state.width}x${state.height}.${format === 'jpeg' ? 'jpg' : format}`;
      if (format === 'svg') {
        downloadBlob(new Blob([getSvgMarkup()], { type: 'image/svg+xml' }), filename);
        return;
      }
      const mime = format === 'jpeg' ? 'image/jpeg' : `image/${format}`;
      els.canvas.toBlob((blob) => blob && downloadBlob(blob, filename), mime, 0.94);
    }

    els.dropZone.addEventListener('click', () => els.fileInput.click());
    els.fileInput.addEventListener('change', () => loadFile(els.fileInput.files?.[0]));
    ['dragenter', 'dragover'].forEach((eventName) => els.dropZone.addEventListener(eventName, (event) => {
      event.preventDefault();
      els.dropZone.classList.add('is-dragging');
    }));
    ['dragleave', 'drop'].forEach((eventName) => els.dropZone.addEventListener(eventName, (event) => {
      event.preventDefault();
      els.dropZone.classList.remove('is-dragging');
    }));
    els.dropZone.addEventListener('drop', (event) => loadFile(event.dataTransfer?.files?.[0]));

    els.presetGrid.addEventListener('click', (event) => {
      const button = event.target.closest('[data-preset]');
      if (!button) return;
      state.preset = button.dataset.preset;
      document.querySelectorAll('[data-preset]').forEach((item) => item.classList.toggle('active', item === button));
      render();
    });

    els.sizePreset.addEventListener('change', () => {
      els.customSize.hidden = els.sizePreset.value !== 'custom';
      if (els.sizePreset.value !== 'custom') {
        const [width, height] = els.sizePreset.value.split('x').map(Number);
        state.width = width;
        state.height = height;
        els.canvasWidth.value = width;
        els.canvasHeight.value = height;
        render();
      }
    });

    [els.canvasWidth, els.canvasHeight].forEach((input) => input.addEventListener('input', () => {
      state.width = clamp(Number(els.canvasWidth.value) || 1200, 400, 4000);
      state.height = clamp(Number(els.canvasHeight.value) || 800, 300, 4000);
      render();
    }));

    document.querySelectorAll('input, select').forEach((input) => {
      if (input.id === 'fileInput' || input.id === 'sizePreset' || input.id === 'canvasWidth' || input.id === 'canvasHeight') return;
      input.addEventListener('input', render);
      input.addEventListener('change', render);
    });

    document.querySelectorAll('[data-download]').forEach((button) => {
      button.addEventListener('click', () => download(button.dataset.download));
    });

    render();
  </script>
</Layout>

<style>
  .tool-hero { padding-bottom: var(--space-8); }
  .editor-shell { display: grid; grid-template-columns: minmax(280px, 370px) minmax(0, 1fr); gap: var(--space-6); align-items: start; }
  .control-panel, .preview-panel { border: 1px solid var(--color-border); border-radius: var(--radius-2xl); background: color-mix(in srgb, var(--color-surface) 94%, transparent); box-shadow: var(--shadow-sm); }
  .control-panel { display: grid; gap: var(--space-5); padding: var(--space-5); position: sticky; top: 5.5rem; }
  .drop-zone { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); align-items: center; min-height: 7rem; padding: var(--space-4); border: 2px dashed var(--color-border-strong); border-radius: var(--radius-xl); background: var(--color-surface-soft); cursor: pointer; transition: border-color var(--transition-base), background var(--transition-base), transform var(--transition-base); }
  .drop-zone:hover, .drop-zone.is-dragging { transform: translateY(-1px); border-color: var(--color-primary); background: var(--color-primary-soft); }
  .drop-icon { display: grid; place-items: center; width: 3.4rem; height: 3.4rem; border-radius: var(--radius-lg); background: linear-gradient(135deg, var(--color-primary), var(--color-secondary)); color: #fff; font-size: .82rem; font-weight: 900; box-shadow: var(--shadow-brand); }
  .drop-zone strong, .drop-zone span { display: block; }
  .drop-zone span { color: var(--color-text-muted); font-size: .92rem; }
  .panel-section { display: grid; gap: var(--space-3); }
  .panel-section h2 { margin: 0; font-size: 1rem; letter-spacing: -.01em; }
  .preset-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--space-2); }
  .preset { min-height: 3.1rem; padding: .25rem; border-radius: var(--radius-md); border: 1px solid var(--color-border); background: var(--color-surface); cursor: pointer; }
  .preset.active { border-color: var(--color-primary); box-shadow: var(--shadow-focus); }
  .preset span { display: block; width: 100%; height: 100%; border-radius: .75rem; }
  .preset[data-preset='soft'] span { background: radial-gradient(circle at 0 0,#dbeafe 0 40%,transparent 42%), radial-gradient(circle at 100% 0,#ccfbf1 0 40%,transparent 42%), #f8fbff; }
  .preset[data-preset='aurora'] span { background: radial-gradient(circle at 20% 20%,#bfdbfe,transparent 42%), radial-gradient(circle at 80% 20%,#a7f3d0,transparent 44%), radial-gradient(circle at 50% 90%,#fde68a,transparent 36%), #fff; }
  .preset[data-preset='mesh'] span { background: linear-gradient(135deg,#fdf2f8,#ecfeff), radial-gradient(circle,#60a5fa,transparent); }
  .preset[data-preset='stripes'] span { background: repeating-linear-gradient(135deg,#dbeafe 0 8px,#fff 8px 22px); }
  .preset[data-preset='grid'] span { background-color:#fff; background-image: linear-gradient(#bfdbfe 1px,transparent 1px), linear-gradient(90deg,#bfdbfe 1px,transparent 1px); background-size: 12px 12px; }
  .preset[data-preset='solid'] span { background: #dbeafe; }
  .field-grid { display: grid; gap: var(--space-3); }
  .field-grid.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .custom-size { margin-top: calc(var(--space-2) * -1); }
  .check-row { display: flex; flex-direction: row; align-items: center; gap: var(--space-2); min-height: 2.5rem; }
  .check-row input { width: 1.1rem; height: 1.1rem; accent-color: var(--color-primary); }
  input[type='range'] { accent-color: var(--color-primary); }
  input[type='color'] { min-height: 2.9rem; padding: .25rem; cursor: pointer; }
  .download-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
  .download-grid .btn { width: 100%; }
  .preview-panel { min-height: 620px; padding: clamp(1rem, 2vw, 1.5rem); }
  .canvas-wrap { display: grid; min-height: 580px; place-items: center; overflow: auto; border-radius: var(--radius-xl); background: color-mix(in srgb, var(--color-bg) 72%, var(--color-surface)); }
  #previewCanvas { width: min(100%, 980px); height: auto; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
  @media (max-width: 980px) { .editor-shell { grid-template-columns: 1fr; } .control-panel { position: static; } .preview-panel, .canvas-wrap { min-height: auto; } }
  @media (max-width: 560px) { .preset-grid { grid-template-columns: repeat(3, 1fr); } .field-grid.two, .download-grid { grid-template-columns: 1fr; } .drop-zone { grid-template-columns: 1fr; } }
</style>
