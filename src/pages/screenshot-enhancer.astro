---
import Layout from '../layouts/Layout.astro';

const title = 'Mejorador de capturas de pantalla';
const description = 'Crea imágenes profesionales a partir de capturas con fondos personalizables, edición visual, recorte, rotación y exportación a PNG, JPG, WebP y SVG.';
---

<Layout title={`${title} — Alon Tools`} description={description} path="/screenshot-enhancer/">
  <section class="hero tool-hero">
    <div class="eyebrow">100% local</div>
    <h1>{title}</h1>
    <p class="hero-text">
      Sube una captura, muévela con el ratón, amplíala, recórtala, rótala y colócala sobre fondos generados para descargar una imagen lista para compartir.
    </p>
  </section>

  <section class="editor-shell" aria-label="Editor de capturas">
    <aside class="control-panel" aria-label="Opciones de diseño">
      <div class="drop-zone" id="dropZone">
        <input id="fileInput" type="file" accept="image/*" hidden />
        <div class="drop-icon" aria-hidden="true">IMG</div>
        <div>
          <strong>Arrastra una captura aquí</strong>
          <span>o pulsa para seleccionar una imagen</span>
        </div>
      </div>

      <div class="panel-section">
        <h2>Editar captura</h2>
        <div class="tool-actions">
          <button class="btn btn-primary" type="button" id="selectTool">Mover</button>
          <button class="btn btn-secondary" type="button" id="cropTool">Recortar</button>
          <button class="btn btn-secondary" type="button" id="fitImage">Encajar</button>
          <button class="btn btn-secondary" type="button" id="fillImage">Rellenar</button>
          <button class="btn btn-secondary" type="button" id="centerImage">Centrar</button>
          <button class="btn btn-secondary" type="button" id="resetImage">Reset</button>
        </div>
        <p class="help-text" id="editHelp">Arrastra la imagen para moverla. Usa las esquinas para redimensionar y el punto superior para rotar.</p>
        <div class="field-grid two">
          <label>X <input id="imageX" type="number" step="1" /></label>
          <label>Y <input id="imageY" type="number" step="1" /></label>
          <label>Ancho <input id="imageW" type="number" min="20" step="1" /></label>
          <label>Alto <input id="imageH" type="number" min="20" step="1" /></label>
        </div>
        <label>Rotación <input id="rotation" type="range" min="-45" max="45" value="0" /></label>
        <label>Opacidad <input id="opacity" type="range" min="10" max="100" value="100" /></label>
        <label>Radio captura <input id="imageRadius" type="range" min="0" max="54" value="18" /></label>
      </div>

      <div class="panel-section">
        <h2>Fondo</h2>
        <div class="preset-grid" id="presetGrid" aria-label="Fondos generados">
          <button type="button" class="preset active" data-preset="soft" aria-label="Fondo suave"><span></span></button>
          <button type="button" class="preset" data-preset="aurora" aria-label="Fondo aurora"><span></span></button>
          <button type="button" class="preset" data-preset="mesh" aria-label="Fondo mesh"><span></span></button>
          <button type="button" class="preset" data-preset="stripes" aria-label="Fondo con líneas"><span></span></button>
          <button type="button" class="preset" data-preset="grid" aria-label="Fondo de rejilla"><span></span></button>
          <button type="button" class="preset" data-preset="solid" aria-label="Fondo sólido"><span></span></button>
        </div>

        <div class="field-grid two">
          <label>Color 1 <input id="colorA" type="color" value="#dbeafe" /></label>
          <label>Color 2 <input id="colorB" type="color" value="#ccfbf1" /></label>
          <label>Color 3 <input id="colorC" type="color" value="#ffffff" /></label>
          <label>Tarjeta <input id="cardColor" type="color" value="#ffffff" /></label>
        </div>
      </div>

      <div class="panel-section">
        <h2>Composición</h2>
        <div class="field-grid">
          <label>Tamaño
            <select id="sizePreset">
              <option value="1200x800">1200 × 800</option>
              <option value="1600x900">1600 × 900</option>
              <option value="1080x1080">1080 × 1080</option>
              <option value="1200x1200">1200 × 1200</option>
              <option value="1920x1080">1920 × 1080</option>
              <option value="custom">Personalizado</option>
            </select>
          </label>
          <div class="field-grid two custom-size" id="customSize" hidden>
            <label>Ancho <input id="canvasWidth" type="number" min="400" max="4000" value="1200" /></label>
            <label>Alto <input id="canvasHeight" type="number" min="300" max="4000" value="800" /></label>
          </div>
          <label>Margen exterior <input id="padding" type="range" min="40" max="220" value="82" /></label>
          <label>Radio fondo <input id="cardRadius" type="range" min="0" max="80" value="48" /></label>
          <label class="check-row"><input id="browserFrame" type="checkbox" checked /> Añadir barra superior tipo navegador</label>
          <label class="check-row"><input id="shadow" type="checkbox" checked /> Sombra suave</label>
          <label class="check-row"><input id="clipToCard" type="checkbox" checked /> Recortar al marco blanco</label>
        </div>
      </div>

      <div class="panel-section">
        <h2>Exportar</h2>
        <div class="download-grid">
          <button class="btn btn-primary" type="button" data-download="png">PNG</button>
          <button class="btn btn-secondary" type="button" data-download="jpeg">JPG</button>
          <button class="btn btn-secondary" type="button" data-download="webp">WebP</button>
          <button class="btn btn-secondary" type="button" data-download="svg">SVG</button>
        </div>
        <p class="help-text" id="status">Sube una imagen para empezar.</p>
      </div>
    </aside>

    <div class="preview-panel">
      <div class="canvas-wrap">
        <canvas id="previewCanvas" width="1200" height="800" aria-label="Vista previa editable de la captura mejorada"></canvas>
      </div>
    </div>
  </section>

  <script>
    const state = {
      image: null,
      imageName: 'captura',
      preset: 'soft',
      width: 1200,
      height: 800,
      mode: 'move',
      selected: true,
      drag: null,
      imageLayer: {
        x: 220,
        y: 250,
        w: 760,
        h: 360,
        rotation: 0,
        opacity: 1,
        crop: { x: 0, y: 0, w: 1, h: 1 }
      }
    };

    const els = {
      canvas: document.getElementById('previewCanvas'),
      dropZone: document.getElementById('dropZone'),
      fileInput: document.getElementById('fileInput'),
      selectTool: document.getElementById('selectTool'),
      cropTool: document.getElementById('cropTool'),
      fitImage: document.getElementById('fitImage'),
      fillImage: document.getElementById('fillImage'),
      centerImage: document.getElementById('centerImage'),
      resetImage: document.getElementById('resetImage'),
      editHelp: document.getElementById('editHelp'),
      imageX: document.getElementById('imageX'),
      imageY: document.getElementById('imageY'),
      imageW: document.getElementById('imageW'),
      imageH: document.getElementById('imageH'),
      rotation: document.getElementById('rotation'),
      opacity: document.getElementById('opacity'),
      presetGrid: document.getElementById('presetGrid'),
      colorA: document.getElementById('colorA'),
      colorB: document.getElementById('colorB'),
      colorC: document.getElementById('colorC'),
      cardColor: document.getElementById('cardColor'),
      sizePreset: document.getElementById('sizePreset'),
      customSize: document.getElementById('customSize'),
      canvasWidth: document.getElementById('canvasWidth'),
      canvasHeight: document.getElementById('canvasHeight'),
      padding: document.getElementById('padding'),
      cardRadius: document.getElementById('cardRadius'),
      imageRadius: document.getElementById('imageRadius'),
      browserFrame: document.getElementById('browserFrame'),
      shadow: document.getElementById('shadow'),
      clipToCard: document.getElementById('clipToCard'),
      status: document.getElementById('status')
    };

    const ctx = els.canvas.getContext('2d');
    const HANDLE = 14;

    const clamp = (value, min, max) => Math.max(min, Math.min(max, value));
    const radians = (degrees) => degrees * Math.PI / 180;
    const degrees = (rad) => rad * 180 / Math.PI;
    const escapeXml = (value) => String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&apos;' }[char]));

    function roundRectPath(context, x, y, width, height, radius) {
      const r = clamp(radius, 0, Math.min(width, height) / 2);
      context.beginPath();
      context.moveTo(x + r, y);
      context.lineTo(x + width - r, y);
      context.quadraticCurveTo(x + width, y, x + width, y + r);
      context.lineTo(x + width, y + height - r);
      context.quadraticCurveTo(x + width, y + height, x + width - r, y + height);
      context.lineTo(x + r, y + height);
      context.quadraticCurveTo(x, y + height, x, y + height - r);
      context.lineTo(x, y + r);
      context.quadraticCurveTo(x, y, x + r, y);
      context.closePath();
    }

    function setCanvasSize() {
      const dpr = window.devicePixelRatio || 1;
      els.canvas.width = state.width * dpr;
      els.canvas.height = state.height * dpr;
      els.canvas.style.aspectRatio = `${state.width} / ${state.height}`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function getPointer(event) {
      const rect = els.canvas.getBoundingClientRect();
      return {
        x: (event.clientX - rect.left) * (state.width / rect.width),
        y: (event.clientY - rect.top) * (state.height / rect.height)
      };
    }

    function screenToLocal(point) {
      const layer = state.imageLayer;
      const cx = layer.x + layer.w / 2;
      const cy = layer.y + layer.h / 2;
      const angle = -radians(layer.rotation);
      const dx = point.x - cx;
      const dy = point.y - cy;
      return {
        x: dx * Math.cos(angle) - dy * Math.sin(angle) + layer.w / 2,
        y: dx * Math.sin(angle) + dy * Math.cos(angle) + layer.h / 2
      };
    }

    function localToScreen(local) {
      const layer = state.imageLayer;
      const cx = layer.x + layer.w / 2;
      const cy = layer.y + layer.h / 2;
      const angle = radians(layer.rotation);
      const dx = local.x - layer.w / 2;
      const dy = local.y - layer.h / 2;
      return {
        x: cx + dx * Math.cos(angle) - dy * Math.sin(angle),
        y: cy + dx * Math.sin(angle) + dy * Math.cos(angle)
      };
    }

    function getLayout() {
      const padding = Number(els.padding.value);
      const frameH = els.browserFrame.checked ? Math.max(46, Math.round(state.height * 0.09)) : 0;
      const card = {
        x: padding,
        y: padding,
        w: state.width - padding * 2,
        h: state.height - padding * 2,
        r: Number(els.cardRadius.value),
        frameH
      };
      const innerPad = Math.max(28, Math.round(Math.min(card.w, card.h) * 0.05));
      const imageBox = {
        x: card.x + innerPad,
        y: card.y + innerPad + frameH,
        w: card.w - innerPad * 2,
        h: card.h - innerPad * 2 - frameH
      };
      return { card, imageBox };
    }

    function drawBackground(context, width, height) {
      const a = els.colorA.value;
      const b = els.colorB.value;
      const c = els.colorC.value;
      context.fillStyle = c;
      context.fillRect(0, 0, width, height);

      if (state.preset === 'solid') {
        context.fillStyle = a;
        context.fillRect(0, 0, width, height);
        return;
      }

      const linear = context.createLinearGradient(0, 0, width, height);
      linear.addColorStop(0, c);
      linear.addColorStop(0.55, '#f8fbff');
      linear.addColorStop(1, b);
      context.fillStyle = linear;
      context.fillRect(0, 0, width, height);

      if (state.preset === 'soft' || state.preset === 'aurora' || state.preset === 'mesh') {
        const circles = state.preset === 'soft'
          ? [[a, -width * 0.04, -height * 0.1, width * 0.34], [b, width * 0.9, -height * 0.08, width * 0.36]]
          : [[a, width * 0.08, height * 0.04, width * 0.42], [b, width * 0.72, height * 0.08, width * 0.44], ['#fde68a', width * 0.42, height * 0.78, width * 0.34]];
        circles.forEach(([color, x, y, r]) => {
          context.save();
          context.globalAlpha = state.preset === 'mesh' ? 0.64 : 0.72;
          context.fillStyle = color;
          context.beginPath();
          context.arc(x, y, r, 0, Math.PI * 2);
          context.fill();
          context.restore();
        });
      }

      if (state.preset === 'stripes') {
        context.save();
        context.globalAlpha = 0.18;
        context.strokeStyle = a;
        context.lineWidth = 7;
        for (let x = -height; x < width + height; x += 46) {
          context.beginPath();
          context.moveTo(x, height);
          context.lineTo(x + height, 0);
          context.stroke();
        }
        context.restore();
      }

      if (state.preset === 'grid') {
        context.save();
        context.globalAlpha = 0.22;
        context.strokeStyle = a;
        context.lineWidth = 1;
        for (let x = 0; x <= width; x += 48) { context.beginPath(); context.moveTo(x, 0); context.lineTo(x, height); context.stroke(); }
        for (let y = 0; y <= height; y += 48) { context.beginPath(); context.moveTo(0, y); context.lineTo(width, y); context.stroke(); }
        context.restore();
      }
    }

    function drawCard(context, card) {
      context.save();
      if (els.shadow.checked) {
        context.shadowColor = 'rgba(15, 23, 42, .18)';
        context.shadowBlur = 42;
        context.shadowOffsetY = 22;
      }
      roundRectPath(context, card.x, card.y, card.w, card.h, card.r);
      context.fillStyle = els.cardColor.value;
      context.fill();
      context.restore();

      if (!els.browserFrame.checked) return;
      context.save();
      roundRectPath(context, card.x + 48, card.y + 48, card.w - 96, Math.max(62, card.frameH * .82), 26);
      context.fillStyle = '#0f172a';
      context.fill();
      context.fillStyle = '#2563eb';
      roundRectPath(context, card.x + 82, card.y + 68, 48, 30, 10);
      context.fill();
      context.fillStyle = '#f8fafc';
      roundRectPath(context, card.x + 154, card.y + 74, Math.min(178, card.w * .22), 18, 99);
      context.fill();
      context.globalAlpha = 0.12;
      context.fillStyle = '#f8fafc';
      roundRectPath(context, card.x + card.w - 280, card.y + 70, 104, 24, 99);
      context.fill();
      roundRectPath(context, card.x + card.w - 154, card.y + 70, 112, 24, 99);
      context.fill();
      context.restore();
    }

    function drawPlaceholder(context, box) {
      context.save();
      roundRectPath(context, box.x, box.y, box.w, box.h, Number(els.imageRadius.value));
      context.fillStyle = 'rgba(15,23,42,.05)';
      context.fill();
      context.strokeStyle = 'rgba(15,23,42,.12)';
      context.setLineDash([16, 14]);
      context.lineWidth = 3;
      context.stroke();
      context.fillStyle = '#334155';
      context.font = '800 32px system-ui, sans-serif';
      context.textAlign = 'center';
      context.fillText('Arrastra una captura', box.x + box.w / 2, box.y + box.h / 2 - 8);
      context.font = '500 20px system-ui, sans-serif';
      context.fillStyle = '#64748b';
      context.fillText('Después podrás moverla, ampliar y recortar', box.x + box.w / 2, box.y + box.h / 2 + 28);
      context.restore();
    }

    function drawImageLayer(context) {
      if (!state.image) return;
      const layer = state.imageLayer;
      const crop = layer.crop;
      const sx = crop.x * state.image.width;
      const sy = crop.y * state.image.height;
      const sw = crop.w * state.image.width;
      const sh = crop.h * state.image.height;
      const cx = layer.x + layer.w / 2;
      const cy = layer.y + layer.h / 2;

      context.save();
      context.translate(cx, cy);
      context.rotate(radians(layer.rotation));
      context.globalAlpha = layer.opacity;
      if (els.shadow.checked) {
        context.shadowColor = 'rgba(15, 23, 42, .16)';
        context.shadowBlur = 28;
        context.shadowOffsetY = 16;
      }
      roundRectPath(context, -layer.w / 2, -layer.h / 2, layer.w, layer.h, Number(els.imageRadius.value));
      context.clip();
      context.drawImage(state.image, sx, sy, sw, sh, -layer.w / 2, -layer.h / 2, layer.w, layer.h);
      context.restore();
    }

    function getHandles() {
      const layer = state.imageLayer;
      const points = {
        nw: localToScreen({ x: 0, y: 0 }),
        ne: localToScreen({ x: layer.w, y: 0 }),
        se: localToScreen({ x: layer.w, y: layer.h }),
        sw: localToScreen({ x: 0, y: layer.h }),
        rotate: localToScreen({ x: layer.w / 2, y: -52 })
      };
      return points;
    }

    function drawSelection(context) {
      if (!state.image || !state.selected) return;
      const layer = state.imageLayer;
      const handles = getHandles();
      const corners = [handles.nw, handles.ne, handles.se, handles.sw];

      context.save();
      context.strokeStyle = state.mode === 'crop' ? '#14b8a6' : '#2563eb';
      context.lineWidth = 2;
      context.setLineDash([8, 6]);
      context.beginPath();
      context.moveTo(corners[0].x, corners[0].y);
      corners.slice(1).forEach((point) => context.lineTo(point.x, point.y));
      context.closePath();
      context.stroke();
      context.setLineDash([]);

      context.beginPath();
      context.moveTo(localToScreen({ x: layer.w / 2, y: 0 }).x, localToScreen({ x: layer.w / 2, y: 0 }).y);
      context.lineTo(handles.rotate.x, handles.rotate.y);
      context.stroke();

      Object.entries(handles).forEach(([name, point]) => {
        context.beginPath();
        context.fillStyle = name === 'rotate' ? '#0f172a' : '#ffffff';
        context.strokeStyle = '#2563eb';
        context.lineWidth = 2;
        context.arc(point.x, point.y, name === 'rotate' ? 8 : HANDLE / 2, 0, Math.PI * 2);
        context.fill();
        context.stroke();
      });

      if (state.mode === 'crop') {
        const crop = layer.crop;
        const x = crop.x * layer.w;
        const y = crop.y * layer.h;
        const w = crop.w * layer.w;
        const h = crop.h * layer.h;
        const a = localToScreen({ x, y });
        const b = localToScreen({ x: x + w, y });
        const c = localToScreen({ x: x + w, y: y + h });
        const d = localToScreen({ x, y: y + h });
        context.fillStyle = 'rgba(20, 184, 166, .12)';
        context.beginPath();
        context.moveTo(a.x, a.y);
        [b, c, d].forEach((point) => context.lineTo(point.x, point.y));
        context.closePath();
        context.fill();
        context.strokeStyle = '#14b8a6';
        context.lineWidth = 3;
        context.stroke();
      }
      context.restore();
    }

    function render(options = {}) {
      setCanvasSize();
      drawBackground(ctx, state.width, state.height);
      const { card, imageBox } = getLayout();
      drawCard(ctx, card);
      if (!state.image) drawPlaceholder(ctx, imageBox);
      ctx.save();
      if (els.clipToCard.checked) {
        roundRectPath(ctx, card.x, card.y, card.w, card.h, card.r);
        ctx.clip();
      }
      drawImageLayer(ctx);
      ctx.restore();
      if (!options.exporting) drawSelection(ctx);
    }

    function syncControlsFromLayer() {
      const layer = state.imageLayer;
      els.imageX.value = Math.round(layer.x);
      els.imageY.value = Math.round(layer.y);
      els.imageW.value = Math.round(layer.w);
      els.imageH.value = Math.round(layer.h);
      els.rotation.value = String(Math.round(layer.rotation));
      els.opacity.value = String(Math.round(layer.opacity * 100));
    }

    function syncLayerFromControls() {
      const layer = state.imageLayer;
      layer.x = Number(els.imageX.value) || layer.x;
      layer.y = Number(els.imageY.value) || layer.y;
      layer.w = clamp(Number(els.imageW.value) || layer.w, 20, 6000);
      layer.h = clamp(Number(els.imageH.value) || layer.h, 20, 6000);
      layer.rotation = Number(els.rotation.value) || 0;
      layer.opacity = clamp(Number(els.opacity.value) / 100, 0.1, 1);
      render();
    }

    function fitImage(mode = 'contain') {
      if (!state.image) return;
      const { imageBox } = getLayout();
      const fit = mode === 'cover'
        ? Math.max(imageBox.w / state.image.width, imageBox.h / state.image.height)
        : Math.min(imageBox.w / state.image.width, imageBox.h / state.image.height);
      const layer = state.imageLayer;
      layer.w = state.image.width * fit;
      layer.h = state.image.height * fit;
      layer.x = imageBox.x + (imageBox.w - layer.w) / 2;
      layer.y = imageBox.y + (imageBox.h - layer.h) / 2;
      layer.rotation = 0;
      layer.opacity = Number(els.opacity.value) / 100;
      layer.crop = { x: 0, y: 0, w: 1, h: 1 };
      syncControlsFromLayer();
      render();
    }

    function centerImage() {
      if (!state.image) return;
      const { imageBox } = getLayout();
      const layer = state.imageLayer;
      layer.x = imageBox.x + (imageBox.w - layer.w) / 2;
      layer.y = imageBox.y + (imageBox.h - layer.h) / 2;
      syncControlsFromLayer();
      render();
    }

    function setMode(mode) {
      state.mode = mode;
      els.selectTool.classList.toggle('btn-primary', mode === 'move');
      els.selectTool.classList.toggle('btn-secondary', mode !== 'move');
      els.cropTool.classList.toggle('btn-primary', mode === 'crop');
      els.cropTool.classList.toggle('btn-secondary', mode !== 'crop');
      els.editHelp.textContent = mode === 'crop'
        ? 'Modo recorte: arrastra dentro del recuadro verde para elegir qué parte de la captura se ve. Usa las esquinas azules para cambiar el tamaño final.'
        : 'Arrastra la imagen para moverla. Usa las esquinas para redimensionar y el punto superior para rotar.';
      render();
    }

    function hitHandle(point) {
      const handles = getHandles();
      for (const [name, handle] of Object.entries(handles)) {
        const dist = Math.hypot(point.x - handle.x, point.y - handle.y);
        if (dist <= HANDLE) return name;
      }
      return null;
    }

    function hitImage(point) {
      const local = screenToLocal(point);
      const layer = state.imageLayer;
      return local.x >= 0 && local.y >= 0 && local.x <= layer.w && local.y <= layer.h;
    }

    function startDrag(event) {
      if (!state.image) return;
      const point = getPointer(event);
      const layer = state.imageLayer;
      const handle = hitHandle(point);
      const local = screenToLocal(point);
      state.selected = hitImage(point) || Boolean(handle);

      if (!state.selected) {
        render();
        return;
      }

      els.canvas.setPointerCapture(event.pointerId);
      if (state.mode === 'crop' && hitImage(point) && !handle) {
        state.drag = { type: 'cropMove', start: point, localStart: local, cropStart: { ...layer.crop } };
      } else if (handle === 'rotate') {
        const cx = layer.x + layer.w / 2;
        const cy = layer.y + layer.h / 2;
        state.drag = { type: 'rotate', cx, cy, startAngle: degrees(Math.atan2(point.y - cy, point.x - cx)), rotationStart: layer.rotation };
      } else if (handle) {
        state.drag = { type: 'resize', handle, start: point, layerStart: { ...layer } };
      } else if (hitImage(point)) {
        state.drag = { type: 'move', start: point, layerStart: { ...layer } };
      }
      event.preventDefault();
    }

    function dragMove(event) {
      if (!state.drag) return;
      const point = getPointer(event);
      const layer = state.imageLayer;

      if (state.drag.type === 'move') {
        layer.x = state.drag.layerStart.x + point.x - state.drag.start.x;
        layer.y = state.drag.layerStart.y + point.y - state.drag.start.y;
      }

      if (state.drag.type === 'resize') {
        const start = state.drag.layerStart;
        const local = screenToLocal(point);
        const keepRatio = event.shiftKey;
        let x = start.x;
        let y = start.y;
        let w = start.w;
        let h = start.h;
        if (state.drag.handle.includes('e')) w = clamp(local.x, 24, 6000);
        if (state.drag.handle.includes('s')) h = clamp(local.y, 24, 6000);
        if (state.drag.handle.includes('w')) { const right = start.x + start.w; x = start.x + local.x; w = clamp(right - x, 24, 6000); }
        if (state.drag.handle.includes('n')) { const bottom = start.y + start.h; y = start.y + local.y; h = clamp(bottom - y, 24, 6000); }
        if (keepRatio && state.image) {
          const ratio = start.w / start.h;
          if (w / h > ratio) w = h * ratio;
          else h = w / ratio;
        }
        layer.x = x;
        layer.y = y;
        layer.w = w;
        layer.h = h;
      }

      if (state.drag.type === 'rotate') {
        const angle = degrees(Math.atan2(point.y - state.drag.cy, point.x - state.drag.cx));
        layer.rotation = clamp(state.drag.rotationStart + angle - state.drag.startAngle, -180, 180);
      }

      if (state.drag.type === 'cropMove') {
        const local = screenToLocal(point);
        const dx = (local.x - state.drag.localStart.x) / layer.w;
        const dy = (local.y - state.drag.localStart.y) / layer.h;
        layer.crop.x = clamp(state.drag.cropStart.x + dx, 0, 1 - layer.crop.w);
        layer.crop.y = clamp(state.drag.cropStart.y + dy, 0, 1 - layer.crop.h);
      }

      syncControlsFromLayer();
      render();
    }

    function endDrag(event) {
      if (state.drag && event.pointerId) {
        try { els.canvas.releasePointerCapture(event.pointerId); } catch {}
      }
      state.drag = null;
    }

    function loadFile(file) {
      if (!file || !file.type.startsWith('image/')) {
        els.status.textContent = 'Selecciona un archivo de imagen válido.';
        return;
      }
      const reader = new FileReader();
      reader.onload = () => {
        const image = new Image();
        image.onload = () => {
          state.image = image;
          state.imageName = file.name.replace(/\.[^/.]+$/, '') || 'captura';
          els.status.textContent = `${file.name} cargada. Ya puedes mover, ampliar, rotar y recortar la captura en el canvas.`;
          fitImage('contain');
        };
        image.src = reader.result;
      };
      reader.readAsDataURL(file);
    }

    function downloadBlob(blob, filename) {
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = filename;
      link.click();
      URL.revokeObjectURL(url);
    }

    function download(format) {
      const filename = `${state.imageName}-mejorada-${state.width}x${state.height}.${format === 'jpeg' ? 'jpg' : format}`;
      render({ exporting: true });
      if (format === 'svg') {
        const dataUrl = els.canvas.toDataURL('image/png');
        const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${state.width}" height="${state.height}" viewBox="0 0 ${state.width} ${state.height}"><image href="${escapeXml(dataUrl)}" width="${state.width}" height="${state.height}"/></svg>`;
        downloadBlob(new Blob([svg], { type: 'image/svg+xml' }), filename);
        render();
        return;
      }
      const mime = format === 'jpeg' ? 'image/jpeg' : `image/${format}`;
      els.canvas.toBlob((blob) => {
        if (blob) downloadBlob(blob, filename);
        render();
      }, mime, 0.94);
    }

    els.dropZone.addEventListener('click', () => els.fileInput.click());
    els.fileInput.addEventListener('change', () => loadFile(els.fileInput.files?.[0]));
    ['dragenter', 'dragover'].forEach((eventName) => els.dropZone.addEventListener(eventName, (event) => {
      event.preventDefault();
      els.dropZone.classList.add('is-dragging');
    }));
    ['dragleave', 'drop'].forEach((eventName) => els.dropZone.addEventListener(eventName, (event) => {
      event.preventDefault();
      els.dropZone.classList.remove('is-dragging');
    }));
    els.dropZone.addEventListener('drop', (event) => loadFile(event.dataTransfer?.files?.[0]));

    els.canvas.addEventListener('pointerdown', startDrag);
    els.canvas.addEventListener('pointermove', dragMove);
    els.canvas.addEventListener('pointerup', endDrag);
    els.canvas.addEventListener('pointercancel', endDrag);

    els.presetGrid.addEventListener('click', (event) => {
      const button = event.target.closest('[data-preset]');
      if (!button) return;
      state.preset = button.dataset.preset;
      document.querySelectorAll('[data-preset]').forEach((item) => item.classList.toggle('active', item === button));
      render();
    });

    els.sizePreset.addEventListener('change', () => {
      els.customSize.hidden = els.sizePreset.value !== 'custom';
      if (els.sizePreset.value !== 'custom') {
        const [width, height] = els.sizePreset.value.split('x').map(Number);
        state.width = width;
        state.height = height;
        els.canvasWidth.value = width;
        els.canvasHeight.value = height;
        if (state.image) fitImage('contain');
        render();
      }
    });

    [els.canvasWidth, els.canvasHeight].forEach((input) => input.addEventListener('input', () => {
      state.width = clamp(Number(els.canvasWidth.value) || 1200, 400, 4000);
      state.height = clamp(Number(els.canvasHeight.value) || 800, 300, 4000);
      render();
    }));

    [els.imageX, els.imageY, els.imageW, els.imageH, els.rotation, els.opacity].forEach((input) => input.addEventListener('input', syncLayerFromControls));
    [els.colorA, els.colorB, els.colorC, els.cardColor, els.padding, els.cardRadius, els.imageRadius, els.browserFrame, els.shadow, els.clipToCard].forEach((input) => {
      input.addEventListener('input', render);
      input.addEventListener('change', render);
    });

    els.selectTool.addEventListener('click', () => setMode('move'));
    els.cropTool.addEventListener('click', () => setMode('crop'));
    els.fitImage.addEventListener('click', () => fitImage('contain'));
    els.fillImage.addEventListener('click', () => fitImage('cover'));
    els.centerImage.addEventListener('click', centerImage);
    els.resetImage.addEventListener('click', () => fitImage('contain'));

    document.querySelectorAll('[data-download]').forEach((button) => {
      button.addEventListener('click', () => download(button.dataset.download));
    });

    document.addEventListener('keydown', (event) => {
      if (!state.image || ['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) return;
      const step = event.shiftKey ? 10 : 1;
      if (event.key === 'ArrowLeft') state.imageLayer.x -= step;
      if (event.key === 'ArrowRight') state.imageLayer.x += step;
      if (event.key === 'ArrowUp') state.imageLayer.y -= step;
      if (event.key === 'ArrowDown') state.imageLayer.y += step;
      if (event.key === '0') fitImage('contain');
      if (['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', '0'].includes(event.key)) {
        event.preventDefault();
        syncControlsFromLayer();
        render();
      }
    });

    syncControlsFromLayer();
    render();
  </script>
</Layout>

<style>
