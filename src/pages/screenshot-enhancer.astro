---
import Layout from '../layouts/Layout.astro';

const title = 'Editor de capturas de pantalla';
const description = 'Mejora capturas con fondos personalizables, pegado desde portapapeles, edición visual y exportación a PNG, JPG, WebP y SVG.';
---

<Layout title={`${title} — Alon Tools`} description={description} path="/screenshot-enhancer/">
  <section class="hero tool-hero">
    <div class="eyebrow">100% local</div>
    <h1>{title}</h1>
    <p class="hero-text">Arrastra, selecciona o pega una captura con Ctrl/Cmd + V. Después muévela, amplíala, recórtala y descárgala con un fondo profesional, sin añadir barras falsas encima.</p>
  </section>

  <section class="editor-shell" aria-label="Editor de capturas">
    <aside class="control-panel">
      <button class="drop-zone" id="dropZone" type="button">
        <input id="fileInput" type="file" accept="image/*" hidden />
        <span class="drop-icon">IMG</span>
        <span><strong>Arrastra, pega o selecciona</strong><small>Ctrl/Cmd + V pega imágenes del portapapeles</small></span>
      </button>

      <div class="panel-section">
        <h2>Editar imagen</h2>
        <div class="tool-actions">
          <button class="btn btn-primary" type="button" id="moveTool">Mover</button>
          <button class="btn btn-secondary" type="button" id="cropTool">Recortar</button>
          <button class="btn btn-secondary" type="button" id="fitImage">Encajar</button>
          <button class="btn btn-secondary" type="button" id="fillImage">Rellenar</button>
          <button class="btn btn-secondary" type="button" id="centerImage">Centrar</button>
          <button class="btn btn-secondary" type="button" id="resetImage">Reset</button>
          <button class="btn btn-secondary danger-button" type="button" id="deleteImage">Borrar imagen</button>
        </div>
        <p class="help-text" id="editHelp">Arrastra la imagen. Usa las esquinas para cambiar tamaño y el punto superior para rotar.</p>
        <div class="field-grid two">
          <label>X <input id="imageX" type="number" step="1" /></label>
          <label>Y <input id="imageY" type="number" step="1" /></label>
          <label>Ancho <input id="imageW" type="number" min="20" step="1" /></label>
          <label>Alto <input id="imageH" type="number" min="20" step="1" /></label>
        </div>
        <label class="check-row"><input id="keepAspect" type="checkbox" checked /> Mantener relación de aspecto</label>
        <label>Rotación <input id="rotation" type="range" min="-180" max="180" value="0" /></label>
        <label>Opacidad <input id="opacity" type="range" min="10" max="100" value="100" /></label>
        <label>Radio de esquinas <input id="imageRadius" type="range" min="0" max="64" value="18" /></label>
      </div>

      <div class="panel-section">
        <h2>Fondo</h2>
        <div class="preset-grid" id="presetGrid">
          <button type="button" class="preset active" data-preset="soft"><span></span></button>
          <button type="button" class="preset" data-preset="aurora"><span></span></button>
          <button type="button" class="preset" data-preset="mesh"><span></span></button>
          <button type="button" class="preset" data-preset="stripes"><span></span></button>
          <button type="button" class="preset" data-preset="grid"><span></span></button>
          <button type="button" class="preset" data-preset="solid"><span></span></button>
        </div>
        <div class="field-grid two">
          <label>Color 1 <input id="colorA" type="color" value="#dbeafe" /></label>
          <label>Color 2 <input id="colorB" type="color" value="#ccfbf1" /></label>
          <label>Base <input id="colorC" type="color" value="#ffffff" /></label>
          <label>Marco <input id="cardColor" type="color" value="#ffffff" /></label>
        </div>
      </div>

      <div class="panel-section">
        <h2>Composición</h2>
        <div class="field-grid">
          <label>Tamaño
            <select id="sizePreset">
              <option value="1200x800">1200 × 800</option>
              <option value="1600x900">1600 × 900</option>
              <option value="1080x1080">1080 × 1080</option>
              <option value="1200x1200">1200 × 1200</option>
              <option value="1920x1080">1920 × 1080</option>
              <option value="custom">Personalizado</option>
            </select>
          </label>
          <div class="field-grid two" id="customSize" hidden>
            <label>Ancho <input id="canvasWidth" type="number" min="400" max="4000" value="1200" /></label>
            <label>Alto <input id="canvasHeight" type="number" min="300" max="4000" value="800" /></label>
          </div>
          <label>Margen exterior <input id="padding" type="range" min="24" max="220" value="82" /></label>
          <label>Radio del marco <input id="cardRadius" type="range" min="0" max="90" value="48" /></label>
          <label class="check-row"><input id="shadow" type="checkbox" checked /> Sombra suave</label>
          <label class="check-row"><input id="clipToCard" type="checkbox" checked /> Recortar al marco</label>
        </div>
      </div>

      <div class="panel-section">
        <h2>Exportar</h2>
        <div class="download-grid">
          <button class="btn btn-primary" type="button" data-download="png">PNG</button>
          <button class="btn btn-secondary" type="button" data-download="jpeg">JPG</button>
          <button class="btn btn-secondary" type="button" data-download="webp">WebP</button>
          <button class="btn btn-secondary" type="button" data-download="svg">SVG</button>
        </div>
        <p class="help-text" id="status">Sube o pega una imagen para empezar.</p>
      </div>
    </aside>

    <div class="preview-panel"><div class="canvas-wrap"><canvas id="previewCanvas" width="1200" height="800" tabindex="0"></canvas></div></div>
  </section>

  <script>
    const defaultLayer=()=>({x:220,y:220,w:760,h:380,rotation:0,opacity:1,crop:{x:0,y:0,w:1,h:1}});
    const state={image:null,imageName:'captura',preset:'soft',width:1200,height:800,mode:'move',selected:true,drag:null,layer:defaultLayer()};
    const $=(id)=>document.getElementById(id);const els={canvas:$('previewCanvas'),dropZone:$('dropZone'),fileInput:$('fileInput'),moveTool:$('moveTool'),cropTool:$('cropTool'),fitImage:$('fitImage'),fillImage:$('fillImage'),centerImage:$('centerImage'),resetImage:$('resetImage'),deleteImage:$('deleteImage'),editHelp:$('editHelp'),imageX:$('imageX'),imageY:$('imageY'),imageW:$('imageW'),imageH:$('imageH'),keepAspect:$('keepAspect'),rotation:$('rotation'),opacity:$('opacity'),imageRadius:$('imageRadius'),presetGrid:$('presetGrid'),colorA:$('colorA'),colorB:$('colorB'),colorC:$('colorC'),cardColor:$('cardColor'),sizePreset:$('sizePreset'),customSize:$('customSize'),canvasWidth:$('canvasWidth'),canvasHeight:$('canvasHeight'),padding:$('padding'),cardRadius:$('cardRadius'),shadow:$('shadow'),clipToCard:$('clipToCard'),status:$('status')};
    const ctx=els.canvas.getContext('2d');const HANDLE=14;const clamp=(v,min,max)=>Math.max(min,Math.min(max,v));const rad=(d)=>d*Math.PI/180;const deg=(r)=>r*180/Math.PI;const esc=(v)=>String(v).replace(/[&<>"']/g,(c)=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&apos;'}[c]));
    function rr(c,x,y,w,h,r){const q=clamp(r,0,Math.min(w,h)/2);c.beginPath();c.moveTo(x+q,y);c.lineTo(x+w-q,y);c.quadraticCurveTo(x+w,y,x+w,y+q);c.lineTo(x+w,y+h-q);c.quadraticCurveTo(x+w,y+h,x+w-q,y+h);c.lineTo(x+q,y+h);c.quadraticCurveTo(x,y+h,x,y+h-q);c.lineTo(x,y+q);c.quadraticCurveTo(x,y,x+q,y);c.closePath()}
    function size(){const d=window.devicePixelRatio||1;els.canvas.width=state.width*d;els.canvas.height=state.height*d;els.canvas.style.aspectRatio=`${state.width}/${state.height}`;ctx.setTransform(d,0,0,d,0,0)}
    function layout(){const p=Number(els.padding.value);const card={x:p,y:p,w:state.width-p*2,h:state.height-p*2,r:Number(els.cardRadius.value)};const i=Math.max(26,Math.round(Math.min(card.w,card.h)*.055));return{card,box:{x:card.x+i,y:card.y+i,w:card.w-i*2,h:card.h-i*2}}}
    function bg(c){const a=els.colorA.value,b=els.colorB.value,base=els.colorC.value;c.fillStyle=base;c.fillRect(0,0,state.width,state.height);if(state.preset==='solid'){c.fillStyle=a;c.fillRect(0,0,state.width,state.height);return}const g=c.createLinearGradient(0,0,state.width,state.height);g.addColorStop(0,base);g.addColorStop(.6,'#f8fbff');g.addColorStop(1,b);c.fillStyle=g;c.fillRect(0,0,state.width,state.height);if(['soft','aurora','mesh'].includes(state.preset)){const circles=state.preset==='soft'?[[a,-state.width*.04,-state.height*.1,state.width*.34],[b,state.width*.9,-state.height*.08,state.width*.36]]:[[a,state.width*.08,state.height*.04,state.width*.42],[b,state.width*.72,state.height*.08,state.width*.44],['#fde68a',state.width*.42,state.height*.78,state.width*.34]];circles.forEach(([col,x,y,r])=>{c.save();c.globalAlpha=state.preset==='mesh'?.64:.72;c.fillStyle=col;c.beginPath();c.arc(x,y,r,0,Math.PI*2);c.fill();c.restore()})}if(state.preset==='stripes'){c.save();c.globalAlpha=.18;c.strokeStyle=a;c.lineWidth=7;for(let x=-state.height;x<state.width+state.height;x+=46){c.beginPath();c.moveTo(x,state.height);c.lineTo(x+state.height,0);c.stroke()}c.restore()}if(state.preset==='grid'){c.save();c.globalAlpha=.22;c.strokeStyle=a;for(let x=0;x<=state.width;x+=48){c.beginPath();c.moveTo(x,0);c.lineTo(x,state.height);c.stroke()}for(let y=0;y<=state.height;y+=48){c.beginPath();c.moveTo(0,y);c.lineTo(state.width,y);c.stroke()}c.restore()}}
    function card(c,r){c.save();if(els.shadow.checked){c.shadowColor='rgba(15,23,42,.18)';c.shadowBlur=42;c.shadowOffsetY=22}rr(c,r.x,r.y,r.w,r.h,r.r);c.fillStyle=els.cardColor.value;c.fill();c.restore()}
    function placeholder(c,b){c.save();rr(c,b.x,b.y,b.w,b.h,Number(els.imageRadius.value));c.fillStyle='rgba(15,23,42,.05)';c.fill();c.strokeStyle='rgba(15,23,42,.12)';c.setLineDash([16,14]);c.lineWidth=3;c.stroke();c.fillStyle='#334155';c.font='800 31px system-ui,sans-serif';c.textAlign='center';c.fillText('Arrastra o pega una captura',b.x+b.w/2,b.y+b.h/2-8);c.font='500 20px system-ui,sans-serif';c.fillStyle='#64748b';c.fillText('Ctrl/Cmd + V para pegar desde el portapapeles',b.x+b.w/2,b.y+b.h/2+30);c.restore()}
    function drawImg(c){if(!state.image)return;const l=state.layer,cr=l.crop;c.save();c.translate(l.x+l.w/2,l.y+l.h/2);c.rotate(rad(l.rotation));c.globalAlpha=l.opacity;if(els.shadow.checked){c.shadowColor='rgba(15,23,42,.16)';c.shadowBlur=28;c.shadowOffsetY=16}rr(c,-l.w/2,-l.h/2,l.w,l.h,Number(els.imageRadius.value));c.clip();c.drawImage(state.image,cr.x*state.image.width,cr.y*state.image.height,cr.w*state.image.width,cr.h*state.image.height,-l.w/2,-l.h/2,l.w,l.h);c.restore()}
    function l2s(p){const l=state.layer,cx=l.x+l.w/2,cy=l.y+l.h/2,a=rad(l.rotation),dx=p.x-l.w/2,dy=p.y-l.h/2;return{x:cx+dx*Math.cos(a)-dy*Math.sin(a),y:cy+dx*Math.sin(a)+dy*Math.cos(a)}}
    function s2l(p){const l=state.layer,cx=l.x+l.w/2,cy=l.y+l.h/2,a=-rad(l.rotation),dx=p.x-cx,dy=p.y-cy;return{x:dx*Math.cos(a)-dy*Math.sin(a)+l.w/2,y:dx*Math.sin(a)+dy*Math.cos(a)+l.h/2}}
    function handles(){const l=state.layer;return{nw:l2s({x:0,y:0}),ne:l2s({x:l.w,y:0}),se:l2s({x:l.w,y:l.h}),sw:l2s({x:0,y:l.h}),rotate:l2s({x:l.w/2,y:-52})}}
    function selection(c){if(!state.image||!state.selected)return;const h=handles(),pts=[h.nw,h.ne,h.se,h.sw];c.save();c.strokeStyle=state.mode==='crop'?'#14b8a6':'#2563eb';c.lineWidth=2;c.setLineDash([8,6]);c.beginPath();c.moveTo(pts[0].x,pts[0].y);pts.slice(1).forEach(p=>c.lineTo(p.x,p.y));c.closePath();c.stroke();c.setLineDash([]);const top=l2s({x:state.layer.w/2,y:0});c.beginPath();c.moveTo(top.x,top.y);c.lineTo(h.rotate.x,h.rotate.y);c.stroke();Object.entries(h).forEach(([n,p])=>{c.beginPath();c.fillStyle=n==='rotate'?'#0f172a':'#fff';c.strokeStyle='#2563eb';c.arc(p.x,p.y,n==='rotate'?8:HANDLE/2,0,Math.PI*2);c.fill();c.stroke()});c.restore()}
    function render(o={}){size();bg(ctx);const{card:ca,box}=layout();card(ctx,ca);if(!state.image)placeholder(ctx,box);ctx.save();if(els.clipToCard.checked){rr(ctx,ca.x,ca.y,ca.w,ca.h,ca.r);ctx.clip()}drawImg(ctx);ctx.restore();if(!o.exporting)selection(ctx)}
    function sync(){const l=state.layer;els.imageX.value=Math.round(l.x);els.imageY.value=Math.round(l.y);els.imageW.value=Math.round(l.w);els.imageH.value=Math.round(l.h);els.rotation.value=Math.round(l.rotation);els.opacity.value=Math.round(l.opacity*100)}
    function apply(){const l=state.layer;const ratio=l.w/l.h;const active=document.activeElement;l.x=Number(els.imageX.value)||l.x;l.y=Number(els.imageY.value)||l.y;if(els.keepAspect.checked&&active===els.imageW){l.w=clamp(Number(els.imageW.value)||l.w,20,6000);l.h=clamp(l.w/ratio,20,6000);sync()}else if(els.keepAspect.checked&&active===els.imageH){l.h=clamp(Number(els.imageH.value)||l.h,20,6000);l.w=clamp(l.h*ratio,20,6000);sync()}else{l.w=clamp(Number(els.imageW.value)||l.w,20,6000);l.h=clamp(Number(els.imageH.value)||l.h,20,6000)}l.rotation=Number(els.rotation.value)||0;l.opacity=clamp(Number(els.opacity.value)/100,.1,1);render()}
    function fit(mode='contain'){if(!state.image)return;const{box}=layout();const r=mode==='cover'?Math.max(box.w/state.image.width,box.h/state.image.height):Math.min(box.w/state.image.width,box.h/state.image.height);state.layer.w=state.image.width*r;state.layer.h=state.image.height*r;state.layer.x=box.x+(box.w-state.layer.w)/2;state.layer.y=box.y+(box.h-state.layer.h)/2;state.layer.rotation=0;state.layer.crop={x:0,y:0,w:1,h:1};sync();render()}
    function center(){const{box}=layout();state.layer.x=box.x+(box.w-state.layer.w)/2;state.layer.y=box.y+(box.h-state.layer.h)/2;sync();render()}
    function mode(m){state.mode=m;els.moveTool.className=`btn ${m==='move'?'btn-primary':'btn-secondary'}`;els.cropTool.className=`btn ${m==='crop'?'btn-primary':'btn-secondary'}`;els.editHelp.textContent=m==='crop'?'Modo recorte: arrastra dentro de la imagen para desplazar el recorte visible.':'Arrastra la imagen. Usa las esquinas para cambiar tamaño y el punto superior para rotar.';render()}
    function deleteCurrentImage(){if(!state.image)return;if(!window.confirm('¿Seguro que quieres borrar la imagen? Esta acción no se puede deshacer.'))return;state.image=null;state.imageName='captura';state.selected=false;state.drag=null;state.layer=defaultLayer();els.fileInput.value='';els.status.textContent='Imagen borrada. Sube o pega otra para continuar.';sync();render()}
    function load(file){if(!file||!file.type.startsWith('image/')){els.status.textContent='Selecciona o pega una imagen válida.';return}const reader=new FileReader();reader.onload=()=>{const img=new Image();img.onload=()=>{state.image=img;state.imageName=(file.name||'imagen-pegada').replace(/\.[^/.]+$/,'')||'captura';state.selected=true;els.status.textContent=`${file.name||'Imagen pegada'} cargada.`;fit('contain')};img.src=reader.result};reader.readAsDataURL(file)}
    function pointer(e){const r=els.canvas.getBoundingClientRect();return{x:(e.clientX-r.left)*(state.width/r.width),y:(e.clientY-r.top)*(state.height/r.height)}}function hit(p){const q=s2l(p);return q.x>=0&&q.y>=0&&q.x<=state.layer.w&&q.y<=state.layer.h}function hitHandle(p){for(const[n,h]of Object.entries(handles()))if(Math.hypot(p.x-h.x,p.y-h.y)<=HANDLE)return n;return null}
    function down(e){if(!state.image)return;const p=pointer(e),hh=hitHandle(p),local=s2l(p);state.selected=hit(p)||!!hh;if(!state.selected){render();return}els.canvas.setPointerCapture(e.pointerId);if(state.mode==='crop'&&hit(p)&&!hh)state.drag={type:'crop',local,crop:{...state.layer.crop}};else if(hh==='rotate'){const cx=state.layer.x+state.layer.w/2,cy=state.layer.y+state.layer.h/2;state.drag={type:'rotate',cx,cy,start:deg(Math.atan2(p.y-cy,p.x-cx)),rot:state.layer.rotation}}else if(hh)state.drag={type:'resize',handle:hh,start:p,layer:{...state.layer}};else state.drag={type:'move',start:p,layer:{...state.layer}};e.preventDefault()}
    function move(e){if(!state.drag)return;const p=pointer(e),l=state.layer;if(state.drag.type==='move'){l.x=state.drag.layer.x+p.x-state.drag.start.x;l.y=state.drag.layer.y+p.y-state.drag.start.y}if(state.drag.type==='rotate')l.rotation=clamp(state.drag.rot+deg(Math.atan2(p.y-state.drag.cy,p.x-state.drag.cx))-state.drag.start,-180,180);if(state.drag.type==='crop'){const local=s2l(p),dx=(local.x-state.drag.local.x)/l.w,dy=(local.y-state.drag.local.y)/l.h;l.crop.x=clamp(state.drag.crop.x+dx,0,1-l.crop.w);l.crop.y=clamp(state.drag.crop.y+dy,0,1-l.crop.h)}if(state.drag.type==='resize'){const s=state.drag.layer,local=s2l(p);let x=s.x,y=s.y,w=s.w,h=s.h;if(state.drag.handle.includes('e'))w=clamp(local.x,24,6000);if(state.drag.handle.includes('s'))h=clamp(local.y,24,6000);if(state.drag.handle.includes('w')){const right=s.x+s.w;x=s.x+local.x;w=clamp(right-x,24,6000)}if(state.drag.handle.includes('n')){const bottom=s.y+s.h;y=s.y+local.y;h=clamp(bottom-y,24,6000)}if(els.keepAspect.checked||e.shiftKey){const ratio=s.w/s.h;if(w/h>ratio)w=h*ratio;else h=w/ratio}Object.assign(l,{x,y,w,h})}sync();render()}
    function up(e){if(state.drag){try{els.canvas.releasePointerCapture(e.pointerId)}catch{}}state.drag=null}
    function save(blob,name){const url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();URL.revokeObjectURL(url)}function download(f){const name=`${state.imageName}-mejorada-${state.width}x${state.height}.${f==='jpeg'?'jpg':f}`;render({exporting:true});if(f==='svg'){const data=els.canvas.toDataURL('image/png');save(new Blob([`<svg xmlns="http://www.w3.org/2000/svg" width="${state.width}" height="${state.height}" viewBox="0 0 ${state.width} ${state.height}"><image href="${esc(data)}" width="${state.width}" height="${state.height}"/></svg>`],{type:'image/svg+xml'}),name);render();return}els.canvas.toBlob(b=>{if(b)save(b,name);render()},f==='jpeg'?'image/jpeg':`image/${f}`,.94)}
    els.dropZone.addEventListener('click',()=>els.fileInput.click());els.fileInput.addEventListener('change',()=>load(els.fileInput.files?.[0]));['dragenter','dragover'].forEach(n=>els.dropZone.addEventListener(n,e=>{e.preventDefault();els.dropZone.classList.add('is-dragging')}));['dragleave','drop'].forEach(n=>els.dropZone.addEventListener(n,e=>{e.preventDefault();els.dropZone.classList.remove('is-dragging')}));els.dropZone.addEventListener('drop',e=>load(e.dataTransfer?.files?.[0]));document.addEventListener('paste',e=>{const item=Array.from(e.clipboardData?.items||[]).find(i=>i.type.startsWith('image/'));if(!item)return;e.preventDefault();load(item.getAsFile())});els.canvas.addEventListener('pointerdown',down);els.canvas.addEventListener('pointermove',move);els.canvas.addEventListener('pointerup',up);els.canvas.addEventListener('pointercancel',up);els.presetGrid.addEventListener('click',e=>{const b=e.target.closest('[data-preset]');if(!b)return;state.preset=b.dataset.preset;document.querySelectorAll('[data-preset]').forEach(i=>i.classList.toggle('active',i===b));render()});els.sizePreset.addEventListener('change',()=>{els.customSize.hidden=els.sizePreset.value!=='custom';if(els.sizePreset.value!=='custom'){const[w,h]=els.sizePreset.value.split('x').map(Number);state.width=w;state.height=h;els.canvasWidth.value=w;els.canvasHeight.value=h;if(state.image)fit('contain');render()}});[els.canvasWidth,els.canvasHeight].forEach(i=>i.addEventListener('input',()=>{state.width=clamp(Number(els.canvasWidth.value)||1200,400,4000);state.height=clamp(Number(els.canvasHeight.value)||800,300,4000);render()}));[els.imageX,els.imageY,els.imageW,els.imageH,els.rotation,els.opacity].forEach(i=>i.addEventListener('input',apply));[els.colorA,els.colorB,els.colorC,els.cardColor,els.padding,els.cardRadius,els.imageRadius,els.keepAspect,els.shadow,els.clipToCard].forEach(i=>{i.addEventListener('input',render);i.addEventListener('change',render)});els.moveTool.addEventListener('click',()=>mode('move'));els.cropTool.addEventListener('click',()=>mode('crop'));els.fitImage.addEventListener('click',()=>fit('contain'));els.fillImage.addEventListener('click',()=>fit('cover'));els.centerImage.addEventListener('click',center);els.resetImage.addEventListener('click',()=>fit('contain'));els.deleteImage.addEventListener('click',deleteCurrentImage);document.addEventListener('keydown',e=>{if(!state.image||!['Delete','Backspace'].includes(e.key))return;if(['INPUT','SELECT','TEXTAREA'].includes(document.activeElement?.tagName||''))return;e.preventDefault();deleteCurrentImage()});document.querySelectorAll('[data-download]').forEach(b=>b.addEventListener('click',()=>download(b.dataset.download)));sync();render();
  </script>
