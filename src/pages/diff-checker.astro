---
import Layout from '../layouts/Layout.astro';
import DiffCheckerTool from '../components/tools/DiffCheckerTool.astro';
import { useTranslations } from '../i18n';

const lang = 'en';
const t = useTranslations(lang);
---

<Layout
  title={t('diff.title')}
  description={t('diff.description')}
  lang={lang}
  path="/diff-checker/"
>
  <DiffCheckerTool lang={lang} />
</Layout>
