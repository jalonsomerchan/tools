---
import Layout from '../layouts/Layout.astro';
const title = 'Comparador JSON v2';
---
<Layout title={title} path="/json-compare-v2/">
<section class="p"><h1>{title}</h1><section class="tool-card"><div class="bar"><button id="go">Comparar</button><button id="ex">Ejemplo</button></div><div class="grid"><div><h2>Original</h2><div class="ed"><div id="ma" class="marks"></div><textarea id="a" wrap="off"></textarea></div></div><div><h2>Cambiado</h2><div class="ed"><div id="mb" class="marks"></div><textarea id="b" wrap="off"></textarea></div></div></div><p id="st">Listo.</p></section></section>
<style>.p{padding:2rem 0}.bar{display:flex;gap:.5rem;margin-bottom:1rem}.bar button{border-radius:999px;padding:.7rem 1rem;font-weight:900;background:var(--color-primary);color:#fff}.grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.grid>div{overflow:hidden;border-radius:1rem;background:#111827}.grid h2{margin:0;padding:.7rem 1rem;background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));color:#fff;font-size:1rem}.ed{position:relative;height:520px;background:#111827;overflow:hidden}.ed textarea{position:absolute;inset:0;z-index:2;width:100%;height:100%;border:0;background:transparent;color:#e5e7eb;padding:1rem 1.5rem;font-family:var(--font-mono);font-size:.94rem;line-height:1.55;white-space:pre;overflow:auto;resize:none}.marks{position:absolute;inset:0;z-index:1;padding-top:1rem;overflow:hidden;pointer-events:none}.m{position:relative;height:1.457rem}.m.d{background:rgba(251,191,36,.18)}.m.d:before,.m.d:after{content:'';position:absolute;top:50%;width:.65rem;height:.65rem;border-radius:999px;background:#fbbf24;border:2px solid #111827;box-shadow:0 0 0 2px rgba(251,191,36,.45);transform:translateY(-50%)}.m:before{left:.35rem}.m:after{right:.35rem}@media(max-width:900px){.grid{grid-template-columns:1fr}.ed{height:360px}}</style>
<script>window.addEventListener('DOMContentLoaded',()=>{const a=document.getElementById('a'),b=document.getElementById('b'),ma=document.getElementById('ma'),mb=document.getElementById('mb'),st=document.getElementById('st');const sync=(t,m)=>m.style.transform=`translate(${-t.scrollLeft}px,${-t.scrollTop}px)`;const row=c=>{const d=document.createElement('div');d.className='m '+c;return d};const paint=(x=[],y=[])=>{ma.innerHTML='';mb.innerHTML='';let n=Math.max(x.length,y.length,1),c=0;for(let i=0;i<n;i++){let dif=x[i]!==y[i];if(dif)c++;ma.append(row(dif?'d':''));mb.append(row(dif?'d':''))}sync(a,ma);sync(b,mb);return c};const cmp=()=>{try{let x=JSON.stringify(JSON.parse(a.value),null,2),y=JSON.stringify(JSON.parse(b.value),null,2);a.value=x;b.value=y;st.textContent=paint(x.split('\n'),y.split('\n'))?'Diferencias marcadas.':'Sin diferencias.'}catch(e){st.textContent=e.message}};document.getElementById('go').onclick=cmp;document.getElementById('ex').onclick=()=>{a.value=JSON.stringify({app:'Alon Tools',version:1,items:[1,2]},null,2);b.value=JSON.stringify({app:'Alon Toos',version:2,items:[1,3]},null,2);cmp()};[a,b].forEach(t=>{const m=t===a?ma:mb;t.addEventListener('scroll',()=>sync(t,m));t.addEventListener('input',()=>paint())});paint()});</script>
</Layout>