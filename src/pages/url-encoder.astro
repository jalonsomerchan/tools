---
import Layout from '../layouts/Layout.astro';

const title = 'URL encoder & decoder';
---

<Layout title={title}>
  <section style="padding: 4rem 0;">
    <div class="eyebrow">Alon Tools</div>

    <h1>{title}</h1>

    <p class="hero-text">
      Codifica y decodifica URLs, parámetros y cadenas especiales usando encodeURIComponent y decodeURIComponent.
    </p>

    <section class="tool-card">
      <div class="toolbar">
        <button class="primary" id="encodeBtn">Codificar</button>
        <button id="decodeBtn">Decodificar</button>
        <button id="swapBtn">Intercambiar</button>
        <button id="clearBtn">Limpiar</button>
      </div>

      <div class="editor-grid">
        <div class="panel">
          <span>Texto original</span>
          <textarea id="inputText" placeholder="https://example.com/?q=hola mundo&test=áéíóú"></textarea>
        </div>

        <div class="panel">
          <span>Resultado</span>
          <textarea id="outputText" readonly placeholder="Resultado codificado o decodificado..."></textarea>
        </div>
      </div>

      <div class="examples">
        <h2>Ejemplos útiles</h2>

        <div class="example-grid">
          <button class="example-btn" data-example="https://google.com/search?q=hola mundo">
            URL con espacios
          </button>

          <button class="example-btn" data-example="nombre=Jorge Alonso&ciudad=Móstoles">
            Parámetros GET
          </button>

          <button class="example-btn" data-example="áéíóú ñ % & ? = /">
            Caracteres especiales
          </button>
        </div>
      </div>
    </section>
  </section>

  <style>
    .toolbar {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    button {
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      cursor: pointer;
      font: inherit;
    }

    button.primary {
      background: var(--primary);
      color: black;
      border: none;
      font-weight: 700;
    }

    .editor-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit,minmax(320px,1fr));
      gap: 1rem;
    }

    .panel {
      display: flex;
      flex-direction: column;
      gap: .6rem;
    }

    .panel span {
      color: var(--muted);
      font-size: .92rem;
    }

    textarea {
      min-height: 320px;
      border-radius: 24px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      resize: vertical;
      font-family: ui-monospace, monospace;
      line-height: 1.7;
    }

    .examples {
      margin-top: 1.5rem;
      border-radius: 24px;
      border: 1px solid var(--border);
      background: rgba(2,6,23,.55);
      padding: 1rem;
    }

    .examples h2 {
      margin-top: 0;
      font-size: 1.1rem;
    }

    .example-grid {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .example-btn {
      background: rgba(148,163,184,.08);
    }
  </style>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('inputText');
      const output = document.getElementById('outputText');

      document.getElementById('encodeBtn').onclick = () => {
        try {
          output.value = encodeURIComponent(input.value);
        } catch {
          alert('No se pudo codificar');
        }
      };

      document.getElementById('decodeBtn').onclick = () => {
        try {
          output.value = decodeURIComponent(input.value);
        } catch {
          alert('No se pudo decodificar');
        }
      };

      document.getElementById('swapBtn').onclick = () => {
        const temp = input.value;
        input.value = output.value;
        output.value = temp;
      };

      document.getElementById('clearBtn').onclick = () => {
        input.value = '';
        output.value = '';
      };

      document.querySelectorAll('.example-btn').forEach((button) => {
        button.onclick = () => {
          input.value = button.dataset.example;
        };
      });
    });
  </script>
</Layout>
