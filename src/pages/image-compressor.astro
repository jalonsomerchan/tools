---
import Layout from '../layouts/Layout.astro';

const title = 'Compresor de imágenes';
---

<Layout title={title}>
  <section style="padding: 4rem 0;">
    <div class="eyebrow">Alon Tools</div>

    <h1>{title}</h1>

    <p class="hero-text">
      Reduce el peso de imágenes directamente desde el navegador ajustando calidad, formato y tamaño.
    </p>

    <section class="tool-card">
      <div class="controls">
        <label class="upload-btn">
          Seleccionar imagen
          <input id="fileInput" type="file" accept="image/*" hidden />
        </label>

        <label>
          Calidad
          <input id="quality" type="range" min="10" max="100" value="80" />
        </label>

        <label>
          Ancho máximo
          <input id="maxWidth" type="number" value="1920" min="100" max="8000" />
        </label>

        <label>
          Formato
          <select id="format">
            <option value="image/jpeg">JPEG</option>
            <option value="image/webp">WebP</option>
            <option value="image/png">PNG</option>
          </select>
        </label>

        <button class="primary" id="compressBtn">Comprimir</button>
      </div>

      <div class="preview-grid" id="previewGrid" hidden>
        <div class="preview-card">
          <span>Original</span>
          <img id="originalPreview" />
          <small id="originalInfo"></small>
        </div>

        <div class="preview-card">
          <span>Comprimida</span>
          <img id="compressedPreview" />
          <small id="compressedInfo"></small>
          <button id="downloadBtn">Descargar imagen</button>
        </div>
      </div>

      <div class="stats" id="stats" hidden>
        <div class="stat-card">
          <span>Reducción</span>
          <strong id="reduction">-</strong>
        </div>

        <div class="stat-card">
          <span>Ahorro</span>
          <strong id="savedBytes">-</strong>
        </div>
      </div>
    </section>
  </section>

  <style>
    .controls {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      align-items: end;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: .45rem;
      color: var(--muted);
      font-size: .92rem;
    }

    .upload-btn,
    button,
    input,
    select {
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      font: inherit;
    }

    .upload-btn,
    button {
      cursor: pointer;
    }

    .primary,
    .upload-btn {
      background: var(--primary);
      color: black;
      border: none;
      font-weight: 700;
    }

    .preview-grid {
      margin-top: 2rem;
      display: grid;
      grid-template-columns: repeat(auto-fit,minmax(320px,1fr));
      gap: 1rem;
    }

    .preview-card,
    .stat-card {
      border-radius: 24px;
      border: 1px solid var(--border);
      background: rgba(2,6,23,.55);
      padding: 1rem;
    }

    .preview-card {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .preview-card span {
      color: var(--muted);
    }

    .preview-card img {
      width: 100%;
      max-height: 420px;
      object-fit: contain;
      border-radius: 18px;
      background: #000;
    }

    .preview-card small {
      color: var(--muted);
      line-height: 1.6;
    }

    .stats {
      margin-top: 1rem;
      display: grid;
      grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
      gap: 1rem;
    }

    .stat-card {
      display: flex;
      flex-direction: column;
      gap: .45rem;
    }

    .stat-card span {
      color: var(--muted);
      font-size: .92rem;
    }
  </style>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const fileInput = document.getElementById('fileInput');
      let currentFile = null;
      let compressedBlob = null;

      const formatBytes = (bytes) => {
        if (!bytes) return '0 B';

        const sizes = ['B', 'KB', 'MB'];
        const i = Math.floor(Math.log(bytes) / Math.log(1024));

        return `${(bytes / Math.pow(1024, i)).toFixed(2)} ${sizes[i]}`;
      };

      fileInput.addEventListener('change', () => {
        currentFile = fileInput.files[0];

        if (!currentFile) return;

        document.getElementById('previewGrid').hidden = false;
        document.getElementById('originalPreview').src = URL.createObjectURL(currentFile);
        document.getElementById('originalInfo').textContent = `${currentFile.name} · ${formatBytes(currentFile.size)}`;
      });

      document.getElementById('compressBtn').onclick = async () => {
        if (!currentFile) {
          alert('Selecciona una imagen');
          return;
        }

        const quality = Number(document.getElementById('quality').value) / 100;
        const maxWidth = Number(document.getElementById('maxWidth').value);
        const format = document.getElementById('format').value;

        const image = new Image();

        image.onload = () => {
          const ratio = Math.min(1, maxWidth / image.width);

          const canvas = document.createElement('canvas');
          canvas.width = Math.round(image.width * ratio);
          canvas.height = Math.round(image.height * ratio);

          const ctx = canvas.getContext('2d');
          ctx.drawImage(image, 0, 0, canvas.width, canvas.height);

          canvas.toBlob((blob) => {
            compressedBlob = blob;

            const compressedUrl = URL.createObjectURL(blob);

            document.getElementById('compressedPreview').src = compressedUrl;
            document.getElementById('compressedInfo').textContent = `${formatBytes(blob.size)} · ${canvas.width}x${canvas.height}`;

            document.getElementById('stats').hidden = false;

            const reduction = 100 - ((blob.size / currentFile.size) * 100);
            const saved = currentFile.size - blob.size;

            document.getElementById('reduction').textContent = `${reduction.toFixed(1)}%`;
            document.getElementById('savedBytes').textContent = formatBytes(saved);
          }, format, quality);
        };

        image.src = URL.createObjectURL(currentFile);
      };

      document.getElementById('downloadBtn').onclick = () => {
        if (!compressedBlob) return;

        const format = document.getElementById('format').value;
        const extension = format.split('/')[1];

        const link = document.createElement('a');
        link.href = URL.createObjectURL(compressedBlob);
        link.download = `compressed.${extension}`;
        link.click();
      };
    });
  </script>
</Layout>
