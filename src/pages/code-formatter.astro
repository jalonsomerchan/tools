---
import Layout from '../layouts/Layout.astro';

const title = 'Minificador y formateador de HTML, CSS y JS';
const description = 'Formatea y minifica snippets de HTML, CSS y JavaScript localmente en el navegador, sin ejecutar el código.';
---

<Layout title={title} description={description} path="/code-formatter/" translated={false}>
  <section class="code-page">
    <div class="eyebrow">100% local</div>

    <h1>{title}</h1>

    <p class="hero-text">
      Pega fragmentos de HTML, CSS o JavaScript para formatearlos o minificarlos. El código no se ejecuta ni se envía a ningún servidor.
    </p>

    <section class="tool-card" aria-labelledby="settingsTitle">
      <div class="section-heading">
        <div>
          <h2 id="settingsTitle">Configuración</h2>
          <p>Las reglas son conservadoras, especialmente en JavaScript, para evitar cambios peligrosos.</p>
        </div>
      </div>

      <div class="controls-grid">
        <div class="field">
          <label for="languageSelect">Tipo</label>
          <select id="languageSelect">
            <option value="html">HTML</option>
            <option value="css">CSS</option>
            <option value="js">JavaScript</option>
          </select>
        </div>

        <div class="field">
          <label for="indentSelect">Indentación</label>
          <select id="indentSelect">
            <option value="2">2 espacios</option>
            <option value="4">4 espacios</option>
            <option value="tab">Tabulador</option>
          </select>
        </div>

        <div class="field stats-field">
          <span>Tamaño original</span>
          <strong id="originalSize">0 B</strong>
        </div>

        <div class="field stats-field">
          <span>Tamaño final</span>
          <strong id="finalSize">0 B</strong>
        </div>

        <div class="field stats-field">
          <span>Reducción</span>
          <strong id="reduction">0%</strong>
        </div>
      </div>

      <div class="toolbar" aria-label="Acciones de código">
        <button class="primary" id="formatBtn" type="button">Formatear</button>
        <button id="minifyBtn" type="button">Minificar</button>
        <button id="copyBtn" type="button">Copiar resultado</button>
        <button id="downloadBtn" type="button">Descargar</button>
        <button id="swapBtn" type="button">Pasar salida a entrada</button>
        <button id="clearBtn" type="button">Limpiar</button>
      </div>

      <p class="status" id="status" role="status" aria-live="polite">Listo para procesar código localmente.</p>
    </section>

    <section class="workspace" aria-label="Entrada y salida">
      <div class="editor-panel">
        <div class="panel-heading">
          <h2>Entrada</h2>
        </div>
        <textarea id="input" spellcheck="false" placeholder="Pega aquí tu HTML, CSS o JavaScript..."><div class="card"><h2>Hola mundo</h2><p>Texto de ejemplo</p></div></textarea>
      </div>

      <div class="editor-panel">
        <div class="panel-heading">
          <h2>Salida</h2>
        </div>
        <textarea id="output" readonly spellcheck="false" placeholder="Aquí aparecerá el resultado..."></textarea>
      </div>
    </section>
  </section>

  <style>
    .code-page {
      padding: 4rem 0;
    }

    .section-heading,
    .panel-heading {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    h2 {
      margin: 0 0 .35rem;
      font-size: 1.25rem;
    }

    .section-heading p {
      margin: 0;
      color: var(--muted);
      line-height: 1.7;
    }

    .controls-grid {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
      align-items: end;
    }

    label {
      display: block;
      margin-bottom: .55rem;
      font-weight: 700;
    }

    select,
    textarea {
      width: 100%;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      font: inherit;
    }

    .stats-field {
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #020617;
      padding: .85rem 1rem;
    }

    .stats-field span {
      display: block;
      color: var(--muted);
      font-size: .86rem;
      margin-bottom: .25rem;
    }

    .stats-field strong {
      color: white;
      font-size: 1.05rem;
    }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: .8rem;
      margin-top: 1rem;
    }

    button {
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #0f172a;
      color: white;
      padding: .95rem 1rem;
      cursor: pointer;
      font-weight: 700;
      transition: transform .15s ease, border-color .15s ease, opacity .15s ease;
    }

    button:hover:not(:disabled) {
      transform: translateY(-1px);
      border-color: rgba(56,189,248,.45);
    }

    button.primary {
      background: var(--primary);
      color: #020617;
      border-color: transparent;
    }

    .status {
      color: var(--muted);
      margin: 1rem 0 0;
      line-height: 1.7;
    }

    .status.success {
      color: #86efac;
    }

    .status.error {
      color: #fca5a5;
    }

    .status.warning {
      color: #fde68a;
    }

    .workspace {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }

    .editor-panel {
      padding: 1.5rem;
      border-radius: 24px;
      border: 1px solid var(--border);
      background: var(--card);
      min-width: 0;
    }

    textarea {
      min-height: 520px;
      resize: vertical;
      line-height: 1.6;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      color: var(--muted);
      tab-size: 2;
    }

    #output {
      color: var(--text);
    }

    @media (max-width: 1050px) {
      .controls-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 860px) {
      .workspace {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .controls-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    const languageSelect = document.getElementById('languageSelect') as HTMLSelectElement;
    const indentSelect = document.getElementById('indentSelect') as HTMLSelectElement;
    const input = document.getElementById('input') as HTMLTextAreaElement;
    const output = document.getElementById('output') as HTMLTextAreaElement;
    const status = document.getElementById('status') as HTMLParagraphElement;
    const originalSize = document.getElementById('originalSize') as HTMLElement;
    const finalSize = document.getElementById('finalSize') as HTMLElement;
    const reduction = document.getElementById('reduction') as HTMLElement;
    const formatBtn = document.getElementById('formatBtn') as HTMLButtonElement;
    const minifyBtn = document.getElementById('minifyBtn') as HTMLButtonElement;
    const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement;
    const downloadBtn = document.getElementById('downloadBtn') as HTMLButtonElement;
    const swapBtn = document.getElementById('swapBtn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clearBtn') as HTMLButtonElement;

    const sampleByType = {
      html: '<div class="card"><h2>Hola mundo</h2><p>Texto de ejemplo</p></div>',
      css: '.card{display:flex;gap:1rem;color:#fff}.card h2{margin:0}',
      js: 'function greet(name){ const text = "Hola " + name; console.log(text); return text; }'
    };

    const setStatus = (message: string, type: 'default' | 'success' | 'error' | 'warning' = 'default') => {
      status.textContent = message;
      status.classList.toggle('success', type === 'success');
      status.classList.toggle('error', type === 'error');
      status.classList.toggle('warning', type === 'warning');
    };

    const getIndent = () => indentSelect.value === 'tab' ? '\t' : ' '.repeat(Number(indentSelect.value));

    const formatBytes = (text: string) => {
      const bytes = new TextEncoder().encode(text).length;
      if (bytes < 1024) return `${bytes} B`;
      return `${(bytes / 1024).toFixed(1)} KB`;
    };

    const updateStats = () => {
      const originalBytes = new TextEncoder().encode(input.value).length;
      const finalBytes = new TextEncoder().encode(output.value).length;
      originalSize.textContent = formatBytes(input.value);
      finalSize.textContent = formatBytes(output.value);

      if (!originalBytes || !finalBytes) {
        reduction.textContent = '0%';
        return;
      }

      reduction.textContent = `${Math.round(((originalBytes - finalBytes) / originalBytes) * 100)}%`;
    };

    const stripHtmlComments = (code: string) => code.replace(/<!--[\s\S]*?-->/g, '');

    const minifyHtml = (code: string) => stripHtmlComments(code)
      .replace(/>\s+</g, '><')
      .replace(/\s{2,}/g, ' ')
      .trim();

    const formatHtml = (code: string) => {
      const indent = getIndent();
      const tokens = minifyHtml(code).replace(/></g, '>\n<').split('\n');
      let level = 0;

      return tokens.map((rawToken) => {
        const token = rawToken.trim();
        if (!token) return '';

        const isClosing = /^<\//.test(token);
        const isSelfClosing = /\/>$/.test(token) || /^<(area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)(\s|>|\/)/i.test(token);
        const isOpening = /^<[^!?/][^>]*>$/.test(token) && !isSelfClosing;

        if (isClosing) level = Math.max(0, level - 1);
        const line = `${indent.repeat(level)}${token}`;
        if (isOpening) level += 1;
        return line;
      }).filter(Boolean).join('\n');
    };

    const stripCssComments = (code: string) => code.replace(/\/\*[\s\S]*?\*\//g, '');

    const minifyCss = (code: string) => stripCssComments(code)
      .replace(/\s+/g, ' ')
      .replace(/\s*([{}:;,>+~])\s*/g, '$1')
      .replace(/;}/g, '}')
      .trim();

    const formatCss = (code: string) => {
      const indent = getIndent();
      let formatted = minifyCss(code)
        .replace(/\{/g, ' {\n')
        .replace(/;/g, ';\n')
        .replace(/\}/g, '\n}\n')
        .replace(/\n\s*\n/g, '\n');

      let level = 0;
      formatted = formatted.split('\n').map((line) => {
        const trimmed = line.trim();
        if (!trimmed) return '';
        if (trimmed.startsWith('}')) level = Math.max(0, level - 1);
        const outputLine = `${indent.repeat(level)}${trimmed}`;
        if (trimmed.endsWith('{')) level += 1;
        return outputLine;
      }).filter(Boolean).join('\n');

      return formatted;
    };

    const stripJsCommentsSafely = (code: string) => {
      let result = '';
      let state = 'normal';

      for (let i = 0; i < code.length; i += 1) {
        const char = code[i];
        const next = code[i + 1];
        const prev = code[i - 1];

        if (state === 'normal') {
          if (char === '"') state = 'double';
          else if (char === "'") state = 'single';
          else if (char === '`') state = 'template';
          else if (char === '/' && next === '/') {
            while (i < code.length && code[i] !== '\n') i += 1;
            result += '\n';
            continue;
          } else if (char === '/' && next === '*') {
            i += 2;
            while (i < code.length && !(code[i] === '*' && code[i + 1] === '/')) i += 1;
            i += 1;
            continue;
          }
        } else if (state === 'double' && char === '"' && prev !== '\\') {
          state = 'normal';
        } else if (state === 'single' && char === "'" && prev !== '\\') {
          state = 'normal';
        } else if (state === 'template' && char === '`' && prev !== '\\') {
          state = 'normal';
        }

        result += char;
      }

      return result;
    };

    const minifyJs = (code: string) => stripJsCommentsSafely(code)
      .replace(/\s+/g, ' ')
      .replace(/\s*([{}();,:=+\-*/<>\[\]])\s*/g, '$1')
      .trim();

    const formatJs = (code: string) => {
      const indent = getIndent();
      const compact = stripJsCommentsSafely(code)
        .replace(/\s+/g, ' ')
        .replace(/\s*([{};])\s*/g, '$1\n')
        .replace(/\n+/g, '\n')
        .trim();
      let level = 0;

      return compact.split('\n').map((line) => {
        const trimmed = line.trim();
        if (!trimmed) return '';
        if (trimmed.startsWith('}')) level = Math.max(0, level - 1);
        const outputLine = `${indent.repeat(level)}${trimmed}`;
        if (trimmed.endsWith('{')) level += 1;
        return outputLine;
      }).filter(Boolean).join('\n');
    };

    const processCode = (action: 'format' | 'minify') => {
      const code = input.value;
      const type = languageSelect.value;

      if (!code.trim()) {
        setStatus('Pega código antes de procesarlo.', 'error');
        output.value = '';
        updateStats();
        return;
      }

      try {
        if (type === 'html') output.value = action === 'format' ? formatHtml(code) : minifyHtml(code);
        if (type === 'css') output.value = action === 'format' ? formatCss(code) : minifyCss(code);
        if (type === 'js') output.value = action === 'format' ? formatJs(code) : minifyJs(code);

        updateStats();

        if (type === 'js' && action === 'minify') {
          setStatus('JavaScript minificado con reglas conservadoras. Revisa el resultado antes de usarlo en producción.', 'warning');
          return;
        }

        setStatus(action === 'format' ? 'Código formateado correctamente.' : 'Código minificado correctamente.', 'success');
      } catch {
        setStatus('No se pudo procesar el código. Revisa que el fragmento sea válido.', 'error');
      }
    };

    const extensionForType = () => {
      if (languageSelect.value === 'html') return 'html';
      if (languageSelect.value === 'css') return 'css';
      return 'js';
    };

    formatBtn.addEventListener('click', () => processCode('format'));
    minifyBtn.addEventListener('click', () => processCode('minify'));

    languageSelect.addEventListener('change', () => {
      input.value = sampleByType[languageSelect.value as keyof typeof sampleByType];
      output.value = '';
      updateStats();
      setStatus('Tipo cambiado. Puedes formatear o minificar el nuevo snippet.');
    });

    input.addEventListener('input', updateStats);
    output.addEventListener('input', updateStats);

    copyBtn.addEventListener('click', async () => {
      if (!output.value) {
        setStatus('No hay resultado para copiar.', 'error');
        return;
      }

      try {
        await navigator.clipboard.writeText(output.value);
        setStatus('Resultado copiado.', 'success');
      } catch {
        setStatus('No se pudo copiar el resultado.', 'error');
      }
    });

    downloadBtn.addEventListener('click', () => {
      if (!output.value) {
        setStatus('No hay resultado para descargar.', 'error');
        return;
      }

      const extension = extensionForType();
      const blob = new Blob([output.value], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `codigo.${extension}`;
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      setStatus('Archivo descargado.', 'success');
    });

    swapBtn.addEventListener('click', () => {
      if (!output.value) {
        setStatus('No hay salida para pasar a entrada.', 'error');
        return;
      }

      input.value = output.value;
      output.value = '';
      updateStats();
      setStatus('Salida movida a entrada.');
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      output.value = '';
      updateStats();
      setStatus('Contenido limpiado.');
    });

    updateStats();
  </script>
</Layout>
