---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const es = lang === 'es';
const title = es ? 'Editor Markdown con vista previa' : 'Markdown editor with live preview';
const description = es ? 'Escribe Markdown, previsualiza títulos, listas, tablas y código y descarga el resultado localmente, sin CDNs ni subir contenido.' : 'Write Markdown, preview headings, lists, tables and code, and download it locally without CDNs or content uploads.';
---

<Layout title={`${title} — Alon Tools`} description={description} lang={lang} path="/markdown-preview/" translated={true}>
  <section style="padding: 4rem 0;">
    <div class="eyebrow">Alon Tools</div>

    <h1>{title}</h1>

    <p class="hero-text">
      {es ? 'Escribe Markdown y visualiza el resultado en tiempo real con soporte para títulos, tablas, listas, bloques de código y más.' : 'Write Markdown and preview the result in real time with headings, tables, lists, code blocks and more.'}
    </p>

    <section class="tool-card">
      <div class="toolbar">
        <button class="primary" id="copyBtn">{es ? 'Copiar Markdown' : 'Copy Markdown'}</button>
        <button id="downloadBtn">{es ? 'Descargar .md' : 'Download .md'}</button>
        <button id="clearBtn">{es ? 'Limpiar' : 'Clear'}</button>
      </div>

      <div class="editor-grid">
        <div class="panel">
          <span>Markdown</span>
          <textarea id="markdownInput"># Hola mundo

Escribe aquí tu markdown.

## Lista

- Uno
- Dos
- Tres

```js
console.log('Hola');
```

| Nombre | Valor |
|---|---|
| Test | 123 |
</textarea>
        </div>

        <div class="panel">
          <span>{es ? 'Vista previa' : 'Preview'}</span>
          <div id="preview"></div>
        </div>
      </div>
    </section>
  </section>

  <style>
    .toolbar {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    button {
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      cursor: pointer;
      font: inherit;
    }

    button.primary {
      background: var(--primary);
      color: black;
      border: none;
      font-weight: 700;
    }

    .editor-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit,minmax(320px,1fr));
      gap: 1rem;
    }

    .panel {
      display: flex;
      flex-direction: column;
      gap: .6rem;
    }

    .panel span {
      color: var(--muted);
      font-size: .92rem;
    }

    textarea,
    #preview {
      min-height: 620px;
      border-radius: 24px;
      border: 1px solid var(--border);
      padding: 1.2rem;
      overflow: auto;
    }

    textarea {
      resize: vertical;
      color: #f8fafc;
      font-family: ui-monospace, monospace;
      line-height: 1.7;
      background: #020617;
    }

    #preview {
      background: #ffffff;
      color: #1f2937;
      line-height: 1.75;
      box-shadow: inset 0 0 0 1px rgba(15, 23, 42, .035);
    }

    #preview :first-child {
      margin-top: 0;
    }

    #preview h1,
    #preview h2,
    #preview h3 {
      color: #111827;
      margin-top: 1.35rem;
      margin-bottom: .65rem;
      line-height: 1.15;
      letter-spacing: -.035em;
    }

    #preview h1 {
      font-size: clamp(2rem, 4vw, 3.2rem);
    }

    #preview h2 {
      font-size: clamp(1.45rem, 2.5vw, 2rem);
    }

    #preview h3 {
      font-size: 1.25rem;
    }

    #preview p,
    #preview li {
      color: #374151;
    }

    #preview ul,
    #preview ol {
      color: #374151;
      padding-left: 1.4rem;
    }

    #preview li::marker {
      color: var(--primary);
    }

    #preview code {
      background: #f1f5f9;
      color: #be123c;
      padding: .18rem .38rem;
      border-radius: 7px;
      font-family: ui-monospace, monospace;
      font-size: .92em;
    }

    #preview pre {
      background: #0f172a;
      color: #e5e7eb;
      border: 1px solid #1e293b;
      padding: 1rem;
      border-radius: 18px;
      overflow-x: auto;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.04);
    }

    #preview pre code {
      background: transparent;
      color: inherit;
      padding: 0;
      border-radius: 0;
    }

    #preview table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 1rem;
      overflow: hidden;
      border-radius: 14px;
    }

    #preview th,
    #preview td {
      border: 1px solid #dbe1ea;
      padding: .7rem;
      text-align: left;
      color: #1f2937;
    }

    #preview th {
      background: #f8fafc;
      color: #111827;
      font-weight: 900;
    }

    #preview tr:nth-child(even) td {
      background: #fbfdff;
    }

    #preview blockquote {
      border-left: 4px solid var(--primary);
      margin-left: 0;
      padding: .8rem 1rem;
      border-radius: 0 14px 14px 0;
      background: #fff7f5;
      color: #4b5563;
    }

    #preview a {
      color: #dd3427;
      font-weight: 800;
    }

    [data-theme='dark'] #preview {
      background: #0f172a;
      color: #e5e7eb;
      border-color: #334155;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,.03);
    }

    [data-theme='dark'] #preview h1,
    [data-theme='dark'] #preview h2,
    [data-theme='dark'] #preview h3 {
      color: #f8fafc;
    }

    [data-theme='dark'] #preview p,
    [data-theme='dark'] #preview li,
    [data-theme='dark'] #preview ul,
    [data-theme='dark'] #preview ol {
      color: #cbd5e1;
    }

    [data-theme='dark'] #preview code {
      background: rgba(148,163,184,.16);
      color: #fda4af;
    }

    [data-theme='dark'] #preview pre {
      background: #020617;
      border-color: #334155;
      color: #f8fafc;
    }

    [data-theme='dark'] #preview pre code {
      background: transparent;
      color: inherit;
    }

    [data-theme='dark'] #preview th,
    [data-theme='dark'] #preview td {
      border-color: #334155;
      color: #e5e7eb;
    }

    [data-theme='dark'] #preview th {
      background: #1e293b;
      color: #f8fafc;
    }

    [data-theme='dark'] #preview tr:nth-child(even) td {
      background: rgba(30,41,59,.5);
    }

    [data-theme='dark'] #preview blockquote {
      background: rgba(249,115,22,.12);
      color: #cbd5e1;
    }

    [data-theme='dark'] #preview a {
      color: #fdba74;
    }
  </style>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const input = document.getElementById('markdownInput');
      const preview = document.getElementById('preview');

      const escapeHtml = (value) => value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
      const inline = (value) => escapeHtml(value)
        .replace(/`([^`]+)`/g, '<code>$1</code>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/\*([^*]+)\*/g, '<em>$1</em>')
        .replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, label, href) => {
          const safeHref = /^(https?:\/\/|\/)/i.test(href) ? href : '#';
          return `<a href="${safeHref}"${safeHref.startsWith('http') ? ' target="_blank" rel="noopener noreferrer"' : ''}>${label}</a>`;
        });

      const parseMarkdown = (markdown) => {
        const lines = markdown.replace(/\r\n?/g, '\n').split('\n');
        const html = [];
        let index = 0;
        while (index < lines.length) {
          const line = lines[index];
          if (!line.trim()) { index += 1; continue; }
          if (line.startsWith('```')) {
            const language = escapeHtml(line.slice(3).trim());
            const code = [];
            index += 1;
            while (index < lines.length && !lines[index].startsWith('```')) code.push(lines[index++]);
            index += 1;
            html.push(`<pre><code${language ? ` class="language-${language}"` : ''}>${escapeHtml(code.join('\n'))}</code></pre>`);
            continue;
          }
          const heading = line.match(/^(#{1,6})\s+(.+)$/);
          if (heading) { const level = heading[1].length; html.push(`<h${level}>${inline(heading[2])}</h${level}>`); index += 1; continue; }
          if (line.startsWith('> ')) { html.push(`<blockquote>${inline(line.slice(2))}</blockquote>`); index += 1; continue; }
          if (index + 1 < lines.length && line.includes('|') && /^\s*\|?\s*:?-{3,}/.test(lines[index + 1])) {
            const cells = (row) => row.replace(/^\||\|$/g, '').split('|').map((cell) => cell.trim());
            const headers = cells(line);
            index += 2;
            const rows = [];
            while (index < lines.length && lines[index].includes('|') && lines[index].trim()) rows.push(cells(lines[index++]));
            html.push(`<table><thead><tr>${headers.map((cell) => `<th>${inline(cell)}</th>`).join('')}</tr></thead><tbody>${rows.map((row) => `<tr>${row.map((cell) => `<td>${inline(cell)}</td>`).join('')}</tr>`).join('')}</tbody></table>`);
            continue;
          }
          if (/^[-*+]\s+/.test(line)) {
            const items = [];
            while (index < lines.length && /^[-*+]\s+/.test(lines[index])) items.push(lines[index++].replace(/^[-*+]\s+/, ''));
            html.push(`<ul>${items.map((item) => `<li>${inline(item)}</li>`).join('')}</ul>`);
            continue;
          }
          if (/^\d+\.\s+/.test(line)) {
            const items = [];
            while (index < lines.length && /^\d+\.\s+/.test(lines[index])) items.push(lines[index++].replace(/^\d+\.\s+/, ''));
            html.push(`<ol>${items.map((item) => `<li>${inline(item)}</li>`).join('')}</ol>`);
            continue;
          }
          const paragraph = [line];
          index += 1;
          while (index < lines.length && lines[index].trim() && !/^(#{1,6})\s|^```|^[-*+]\s|^\d+\.\s|^>\s/.test(lines[index])) paragraph.push(lines[index++]);
          html.push(`<p>${inline(paragraph.join(' '))}</p>`);
        }
        return html.join('');
      };

      const render = () => {
        preview.innerHTML = parseMarkdown(input.value);
      };

      render();

      input.addEventListener('input', render);

      document.getElementById('copyBtn').onclick = async () => {
        await navigator.clipboard.writeText(input.value);
      };

      document.getElementById('clearBtn').onclick = () => {
        input.value = '';
        render();
      };

      document.getElementById('downloadBtn').onclick = () => {
        const blob = new Blob([input.value], { type: 'text/markdown' });
        const url = URL.createObjectURL(blob);

        const link = document.createElement('a');
        link.href = url;
        link.download = 'document.md';
        link.click();
      };
    });
  </script>
</Layout>
