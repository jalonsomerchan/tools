---
import NewUtilityPage from '../components/NewUtilityPage.astro';
import { newUtilitySlugs } from '../data/new-utilities';
import ExtraUtilityPage from '../components/ExtraUtilityPage.astro';
import { extraUtilitySlugs } from '../data/extra-utilities';
export function getStaticPaths(){return [...newUtilitySlugs,...extraUtilitySlugs].map((utility)=>({params:{utility},props:{utility}}));}
const utility=Astro.props.utility;
const isExtra=extraUtilitySlugs.includes(utility);
---
{isExtra ? <ExtraUtilityPage slug={utility} /> : <NewUtilityPage slug={utility} />}
