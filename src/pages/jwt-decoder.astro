---
import Layout from '../layouts/Layout.astro';
import ToolMessage from '../components/ToolMessage.astro';

const title = 'JWT decoder';
---

<Layout title={title}>
  <section style="padding: 4rem 0;">
    <div class="eyebrow">Alon Tools</div>

    <h1>{title}</h1>

    <p class="hero-text">
      Decodifica tokens JWT directamente desde el navegador y visualiza header, payload y fechas importantes.
    </p>

    <div class="warning-box">
      ⚠️ El token JWT se procesa localmente en tu navegador. No se valida la firma.
    </div>

    <section class="tool-card">
      <div class="toolbar">
        <button type="button" class="primary" id="decodeBtn">Decodificar JWT</button>
        <button type="button" id="clearBtn">Limpiar</button>
        <button type="button" id="exampleBtn">Cargar ejemplo</button>
      </div>

      <textarea id="jwtInput" aria-label="Token JWT" aria-describedby="jwtMessage" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."></textarea>
      <ToolMessage id="jwtMessage" type="error" />

      <div class="results-grid" id="results" hidden>
        <div class="result-panel">
          <h2>Header</h2>
          <pre id="headerOutput"></pre>
        </div>

        <div class="result-panel">
          <h2>Payload</h2>
          <pre id="payloadOutput"></pre>
        </div>
      </div>

      <div class="meta-grid" id="metaGrid" hidden>
        <div class="meta-card">
          <span>Algoritmo</span>
          <strong id="algorithm">-</strong>
        </div>

        <div class="meta-card">
          <span>Emitido</span>
          <strong id="issuedAt">-</strong>
        </div>

        <div class="meta-card">
          <span>Expira</span>
          <strong id="expiresAt">-</strong>
        </div>

        <div class="meta-card">
          <span>Issuer</span>
          <strong id="issuer">-</strong>
        </div>
      </div>
    </section>
  </section>

  <style>
    .warning-box {
      margin-top: 1.5rem;
      margin-bottom: 2rem;
      padding: 1rem 1.2rem;
      border-radius: 18px;
      background: rgba(251,191,36,.12);
      border: 1px solid rgba(251,191,36,.25);
      color: #fde68a;
      line-height: 1.7;
    }

    .toolbar {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    button {
      border-radius: 14px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      cursor: pointer;
      font: inherit;
    }

    button.primary {
      background: var(--primary);
      color: black;
      border: none;
      font-weight: 700;
    }

    textarea {
      width: 100%;
      min-height: 180px;
      border-radius: 24px;
      border: 1px solid var(--border);
      background: #020617;
      color: white;
      padding: 1rem;
      resize: vertical;
      font-family: ui-monospace, monospace;
      line-height: 1.7;
    }

    textarea[aria-invalid='true'] {
      border-color: rgba(248, 113, 113, .8);
    }

    .results-grid {
      margin-top: 1.5rem;
      display: grid;
      grid-template-columns: repeat(auto-fit,minmax(320px,1fr));
      gap: 1rem;
    }

    .result-panel,
    .meta-card {
      border-radius: 24px;
      border: 1px solid var(--border);
      background: rgba(2,6,23,.55);
      padding: 1rem;
    }

    .result-panel h2 {
      margin-top: 0;
      font-size: 1.1rem;
    }

    pre {
      white-space: pre-wrap;
      word-break: break-word;
      overflow-x: auto;
      line-height: 1.6;
      color: var(--muted);
      font-family: ui-monospace, monospace;
    }

    .meta-grid {
      margin-top: 1rem;
      display: grid;
      grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
      gap: 1rem;
    }

    .meta-card {
      display: flex;
      flex-direction: column;
      gap: .45rem;
    }

    .meta-card span {
      color: var(--muted);
      font-size: .92rem;
    }
  </style>

  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const jwtInput = document.getElementById('jwtInput');
      const message = document.getElementById('jwtMessage');

      const showError = (text) => {
        message.textContent = text;
        message.hidden = false;
        jwtInput.setAttribute('aria-invalid', 'true');
      };

      const clearError = () => {
        message.textContent = '';
        message.hidden = true;
        jwtInput.removeAttribute('aria-invalid');
      };

      const decodeBase64Url = (str) => {
        str = str.replace(/-/g, '+').replace(/_/g, '/');

        while (str.length % 4) {
          str += '=';
        }

        return decodeURIComponent(
          atob(str)
            .split('')
            .map((c) => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2))
            .join('')
        );
      };

      const formatDate = (timestamp) => {
        if (!timestamp) return '-';
        return new Date(timestamp * 1000).toLocaleString();
      };

      document.getElementById('decodeBtn').onclick = () => {
        try {
          clearError();
          const token = jwtInput.value.trim();
          const parts = token.split('.');

          if (!token) {
            throw new Error('empty');
          }

          if (parts.length < 2) {
            throw new Error('format');
          }

          const header = JSON.parse(decodeBase64Url(parts[0]));
          const payload = JSON.parse(decodeBase64Url(parts[1]));

          document.getElementById('results').hidden = false;
          document.getElementById('metaGrid').hidden = false;

          document.getElementById('headerOutput').textContent = JSON.stringify(header, null, 2);
          document.getElementById('payloadOutput').textContent = JSON.stringify(payload, null, 2);

          document.getElementById('algorithm').textContent = header.alg || '-';
          document.getElementById('issuedAt').textContent = formatDate(payload.iat);
          document.getElementById('expiresAt').textContent = formatDate(payload.exp);
          document.getElementById('issuer').textContent = payload.iss || '-';
        } catch (error) {
          document.getElementById('results').hidden = true;
          document.getElementById('metaGrid').hidden = true;

          if (error instanceof Error && error.message === 'empty') {
            showError('El campo JWT está vacío. Pega un token con formato header.payload.signature.');
            return;
          }

          showError('No se pudo decodificar el JWT. Revisa que tenga formato header.payload.signature y que header y payload sean JSON válidos en Base64URL.');
        }
      };

      jwtInput.addEventListener('input', clearError);

      document.getElementById('clearBtn').onclick = () => {
        jwtInput.value = '';
        clearError();
        document.getElementById('results').hidden = true;
        document.getElementById('metaGrid').hidden = true;
      };

      document.getElementById('exampleBtn').onclick = () => {
        jwtInput.value = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkFs b24gVG9vbHMiLCJpYXQiOjE1MTYyMzkwMjIsImV4cCI6MjUxNjIzOTAyMiwiaXNzIjoiYWxvbi5vbmUifQ.signature'.replace(/ /g, '');
        clearError();
      };
    });
  </script>
</Layout>
