---
import Layout from '../../layouts/Layout.astro';

const categories = [
  {
    title: 'Desarrollo',
    items: [
      ['Formateador HTML/CSS/JS', 'Formatea y minifica snippets de código localmente.', '/code-formatter/', 'CODE'],
      ['Formateador SQL', 'Formatea, minifica y exporta consultas SQL localmente.', '/sql-formatter/', 'SQL'],
      ['Formateador y validador XML', 'Formatea, valida y minifica XML localmente.', '/xml-formatter/', 'XML'],
      ['Convertidor de colores CSS', 'Convierte HEX, RGB, HSL, HWB y nombres CSS.', '/css-color-converter/', 'COLOR'],
      ['Conversor de timestamps y zonas horarias', 'Convierte Unix timestamps, fechas ISO y zonas horarias.', '/timestamp-converter/', 'TIME'],
      ['Base64 encoder y decoder', 'Codifica y decodifica Base64.', '/base64/', '64'],
      ['Parser y conversor de CSV', 'Previsualiza CSV y conviértelo a JSON, Markdown o HTML.', '/csv-converter/', 'CSV'],
      ['JSON viewer y formatter', 'Visualiza y valida JSON.', '/json-viewer/', '{}'],
      ['Generador MD5', 'Genera hashes MD5.', '/md5/', 'MD5'],
      ['JWT decoder', 'Decodifica JWT localmente.', '/jwt-decoder/', 'JWT'],
      ['URL encoder & decoder', 'Codifica parámetros y URLs.', '/url-encoder/', 'ENC'],
      ['Inspector de URLs', 'Analiza URLs para desarrolladores.', '/url-inspector/', 'URL'],
      ['Configurador cURL', 'Genera peticiones HTTP.', '/curl-builder/', 'API'],
      ['Diff checker', 'Compara textos rápidamente.', '/diff-checker/', 'DIFF']
    ]
  },
  {
    title: 'Imágenes',
    items: [
      ['Generador de iconos para apps', 'Crea iconos con imagen, textos, bordes y exportación ZIP.', '/app-icon-generator/', 'APP'],
      ['Generador de placeholders SVG', 'Crea SVG, data URLs y snippets HTML/CSS.', '/svg-placeholder/', 'SVG'],
      ['Generador y lector QR', 'Crea códigos QR y lee imágenes locales.', '/qr-code/', 'QR'],
      ['Compresor de imágenes', 'Reduce el tamaño de imágenes.', '/image-compressor/', 'ZIP'],
      ['Conversor de imágenes', 'Convierte PNG, JPEG y WebP.', '/image-converter/', 'CONV'],
      ['Información de imágenes', 'Obtén metadatos y tamaño.', '/image-info/', 'IMG'],
      ['Generador de favicon', 'Crea favicons desde texto o imágenes.', '/favicon-generator/', 'ICO'],
      ['Censurador de fotos', 'Pixelado, blur y censura.', '/photo-censor/', 'CEN']
    ]
  },
  {
    title: 'Internet y mapas',
    items: [
      ['DNS lookup', 'Consulta registros DNS con Google Public DNS.', '/dns-lookup/', 'DNS'],
      ['Información de IP', 'Consulta información técnica de IPs.', '/ip-info/', 'IP'],
      ['Coordenadas de direcciones', 'Busca coordenadas GPS.', '/geocoder/', 'MAP'],
      ['Preview social de URLs', 'Comprueba Open Graph y Twitter.', '/social-preview/', 'SOC']
    ]
  },
  {
    title: 'Texto y escritura',
    items: [
      ['Contador de caracteres', 'Cuenta caracteres, palabras, frases y términos repetidos.', '/character-counter/', 'ABC'],
      ['Generador de Lorem Ipsum', 'Genera texto por letras, párrafos o páginas.', '/lorem-ipsum/', 'TXT'],
      ['Markdown writer & preview', 'Editor Markdown con preview.', '/markdown-preview/', 'MD']
    ]
  },
  {
    title: 'Finanzas',
    items: [
      ['Calculadora de IVA', 'Calcula IVA desde precios con o sin impuesto incluido.', '/vat-calculator/', 'IVA']
    ]
  }
];

const totalTools = categories.reduce((total, category) => total + category.items.length, 0);
---

<Layout title="Alon Tools — Herramientas privadas para navegador" description="Herramientas rápidas para desarrollo, imágenes e internet que funcionan localmente en tu navegador. Sin backend, sin cuentas y sin subir archivos a la nube." lang="es" path="/" translated={true}>
  <section class="hero home-simple">
    <div class="eyebrow">{totalTools} herramientas locales</div>
    <h1>Herramientas útiles para el navegador. Sin líos.</h1>
    <p class="hero-text">Busca, abre y trabaja en local. Sin cuentas. Sin subir archivos.</p>
  </section>

  <section class="search-panel" aria-labelledby="toolsSearchTitle">
    <div class="search-row">
      <h2 id="toolsSearchTitle">Herramientas</h2>
      <p id="toolsCount">{totalTools} herramientas</p>
    </div>

    <div class="search-box">
      <input id="toolSearch" type="search" placeholder="Buscar herramienta..." aria-label="Buscar herramientas" autocomplete="off" />
      <button id="clearFilters" class="btn btn-secondary" type="button">Limpiar</button>
    </div>

    <div class="category-filters" aria-label="Filtros por categoría">
      <button class="filter-button active" type="button" data-category-filter="all">Todas</button>
      {categories.map((category) => (
        <button class="filter-button" type="button" data-category-filter={category.title}>{category.title}</button>
      ))}
    </div>
  </section>

  <p class="empty-state" id="emptyState" hidden>No hay herramientas.</p>

  <div class="tools-directory">
    {categories.map((category) => (
      <section class="category-section" data-category-section={category.title}>
        <div class="category-header">
          <h2>{category.title}</h2>
          <span>{category.items.length}</span>
        </div>
        <div class="directory-grid">
          {category.items.map(([title, description, href, icon]) => (
            <a class="tool-link-card" href={href} data-tool-card data-category={category.title} data-search={`${title} ${description} ${href} ${icon} ${category.title}`.toLowerCase()} aria-label={`${title}: ${description}`}>
              <div class="tool-icon">{icon}</div>
              <strong>{title}</strong>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <script>
    const searchInput = document.getElementById('toolSearch');
    const clearFilters = document.getElementById('clearFilters');
    const toolsCount = document.getElementById('toolsCount');
    const emptyState = document.getElementById('emptyState');
    const cards = Array.from(document.querySelectorAll('[data-tool-card]'));
    const sections = Array.from(document.querySelectorAll('[data-category-section]'));
    const filterButtons = Array.from(document.querySelectorAll('[data-category-filter]'));
    const total = cards.length;
    let activeCategory = 'all';

    const setActiveButton = () => {
      filterButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.categoryFilter === activeCategory);
      });
    };

    const filterTools = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
        const matchesSearch = !query || card.dataset.search.includes(query);
        const show = matchesCategory && matchesSearch;
        card.hidden = !show;
        if (show) visible += 1;
      });

      sections.forEach((section) => {
        section.hidden = !section.querySelector('[data-tool-card]:not([hidden])');
      });

      toolsCount.textContent = visible === total ? `${total} herramientas` : `${visible} de ${total}`;
      emptyState.hidden = visible !== 0;
      setActiveButton();
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.categoryFilter || 'all';
        filterTools();
      });
    });

    searchInput.addEventListener('input', filterTools);
    clearFilters.addEventListener('click', () => {
      searchInput.value = '';
      activeCategory = 'all';
      filterTools();
      searchInput.focus();
    });

    filterTools();
  </script>
</Layout>

<style>
  .home-simple {
    padding: clamp(2.5rem, 7vw, 5rem) 0 clamp(1.25rem, 3vw, 2rem);
  }

  .home-simple h1 {
    max-width: 760px;
  }

  .home-simple .hero-text {
    max-width: 560px;
  }

  .search-panel {
    position: sticky;
    top: calc(var(--space-4) + 4.5rem);
    z-index: 10;
    margin: var(--space-4) 0 var(--space-8);
    padding: clamp(.9rem, 2.2vw, 1.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: color-mix(in srgb, var(--color-surface-raised) 94%, transparent);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(18px);
  }

  .search-row,
  .search-box {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .search-row {
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .search-row h2,
  .category-header h2 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    letter-spacing: -.03em;
  }

  .search-row p,
  .category-header span {
    margin: 0;
    color: var(--color-text-muted);
    font-size: .9rem;
    font-weight: 850;
  }

  .search-box input[type='search'] {
    min-height: 3rem;
    border-radius: var(--radius-full);
    font-size: 1rem;
  }

  .category-filters {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    overflow-x: auto;
    padding-bottom: .15rem;
    scrollbar-width: none;
  }

  .category-filters::-webkit-scrollbar {
    display: none;
  }

  .filter-button {
    flex: 0 0 auto;
    min-height: 2.35rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    font: inherit;
    font-size: .9rem;
    font-weight: 850;
    padding: .55rem .85rem;
    transition: transform var(--transition-fast), background-color var(--transition-base), color var(--transition-base), border-color var(--transition-base);
  }

  .filter-button:hover {
    transform: translateY(-1px);
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .filter-button.active {
    background: var(--color-primary);
    border-color: transparent;
    color: #fff;
  }

  [data-theme='dark'] .filter-button.active {
    color: #020617;
  }

  .empty-state {
    padding: var(--space-5);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    color: var(--color-text-muted);
    text-align: center;
  }

  .tools-directory {
    display: grid;
    gap: var(--space-8);
  }

  .category-section[hidden],
  .tool-link-card[hidden] {
    display: none;
  }

  .category-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .directory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-3);
  }

  .tool-link-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 5.25rem;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-xs);
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base), background-color var(--transition-base);
  }

  .tool-link-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
    box-shadow: var(--shadow-sm);
    color: inherit;
  }

  .tool-icon {
    flex: 0 0 auto;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: #fff;
    font-size: .78rem;
    font-weight: 950;
    letter-spacing: -.02em;
    box-shadow: var(--shadow-xs);
  }

  .tool-link-card strong {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.2;
  }

  @media (max-width: 760px) {
    .search-panel {
      position: relative;
      top: auto;
      border-radius: var(--radius-xl);
    }
  }

  @media (max-width: 520px) {
    .search-box {
      align-items: stretch;
    }

    #clearFilters {
      min-width: 5.2rem;
      padding-inline: .9rem;
    }

    .directory-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
