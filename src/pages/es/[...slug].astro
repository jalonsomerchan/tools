      'HTML/CSS/JS formatter': 'Formateador HTML/CSS/JS',
      'UUID & random key generator': 'Generador de UUID y claves aleatorias',
      'SQL formatter': 'Formateador SQL',
      'XML formatter & validator': 'Formateador y validador XML',
      'CSS color converter': 'Convertidor de colores CSS',
      'Timestamp & timezone converter': 'Conversor de timestamps y zonas horarias',
      'Base64 encoder & decoder': 'Codificador y decodificador Base64',
      'CSV parser & converter': 'Parser y conversor CSV',
      'JSON viewer & formatter': 'Visor y formateador JSON',
      'MD5 generator': 'Generador MD5',
