  'meta-tags-generator': 'Generador de meta tags y Open Graph',
  'yaml-formatter': 'Formateador y validador YAML',
  'web-icon-generator': 'Generador de iconos para web'
};

export function getStaticPaths() {
  return [
    'app-icon-generator',
    'base64',
    'character-counter',
    'code-formatter',
    'curl-builder',
    'csv-converter',
    'css-color-converter',
    'diff-checker',
    'dns-lookup',
    'favicon-generator',
    'geocoder',
    'image-compressor',
    'image-converter',
    'image-info',
    'ip-info',
    'json-viewer',
    'jwt-decoder',
    'lorem-ipsum',
    'markdown-preview',
    'md5',
    'photo-censor',
    'qr-code',
    'social-preview',
    'sql-formatter',
    'svg-placeholder',
    'timestamp-converter',
    'url-encoder',
    'url-inspector',
    'uuid-generator',
    'vat-calculator',
    'xml-formatter',
    'currency-converter',
    'simple-postman',
    'screenshot-enhancer',
    'password-generator',
    'robots-sitemap-generator',
    'meta-tags-generator',
    'yaml-formatter',
    'web-icon-generator'
  ].map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as PageSlug;
const Page = pages[slug];
const translatedTitle = translatedTitles[slug];
---

<Page />

