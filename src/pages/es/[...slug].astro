      'DOMParser validates the document locally. External resources are not fetched and XML content is never executed.': 'DOMParser valida el documento localmente. No se descargan recursos externos y el contenido XML nunca se ejecuta.',
      'Paste a query, choose formatting options and export the result. Comments and quoted strings are preserved when possible.': 'Pega una consulta, elige las opciones de formato y exporta el resultado. Los comentarios y cadenas entrecomilladas se conservan cuando es posible.',
      'Use UUIDs for identifiers or random strings for tokens, test data and temporary keys.': 'Usa UUIDs como identificadores o cadenas aleatorias para tokens, datos de prueba y claves temporales.'
    };

    const placeholderDictionary = {
      'Paste your SQL here...': 'Pega tu SQL aquí...',
      'Formatted or minified SQL will appear here...': 'El SQL formateado o minificado aparecerá aquí...',
      'Paste your XML here...': 'Pega tu XML aquí...',
      'Formatted, minified or validated XML will appear here...': 'El XML formateado, minificado o validado aparecerá aquí...',
      'Generated UUIDs or random strings will appear here...': 'Aquí aparecerán los UUIDs o cadenas aleatorias generadas...',
      'Paste your code here...': 'Pega tu código aquí...',
      'Paste your JSON here...': 'Pega tu JSON aquí...',
      'Paste your CSV here...': 'Pega tu CSV aquí...',
      'Text input...': 'Texto de entrada...',
      'Result...': 'Resultado...'
    };

    const normalize = (value) => value.replace(/\s+/g, ' ').trim();
    const translateNode = (node) => {
      const text = normalize(node.textContent || '');
      const translated = dictionary[text];
      if (translated && node.textContent !== translated) node.textContent = translated;
    };

    const translateAll = () => {
      if (translatedTitle) {
        if (document.title !== translatedTitle) document.title = translatedTitle;
        const h1 = document.querySelector('h1');
        if (h1 && h1.textContent !== translatedTitle) h1.textContent = translatedTitle;
        document.querySelector('meta[property="og:title"]')?.setAttribute('content', translatedTitle);
        document.querySelector('meta[name="twitter:title"]')?.setAttribute('content', translatedTitle);
      }

      document.querySelectorAll('h1,h2,h3,h4,p,button,label,legend,summary,small,span,option,output,div[role="note"],.status,.stat-card,.editor-label,.empty-context').forEach(translateNode);
      document.querySelectorAll('[placeholder]').forEach((element) => {
        const placeholder = element.getAttribute('placeholder');
        if (placeholderDictionary[placeholder]) element.setAttribute('placeholder', placeholderDictionary[placeholder]);
      });
    };

    translateAll();

    const observer = new MutationObserver(() => translateAll());
    observer.observe(document.body, { childList: true, subtree: true });
  })();
</script>
