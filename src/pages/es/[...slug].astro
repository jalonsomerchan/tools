      'Reset': 'Reiniciar',
      'Bring forward': 'Traer delante',
      'Send backward': 'Enviar detrás',
      'Center': 'Centrar',
      'Fit to canvas': 'Ajustar al lienzo',
      'Type': 'Tipo',
      'Amount': 'Cantidad',
      'String length': 'Longitud de la cadena',
      'Characters for random strings': 'Caracteres para cadenas aleatorias',
