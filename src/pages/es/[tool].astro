---
import Layout from '../../layouts/Layout.astro';
import UrlEncoderTool from '../../components/tools/UrlEncoderTool.astro';
import Md5Tool from '../../components/tools/Md5Tool.astro';
import JwtDecoderTool from '../../components/tools/JwtDecoderTool.astro';
import { useTranslations } from '../../i18n';

export function getStaticPaths() {
  return [
    {
      params: { tool: 'url-encoder' },
      props: {
        toolKey: 'urlEncoder',
        path: '/url-encoder/'
      }
    },
    {
      params: { tool: 'md5' },
      props: {
        toolKey: 'md5',
        path: '/md5/'
      }
    },
    {
      params: { tool: 'jwt-decoder' },
      props: {
        toolKey: 'jwt',
        path: '/jwt-decoder/'
      }
    }
  ];
}

const { toolKey, path } = Astro.props;
const lang = 'es';
const t = useTranslations(lang);

const components = {
  urlEncoder: UrlEncoderTool,
  md5: Md5Tool,
  jwt: JwtDecoderTool
};

const ToolComponent = components[toolKey];
---

<Layout
  title={t(`${toolKey}.title`)}
  description={t(`${toolKey}.description`)}
  lang={lang}
  path={path}
>
  <ToolComponent lang={lang} />
</Layout>
