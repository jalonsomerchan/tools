---
import Layout from '../layouts/Layout.astro';

const categories = [
  {
    title: 'Development',
    items: [
      ['HTML/CSS/JS formatter', 'Format and minify code snippets locally.', '/code-formatter/', 'CODE'],
      ['SQL formatter', 'Format, minify and export SQL queries locally.', '/sql-formatter/', 'SQL'],
      ['XML formatter & validator', 'Format, validate and minify XML locally.', '/xml-formatter/', 'XML'],
      ['CSS color converter', 'Convert HEX, RGB, HSL, HWB and CSS color names.', '/css-color-converter/', 'COLOR'],
      ['Timestamp & timezone converter', 'Convert Unix timestamps, ISO dates and time zones.', '/timestamp-converter/', 'TIME'],
      ['Base64 encoder & decoder', 'Encode and decode Base64 text.', '/base64/', '64'],
      ['CSV parser & converter', 'Preview CSV and convert it to JSON, Markdown or HTML.', '/csv-converter/', 'CSV'],
      ['JSON viewer & formatter', 'View, validate and format JSON.', '/json-viewer/', '{}'],
      ['MD5 generator', 'Generate MD5 hashes in the browser.', '/md5/', 'MD5'],
      ['JWT decoder', 'Decode JWT tokens locally.', '/jwt-decoder/', 'JWT'],
      ['URL encoder & decoder', 'Encode URLs and query parameters.', '/url-encoder/', 'ENC'],
      ['URL inspector', 'Analyze URLs for developers.', '/url-inspector/', 'URL'],
      ['cURL builder', 'Generate HTTP requests and code snippets.', '/curl-builder/', 'API'],
      ['Diff checker', 'Compare texts quickly.', '/diff-checker/', 'DIFF']
    ]
  },
  {
    title: 'Images',
    items: [
      ['App icon generator', 'Create app icons with images, text, borders and ZIP exports.', '/app-icon-generator/', 'APP'],
      ['SVG placeholder generator', 'Create SVG placeholders and data URLs.', '/svg-placeholder/', 'SVG'],
      ['QR code generator & reader', 'Generate QR codes and read local QR images.', '/qr-code/', 'QR'],
      ['Image compressor', 'Reduce image file size locally.', '/image-compressor/', 'ZIP'],
      ['Image converter', 'Convert between PNG, JPEG and WebP.', '/image-converter/', 'CONV'],
      ['Image information', 'Get image size and metadata.', '/image-info/', 'IMG'],
      ['Favicon generator', 'Create favicons from text or images.', '/favicon-generator/', 'ICO'],
      ['Photo censor', 'Pixelate, blur or cover image areas.', '/photo-censor/', 'CEN']
    ]
  },
  {
    title: 'Internet & maps',
    items: [
      ['DNS lookup', 'Query DNS records with Google Public DNS.', '/dns-lookup/', 'DNS'],
      ['IP information', 'Look up technical IP information.', '/ip-info/', 'IP'],
      ['Address coordinates', 'Find GPS coordinates from an address.', '/geocoder/', 'MAP'],
      ['Social URL preview', 'Check Open Graph and Twitter Cards.', '/social-preview/', 'SOC']
    ]
  },
  {
    title: 'Text & writing',
    items: [
      ['Character counter', 'Count characters, words, sentences and repeated terms.', '/character-counter/', 'ABC'],
      ['Lorem Ipsum generator', 'Generate filler text by letters, paragraphs or pages.', '/lorem-ipsum/', 'TXT'],
      ['Markdown writer & preview', 'Markdown editor with live preview.', '/markdown-preview/', 'MD']
    ]
  },
  {
    title: 'Finance',
    items: [
      ['VAT calculator', 'Calculate VAT from prices with or without tax.', '/vat-calculator/', 'VAT']
    ]
  }
];

const totalTools = categories.reduce((total, category) => total + category.items.length, 0);
---

<Layout title="Alon Tools — Privacy-first browser tools" description="Fast developer, image and internet tools that run locally in your browser. No backend, no accounts, no cloud uploads." lang="en" path="/" translated={true}>
  <script is:inline>
    (() => {
      const isHome = window.location.pathname === '/';
      const alreadyRedirected = window.sessionStorage.getItem('alon-tools-lang-redirected');
      const preferredLanguages = navigator.languages?.length ? navigator.languages : [navigator.language];
      const prefersSpanish = preferredLanguages.some((language) => language?.toLowerCase().startsWith('es'));
      if (isHome && prefersSpanish && !alreadyRedirected) {
        window.sessionStorage.setItem('alon-tools-lang-redirected', '1');
        window.location.replace('/es/');
      }
    })();
  </script>
  <section class="hero"><div class="eyebrow">Privacy First</div><h1>Fast browser tools that respect your privacy</h1><p class="hero-text">No backend. No accounts. No cloud uploads. Most tools run entirely on your device.</p></section>
  <section class="search-panel" aria-labelledby="toolsSearchTitle"><div class="search-heading"><div><h2 id="toolsSearchTitle">Find a tool</h2><p id="toolsCount">Showing {totalTools} tools</p></div><button id="clearFilters" class="btn btn-secondary" type="button">Clear filters</button></div><label for="toolSearch">Search by name, description or shortcut</label><input id="toolSearch" type="search" placeholder="Search: json, image, qr, timestamp..." autocomplete="off" /><div class="category-filters" aria-label="Category filters"><button class="filter-button active" type="button" data-category-filter="all">All</button>{categories.map((category) => (<button class="filter-button" type="button" data-category-filter={category.title}>{category.title}</button>))}</div></section>
  <p class="empty-state" id="emptyState" hidden>No tools match your search.</p>
  {categories.map((category) => (<section class="category-section" data-category-section={category.title}><div class="category-header"><h2>{category.title}</h2></div><div class="directory-grid">{category.items.map(([title, description, href, icon]) => (<a class="tool-link-card" href={href} data-tool-card data-category={category.title} data-search={`${title} ${description} ${href} ${icon} ${category.title}`.toLowerCase()}><div class="tool-icon">{icon}</div><div><strong>{title}</strong><small>{description}</small></div></a>))}</div></section>))}
  <script>
    const searchInput = document.getElementById('toolSearch');
    const clearFilters = document.getElementById('clearFilters');
    const toolsCount = document.getElementById('toolsCount');
    const emptyState = document.getElementById('emptyState');
    const cards = Array.from(document.querySelectorAll('[data-tool-card]'));
    const sections = Array.from(document.querySelectorAll('[data-category-section]'));
    const filterButtons = Array.from(document.querySelectorAll('[data-category-filter]'));
    const total = cards.length;
    let activeCategory = 'all';
    const setActiveButton = () => { filterButtons.forEach((button) => { button.classList.toggle('active', button.dataset.categoryFilter === activeCategory); }); };
    const filterTools = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => { const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory; const matchesSearch = !query || card.dataset.search.includes(query); const show = matchesCategory && matchesSearch; card.hidden = !show; if (show) visible += 1; });
      sections.forEach((section) => { section.hidden = !section.querySelector('[data-tool-card]:not([hidden])'); });
      toolsCount.textContent = `Showing ${visible} of ${total} tools`;
      emptyState.hidden = visible !== 0;
      setActiveButton();
    };
    filterButtons.forEach((button) => { button.addEventListener('click', () => { activeCategory = button.dataset.categoryFilter || 'all'; filterTools(); }); });
    searchInput.addEventListener('input', filterTools);
    clearFilters.addEventListener('click', () => { searchInput.value = ''; activeCategory = 'all'; filterTools(); searchInput.focus(); });
    filterTools();
  </script>
</Layout>

<style>
  .hero{padding:clamp(3rem,8vw,6rem) 0 var(--space-8)}.search-panel{margin:var(--space-4) 0 var(--space-10);padding:clamp(1rem,3vw,1.5rem);border-radius:var(--radius-2xl);border:1px solid var(--color-border);background:color-mix(in srgb,var(--color-surface) 94%,transparent);box-shadow:var(--shadow-sm)}.search-heading{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-4);margin-bottom:var(--space-4)}.search-heading h2{margin:0 0 var(--space-1);font-size:1.25rem}.search-heading p{margin:0;color:var(--color-text-muted)}input[type='search']{font-size:1rem}.category-filters{display:flex;gap:var(--space-2);flex-wrap:wrap;margin-top:var(--space-4)}.filter-button{min-height:2.55rem;border-radius:var(--radius-full);border:1px solid var(--color-border);background:var(--color-surface);color:var(--color-text-muted);padding:.65rem .9rem;cursor:pointer;font:inherit;font-weight:800;transition:transform var(--transition-fast),background-color var(--transition-base),color var(--transition-base),border-color var(--transition-base)}.filter-button:hover{transform:translateY(-1px);border-color:var(--color-border-strong);color:var(--color-text)}.filter-button.active{background:var(--color-primary);color:#fff;border-color:transparent}[data-theme='dark'] .filter-button.active{color:#020617}.empty-state{padding:var(--space-5);border-radius:var(--radius-xl);border:1px dashed var(--color-border-strong);background:var(--color-surface);color:var(--color-text-muted);text-align:center}.category-section{margin-top:var(--space-12)}.category-section[hidden]{display:none}.category-header{margin-bottom:var(--space-4)}.category-header h2{margin:0}.directory-grid{display:grid;gap:var(--space-4);grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))}.tool-link-card{display:flex;gap:var(--space-4);padding:var(--space-5);border-radius:var(--radius-2xl);border:1px solid var(--color-border);background:color-mix(in srgb,var(--color-surface) 94%,transparent);color:inherit;text-decoration:none;box-shadow:var(--shadow-xs);transition:transform var(--transition-base),border-color var(--transition-base),box-shadow var(--transition-base),background-color var(--transition-base)}.tool-link-card:hover{transform:translateY(-2px);border-color:var(--color-border-strong);box-shadow:var(--shadow-sm);color:inherit}.tool-link-card[hidden]{display:none}.tool-icon{width:4rem;height:4rem;display:grid;place-items:center;border-radius:var(--radius-lg);background:linear-gradient(135deg,var(--color-primary),var(--color-secondary));color:#fff;font-weight:900;font-size:.9rem;flex-shrink:0;box-shadow:var(--shadow-xs)}.tool-link-card strong{display:block;margin-bottom:var(--space-2);color:var(--color-text);line-height:1.3}.tool-link-card small{color:var(--color-text-muted);line-height:1.7}@media(max-width:640px){.hero{padding-top:var(--space-10)}.search-heading{flex-direction:column}#clearFilters,.filter-button{width:100%}.tool-link-card{padding:var(--space-4)}}
</style>
