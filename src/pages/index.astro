---
import Layout from '../layouts/Layout.astro';

const categories = [
  {
    title: 'Development',
    items: [
      ['HTML/CSS/JS formatter', 'Format and minify code snippets locally.', '/code-formatter/', 'CODE'],
      ['SQL formatter', 'Format, minify and export SQL queries locally.', '/sql-formatter/', 'SQL'],
      ['XML formatter & validator', 'Format, validate and minify XML locally.', '/xml-formatter/', 'XML'],
      ['CSS color converter', 'Convert HEX, RGB, HSL, HWB and CSS color names.', '/css-color-converter/', 'COLOR'],
      ['Timestamp & timezone converter', 'Convert Unix timestamps, ISO dates and time zones.', '/timestamp-converter/', 'TIME'],
      ['Base64 encoder & decoder', 'Encode and decode Base64 text.', '/base64/', '64'],
      ['CSV parser & converter', 'Preview CSV and convert it to JSON, Markdown or HTML.', '/csv-converter/', 'CSV'],
      ['JSON viewer & formatter', 'View, validate and format JSON.', '/json-viewer/', '{}'],
      ['MD5 generator', 'Generate MD5 hashes in the browser.', '/md5/', 'MD5'],
      ['JWT decoder', 'Decode JWT tokens locally.', '/jwt-decoder/', 'JWT'],
      ['URL encoder & decoder', 'Encode URLs and query parameters.', '/url-encoder/', 'ENC'],
      ['URL inspector', 'Analyze URLs for developers.', '/url-inspector/', 'URL'],
      ['cURL builder', 'Generate HTTP requests and code snippets.', '/curl-builder/', 'API'],
      ['Diff checker', 'Compare texts quickly.', '/diff-checker/', 'DIFF']
    ]
  },
  {
    title: 'Images',
    items: [
      ['App icon generator', 'Create app icons with images, text, borders and ZIP exports.', '/app-icon-generator/', 'APP'],
      ['SVG placeholder generator', 'Create SVG placeholders and data URLs.', '/svg-placeholder/', 'SVG'],
      ['QR code generator & reader', 'Generate QR codes and read local QR images.', '/qr-code/', 'QR'],
      ['Image compressor', 'Reduce image file size locally.', '/image-compressor/', 'ZIP'],
      ['Image converter', 'Convert between PNG, JPEG and WebP.', '/image-converter/', 'CONV'],
      ['Image information', 'Get image size and metadata.', '/image-info/', 'IMG'],
      ['Favicon generator', 'Create favicons from text or images.', '/favicon-generator/', 'ICO'],
      ['Photo censor', 'Pixelate, blur or cover image areas.', '/photo-censor/', 'CEN']
    ]
  },
  {
    title: 'Internet & maps',
    items: [
      ['DNS lookup', 'Query DNS records with Google Public DNS.', '/dns-lookup/', 'DNS'],
      ['IP information', 'Look up technical IP information.', '/ip-info/', 'IP'],
      ['Address coordinates', 'Find GPS coordinates from an address.', '/geocoder/', 'MAP'],
      ['Social URL preview', 'Check Open Graph and Twitter Cards.', '/social-preview/', 'SOC']
    ]
  },
  {
    title: 'Text & writing',
    items: [
      ['Character counter', 'Count characters, words, sentences and repeated terms.', '/character-counter/', 'ABC'],
      ['Lorem Ipsum generator', 'Generate filler text by letters, paragraphs or pages.', '/lorem-ipsum/', 'TXT'],
      ['Markdown writer & preview', 'Markdown editor with live preview.', '/markdown-preview/', 'MD']
    ]
  },
  {
    title: 'Finance',
    items: [
      ['VAT calculator', 'Calculate VAT from prices with or without tax.', '/vat-calculator/', 'VAT']
    ]
  }
];

const totalTools = categories.reduce((total, category) => total + category.items.length, 0);
---

<Layout title="Alon Tools — Private browser tools" description="Fast developer, image and internet tools that run locally in your browser. No backend, no accounts, no cloud uploads." lang="en" path="/" translated={true}>
  <script is:inline>
    (() => {
      const isHome = window.location.pathname === '/';
      const alreadyRedirected = window.sessionStorage.getItem('alon-tools-lang-redirected');
      const preferredLanguages = navigator.languages?.length ? navigator.languages : [navigator.language];
      const prefersSpanish = preferredLanguages.some((language) => language?.toLowerCase().startsWith('es'));
      if (isHome && prefersSpanish && !alreadyRedirected) {
        window.sessionStorage.setItem('alon-tools-lang-redirected', '1');
        window.location.replace('/es/');
      }
    })();
  </script>

  <section class="hero home-simple">
    <div class="eyebrow">{totalTools} local tools</div>
    <h1>Useful browser tools. No clutter.</h1>
    <p class="hero-text">Search, open and work locally. No accounts. No uploads.</p>
  </section>

  <section class="search-panel" aria-labelledby="toolsSearchTitle">
    <div class="search-row">
      <h2 id="toolsSearchTitle">Tools</h2>
      <p id="toolsCount">{totalTools} tools</p>
    </div>

    <div class="search-box">
      <input id="toolSearch" type="search" placeholder="Search tools..." aria-label="Search tools" autocomplete="off" />
      <button id="clearFilters" class="btn btn-secondary" type="button">Clear</button>
    </div>

    <div class="category-filters" aria-label="Category filters">
      <button class="filter-button active" type="button" data-category-filter="all">All</button>
      {categories.map((category) => (
        <button class="filter-button" type="button" data-category-filter={category.title}>{category.title}</button>
      ))}
    </div>
  </section>

  <p class="empty-state" id="emptyState" hidden>No tools found.</p>

  <div class="tools-directory">
    {categories.map((category) => (
      <section class="category-section" data-category-section={category.title}>
        <div class="category-header">
          <h2>{category.title}</h2>
          <span>{category.items.length}</span>
        </div>
        <div class="directory-grid">
          {category.items.map(([title, description, href, icon]) => (
            <a class="tool-link-card" href={href} data-tool-card data-category={category.title} data-search={`${title} ${description} ${href} ${icon} ${category.title}`.toLowerCase()} aria-label={`${title}: ${description}`}>
              <div class="tool-icon">{icon}</div>
              <strong>{title}</strong>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>

  <script>
    const searchInput = document.getElementById('toolSearch');
    const clearFilters = document.getElementById('clearFilters');
    const toolsCount = document.getElementById('toolsCount');
    const emptyState = document.getElementById('emptyState');
    const cards = Array.from(document.querySelectorAll('[data-tool-card]'));
    const sections = Array.from(document.querySelectorAll('[data-category-section]'));
    const filterButtons = Array.from(document.querySelectorAll('[data-category-filter]'));
    const total = cards.length;
    let activeCategory = 'all';

    const setActiveButton = () => {
      filterButtons.forEach((button) => {
        button.classList.toggle('active', button.dataset.categoryFilter === activeCategory);
      });
    };

    const filterTools = () => {
      const query = searchInput.value.trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
        const matchesSearch = !query || card.dataset.search.includes(query);
        const show = matchesCategory && matchesSearch;
        card.hidden = !show;
        if (show) visible += 1;
      });

      sections.forEach((section) => {
        section.hidden = !section.querySelector('[data-tool-card]:not([hidden])');
      });

      toolsCount.textContent = visible === total ? `${total} tools` : `${visible} of ${total}`;
      emptyState.hidden = visible !== 0;
      setActiveButton();
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCategory = button.dataset.categoryFilter || 'all';
        filterTools();
      });
    });

    searchInput.addEventListener('input', filterTools);
    clearFilters.addEventListener('click', () => {
      searchInput.value = '';
      activeCategory = 'all';
      filterTools();
      searchInput.focus();
    });

    filterTools();
  </script>
</Layout>

<style>
  .home-simple {
    padding: clamp(2.5rem, 7vw, 5rem) 0 clamp(1.25rem, 3vw, 2rem);
  }

  .home-simple h1 {
    max-width: 760px;
  }

  .home-simple .hero-text {
    max-width: 560px;
  }

  .search-panel {
    position: sticky;
    top: calc(var(--space-4) + 4.5rem);
    z-index: 10;
    margin: var(--space-4) 0 var(--space-8);
    padding: clamp(.9rem, 2.2vw, 1.25rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: color-mix(in srgb, var(--color-surface-raised) 94%, transparent);
    box-shadow: var(--shadow-sm);
    backdrop-filter: blur(18px);
  }

  .search-row,
  .search-box {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .search-row {
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .search-row h2,
  .category-header h2 {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    letter-spacing: -.03em;
  }

  .search-row p,
  .category-header span {
    margin: 0;
    color: var(--color-text-muted);
    font-size: .9rem;
    font-weight: 850;
  }

  .search-box input[type='search'] {
    min-height: 3rem;
    border-radius: var(--radius-full);
    font-size: 1rem;
  }

  .category-filters {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-3);
    overflow-x: auto;
    padding-bottom: .15rem;
    scrollbar-width: none;
  }

  .category-filters::-webkit-scrollbar {
    display: none;
  }

  .filter-button {
    flex: 0 0 auto;
    min-height: 2.35rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    font: inherit;
    font-size: .9rem;
    font-weight: 850;
    padding: .55rem .85rem;
    transition: transform var(--transition-fast), background-color var(--transition-base), color var(--transition-base), border-color var(--transition-base);
  }

  .filter-button:hover {
    transform: translateY(-1px);
    border-color: var(--color-border-strong);
    color: var(--color-text);
  }

  .filter-button.active {
    background: var(--color-primary);
    border-color: transparent;
    color: #fff;
  }

  [data-theme='dark'] .filter-button.active {
    color: #020617;
  }

  .empty-state {
    padding: var(--space-5);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    color: var(--color-text-muted);
    text-align: center;
  }

  .tools-directory {
    display: grid;
    gap: var(--space-8);
  }

  .category-section[hidden],
  .tool-link-card[hidden] {
    display: none;
  }

  .category-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .directory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: var(--space-3);
  }

  .tool-link-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 5.25rem;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-xs);
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base), background-color var(--transition-base);
  }

  .tool-link-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
    box-shadow: var(--shadow-sm);
    color: inherit;
  }

  .tool-icon {
    flex: 0 0 auto;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
    color: #fff;
    font-size: .78rem;
    font-weight: 950;
    letter-spacing: -.02em;
    box-shadow: var(--shadow-xs);
  }

  .tool-link-card strong {
    color: var(--color-text);
    font-size: 1rem;
    line-height: 1.2;
  }

  @media (max-width: 760px) {
    .search-panel {
      position: relative;
      top: auto;
      border-radius: var(--radius-xl);
    }
  }

  @media (max-width: 520px) {
    .search-box {
      align-items: stretch;
    }

    #clearFilters {
      min-width: 5.2rem;
      padding-inline: .9rem;
    }

    .directory-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
