---
import Layout from '../layouts/Layout.astro';

const tools = [
  {
    title: 'Base64 encoder y decoder',
    description: 'Codifica y decodifica texto Base64 con soporte UTF-8.',
    href: '/tools/base64/',
    icon: '64'
  },
  {
    title: 'JSON viewer y formatter',
    description: 'Visualiza, valida y formatea JSON rápidamente.',
    href: '/tools/json-viewer/',
    icon: '{}'
  },
  {
    title: 'Generador MD5',
    description: 'Genera hashes MD5 rápidamente desde el navegador.',
    href: '/tools/md5/',
    icon: 'MD5'
  },
  {
    title: 'Información de imágenes',
    description: 'Obtén tamaño, resolución, formato y metadatos de imágenes.',
    href: '/tools/image-info/',
    icon: 'IMG'
  },
  {
    title: 'Inspector de URLs',
    description: 'Analiza URLs y genera ejemplos para desarrolladores.',
    href: '/tools/url-inspector/',
    icon: 'URL'
  },
  {
    title: 'Configurador cURL',
    description: 'Genera peticiones HTTP para múltiples lenguajes.',
    href: '/tools/curl-builder/',
    icon: 'API'
  },
  {
    title: 'Censurador de fotos',
    description: 'Pixela, desenfoca o tapa partes de una imagen.',
    href: '/tools/photo-censor/',
    icon: 'CEN'
  },
  {
    title: 'Coordenadas de direcciones',
    description: 'Busca ubicaciones y obtén coordenadas GPS.',
    href: '/tools/geocoder/',
    icon: 'MAP'
  },
  {
    title: 'Información de IP',
    description: 'Consulta información técnica y geográfica de una IP.',
    href: '/tools/ip-info/',
    icon: 'IP'
  },
  {
    title: 'Preview social de URLs',
    description: 'Comprueba Open Graph y Twitter Cards.',
    href: '/tools/social-preview/',
    icon: 'SOC'
  },
  {
    title: 'Diff checker',
    description: 'Compara textos y detecta diferencias rápidamente.',
    href: '/tools/diff-checker/',
    icon: 'DIFF'
  },
  {
    title: 'Compresor de imágenes',
    description: 'Reduce el tamaño de imágenes en el navegador.',
    href: '/tools/image-compressor/',
    icon: 'ZIP'
  },
  {
    title: 'Markdown writer & preview',
    description: 'Editor Markdown con preview en tiempo real.',
    href: '/tools/markdown-preview/',
    icon: 'MD'
  },
  {
    title: 'URL encoder & decoder',
    description: 'Codifica y decodifica URLs y parámetros.',
    href: '/tools/url-encoder/',
    icon: 'ENC'
  },
  {
    title: 'JWT decoder',
    description: 'Decodifica tokens JWT localmente.',
    href: '/tools/jwt-decoder/',
    icon: 'JWT'
  }
];
---

<Layout title="Alon Tools">
  <section style="padding: 4rem 0;">
    <div class="eyebrow">Alon Tools</div>

    <h1>Herramientas rápidas para el navegador</h1>

    <p class="hero-text">
      Colección de pequeñas utilidades privadas y rápidas creadas con Astro.
    </p>

    <section class="directory-grid">
      {
        tools.map((tool) => (
          <a class="tool-link-card" href={tool.href}>
            <div class="tool-icon">{tool.icon}</div>

            <div>
              <strong>{tool.title}</strong>
              <small>{tool.description}</small>
            </div>
          </a>
        ))
      }
    </section>
  </section>
</Layout>

<style>
  .directory-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .tool-link-card {
    display: flex;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: 24px;
    border: 1px solid var(--border);
    background: var(--card);
    color: inherit;
    text-decoration: none;
  }

  .tool-icon {
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border-radius: 18px;
    background: var(--primary);
    color: black;
    font-weight: 900;
    font-size: .9rem;
  }

  .tool-link-card strong {
    display: block;
    margin-bottom: .5rem;
  }

  .tool-link-card small {
    color: var(--muted);
    line-height: 1.7;
  }
</style>
