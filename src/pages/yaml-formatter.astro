---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const copy = {
  en: {
    title: 'YAML formatter and validator',
    description: 'Validate, format and convert YAML and JSON locally in your browser.',
    eyebrow: '100% local',
    hero: 'Paste YAML or JSON, upload a .yml, .yaml or .json file, validate syntax and convert between YAML and JSON without network requests.',
    workspaceTitle: 'YAML workspace',
    workspaceText: 'No remote references are resolved and no user content is executed. Large files are limited to keep the browser responsive.',
    input: 'Input',
    output: 'Result',
    formatYaml: 'Format YAML',
    validate: 'Validate',
    toJson: 'YAML → JSON',
    toYaml: 'JSON → YAML',
    copy: 'Copy result',
    downloadYaml: 'Download .yaml',
    downloadJson: 'Download .json',
    clear: 'Clear',
    upload: 'Load .yml, .yaml or .json',
    viewMode: 'Result view',
    yamlView: 'YAML',
    jsonView: 'JSON',
    indent: 'Indentation',
    spaces2: '2 spaces',
    spaces4: '4 spaces',
    fileLimit: 'Maximum file size: 512 KB.',
    inputPlaceholder: 'Paste YAML or JSON here...',
    outputPlaceholder: 'Formatted YAML or JSON will appear here...',
    lines: 'Lines',
    characters: 'Characters',
    size: 'Size',
    ready: 'Ready.',
    valid: 'Valid YAML.',
    validJson: 'Valid JSON.',
    formatted: 'YAML formatted.',
    convertedToJson: 'YAML converted to JSON.',
    convertedToYaml: 'JSON converted to YAML.',
    loaded: 'File loaded.',
    cleared: 'Content cleared.',
    copied: 'Result copied.',
    downloaded: 'File downloaded.',
    pasteFirst: 'Paste YAML or JSON first.',
    invalidFile: 'Only .yml, .yaml and .json files are supported.',
    fileTooLarge: 'The file is too large. Maximum size is 512 KB.',
    parseError: 'Could not parse the input.',
    jsonError: 'The input is not valid JSON.',
    noResult: 'There is no result yet.',
    copyError: 'Could not copy. The result is selected so you can copy it manually.',
    downloadError: 'There is nothing to download.',
    warningTitle: 'Local only',
    warningText: 'This tool parses text locally with the yaml package. It does not fetch remote files, resolve external references or run the content you paste.'
  },
  es: {
    title: 'Formateador y validador YAML',
    description: 'Valida, formatea y convierte YAML y JSON localmente en tu navegador.',
    eyebrow: '100% local',
    hero: 'Pega YAML o JSON, carga un archivo .yml, .yaml o .json, valida sintaxis y convierte entre YAML y JSON sin llamadas de red.',
    workspaceTitle: 'Espacio de trabajo YAML',
    workspaceText: 'No se resuelven referencias remotas ni se ejecuta contenido del usuario. Los archivos grandes se limitan para no bloquear el navegador.',
    input: 'Entrada',
    output: 'Resultado',
    formatYaml: 'Formatear YAML',
    validate: 'Validar',
    toJson: 'YAML → JSON',
    toYaml: 'JSON → YAML',
    copy: 'Copiar resultado',
    downloadYaml: 'Descargar .yaml',
    downloadJson: 'Descargar .json',
    clear: 'Limpiar',
    upload: 'Cargar .yml, .yaml o .json',
    viewMode: 'Vista del resultado',
    yamlView: 'YAML',
    jsonView: 'JSON',
    indent: 'Indentación',
    spaces2: '2 espacios',
    spaces4: '4 espacios',
    fileLimit: 'Tamaño máximo: 512 KB.',
    inputPlaceholder: 'Pega aquí YAML o JSON...',
    outputPlaceholder: 'Aquí aparecerá el YAML o JSON formateado...',
    lines: 'Líneas',
    characters: 'Caracteres',
    size: 'Tamaño',
    ready: 'Listo.',
    valid: 'YAML válido.',
    validJson: 'JSON válido.',
    formatted: 'YAML formateado.',
    convertedToJson: 'YAML convertido a JSON.',
    convertedToYaml: 'JSON convertido a YAML.',
    loaded: 'Archivo cargado.',
    cleared: 'Contenido eliminado.',
    copied: 'Resultado copiado.',
    downloaded: 'Archivo descargado.',
    pasteFirst: 'Pega primero YAML o JSON.',
    invalidFile: 'Solo se admiten archivos .yml, .yaml y .json.',
    fileTooLarge: 'El archivo es demasiado grande. Tamaño máximo: 512 KB.',
    parseError: 'No se pudo interpretar la entrada.',
    jsonError: 'La entrada no es JSON válido.',
    noResult: 'Todavía no hay resultado.',
    copyError: 'No se pudo copiar. El resultado queda seleccionado para que lo copies manualmente.',
    downloadError: 'No hay nada que descargar.',
    warningTitle: 'Solo local',
    warningText: 'Esta herramienta interpreta texto localmente con el paquete yaml. No descarga archivos remotos, no resuelve referencias externas ni ejecuta el contenido pegado.'
  }
}[lang];
---

<Layout title={copy.title} description={copy.description} lang={lang} path="/yaml-formatter/" translated={true}>
  <section class="yaml-page">
    <div class="eyebrow">{copy.eyebrow}</div>
    <h1>{copy.title}</h1>
    <p class="hero-text">{copy.hero}</p>

    <section class="tool-card yaml-tool" aria-labelledby="yamlToolTitle">
      <div class="tool-header">
        <div>
          <h2 id="yamlToolTitle">{copy.workspaceTitle}</h2>
          <p>{copy.workspaceText}</p>
        </div>
      </div>

      <div class="options-grid">
        <label for="fileInput" class="file-label">
          {copy.upload}
          <input id="fileInput" type="file" accept=".yml,.yaml,.json,application/yaml,application/x-yaml,application/json,text/yaml,text/plain" />
          <span>{copy.fileLimit}</span>
        </label>

        <label for="viewMode">
          {copy.viewMode}
          <select id="viewMode">
            <option value="yaml">{copy.yamlView}</option>
            <option value="json">{copy.jsonView}</option>
          </select>
        </label>

        <label for="indentSelect">
          {copy.indent}
          <select id="indentSelect">
            <option value="2">{copy.spaces2}</option>
            <option value="4">{copy.spaces4}</option>
          </select>
        </label>
      </div>

      <div class="toolbar" aria-label="YAML actions">
        <button class="primary" id="formatYamlBtn" type="button">{copy.formatYaml}</button>
        <button id="validateBtn" type="button">{copy.validate}</button>
        <button id="toJsonBtn" type="button">{copy.toJson}</button>
        <button id="toYamlBtn" type="button">{copy.toYaml}</button>
        <button id="copyBtn" type="button">{copy.copy}</button>
        <button id="downloadYamlBtn" type="button">{copy.downloadYaml}</button>
        <button id="downloadJsonBtn" type="button">{copy.downloadJson}</button>
        <button id="clearBtn" type="button">{copy.clear}</button>
      </div>

      <div class="notice" role="note">
        <strong>{copy.warningTitle}</strong>
        <span>{copy.warningText}</span>
      </div>

      <div class="workspace">
        <label class="editor-label" for="inputText">{copy.input}</label>
        <label class="editor-label" for="outputText">{copy.output}</label>
        <textarea id="inputText" spellcheck="false" placeholder={copy.inputPlaceholder}></textarea>
        <textarea id="outputText" spellcheck="false" readonly placeholder={copy.outputPlaceholder}></textarea>
      </div>

      <div class="stats-grid" aria-label="YAML statistics">
        <output class="stat-card" id="lineCount">{copy.lines}: 0</output>
        <output class="stat-card" id="charCount">{copy.characters}: 0</output>
        <output class="stat-card" id="sizeCount">{copy.size}: 0 B</output>
      </div>

      <p class="status" id="status" role="status" aria-live="polite">{copy.ready}</p>
    </section>
  </section>

  <style>
    .yaml-page{padding:clamp(2rem,6vw,4rem) 0}.yaml-tool{display:grid;gap:var(--space-4)}.tool-header{display:flex;justify-content:space-between;gap:var(--space-4);align-items:flex-start}.tool-header h2{margin:0 0 var(--space-2);font-size:clamp(1.25rem,2vw,1.6rem)}.tool-header p,.status,.notice{margin:0;color:var(--color-text-muted,var(--muted));line-height:1.7}.options-grid{display:grid;grid-template-columns:1.4fr minmax(0,.8fr) minmax(0,.8fr);gap:var(--space-3);align-items:end}.options-grid label{display:grid;gap:.45rem;color:var(--color-text-muted,var(--muted));font-weight:800}.file-label input{padding:.8rem;background:var(--color-surface,#020617)}.file-label span{font-size:.82rem;color:var(--color-text-soft,var(--muted))}.toolbar{display:flex;gap:var(--space-2);flex-wrap:wrap}button,select,input[type='file']{border-radius:var(--radius-lg,14px);border:1px solid var(--color-border,var(--border));background:var(--color-surface,#020617);color:var(--color-text,#fff);padding:.85rem 1rem;font:inherit;font-weight:800;cursor:pointer}button.primary{background:var(--color-primary,var(--primary));color:#020617;border-color:transparent}.notice{display:grid;gap:.25rem;padding:1rem;border:1px solid var(--color-border,var(--border));border-radius:var(--radius-xl,18px);background:color-mix(in srgb,var(--color-surface,#020617) 92%,transparent)}.notice strong{color:var(--color-text)}.workspace{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-3);align-items:start}.editor-label{color:var(--color-text-muted,var(--muted));font-weight:800}textarea{width:100%;min-height:460px;border-radius:var(--radius-xl,18px);border:1px solid var(--color-border,var(--border));background:#020617;color:#e5e7eb;padding:1rem;font:500 .95rem/1.65 ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;resize:vertical;tab-size:2;white-space:pre;overflow:auto}textarea[data-invalid='true']{border-color:rgba(252,165,165,.72);box-shadow:0 0 0 2px rgba(252,165,165,.12)}.stats-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-3)}.stat-card{border:1px solid var(--color-border,var(--border));border-radius:var(--radius-lg,14px);background:color-mix(in srgb,var(--color-surface,#020617) 92%,transparent);color:var(--color-text-muted,var(--muted));padding:.85rem 1rem;font-weight:800}.status.success{color:#86efac}.status.error{color:#fca5a5;white-space:pre-wrap}@media(max-width:920px){.options-grid,.workspace,.stats-grid{grid-template-columns:1fr}.editor-label:nth-of-type(2){grid-row:3}button,select,input[type='file']{width:100%}textarea{min-height:320px}}
  </style>

  <script define:vars={{ copy }}>
    import YAML from 'yaml';

    const MAX_FILE_SIZE = 512 * 1024;

    const inputText = document.getElementById('inputText') as HTMLTextAreaElement;
    const outputText = document.getElementById('outputText') as HTMLTextAreaElement;
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const viewMode = document.getElementById('viewMode') as HTMLSelectElement;
    const indentSelect = document.getElementById('indentSelect') as HTMLSelectElement;
    const formatYamlBtn = document.getElementById('formatYamlBtn') as HTMLButtonElement;
    const validateBtn = document.getElementById('validateBtn') as HTMLButtonElement;
    const toJsonBtn = document.getElementById('toJsonBtn') as HTMLButtonElement;
    const toYamlBtn = document.getElementById('toYamlBtn') as HTMLButtonElement;
    const copyBtn = document.getElementById('copyBtn') as HTMLButtonElement;
    const downloadYamlBtn = document.getElementById('downloadYamlBtn') as HTMLButtonElement;
    const downloadJsonBtn = document.getElementById('downloadJsonBtn') as HTMLButtonElement;
    const clearBtn = document.getElementById('clearBtn') as HTMLButtonElement;
    const status = document.getElementById('status') as HTMLParagraphElement;
    const lineCount = document.getElementById('lineCount') as HTMLOutputElement;
    const charCount = document.getElementById('charCount') as HTMLOutputElement;
    const sizeCount = document.getElementById('sizeCount') as HTMLOutputElement;

    let lastData: unknown = null;
    let lastMode: 'yaml' | 'json' = 'yaml';

    const setStatus = (message: string, type: 'default' | 'success' | 'error' = 'default') => {
      status.textContent = message;
      status.classList.toggle('success', type === 'success');
      status.classList.toggle('error', type === 'error');
      inputText.dataset.invalid = String(type === 'error');
      outputText.dataset.invalid = String(type === 'error');
    };

    const byteSize = (value: string) => new Blob([value]).size;
    const formatBytes = (bytes: number) => bytes < 1024 ? `${bytes} B` : bytes < 1024 * 1024 ? `${(bytes / 1024).toFixed(1)} KB` : `${(bytes / 1024 / 1024).toFixed(2)} MB`;

    const updateStats = () => {
      const value = outputText.value || inputText.value;
      lineCount.textContent = `${copy.lines}: ${value ? value.split('\n').length : 0}`;
      charCount.textContent = `${copy.characters}: ${value.length}`;
      sizeCount.textContent = `${copy.size}: ${formatBytes(byteSize(value))}`;
    };

    const getIndent = () => Number(indentSelect.value) || 2;

    const formatYamlValue = (value: unknown) => YAML.stringify(value, {
      indent: getIndent(),
      lineWidth: 0,
      sortMapEntries: false
    });

    const formatJsonValue = (value: unknown) => JSON.stringify(value, null, getIndent());

    const getParseErrorMessage = (error: unknown) => {
      if (!(error instanceof Error)) return copy.parseError;
      const anyError = error as Error & { linePos?: Array<{ line: number; col: number }> };
      const firstLinePos = anyError.linePos?.[0];
      if (firstLinePos) return `${copy.parseError}\nLínea ${firstLinePos.line}, columna ${firstLinePos.col}: ${error.message}`;
      return `${copy.parseError}\n${error.message}`;
    };

    const parseYaml = (value: string) => YAML.parse(value, {
      maxAliasCount: 50,
      prettyErrors: true
    });

    const parseInputAsYaml = () => {
      const value = inputText.value.trim();
      if (!value) throw new Error(copy.pasteFirst);
      return parseYaml(value);
    };

    const parseInputAsJson = () => {
      const value = inputText.value.trim();
      if (!value) throw new Error(copy.pasteFirst);
      try {
        return JSON.parse(value);
      } catch (error) {
        if (error instanceof Error) throw new Error(`${copy.jsonError}\n${error.message}`);
        throw new Error(copy.jsonError);
      }
    };

    const renderResult = (data: unknown, mode: 'yaml' | 'json', message: string) => {
      lastData = data;
      lastMode = mode;
      viewMode.value = mode;
      outputText.value = mode === 'yaml' ? formatYamlValue(data) : formatJsonValue(data);
      setStatus(message, 'success');
      updateStats();
    };

    const runYamlAction = async (action: 'validate' | 'format' | 'json') => {
      await new Promise((resolve) => window.requestAnimationFrame(resolve));
      try {
        const data = parseInputAsYaml();
        if (action === 'validate') {
          lastData = data;
          outputText.value = '';
          setStatus(copy.valid, 'success');
          updateStats();
          return;
        }
        renderResult(data, action === 'json' ? 'json' : 'yaml', action === 'json' ? copy.convertedToJson : copy.formatted);
      } catch (error) {
        outputText.value = '';
        setStatus(error instanceof Error && error.message === copy.pasteFirst ? error.message : getParseErrorMessage(error), 'error');
        updateStats();
      }
    };

    const runJsonToYaml = async () => {
      await new Promise((resolve) => window.requestAnimationFrame(resolve));
      try {
        const data = parseInputAsJson();
        renderResult(data, 'yaml', copy.convertedToYaml);
      } catch (error) {
        outputText.value = '';
        setStatus(error instanceof Error ? error.message : copy.jsonError, 'error');
        updateStats();
      }
    };

    const refreshOutputMode = () => {
      if (lastData === null && !outputText.value) return;
      const mode = viewMode.value as 'yaml' | 'json';
      if (lastData !== null) {
        outputText.value = mode === 'yaml' ? formatYamlValue(lastData) : formatJsonValue(lastData);
        lastMode = mode;
        updateStats();
      }
    };

    const download = (mode: 'yaml' | 'json') => {
      let value = outputText.value;
      if (lastData !== null && lastMode !== mode) value = mode === 'yaml' ? formatYamlValue(lastData) : formatJsonValue(lastData);
      if (!value.trim()) {
        setStatus(copy.downloadError, 'error');
        return;
      }

      const blob = new Blob([value], { type: mode === 'yaml' ? 'application/yaml;charset=utf-8' : 'application/json;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = mode === 'yaml' ? 'formatted.yaml' : 'converted.json';
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      setStatus(copy.downloaded, 'success');
    };

    formatYamlBtn.addEventListener('click', () => runYamlAction('format'));
    validateBtn.addEventListener('click', () => runYamlAction('validate'));
    toJsonBtn.addEventListener('click', () => runYamlAction('json'));
    toYamlBtn.addEventListener('click', runJsonToYaml);

    viewMode.addEventListener('change', refreshOutputMode);
    indentSelect.addEventListener('change', refreshOutputMode);

    inputText.addEventListener('input', () => {
      lastData = null;
      updateStats();
    });

    fileInput.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file) return;
      const lowerName = file.name.toLowerCase();
      if (!lowerName.endsWith('.yml') && !lowerName.endsWith('.yaml') && !lowerName.endsWith('.json')) {
        setStatus(copy.invalidFile, 'error');
        fileInput.value = '';
        return;
      }
      if (file.size > MAX_FILE_SIZE) {
        setStatus(copy.fileTooLarge, 'error');
        fileInput.value = '';
        return;
      }
      inputText.value = await file.text();
      outputText.value = '';
      lastData = null;
      setStatus(copy.loaded, 'success');
      updateStats();
      if (lowerName.endsWith('.json')) runJsonToYaml();
      else runYamlAction('format');
    });

    copyBtn.addEventListener('click', async () => {
      if (!outputText.value) {
        setStatus(copy.noResult, 'error');
        return;
      }
      try {
        await navigator.clipboard.writeText(outputText.value);
        setStatus(copy.copied, 'success');
      } catch {
        outputText.focus();
        outputText.select();
        setStatus(copy.copyError, 'error');
      }
    });

    downloadYamlBtn.addEventListener('click', () => download('yaml'));
    downloadJsonBtn.addEventListener('click', () => download('json'));

    clearBtn.addEventListener('click', () => {
      inputText.value = '';
      outputText.value = '';
      fileInput.value = '';
      lastData = null;
      setStatus(copy.cleared);
      updateStats();
      inputText.focus();
    });

    updateStats();
  </script>
</Layout>
