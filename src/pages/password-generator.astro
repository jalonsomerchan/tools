---
import Layout from '../layouts/Layout.astro';

const title = 'Generador de contraseñas y frases seguras';
const description = 'Genera contraseñas y passphrases localmente en el navegador usando Web Crypto, sin backend ni almacenamiento.';
---

<Layout title={`${title} — Alon Tools`} description={description} path="/password-generator/" translated={false}>
  <section class="password-page">
    <div class="eyebrow">100% local</div>
    <h1>{title}</h1>
    <p class="hero-text">Crea contraseñas configurables y frases seguras sin enviar datos a ningún servidor. La herramienta usa <code>crypto.getRandomValues()</code> y no guarda resultados.</p>

    <section class="tool-card password-tool" aria-labelledby="passwordToolTitle">
      <div class="tool-header">
        <div>
          <h2 id="passwordToolTitle">Generador local</h2>
          <p>Elige entre contraseñas aleatorias o frases con palabras incluidas en el propio bundle.</p>
        </div>
      </div>

      <div class="privacy-note" role="note">Privacidad: todo se genera en tu navegador. No hay llamadas de red, no se usa <code>localStorage</code> y las contraseñas no se persisten.</div>

      <div class="options-grid" aria-label="Opciones del generador">
        <label for="modeSelect">Tipo<select id="modeSelect"><option value="password">Contraseña</option><option value="passphrase">Frase segura</option></select></label>
        <label for="amountInput">Cantidad<input id="amountInput" type="number" min="1" max="100" step="1" value="5" /></label>
        <label for="lengthInput" id="lengthLabel">Longitud<input id="lengthInput" type="number" min="8" max="128" step="1" value="24" /></label>
        <label for="wordsInput" id="wordsLabel" hidden>Palabras por frase<input id="wordsInput" type="number" min="3" max="10" step="1" value="5" /></label>
      </div>

      <fieldset class="charset-options" id="charsetOptions">
        <legend>Caracteres para contraseñas</legend>
        <label><input id="lowercaseInput" type="checkbox" checked /> Minúsculas</label>
        <label><input id="uppercaseInput" type="checkbox" checked /> Mayúsculas</label>
        <label><input id="numbersInput" type="checkbox" checked /> Números</label>
        <label><input id="symbolsInput" type="checkbox" checked /> Símbolos</label>
        <label><input id="ambiguousInput" type="checkbox" checked /> Evitar ambiguos</label>
      </fieldset>

      <div class="phrase-options" id="phraseOptions" hidden>
        <label for="separatorInput">Separador<input id="separatorInput" type="text" maxlength="4" value="-" /></label>
        <label class="check-row"><input id="phraseNumberInput" type="checkbox" checked /> Añadir número al final</label>
      </div>

      <div class="toolbar" aria-label="Acciones">
        <button class="primary" id="generateBtn" type="button">Generar</button>
        <button id="copyBtn" type="button">Copiar resultados</button>
        <button id="clearBtn" type="button">Limpiar</button>
      </div>

      <div class="strength" aria-label="Fortaleza aproximada">
        <div><strong id="entropyLabel">Entropía estimada: 0 bits</strong><span id="strengthLabel">Configura y genera resultados.</span></div>
        <meter id="strengthMeter" min="0" max="128" value="0">0</meter>
      </div>

      <label class="editor-label" for="output">Resultados</label>
      <textarea id="output" readonly spellcheck="false" placeholder="Aquí aparecerán las contraseñas o frases generadas..."></textarea>

      <p class="status" id="status" role="status" aria-live="polite">Listo.</p>
    </section>
  </section>

  <style>
    .password-page{padding:clamp(2rem,6vw,4rem) 0}.password-tool{display:grid;gap:var(--space-4)}.tool-header{display:flex;justify-content:space-between;gap:var(--space-4);align-items:flex-start}.tool-header h2{margin:0 0 var(--space-2);font-size:clamp(1.25rem,2vw,1.6rem)}.tool-header p,.status,.privacy-note,.strength span{margin:0;color:var(--color-text-muted,var(--muted));line-height:1.7}.privacy-note,.strength{padding:1rem;border:1px solid var(--color-border,var(--border));border-radius:var(--radius-xl,18px);background:color-mix(in srgb,var(--color-surface,#020617) 92%,transparent)}.privacy-note code,.password-page code{font:600 .95em ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace}.options-grid,.phrase-options{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--space-3)}.options-grid label,.phrase-options label{display:grid;gap:.45rem;color:var(--color-text-muted,var(--muted));font-weight:800}input,select,button{border-radius:var(--radius-lg,14px);border:1px solid var(--color-border,var(--border));background:var(--color-surface,#020617);color:var(--color-text,#fff);padding:.85rem 1rem;font:inherit}button{font-weight:800;cursor:pointer}button.primary{background:var(--color-primary,var(--primary));color:#020617;border-color:transparent}.charset-options{display:flex;flex-wrap:wrap;gap:.75rem 1rem;border:1px solid var(--color-border,var(--border));border-radius:var(--radius-xl,18px);padding:1rem}.charset-options legend{padding:0 .35rem;font-weight:900;color:var(--color-text)}.charset-options label,.check-row{display:flex;align-items:center;gap:.45rem;color:var(--color-text-muted,var(--muted));font-weight:800}.charset-options input,.check-row input{width:auto;accent-color:var(--color-primary,var(--primary))}.toolbar{display:flex;gap:var(--space-2);flex-wrap:wrap}.editor-label{color:var(--color-text-muted,var(--muted));font-weight:800}textarea{width:100%;min-height:300px;border-radius:var(--radius-xl,18px);border:1px solid var(--color-border,var(--border));background:#020617;color:#e5e7eb;padding:1rem;font:500 .95rem/1.65 ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;resize:vertical;white-space:pre;overflow:auto}.strength{display:grid;gap:.75rem}.strength strong,.strength span{display:block}.strength meter{width:100%;height:1rem}.status.success{color:#86efac}.status.error{color:#fca5a5}@media(max-width:900px){.options-grid,.phrase-options{grid-template-columns:1fr 1fr}}@media(max-width:640px){.options-grid,.phrase-options{grid-template-columns:1fr}.charset-options{display:grid;grid-template-columns:1fr}.toolbar{display:grid;grid-template-columns:1fr}button,input,select{width:100%}}
  </style>

  <script>
    const $ = (id) => document.getElementById(id);
    const modeSelect = $('modeSelect');
    const amountInput = $('amountInput');
    const lengthInput = $('lengthInput');
    const wordsInput = $('wordsInput');
    const lengthLabel = $('lengthLabel');
    const wordsLabel = $('wordsLabel');
    const charsetOptions = $('charsetOptions');
    const phraseOptions = $('phraseOptions');
    const lowercaseInput = $('lowercaseInput');
    const uppercaseInput = $('uppercaseInput');
    const numbersInput = $('numbersInput');
    const symbolsInput = $('symbolsInput');
    const ambiguousInput = $('ambiguousInput');
    const separatorInput = $('separatorInput');
    const phraseNumberInput = $('phraseNumberInput');
    const output = $('output');
    const status = $('status');
    const entropyLabel = $('entropyLabel');
    const strengthLabel = $('strengthLabel');
    const strengthMeter = $('strengthMeter');
    const LOWER = 'abcdefghijklmnopqrstuvwxyz';
    const UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const NUMBERS = '0123456789';
    const SYMBOLS = '!@#$%^&*()-_=+[]{};:,.?/|~';
    const AMBIGUOUS = /[0O1Il|`'"\\/{}()[\]<>;]/g;
    const WORDS = ['sol','rio','monte','nube','casa','pino','luna','campo','mar','faro','trigo','roca','valle','olivo','brisa','norte','sur','este','oeste','verde','azul','rojo','oro','plata','cobre','arena','lluvia','nieve','trueno','rayo','flor','hoja','rama','bosque','sendero','puente','torre','fuente','plaza','camino','estrella','cielo','tierra','fuego','agua','aire','libro','mapa','clave','puerta','ventana','mesa','silla','coral','granito','cerezo','encina','miel','limon','uva','perla','barco','isla','bahia','puerto'];

    const clamp = (value, min, max) => Math.min(max, Math.max(min, value));
    const setStatus = (message, type = 'default') => {
      status.textContent = message;
      status.classList.toggle('success', type === 'success');
      status.classList.toggle('error', type === 'error');
    };
    const randomIndex = (max) => {
      const limit = Math.floor(0xffffffff / max) * max;
      const buffer = new Uint32Array(1);
      do crypto.getRandomValues(buffer); while (buffer[0] >= limit);
      return buffer[0] % max;
    };
    const normalize = () => {
      amountInput.value = String(clamp(Math.round(Number(amountInput.value) || 1), 1, 100));
      lengthInput.value = String(clamp(Math.round(Number(lengthInput.value) || 8), 8, 128));
      wordsInput.value = String(clamp(Math.round(Number(wordsInput.value) || 3), 3, 10));
    };
    const getCharset = () => {
      let charset = '';
      if (lowercaseInput.checked) charset += LOWER;
      if (uppercaseInput.checked) charset += UPPER;
      if (numbersInput.checked) charset += NUMBERS;
      if (symbolsInput.checked) charset += SYMBOLS;
      if (ambiguousInput.checked) charset = charset.replace(AMBIGUOUS, '');
      return Array.from(new Set(charset.split(''))).join('');
    };
    const updateMode = () => {
      const phrase = modeSelect.value === 'passphrase';
      lengthLabel.hidden = phrase;
      charsetOptions.hidden = phrase;
      wordsLabel.hidden = !phrase;
      phraseOptions.hidden = !phrase;
      updateStrength();
    };
    const updateStrength = () => {
      normalize();
      let entropy = 0;
      if (modeSelect.value === 'password') {
        const charset = getCharset();
        entropy = charset ? Math.log2(charset.length) * Number(lengthInput.value) : 0;
      } else {
        entropy = Math.log2(WORDS.length) * Number(wordsInput.value) + (phraseNumberInput.checked ? Math.log2(100) : 0);
      }
      const rounded = Math.round(entropy);
      entropyLabel.textContent = `Entropía estimada: ${rounded} bits`;
      strengthMeter.value = Math.min(128, rounded);
      strengthLabel.textContent = rounded >= 90 ? 'Muy fuerte para usos generales.' : rounded >= 60 ? 'Correcta, aunque puedes subir longitud o palabras.' : 'Débil: aumenta longitud, palabras o grupos de caracteres.';
    };
    const makePassword = (length, charset) => {
      let value = '';
      for (let index = 0; index < length; index += 1) value += charset[randomIndex(charset.length)];
      return value;
    };
    const makePhrase = (count) => {
      const separator = separatorInput.value || '-';
      const words = Array.from({ length: count }, () => WORDS[randomIndex(WORDS.length)]);
      if (phraseNumberInput.checked) words.push(String(randomIndex(100)).padStart(2, '0'));
      return words.join(separator);
    };

    $('generateBtn').addEventListener('click', () => {
      normalize();
      const amount = Number(amountInput.value);
      const results = [];
      if (modeSelect.value === 'password') {
        const charset = getCharset();
        if (!charset) return setStatus('Selecciona al menos un grupo de caracteres.', 'error');
        for (let index = 0; index < amount; index += 1) results.push(makePassword(Number(lengthInput.value), charset));
      } else {
        for (let index = 0; index < amount; index += 1) results.push(makePhrase(Number(wordsInput.value)));
      }
      output.value = results.join('\n');
      updateStrength();
      setStatus(`${amount} resultado${amount === 1 ? '' : 's'} generado${amount === 1 ? '' : 's'} localmente.`, 'success');
    });
    $('copyBtn').addEventListener('click', async () => {
      if (!output.value) return setStatus('No hay resultados que copiar.', 'error');
      try {
        await navigator.clipboard.writeText(output.value);
        setStatus('Resultados copiados al portapapeles.', 'success');
      } catch {
        output.focus();
        output.select();
        setStatus('No se pudo usar el portapapeles. El texto queda seleccionado para copiarlo manualmente.', 'error');
      }
    });
    $('clearBtn').addEventListener('click', () => {
      output.value = '';
      setStatus('Resultados eliminados.');
    });
    [modeSelect, amountInput, lengthInput, wordsInput, lowercaseInput, uppercaseInput, numbersInput, symbolsInput, ambiguousInput, separatorInput, phraseNumberInput].forEach((element) => element.addEventListener('input', () => { updateMode(); updateStrength(); }));
    updateMode();
  </script>
</Layout>
