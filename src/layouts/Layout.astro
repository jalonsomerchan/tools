---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <style is:global>
      :root {
        color-scheme: dark;
        --bg: #020617;
        --card: rgba(15, 23, 42, .88);
        --border: rgba(148, 163, 184, .18);
        --text: #e2e8f0;
        --muted: #94a3b8;
        --primary: #38bdf8;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          radial-gradient(circle at top, rgba(56,189,248,.12), transparent 35%),
          var(--bg);
        color: var(--text);
        font-family: Inter, system-ui, sans-serif;
      }

      .page-shell {
        width: min(1200px, calc(100% - 2rem));
        margin: auto;
      }

      .eyebrow {
        display: inline-block;
        padding: .4rem .8rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        color: var(--primary);
      }

      h1 {
        font-size: clamp(3rem, 6vw, 5rem);
        line-height: .95;
        letter-spacing: -.05em;
      }

      .hero-text {
        color: var(--muted);
        max-width: 700px;
        line-height: 1.7;
      }

      .tool-card {
        margin-top: 2rem;
        padding: 1.5rem;
        border-radius: 24px;
        border: 1px solid var(--border);
        background: var(--card);
      }
    </style>
  </head>

  <body>
    <Header />

    <main class="page-shell">
      <slot />
    </main>

    <Footer />
  </body>
</html>
